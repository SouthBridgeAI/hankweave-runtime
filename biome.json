{
  "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
  "files": {
    "includes": [
      "server/**/*",
      "!server/llm/*.json",
      "scripts/**/*.ts",
      "tests/e2e/**/*.ts",
      "tests/integration/**/*.ts",
      "tests/utils/**/*.ts",
      "tests/unit/**/*.ts",
      "tests/*.ts",
      "types/**/*"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noBannedTypes": "off"
      },
      "style": {
        "noParameterAssign": "off",
        "useConst": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "minimatch": "Glob matching must go through UnifiedFileResolver (micromatch + shared ignore rules) so every site applies identical semantics. See intermediates/65-watched-patterns-bugs/02-divergent-pattern-matching.md."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  }
}
