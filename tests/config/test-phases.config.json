[
  {
    "id": "phase-1",
    "name": "Phase 1: TestPhase1",
    "promptFile": ["./phase1Prompt1.md", "./phase1Prompt2.md"],
    "model": "sonnet",
    "continuationMode": "fresh",
    "workspaceSetup": [
      {
        "type": "command",
        "command": {
          "run": "mkdir -p notes",
          "workingDirectory": "project"
        }
      }
    ],
    "appendSystemPromptFile": [
      "./systemPrompt1.md",
      "./systemPrompt2.md",
      "./noTodosPrompt.md"
    ],
    "description": "Write three pick one",
    "trackedFiles": ["notes/**/*", "*.md"],
    "output": {
      "copy": ["notes/favorite_poem.txt"]
    }
  },
  {
    "id": "phase-2",
    "name": "Phase 2: Schema Generation",
    "promptText": "Can you put your second favorite of the poems you just made into the notes folder as '<%PROJECT_DIR%>/notes/second_favorite_poem.txt'?",
    "model": "sonnet",
    "continuationMode": "continue-previous",
    "appendSystemPromptFile": ["./noTodosPrompt.md"],
    "description": "Write one more",
    "trackedFiles": ["notes/**/*"],
    "output": {
      "copy": ["notes/second_favorite_poem.txt"]
    }
  },
  {
    "id": "phase-3",
    "name": "Phase 3: More Validation",
    "promptText": "Can you convert the poems in the notes folder into typescript code in the <%PROJECT_DIR%>/typescript_code/src folder? Call them poem1.ts and poem2.ts. DON'T USE TODOs.",
    "model": "sonnet",
    "workspaceSetup": [
      {
        "type": "copy",
        "copy": {
          "from": "./typescript_structure",
          "to": "typescript_code"
        }
      },
      {
        "type": "command",
        "command": {
          "run": "bun install",
          "workingDirectory": "lastCopied"
        }
      }
    ],
    "continuationMode": "fresh",
    "description": "Convert poems to code",
    "appendSystemPromptFile": ["./noTodosPrompt.md"],
    "trackedFiles": [
      "typescript_code/src/**/*.ts",
      "typescript_code/package.json"
    ]
  }
]
