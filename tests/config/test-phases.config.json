[
  {
    "id": "phase-1",
    "name": "Phase 1: TestPhase1",
    "promptFile": ["./phase1Prompt1.md", "./phase1Prompt2.md"],
    "model": "sonnet",
    "continueFromPrevious": false,
    "workspaceSetup": [
      {
        "type": "command",
        "command": {
          "run": "mkdir -p notes",
          "workingDirectory": "project"
        }
      }
    ],
    "watch": "./notes/*.txt",
    "appendSystemPromptFile": ["./systemPrompt1.md", "./systemPrompt2.md"],
    "description": "Write three pick one"
  },
  {
    "id": "phase-2",
    "name": "Phase 2: Schema Generation",
    "promptText": "Can you put your second favorite of the poems you just made into the notes folder as 'second_favorite_poem.txt'?",
    "model": "sonnet",
    "continueFromPrevious": true,
    "watch": "./notes/*.*",
    "description": "Write one more"
  },
  {
    "id": "phase-3",
    "name": "Phase 2a: More Validation",
    "promptText": "Can you convert the poems in the notes folder into typescript code in the typescript_code/src folder? Call them poem1.ts and poem2.ts.",
    "model": "sonnet",
    "workspaceSetup": [
      {
        "type": "copy",
        "copy": {
          "from": "./typescript_structure",
          "to": "typescript_code"
        }
      },
      {
        "type": "command",
        "command": {
          "run": "bun install",
          "workingDirectory": "lastCopied"
        }
      }
    ],
    "continueFromPrevious": false,
    "watch": "./typescript_code/src/**/*.ts",
    "description": "Convert poems to code"
  }
]
