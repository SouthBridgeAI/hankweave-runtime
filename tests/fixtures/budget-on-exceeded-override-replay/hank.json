{
  "$schema": "https://unpkg.com/hankweave@latest/schemas/hank.schema.json",
  "overrides": {
    "budget": { "maxDollars": 0.001, "onExceeded": "fail" }
  },
  "hank": [
    {
      "id": "override-codon",
      "name": "Override to Complete",
      "promptText": "Write a detailed essay about the history of computing. Make it at least 2000 words.",
      "model": "anthropic/claude-haiku-4-5",
      "budget": { "onExceeded": "complete" },
      "continuationMode": "fresh"
    },
    {
      "id": "followup-codon",
      "name": "Followup",
      "promptText": "Say exactly: hello world",
      "model": "anthropic/claude-haiku-4-5",
      "continuationMode": "fresh"
    }
  ]
}
