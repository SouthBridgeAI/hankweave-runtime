    const ajv = createAjv();\n    43→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n    44→      expect(schema.$schema).toBe(\"http://json-schema.org/draft-07/schema#\");\n    45→      expect(schema.title).toContain(\"Hank\");\n    46→\n    47→      const validate = ajv.compile(schema);\n    48→      expect(typeof validate).toBe(\"function\");\n    49→    });\n    50→\n    51→    test(\"hankweave.schema.json is valid JSON Schema\", () => {\n    52→      const ajv = createAjv();\n    53→      const schema = JSON.parse(\n    54→        fs.readFileSync(path.join(schemaDir, \"hankweave.schema.json\"), \"utf-8\"),\n    55→      );\n    56→      const validate = ajv.compile(schema);\n    57→      expect(typeof validate).toBe(\"function\");\n    58→    });\n    59→\n    60→    test(\"sentinel.schema.json is valid JSON Schema\", () => {\n    61→      const ajv = createAjv();\n    62→      const schema = JSON.parse(\n    63→        fs.readFileSync(path.join(schemaDir, \"sentinel.schema.json\"), \"utf-8\"),\n    64→      );\n    65→      const validate = ajv.compile(schema);\n    66→      expect(typeof validate).toBe(\"function\");\n    67→    });\n    68→  });\n    69→\n    70→  describe(\"Schema structure\", () => {\n    71→    test(\"hank schema has required properties\", () => {\n    72→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n    73→\n    74→      // Schema uses $ref to definitions, so get the root definition\n    75→      const rootDef = getRootDefinition(schema);\n    76→      expect(rootDef).not.toBeNull();\n    77→\n    78→      // Should have top-level properties for hank files\n    79→      const properties = rootDef?.properties as Record<string, unknown>;\n    80→      expect(properties).toBeDefined();\n    81→      expect(properties.hank).toBeDefined();\n    82→      expect(properties.meta).toBeDefined();\n    83→      expect(properties.over