{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7P3nq5jD2MiaoVBjWWh2S","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→/**\n     3→ * Generate JSON Schemas from Zod schemas.\n     4→ * Run with: bun scripts/generate-schemas.ts\n     5→ *\n     6→ * These schemas enable editor autocomplete and validation for:\n     7→ * - hank.json (workflow configuration)\n     8→ * - hankweave.json (runtime settings)\n     9→ * - sentinel config files\n    10→ */\n    11→\n    12→import Ajv from \"ajv\";\n    13→import * as fs from \"node:fs\";\n    14→import * as path from \"node:path\";\n    15→import type { z } from \"zod\";\n    16→import { zodToJsonSchema } from \"zod-to-json-schema\";\n    17→import { hankFileAuthoringSchema, runtimeConfigSchema } from \"../server/config.js\";\n    18→import { sentinelConfigSchema } from \"../server/config-validation/sentinel.schema.js\";\n    19→\n    20→// AJV instance for validating generated schemas are valid JSON Schema draft-07\n    21→const ajv = new Ajv({ allErrors: true, strict: false });\n    22→\n    23→const SCHEMA_DIR = path.join(import.meta.dir, \"..\", \"schemas\");\n    24→const DOCS_SCHEMA_DIR = path.join(\n    25→  import.meta.dir,\n    26→  \"..\",\n    27→  \"..\",\n    28→  \"hankweave-docs\",\n    29→  \"nextra-site\",\n    30→  \"public\",\n    31→  \"schemas\",\n    32→);\n    33→// Using unpkg CDN for npm package hosting\n    34→const BASE_URL = \"https://unpkg.com/hankweave@latest/schemas\";\n    35→\n    36→interface SchemaConfig {\n    37→  zodSchema: z.ZodTypeAny;\n    38→  outputFile: string;\n    39→  title: string;\n    40→  description: string;\n    41→}\n    42→\n    43→const schemas: SchemaConfig[] = [\n    44→  {\n    45→    zodSchema: hankFileAuthoringSchema,\n    46→    outputFile: \"hank.schema.json\",\n    47→    title: \"Hankweave Hank File\",\n    48→    description:\n    49→      \"Schema for hank.json - the main workflow configuration file for Hankweave. See https://hankweave.dev/reference/configuration for documentation.\",\n    50→  },\n    51→  {\n    52→    zodSchema: runtimeConfigSchema,\n    53→    outputFile: \"hankweave.schema.json\",\n    54→    title: \"Hankweave Runtime Configuration\",\n    55→    description:\n    56→      \"Schema for hankweave.json - runtime settings for the Hankweave server. See https://hankweave.dev/reference/configuration for documentation.\",\n    57→  },\n    58→  {\n    59→    zodSchema: sentinelConfigSchema,\n    60→    outputFile: \"sentinel.schema.json\",\n    61→    title: \"Hankweave Sentinel Configuration\",\n    62→    description:\n    63→      \"Schema for sentinel configuration files - parallel observation agents. Note: Some runtime validations cannot be expressed in JSON Schema. See https://hankweave.dev/reference/sentinel-config for documentation.\",\n    64→  },\n    65→];\n    66→\n    67→async function generateSchemas() {\n    68→  console.log(\"Generating JSON schemas...\\n\");\n    69→\n    70→  // Ensure package schemas directory exists (required)\n    71→  if (!fs.existsSync(SCHEMA_DIR)) {\n    72→    fs.mkdirSync(SCHEMA_DIR, { recursive: true });\n    73→  }\n    74→\n    75→  // Check if docs directory exists (optional - only used if hosting schemas on hankweave.dev)\n    76→  const docsAvailable = fs.existsSync(path.dirname(DOCS_SCHEMA_DIR));\n    77→  if (docsAvailable && !fs.existsSync(DOCS_SCHEMA_DIR)) {\n    78→    fs.mkdirSync(DOCS_SCHEMA_DIR, { recursive: true });\n    79→  }\n    80→\n    81→  for (const config of schemas) {\n    82→    console.log(`Generating ${config.outputFile}...`);\n    83→\n    84→    // @ts-ignore - zodToJsonSchema has excessively deep types\n    85→    const jsonSchema: Record<string, unknown> = zodToJsonSchema(config.zodSchema, {\n    86→      name: config.title.replace(/\\s+/g, \"\"),\n    87→      target: \"jsonSchema7\", // Draft-07 for VS Code compatibility\n    88→      $refStrategy: \"none\", // Inline all definitions for simpler schemas\n    89→    });\n    90→\n    91→    // Add standard JSON Schema metadata\n    92→    const schemaWithMeta: Record<string, unknown> = {\n    93→      $schema: \"http://json-schema.org/draft-07/schema#\",\n    94→      $id: `${BASE_URL}/${config.outputFile}`,\n    95→      title: config.title,\n    96→      description: config.description,\n    97→      ...jsonSchema,\n    98→    };\n    99→\n   100→    // Remove the auto-generated name key if present\n   101→    if (\"name\" in schemaWithMeta) {\n   102→      delete schemaWithMeta.name;\n   103→    }\n   104→\n   105→    // For schemas without authoring variants (hankweave.json, sentinel.json),\n   106→    // inject $schema property into the generated schema so editors show it in autocomplete.\n   107→    // hank.schema.json already has $schema via hankFileAuthoringSchema.\n   108→    if (config.outputFile !== \"hank.schema.json\") {\n   109→      // Handle both direct properties and $ref-based schemas\n   110→      if (\"properties\" in schemaWithMeta && schemaWithMeta.properties) {\n   111→        (schemaWithMeta.properties as Record<string, unknown>).$schema = {\n   112→          type: \"string\",\n   113→          description: \"JSON Schema URL for editor support\",\n   114→        };\n   115→      } else if (\"definitions\" in schemaWithMeta && schemaWithMeta.definitions) {\n   116→        // When using $ref, properties are in definitions\n   117→        const definitions = schemaWithMeta.definitions as Record<string, Record<string, unknown>>;\n   118→        for (const defKey of Object.keys(definitions)) {\n   119→          const definition = definitions[defKey];\n   120→          if (definition && typeof definition === \"object\" && \"properties\" in definition) {\n   121→            (definition.properties as Record<string, unknown>).$schema = {\n   122→              type: \"string\",\n   123→              description: \"JSON Schema URL for editor support\",\n   124→            };\n   125→          }\n   126→        }\n   127→      }\n   128→    }\n   129→\n   130→    const schemaJson = JSON.stringify(schemaWithMeta, null, 2);\n   131→\n   132→    // Validate that generated schema is valid JSON Schema\n   133→    try {\n   134→      ajv.compile(schemaWithMeta);\n   135→      console.log(\"  ✅ Schema validated successfully\");\n   136→    } catch (error) {\n   137→      console.error(`  ❌ Generated schema is invalid JSON Schema: ${error}`);\n   138→      throw error;\n   139→    }\n   140→\n   141→    // Write to package schemas directory\n   142→    const packagePath = path.join(SCHEMA_DIR, config.outputFile);\n   143→    fs.writeFileSync(packagePath, schemaJson);\n   144→    console.log(`  ✅ Written to ${packagePath}`);\n   145→\n   146→    // Write to docs public directory for URL hosting (if available)\n   147→    if (docsAvailable) {\n   148→      const docsPath = path.join(DOCS_SCHEMA_DIR, config.outputFile);\n   149→      fs.writeFileSync(docsPath, schemaJson);\n   150→      console.log(`  ✅ Written to ${docsPath}`);\n   151→    }\n   152→  }\n   153→\n   154→  console.log(\"\\nSchema generation complete!\");\n   155→}\n   156→\n   157→generateSchemas().catch((error) => {\n   158→  console.error(\"❌ Schema generation failed:\", error);\n   159→  process.exit(1);\n   160→});\n   161→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a77b2755-3bdb-4c5a-a31c-e6ef769bd1ab","uuid":"634532b3-8570-470d-8511-dca12b80edbe","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/generate-schemas.ts","content":"#!/usr/bin/env bun\n/**\n * Generate JSON Schemas from Zod schemas.\n * Run with: bun scripts/generate-schemas.ts\n *\n * These schemas enable editor autocomplete and validation for:\n * - hank.json (workflow configuration)\n * - hankweave.json (runtime settings)\n * - sentinel config files\n */\n\nimport Ajv from \"ajv\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport type { z } from \"zod\";\nimport { zodToJsonSchema } from \"zod-to-json-schema\";\nimport { hankFileAuthoringSchema, runtimeConfigSchema } from \"../server/config.js\";\nimport { sentinelConfigSchema } from \"../server/config-validation/sentinel.schema.js\";\n\n// AJV instance for validating generated schemas are valid JSON Schema draft-07\nconst ajv = new Ajv({ allErrors: true, strict: false });\n\nconst SCHEMA_DIR = path.join(import.meta.dir, \"..\", \"schemas\");\nconst DOCS_SCHEMA_DIR = path.join(\n  import.meta.dir,\n  \"..\",\n  \"..\",\n  \"hankweave-docs\",\n  \"nextra-site\",\n  \"public\",\n  \"schemas\",\n);\n// Using unpkg CDN for npm package hosting\nconst BASE_URL = \"https://unpkg.com/hankweave@latest/schemas\";\n\ninterface SchemaConfig {\n  zodSchema: z.ZodTypeAny;\n  outputFile: string;\n  title: string;\n  description: string;\n}\n\nconst schemas: SchemaConfig[] = [\n  {\n    zodSchema: hankFileAuthoringSchema,\n    outputFile: \"hank.schema.json\",\n    title: \"Hankweave Hank File\",\n    description:\n      \"Schema for hank.json - the main workflow configuration file for Hankweave. See https://hankweave.dev/reference/configuration for documentation.\",\n  },\n  {\n    zodSchema: runtimeConfigSchema,\n    outputFile: \"hankweave.schema.json\",\n    title: \"Hankweave Runtime Configuration\",\n    description:\n      \"Schema for hankweave.json - runtime settings for the Hankweave server. See https://hankweave.dev/reference/configuration for documentation.\",\n  },\n  {\n    zodSchema: sentinelConfigSchema,\n    outputFile: \"sentinel.schema.json\",\n    title: \"Hankweave Sentinel Configuration\",\n    description:\n      \"Schema for sentinel configuration files - parallel observation agents. Note: Some runtime validations cannot be expressed in JSON Schema. See https://hankweave.dev/reference/sentinel-config for documentation.\",\n  },\n];\n\nasync function generateSchemas() {\n  console.log(\"Generating JSON schemas...\\n\");\n\n  // Ensure package schemas directory exists (required)\n  if (!fs.existsSync(SCHEMA_DIR)) {\n    fs.mkdirSync(SCHEMA_DIR, { recursive: true });\n  }\n\n  // Check if docs directory exists (optional - only used if hosting schemas on hankweave.dev)\n  const docsAvailable = fs.existsSync(path.dirname(DOCS_SCHEMA_DIR));\n  if (docsAvailable && !fs.existsSync(DOCS_SCHEMA_DIR)) {\n    fs.mkdirSync(DOCS_SCHEMA_DIR, { recursive: true });\n  }\n\n  for (const config of schemas) {\n    console.log(`Generating ${config.outputFile}...`);\n\n    // @ts-ignore - zodToJsonSchema has excessively deep types\n    const jsonSchema: Record<string, unknown> = zodToJsonSchema(config.zodSchema, {\n      name: config.title.replace(/\\s+/g, \"\"),\n      target: \"jsonSchema7\", // Draft-07 for VS Code compatibility\n      $refStrategy: \"none\", // Inline all definitions for simpler schemas\n    });\n\n    // Add standard JSON Schema metadata\n    const schemaWithMeta: Record<string, unknown> = {\n      $schema: \"http://json-schema.org/draft-07/schema#\",\n      $id: `${BASE_URL}/${config.outputFile}`,\n      title: config.title,\n      description: config.description,\n      ...jsonSchema,\n    };\n\n    // Remove the auto-generated name key if present\n    if (\"name\" in schemaWithMeta) {\n      delete schemaWithMeta.name;\n    }\n\n    // For schemas without authoring variants (hankweave.json, sentinel.json),\n    // inject $schema property into the generated schema so editors show it in autocomplete.\n    // hank.schema.json already has $schema via hankFileAuthoringSchema.\n    if (config.outputFile !== \"hank.schema.json\") {\n      // Handle both direct properties and $ref-based schemas\n      if (\"properties\" in schemaWithMeta && schemaWithMeta.properties) {\n        (schemaWithMeta.properties as Record<string, unknown>).$schema = {\n          type: \"string\",\n          description: \"JSON Schema URL for editor support\",\n        };\n      } else if (\"definitions\" in schemaWithMeta && schemaWithMeta.definitions) {\n        // When using $ref, properties are in definitions\n        const definitions = schemaWithMeta.definitions as Record<string, Record<string, unknown>>;\n        for (const defKey of Object.keys(definitions)) {\n          const definition = definitions[defKey];\n          if (definition && typeof definition === \"object\" && \"properties\" in definition) {\n            (definition.properties as Record<string, unknown>).$schema = {\n              type: \"string\",\n              description: \"JSON Schema URL for editor support\",\n            };\n          }\n        }\n      }\n    }\n\n    const schemaJson = JSON.stringify(schemaWithMeta, null, 2);\n\n    // Validate that generated schema is valid JSON Schema\n    try {\n      ajv.compile(schemaWithMeta);\n      console.log(\"  ✅ Schema validated successfully\");\n    } catch (error) {\n      console.error(`  ❌ Generated schema is invalid JSON Schema: ${error}`);\n      throw error;\n    }\n\n    // Write to package schemas directory\n    const packagePath = path.join(SCHEMA_DIR, config.outputFile);\n    fs.writeFileSync(packagePath, schemaJson);\n    console.log(`  ✅ Written to ${packagePath}`);\n\n    // Write to docs public directory for URL hosting (if available)\n    if (docsAvailable) {\n      const docsPath = path.join(DOCS_SCHEMA_DIR, config.outputFile);\n      fs.writeFileSync(docsPath, schemaJson);\n      console.log(`  ✅ Written to ${docsPath}`);\n    }\n  }\n\n  console.log(\"\\nSchema generation complete!\");\n}\n\ngenerateSchemas().catch((error) => {\n  console.error(\"❌ Schema generation failed:\", error);\n  process.exit(1);\n});\n","numLines":161,"startLine":1,"totalLines":161}},"timestamp":"2026-03-05T12:49:06.766Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M55hc9vBeWrSDVBBDdGHPx","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→\n     3→/**\n     4→ * Sync to Public Repository Script\n     5→ *\n     6→ * Handles syncing releases from the private repo to the public repo.\n     7→ * Called by the sync-public.yml workflow.\n     8→ *\n     9→ * Usage:\n    10→ *   bun scripts/sync-public.ts prepare-snapshot --version 0.1.41\n    11→ *   bun scripts/sync-public.ts initial-sync --version 0.1.41\n    12→ *   bun scripts/sync-public.ts snapshot-sync --version 0.1.41\n    13→ */\n    14→\n    15→import { existsSync } from \"node:fs\";\n    16→import { readFile, writeFile, mkdir, rm, readdir, cp } from \"node:fs/promises\";\n    17→import { resolve, join } from \"node:path\";\n    18→\n    19→// Configuration\n    20→//\n    21→// Note: Most internal files (intermediates/, external-docs/, CLAUDE.md, etc.) are\n    22→// already stripped during the release process (develop → release/alpha). The exclusions\n    23→// here are safety nets for:\n    24→// 1. Initial sync (which imports full history that may contain these files)\n    25→// 2. Any edge cases where files weren't stripped during release\n    26→//\n    27→// Directories to strip (will be excluded with trailing /)\n    28→const STRIP_DIRS = [\"intermediates\", \"external-docs\", \"public-release-files\", \".github/actions\"];\n    29→\n    30→// Files to strip (excluded without trailing /)\n    31→const STRIP_FILES = [\n    32→  \"CLAUDE.md\",\n    33→  \"Claude.md\", // Handle both cases\n    34→  \"CONTRIBUTING.md\",\n    35→  \"PUBLISHING-PLAN.md\",\n    36→  \".github/workflows/sync-public.yml\",\n    37→  \"scripts/sync-public.ts\",\n    38→  \"scripts/test-sync-local.ts\",\n    39→  \"scripts/release.ts\",\n    40→  \"reference/telemetry.md\", // Internal version has credentials; replaced by public-release-files version\n    41→  \"telemetry.md\", // Root-level internal telemetry doc (has PostHog dashboard URLs); public version is reference/telemetry.md\n    42→  \".DS_Store\", // macOS Finder metadata — should never reach the public repo\n    43→  \"standard-operating-procedures.md\", // Internal development conventions\n    44→];\n    45→\n    46→const GIT_AUTHOR_NAME = \"Hrishibot\";\n    47→const GIT_AUTHOR_EMAIL = \"operations@southbridge.ai\";\n    48→\n    49→// Parse arguments\n    50→const command = process.argv[2];\n    51→const args = process.argv.slice(3);\n    52→\n    53→function getArg(name: string): string | undefined {\n    54→  const index = args.indexOf(`--${name}`);\n    55→  return index !== -1 ? args[index + 1] : undefined;\n    56→}\n    57→\n    58→const version = getArg(\"version\");\n    59→const sinceVersion = getArg(\"since\");\n    60→\n    61→if (!command) {\n    62→  console.error(\"Usage: bun scripts/sync-public.ts <command> [options]\");\n    63→  console.error(\n    64→    \"Commands: prepare-snapshot, initial-sync, snapshot-sync, extract-changelog\",\n    65→  );\n    66→  process.exit(1);\n    67→}\n    68→\n    69→/**\n    70→ * Execute a shell command\n    71→ */\n    72→async function exec(\n    73→  cmd: string,\n    74→  options: { cwd?: string; silent?: boolean } = {},\n    75→): Promise<string> {\n    76→  const proc = Bun.spawn([\"sh\", \"-c\", cmd], {\n    77→    cwd: options.cwd,\n    78→    stdout: \"pipe\",\n    79→    stderr: options.silent ? \"pipe\" : \"inherit\",\n    80→  });\n    81→\n    82→  const exitCode = await proc.exited;\n    83→  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n    84→\n    85→  if (exitCode !== 0 && !options.silent) {\n    86→    throw new Error(`Command failed (exit ${exitCode}): ${cmd}`);\n    87→  }\n    88→\n    89→  return output.trim();\n    90→}\n    91→\n    92→/**\n    93→ * Extract changelog section for a specific version\n    94→ */\n    95→async function extractChangelog(\n    96→  ver: string,\n    97→  changelogPath: string,\n    98→): Promise<string> {\n    99→  if (!existsSync(changelogPath)) {\n   100→    return \"See release commits for details.\";\n   101→  }\n   102→\n   103→  const changelog = await readFile(changelogPath, \"utf-8\");\n   104→  const regex = new RegExp(`## \\\\[${ver}\\\\]([\\\\s\\\\S]*?)(?=\\\\n## \\\\[|$)`);\n   105→  const match = changelog.match(regex);\n   106→\n   107→  if (match && match[1].trim()) {\n   108→    console.log(`✓ Found changelog entry for v${ver}`);\n   109→    return match[1].trim();\n   110→  }\n   111→\n   112→  console.log(`⚠ No changelog entry found for v${ver}`);\n   113→  return \"See release commits for details.\";\n   114→}\n   115→\n   116→/**\n   117→ * Extract changelog sections for all versions between current and last-synced version.\n   118→ * When versions are skipped in the public repo (e.g. public is at v0.2.2 and we sync v0.3.2),\n   119→ * this aggregates all intermediate changelog entries so release notes are complete.\n   120→ *\n   121→ * Falls back to single-version extraction when --since is not provided or not found.\n   122→ */\n   123→async function extractChangelogRange(\n   124→  currentVer: string,\n   125→  sinceVer: string | undefined,\n   126→  changelogPath: string,\n   127→): Promise<string> {\n   128→  if (!existsSync(changelogPath)) {\n   129→    return \"See release commits for details.\";\n   130→  }\n   131→\n   132→  // No since version (first sync or not provided) — single version extraction\n   133→  if (!sinceVer) {\n   134→    console.log(\"ℹ No --since version provided, extracting single version\");\n   135→    return extractChangelog(currentVer, changelogPath);\n   136→  }\n   137→\n   138→  const changelog = await readFile(changelogPath, \"utf-8\");\n   139→\n   140→  const currentHeader = `## [${currentVer}]`;\n   141→  const sinceHeader = `## [${sinceVer}]`;\n   142→\n   143→  const startIdx = changelog.indexOf(currentHeader);\n   144→  const endIdx = changelog.indexOf(sinceHeader);\n   145→\n   146→  if (startIdx === -1) {\n   147→    console.log(`⚠ Version ${currentVer} not found in changelog, falling back to single extraction`);\n   148→    return extractChangelog(currentVer, changelogPath);\n   149→  }\n   150→\n   151→  if (endIdx === -1 || endIdx <= startIdx) {\n   152→    console.log(`⚠ Since-version ${sinceVer} not found or precedes current, falling back to single extraction`);\n   153→    return extractChangelog(currentVer, changelogPath);\n   154→  }\n   155→\n   156→  // Extract everything from the current version header down to (not including) the since version\n   157→  const section = changelog.substring(startIdx, endIdx).trim();\n   158→  console.log(`✓ Extracted changelog range: v${currentVer} → v${sinceVer} (exclusive)`);\n   159→  return section;\n   160→}\n   161→\n   162→/**\n   163→ * Transform package.json for public release\n   164→ */\n   165→// Scripts to remove from package.json for public release.\n   166→// These reference files that are stripped (release.ts, sync-public.ts, etc.)\n   167→const STRIP_SCRIPTS = [\n   168→  \"release:patch\",\n   169→  \"release:minor\",\n   170→  \"release:major\",\n   171→];\n   172→\n   173→async function transformPackageJson(packagePath: string): Promise<void> {\n   174→  const content = await readFile(packagePath, \"utf-8\");\n   175→  const pkg = JSON.parse(content);\n   176→\n   177→  pkg.name = \"hankweave\";\n   178→  pkg.publishConfig = { access: \"public\" };\n   179→  pkg.homepage = \"https://github.com/SouthBridgeAI/hankweave-runtime\";\n   180→\n   181→  // Remove scripts that reference stripped internal files\n   182→  if (pkg.scripts) {\n   183→    for (const script of STRIP_SCRIPTS) {\n   184→      delete pkg.scripts[script];\n   185→    }\n   186→  }\n   187→\n   188→  await writeFile(packagePath, JSON.stringify(pkg, null, 2) + \"\\n\");\n   189→  console.log(\"✓ Transformed package.json:\");\n   190→  console.log(\"    name: hankweave\");\n   191→  console.log(\"    publishConfig.access: public\");\n   192→  console.log(\n   193→    \"    homepage: https://github.com/SouthBridgeAI/hankweave-runtime\",\n   194→  );\n   195→  console.log(`    removed scripts: ${STRIP_SCRIPTS.join(\", \")}`);\n   196→}\n   197→\n   198→/**\n   199→ * Prepare snapshot directory from private repo\n   200→ */\n   201→async function prepareSnapshot(): Promise<void> {\n   202→  if (!version) {\n   203→    console.error(\"Error: --version required\");\n   204→    process.exit(1);\n   205→  }\n   206→\n   207→  const privateDir = resolve(process.cwd(), \"private\");\n   208→  const snapshotDir = resolve(process.cwd(), \"snapshot\");\n   209→\n   210→  // Create snapshot directory\n   211→  await mkdir(snapshotDir, { recursive: true });\n   212→\n   213→  // Build rsync exclude args (dirs get trailing /, files don't)\n   214→  const dirExcludes = [\".git\", ...STRIP_DIRS].map((p) => `--exclude='${p}/'`);\n   215→  const fileExcludes = STRIP_FILES.map((p) => `--exclude='${p}'`);\n   216→  const excludes = [...dirExcludes, ...fileExcludes].join(\" \");\n   217→\n   218→  // Copy files excluding internal ones\n   219→  await exec(`rsync -av ${excludes} ${privateDir}/ ${snapshotDir}/`);\n   220→  console.log(\"✓ Copied code to snapshot (excluding internal files)\");\n   221→\n   222→  // Inject public files\n   223→  const publicFilesDir = join(privateDir, \"public-release-files\");\n   224→  if (existsSync(publicFilesDir)) {\n   225→    await exec(`cp -r ${publicFilesDir}/. ${snapshotDir}/`);\n   226→    console.log(\"✓ Injected public files from public-release-files/\");\n   227→  } else {\n   228→    console.log(\"⚠ No public-release-files/ directory found\");\n   229→  }\n   230→\n   231→  // Remove ci.yml\n   232→  const ciYmlPath = join(snapshotDir, \".github\", \"workflows\", \"ci.yml\");\n   233→  if (existsSync(ciYmlPath)) {\n   234→    await rm(ciYmlPath);\n   235→  }\n   236→  console.log(\"✓ Removed ci.yml (tests run only in private repo)\");\n   237→\n   238→  // Transform package.json\n   239→  await transformPackageJson(join(snapshotDir, \"package.json\"));\n   240→\n   241→  // Copy changelog section (aggregates all versions since last public sync)\n   242→  const changelogContent = await extractChangelogRange(\n   243→    version,\n   244→    sinceVersion,\n   245→    join(privateDir, \"CHANGELOG.md\"),\n   246→  );\n   247→  await writeFile(\n   248→    resolve(process.cwd(), \"changelog-section.md\"),\n   249→    changelogContent,\n   250→  );\n   251→  await writeFile(join(snapshotDir, \"RELEASE_NOTES.md\"), changelogContent);\n   252→  console.log(\"✓ Added RELEASE_NOTES.md\");\n   253→\n   254→  // List snapshot contents\n   255→  console.log(\"\\nFiles in snapshot:\");\n   256→  await exec(`ls -la ${snapshotDir}`);\n   257→}\n   258→\n   259→/**\n   260→ * Initial sync - push full history then apply transformations\n   261→ */\n   262→async function initialSync(): Promise<void> {\n   263→  if (!version) {\n   264→    console.error(\"Error: --version required\");\n   265→    process.exit(1);\n   266→  }\n   267→\n   268→  const publicDir = resolve(process.cwd(), \"public\");\n   269→  const privateDir = resolve(process.cwd(), \"private\");\n   270→\n   271→  console.log(\"=== Performing initial sync (full history) ===\");\n   272→\n   273→  // Configure git\n   274→  await exec(`git config user.name \"${GIT_AUTHOR_NAME}\"`, { cwd: publicDir });\n   275→  await exec(`git config user.email \"${GIT_AUTHOR_EMAIL}\"`, { cwd: publicDir });\n   276→\n   277→  // Add private repo as remote and fetch all history\n   278→  // The private repo was checked out at the tag with full history (fetch-depth: 0)\n   279→  // We fetch everything and reset to the tag\n   280→  await exec(\"git remote add private ../private\", {\n   281→    cwd: publicDir,\n   282→    silent: true,\n   283→  }).catch(() => {});\n   284→  await exec(\"git fetch private --tags\", { cwd: publicDir });\n   285→  await exec(`git fetch private v${version}`, { cwd: publicDir });\n   286→\n   287→  // Reset to the tag (which has the full history behind it)\n   288→  await exec(`git reset --hard v${version}`, { cwd: publicDir });\n   289→\n   290→  // Remove internal files\n   291→  for (const dir of STRIP_DIRS) {\n   292→    const fullPath = join(publicDir, dir);\n   293→    if (existsSync(fullPath)) {\n   294→      await rm(fullPath, { recursive: true, force: true });\n   295→    }\n   296→  }\n   297→  for (const file of STRIP_FILES) {\n   298→    const fullPath = join(publicDir, file);\n   299→    if (existsSync(fullPath)) {\n   300→      await rm(fullPath, { force: true });\n   301→    }\n   302→  }\n   303→  console.log(\"✓ Removed internal files\");\n   304→\n   305→  // Copy public files\n   306→  const publicFilesDir = join(privateDir, \"public-release-files\");\n   307→  if (existsSync(publicFilesDir)) {\n   308→    await exec(`cp -r ${publicFilesDir}/. ${publicDir}/`);\n   309→    console.log(\"✓ Copied public files\");\n   310→  }\n   311→\n   312→  // Remove ci.yml\n   313→  const ciYmlPath = join(publicDir, \".github\", \"workflows\", \"ci.yml\");\n   314→  if (existsSync(ciYmlPath)) {\n   315→    await rm(ciYmlPath);\n   316→  }\n   317→  console.log(\"✓ Removed ci.yml\");\n   318→\n   319→  // Transform package.json\n   320→  await transformPackageJson(join(publicDir, \"package.json\"));\n   321→\n   322→  // Copy release notes\n   323→  const changelogPath = resolve(process.cwd(), \"changelog-section.md\");\n   324→  if (existsSync(changelogPath)) {\n   325→    await cp(changelogPath, join(publicDir, \"RELEASE_NOTES.md\"));\n   326→  }\n   327→\n   328→  // Commit changes\n   329→  await exec(\"git add -A\", { cwd: publicDir });\n   330→  // git diff --staged --quiet exits 0 if no changes, 1 if changes exist\n   331→  // We can't rely on .catch() because exec() with silent:true doesn't throw\n   332→  const diffOutput = await exec(\"git diff --staged --name-only\", {\n   333→    cwd: publicDir,\n   334→    silent: true,\n   335→  });\n   336→  const hasChanges = diffOutput.trim().length > 0;\n   337→\n   338→  if (hasChanges) {\n   339→    await exec(`git commit -m \"Apply public release files for v${version}\"`, {\n   340→      cwd: publicDir,\n   341→    });\n   342→    console.log(\"✓ Committed public file overlay\");\n   343→  } else {\n   344→    console.log(\"✓ No changes to commit\");\n   345→  }\n   346→\n   347→  console.log(\"✓ Initial sync complete\");\n   348→}\n   349→\n   350→/**\n   351→ * Snapshot sync - replace tree with snapshot contents\n   352→ */\n   353→async function snapshotSync(): Promise<void> {\n   354→  if (!version) {\n   355→    console.error(\"Error: --version required\");\n   356→    process.exit(1);\n   357→  }\n   358→\n   359→  const publicDir = resolve(process.cwd(), \"public\");\n   360→  const snapshotDir = resolve(process.cwd(), \"snapshot\");\n   361→  const changelogPath = resolve(process.cwd(), \"changelog-section.md\");\n   362→\n   363→  console.log(\"=== Performing snapshot sync ===\");\n   364→\n   365→  // Remove everything except .git\n   366→  await exec(\n   367→    \"find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec rm -rf {} +\",\n   368→    { cwd: publicDir },\n   369→  );\n   370→\n   371→  // Copy snapshot contents\n   372→  await exec(`cp -r ${snapshotDir}/. ${publicDir}/`);\n   373→\n   374→  // Configure git\n   375→  await exec(`git config user.name \"${GIT_AUTHOR_NAME}\"`, { cwd: publicDir });\n   376→  await exec(`git config user.email \"${GIT_AUTHOR_EMAIL}\"`, { cwd: publicDir });\n   377→\n   378→  // Stage all changes\n   379→  await exec(\"git add -A\", { cwd: publicDir });\n   380→\n   381→  // Check for changes\n   382→  // git diff --staged --quiet exits 0 if no changes, 1 if changes exist\n   383→  // We can't rely on .catch() because exec() with silent:true doesn't throw\n   384→  const diffOutput = await exec(\"git diff --staged --name-only\", {\n   385→    cwd: publicDir,\n   386→    silent: true,\n   387→  });\n   388→  const hasChanges = diffOutput.trim().length > 0;\n   389→\n   390→  if (!hasChanges) {\n   391→    console.log(\"⚠ No changes detected. Tree is identical to previous sync.\");\n   392→    return;\n   393→  }\n   394→\n   395→  // Read changelog for commit message\n   396→  let changelog = \"See release commits for details.\";\n   397→  if (existsSync(changelogPath)) {\n   398→    changelog = await readFile(changelogPath, \"utf-8\");\n   399→  }\n   400→\n   401→  // Create commit using a file to avoid shell escaping issues with backticks/quotes in changelog\n   402→  const commitMsgPath = join(publicDir, \".commit-msg\");\n   403→  await writeFile(commitMsgPath, `Release v${version}\\n\\n${changelog}`);\n   404→  await exec(`git commit -F .commit-msg`, { cwd: publicDir });\n   405→  await rm(commitMsgPath);\n   406→  console.log(`✓ Created snapshot commit for v${version}`);\n   407→}\n   408→\n   409→/**\n   410→ * Create and verify tag\n   411→ * Use --force flag to delete existing remote tag (for initial sync)\n   412→ */\n   413→async function createTag(): Promise<void> {\n   414→  if (!version) {\n   415→    console.error(\"Error: --version required\");\n   416→    process.exit(1);\n   417→  }\n   418→\n   419→  const publicDir = resolve(process.cwd(), \"public\");\n   420→  const tag = `v${version}`;\n   421→  const forceMode = args.includes(\"--force\");\n   422→\n   423→  // Check if tag exists locally (use git tag -l, not rev-parse which matches remote refs too)\n   424→  const localTagOutput = await exec(`git tag -l ${tag}`, {\n   425→    cwd: publicDir,\n   426→    silent: true,\n   427→  });\n   428→  if (localTagOutput.includes(tag)) {\n   429→    console.log(`⚠ Tag ${tag} already exists locally, deleting...`);\n   430→    await exec(`git tag -d ${tag}`, { cwd: publicDir });\n   431→  }\n   432→\n   433→  // Check if tag exists on remote\n   434→  const remoteTagOutput = await exec(`git ls-remote --tags origin ${tag}`, {\n   435→    cwd: publicDir,\n   436→    silent: true,\n   437→  });\n   438→  if (remoteTagOutput.includes(tag)) {\n   439→    if (forceMode) {\n   440→      console.log(`⚠ Tag ${tag} exists on remote, will be replaced (--force)`);\n   441→      // Delete remote tag - will be recreated on push\n   442→      await exec(`git push origin --delete ${tag}`, {\n   443→        cwd: publicDir,\n   444→        silent: true,\n   445→      }).catch(() => {});\n   446→    } else {\n   447→      console.error(\n   448→        `Error: Tag ${tag} already exists on remote. Cannot overwrite.`,\n   449→      );\n   450→      console.error(\n   451→        \"Delete the tag from the public repo first, or use --force for initial sync.\",\n   452→      );\n   453→      process.exit(1);\n   454→    }\n   455→  }\n   456→\n   457→  await exec(`git tag ${tag}`, { cwd: publicDir });\n   458→  console.log(`✓ Created tag ${tag}`);\n   459→}\n   460→\n   461→/**\n   462→ * Push to public repo\n   463→ * Use --force flag for initial sync (replaces existing history)\n   464→ */\n   465→async function push(): Promise<void> {\n   466→  if (!version) {\n   467→    console.error(\"Error: --version required\");\n   468→    process.exit(1);\n   469→  }\n   470→\n   471→  const publicDir = resolve(process.cwd(), \"public\");\n   472→  const forceFlag = args.includes(\"--force\") ? \" --force\" : \"\";\n   473→\n   474→  if (forceFlag) {\n   475→    console.log(\"=== Force pushing to public repo (initial sync) ===\");\n   476→    console.log(\"⚠️  This will replace existing history in the public repo\");\n   477→  } else {\n   478→    console.log(\"=== Pushing to public repo ===\");\n   479→  }\n   480→\n   481→  await exec(`git push${forceFlag} origin release/alpha`, { cwd: publicDir });\n   482→  console.log(\"✓ Pushed release/alpha branch\");\n   483→\n   484→  await exec(`git push${forceFlag} origin v${version}`, { cwd: publicDir });\n   485→  console.log(`✓ Pushed tag v${version}`);\n   486→}\n   487→\n   488→// Main command router\n   489→async function main() {\n   490→  switch (command) {\n   491→    case \"extract-changelog\":\n   492→      if (!version) {\n   493→        console.error(\"Error: --version required\");\n   494→        process.exit(1);\n   495→      }\n   496→      const content = await extractChangelogRange(\n   497→        version,\n   498→        sinceVersion,\n   499→        join(process.cwd(), \"private\", \"CHANGELOG.md\"),\n   500→      );\n   501→      await writeFile(resolve(process.cwd(), \"changelog-section.md\"), content);\n   502→      break;\n   503→\n   504→    case \"prepare-snapshot\":\n   505→      await prepareSnapshot();\n   506→      break;\n   507→\n   508→    case \"initial-sync\":\n   509→      await initialSync();\n   510→      break;\n   511→\n   512→    case \"snapshot-sync\":\n   513→      await snapshotSync();\n   514→      break;\n   515→\n   516→    case \"create-tag\":\n   517→      await createTag();\n   518→      break;\n   519→\n   520→    case \"push\":\n   521→      await push();\n   522→      break;\n   523→\n   524→    default:\n   525→      console.error(`Unknown command: ${command}`);\n   526→      console.error(\n   527→        \"Commands: extract-changelog, prepare-snapshot, initial-sync, snapshot-sync, create-tag, push\",\n   528→      );\n   529→      process.exit(1);\n   530→  }\n   531→}\n   532→\n   533→main().catch((error) => {\n   534→  console.error(\"Error:\", error.message);\n   535→  process.exit(1);\n   536→});\n   537→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a77b2755-3bdb-4c5a-a31c-e6ef769bd1ab","uuid":"086226f1-c8d4-444c-b19a-6fec77d43889","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/sync-public.ts","content":"#!/usr/bin/env bun\n\n/**\n * Sync to Public Repository Script\n *\n * Handles syncing releases from the private repo to the public repo.\n * Called by the sync-public.yml workflow.\n *\n * Usage:\n *   bun scripts/sync-public.ts prepare-snapshot --version 0.1.41\n *   bun scripts/sync-public.ts initial-sync --version 0.1.41\n *   bun scripts/sync-public.ts snapshot-sync --version 0.1.41\n */\n\nimport { existsSync } from \"node:fs\";\nimport { readFile, writeFile, mkdir, rm, readdir, cp } from \"node:fs/promises\";\nimport { resolve, join } from \"node:path\";\n\n// Configuration\n//\n// Note: Most internal files (intermediates/, external-docs/, CLAUDE.md, etc.) are\n// already stripped during the release process (develop → release/alpha). The exclusions\n// here are safety nets for:\n// 1. Initial sync (which imports full history that may contain these files)\n// 2. Any edge cases where files weren't stripped during release\n//\n// Directories to strip (will be excluded with trailing /)\nconst STRIP_DIRS = [\"intermediates\", \"external-docs\", \"public-release-files\", \".github/actions\"];\n\n// Files to strip (excluded without trailing /)\nconst STRIP_FILES = [\n  \"CLAUDE.md\",\n  \"Claude.md\", // Handle both cases\n  \"CONTRIBUTING.md\",\n  \"PUBLISHING-PLAN.md\",\n  \".github/workflows/sync-public.yml\",\n  \"scripts/sync-public.ts\",\n  \"scripts/test-sync-local.ts\",\n  \"scripts/release.ts\",\n  \"reference/telemetry.md\", // Internal version has credentials; replaced by public-release-files version\n  \"telemetry.md\", // Root-level internal telemetry doc (has PostHog dashboard URLs); public version is reference/telemetry.md\n  \".DS_Store\", // macOS Finder metadata — should never reach the public repo\n  \"standard-operating-procedures.md\", // Internal development conventions\n];\n\nconst GIT_AUTHOR_NAME = \"Hrishibot\";\nconst GIT_AUTHOR_EMAIL = \"operations@southbridge.ai\";\n\n// Parse arguments\nconst command = process.argv[2];\nconst args = process.argv.slice(3);\n\nfunction getArg(name: string): string | undefined {\n  const index = args.indexOf(`--${name}`);\n  return index !== -1 ? args[index + 1] : undefined;\n}\n\nconst version = getArg(\"version\");\nconst sinceVersion = getArg(\"since\");\n\nif (!command) {\n  console.error(\"Usage: bun scripts/sync-public.ts <command> [options]\");\n  console.error(\n    \"Commands: prepare-snapshot, initial-sync, snapshot-sync, extract-changelog\",\n  );\n  process.exit(1);\n}\n\n/**\n * Execute a shell command\n */\nasync function exec(\n  cmd: string,\n  options: { cwd?: string; silent?: boolean } = {},\n): Promise<string> {\n  const proc = Bun.spawn([\"sh\", \"-c\", cmd], {\n    cwd: options.cwd,\n    stdout: \"pipe\",\n    stderr: options.silent ? \"pipe\" : \"inherit\",\n  });\n\n  const exitCode = await proc.exited;\n  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.silent) {\n    throw new Error(`Command failed (exit ${exitCode}): ${cmd}`);\n  }\n\n  return output.trim();\n}\n\n/**\n * Extract changelog section for a specific version\n */\nasync function extractChangelog(\n  ver: string,\n  changelogPath: string,\n): Promise<string> {\n  if (!existsSync(changelogPath)) {\n    return \"See release commits for details.\";\n  }\n\n  const changelog = await readFile(changelogPath, \"utf-8\");\n  const regex = new RegExp(`## \\\\[${ver}\\\\]([\\\\s\\\\S]*?)(?=\\\\n## \\\\[|$)`);\n  const match = changelog.match(regex);\n\n  if (match && match[1].trim()) {\n    console.log(`✓ Found changelog entry for v${ver}`);\n    return match[1].trim();\n  }\n\n  console.log(`⚠ No changelog entry found for v${ver}`);\n  return \"See release commits for details.\";\n}\n\n/**\n * Extract changelog sections for all versions between current and last-synced version.\n * When versions are skipped in the public repo (e.g. public is at v0.2.2 and we sync v0.3.2),\n * this aggregates all intermediate changelog entries so release notes are complete.\n *\n * Falls back to single-version extraction when --since is not provided or not found.\n */\nasync function extractChangelogRange(\n  currentVer: string,\n  sinceVer: string | undefined,\n  changelogPath: string,\n): Promise<string> {\n  if (!existsSync(changelogPath)) {\n    return \"See release commits for details.\";\n  }\n\n  // No since version (first sync or not provided) — single version extraction\n  if (!sinceVer) {\n    console.log(\"ℹ No --since version provided, extracting single version\");\n    return extractChangelog(currentVer, changelogPath);\n  }\n\n  const changelog = await readFile(changelogPath, \"utf-8\");\n\n  const currentHeader = `## [${currentVer}]`;\n  const sinceHeader = `## [${sinceVer}]`;\n\n  const startIdx = changelog.indexOf(currentHeader);\n  const endIdx = changelog.indexOf(sinceHeader);\n\n  if (startIdx === -1) {\n    console.log(`⚠ Version ${currentVer} not found in changelog, falling back to single extraction`);\n    return extractChangelog(currentVer, changelogPath);\n  }\n\n  if (endIdx === -1 || endIdx <= startIdx) {\n    console.log(`⚠ Since-version ${sinceVer} not found or precedes current, falling back to single extraction`);\n    return extractChangelog(currentVer, changelogPath);\n  }\n\n  // Extract everything from the current version header down to (not including) the since version\n  const section = changelog.substring(startIdx, endIdx).trim();\n  console.log(`✓ Extracted changelog range: v${currentVer} → v${sinceVer} (exclusive)`);\n  return section;\n}\n\n/**\n * Transform package.json for public release\n */\n// Scripts to remove from package.json for public release.\n// These reference files that are stripped (release.ts, sync-public.ts, etc.)\nconst STRIP_SCRIPTS = [\n  \"release:patch\",\n  \"release:minor\",\n  \"release:major\",\n];\n\nasync function transformPackageJson(packagePath: string): Promise<void> {\n  const content = await readFile(packagePath, \"utf-8\");\n  const pkg = JSON.parse(content);\n\n  pkg.name = \"hankweave\";\n  pkg.publishConfig = { access: \"public\" };\n  pkg.homepage = \"https://github.com/SouthBridgeAI/hankweave-runtime\";\n\n  // Remove scripts that reference stripped internal files\n  if (pkg.scripts) {\n    for (const script of STRIP_SCRIPTS) {\n      delete pkg.scripts[script];\n    }\n  }\n\n  await writeFile(packagePath, JSON.stringify(pkg, null, 2) + \"\\n\");\n  console.log(\"✓ Transformed package.json:\");\n  console.log(\"    name: hankweave\");\n  console.log(\"    publishConfig.access: public\");\n  console.log(\n    \"    homepage: https://github.com/SouthBridgeAI/hankweave-runtime\",\n  );\n  console.log(`    removed scripts: ${STRIP_SCRIPTS.join(\", \")}`);\n}\n\n/**\n * Prepare snapshot directory from private repo\n */\nasync function prepareSnapshot(): Promise<void> {\n  if (!version) {\n    console.error(\"Error: --version required\");\n    process.exit(1);\n  }\n\n  const privateDir = resolve(process.cwd(), \"private\");\n  const snapshotDir = resolve(process.cwd(), \"snapshot\");\n\n  // Create snapshot directory\n  await mkdir(snapshotDir, { recursive: true });\n\n  // Build rsync exclude args (dirs get trailing /, files don't)\n  const dirExcludes = [\".git\", ...STRIP_DIRS].map((p) => `--exclude='${p}/'`);\n  const fileExcludes = STRIP_FILES.map((p) => `--exclude='${p}'`);\n  const excludes = [...dirExcludes, ...fileExcludes].join(\" \");\n\n  // Copy files excluding internal ones\n  await exec(`rsync -av ${excludes} ${privateDir}/ ${snapshotDir}/`);\n  console.log(\"✓ Copied code to snapshot (excluding internal files)\");\n\n  // Inject public files\n  const publicFilesDir = join(privateDir, \"public-release-files\");\n  if (existsSync(publicFilesDir)) {\n    await exec(`cp -r ${publicFilesDir}/. ${snapshotDir}/`);\n    console.log(\"✓ Injected public files from public-release-files/\");\n  } else {\n    console.log(\"⚠ No public-release-files/ directory found\");\n  }\n\n  // Remove ci.yml\n  const ciYmlPath = join(snapshotDir, \".github\", \"workflows\", \"ci.yml\");\n  if (existsSync(ciYmlPath)) {\n    await rm(ciYmlPath);\n  }\n  console.log(\"✓ Removed ci.yml (tests run only in private repo)\");\n\n  // Transform package.json\n  await transformPackageJson(join(snapshotDir, \"package.json\"));\n\n  // Copy changelog section (aggregates all versions since last public sync)\n  const changelogContent = await extractChangelogRange(\n    version,\n    sinceVersion,\n    join(privateDir, \"CHANGELOG.md\"),\n  );\n  await writeFile(\n    resolve(process.cwd(), \"changelog-section.md\"),\n    changelogContent,\n  );\n  await writeFile(join(snapshotDir, \"RELEASE_NOTES.md\"), changelogContent);\n  console.log(\"✓ Added RELEASE_NOTES.md\");\n\n  // List snapshot contents\n  console.log(\"\\nFiles in snapshot:\");\n  await exec(`ls -la ${snapshotDir}`);\n}\n\n/**\n * Initial sync - push full history then apply transformations\n */\nasync function initialSync(): Promise<void> {\n  if (!version) {\n    console.error(\"Error: --version required\");\n    process.exit(1);\n  }\n\n  const publicDir = resolve(process.cwd(), \"public\");\n  const privateDir = resolve(process.cwd(), \"private\");\n\n  console.log(\"=== Performing initial sync (full history) ===\");\n\n  // Configure git\n  await exec(`git config user.name \"${GIT_AUTHOR_NAME}\"`, { cwd: publicDir });\n  await exec(`git config user.email \"${GIT_AUTHOR_EMAIL}\"`, { cwd: publicDir });\n\n  // Add private repo as remote and fetch all history\n  // The private repo was checked out at the tag with full history (fetch-depth: 0)\n  // We fetch everything and reset to the tag\n  await exec(\"git remote add private ../private\", {\n    cwd: publicDir,\n    silent: true,\n  }).catch(() => {});\n  await exec(\"git fetch private --tags\", { cwd: publicDir });\n  await exec(`git fetch private v${version}`, { cwd: publicDir });\n\n  // Reset to the tag (which has the full history behind it)\n  await exec(`git reset --hard v${version}`, { cwd: publicDir });\n\n  // Remove internal files\n  for (const dir of STRIP_DIRS) {\n    const fullPath = join(publicDir, dir);\n    if (existsSync(fullPath)) {\n      await rm(fullPath, { recursive: true, force: true });\n    }\n  }\n  for (const file of STRIP_FILES) {\n    const fullPath = join(publicDir, file);\n    if (existsSync(fullPath)) {\n      await rm(fullPath, { force: true });\n    }\n  }\n  console.log(\"✓ Removed internal files\");\n\n  // Copy public files\n  const publicFilesDir = join(privateDir, \"public-release-files\");\n  if (existsSync(publicFilesDir)) {\n    await exec(`cp -r ${publicFilesDir}/. ${publicDir}/`);\n    console.log(\"✓ Copied public files\");\n  }\n\n  // Remove ci.yml\n  const ciYmlPath = join(publicDir, \".github\", \"workflows\", \"ci.yml\");\n  if (existsSync(ciYmlPath)) {\n    await rm(ciYmlPath);\n  }\n  console.log(\"✓ Removed ci.yml\");\n\n  // Transform package.json\n  await transformPackageJson(join(publicDir, \"package.json\"));\n\n  // Copy release notes\n  const changelogPath = resolve(process.cwd(), \"changelog-section.md\");\n  if (existsSync(changelogPath)) {\n    await cp(changelogPath, join(publicDir, \"RELEASE_NOTES.md\"));\n  }\n\n  // Commit changes\n  await exec(\"git add -A\", { cwd: publicDir });\n  // git diff --staged --quiet exits 0 if no changes, 1 if changes exist\n  // We can't rely on .catch() because exec() with silent:true doesn't throw\n  const diffOutput = await exec(\"git diff --staged --name-only\", {\n    cwd: publicDir,\n    silent: true,\n  });\n  const hasChanges = diffOutput.trim().length > 0;\n\n  if (hasChanges) {\n    await exec(`git commit -m \"Apply public release files for v${version}\"`, {\n      cwd: publicDir,\n    });\n    console.log(\"✓ Committed public file overlay\");\n  } else {\n    console.log(\"✓ No changes to commit\");\n  }\n\n  console.log(\"✓ Initial sync complete\");\n}\n\n/**\n * Snapshot sync - replace tree with snapshot contents\n */\nasync function snapshotSync(): Promise<void> {\n  if (!version) {\n    console.error(\"Error: --version required\");\n    process.exit(1);\n  }\n\n  const publicDir = resolve(process.cwd(), \"public\");\n  const snapshotDir = resolve(process.cwd(), \"snapshot\");\n  const changelogPath = resolve(process.cwd(), \"changelog-section.md\");\n\n  console.log(\"=== Performing snapshot sync ===\");\n\n  // Remove everything except .git\n  await exec(\n    \"find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec rm -rf {} +\",\n    { cwd: publicDir },\n  );\n\n  // Copy snapshot contents\n  await exec(`cp -r ${snapshotDir}/. ${publicDir}/`);\n\n  // Configure git\n  await exec(`git config user.name \"${GIT_AUTHOR_NAME}\"`, { cwd: publicDir });\n  await exec(`git config user.email \"${GIT_AUTHOR_EMAIL}\"`, { cwd: publicDir });\n\n  // Stage all changes\n  await exec(\"git add -A\", { cwd: publicDir });\n\n  // Check for changes\n  // git diff --staged --quiet exits 0 if no changes, 1 if changes exist\n  // We can't rely on .catch() because exec() with silent:true doesn't throw\n  const diffOutput = await exec(\"git diff --staged --name-only\", {\n    cwd: publicDir,\n    silent: true,\n  });\n  const hasChanges = diffOutput.trim().length > 0;\n\n  if (!hasChanges) {\n    console.log(\"⚠ No changes detected. Tree is identical to previous sync.\");\n    return;\n  }\n\n  // Read changelog for commit message\n  let changelog = \"See release commits for details.\";\n  if (existsSync(changelogPath)) {\n    changelog = await readFile(changelogPath, \"utf-8\");\n  }\n\n  // Create commit using a file to avoid shell escaping issues with backticks/quotes in changelog\n  const commitMsgPath = join(publicDir, \".commit-msg\");\n  await writeFile(commitMsgPath, `Release v${version}\\n\\n${changelog}`);\n  await exec(`git commit -F .commit-msg`, { cwd: publicDir });\n  await rm(commitMsgPath);\n  console.log(`✓ Created snapshot commit for v${version}`);\n}\n\n/**\n * Create and verify tag\n * Use --force flag to delete existing remote tag (for initial sync)\n */\nasync function createTag(): Promise<void> {\n  if (!version) {\n    console.error(\"Error: --version required\");\n    process.exit(1);\n  }\n\n  const publicDir = resolve(process.cwd(), \"public\");\n  const tag = `v${version}`;\n  const forceMode = args.includes(\"--force\");\n\n  // Check if tag exists locally (use git tag -l, not rev-parse which matches remote refs too)\n  const localTagOutput = await exec(`git tag -l ${tag}`, {\n    cwd: publicDir,\n    silent: true,\n  });\n  if (localTagOutput.includes(tag)) {\n    console.log(`⚠ Tag ${tag} already exists locally, deleting...`);\n    await exec(`git tag -d ${tag}`, { cwd: publicDir });\n  }\n\n  // Check if tag exists on remote\n  const remoteTagOutput = await exec(`git ls-remote --tags origin ${tag}`, {\n    cwd: publicDir,\n    silent: true,\n  });\n  if (remoteTagOutput.includes(tag)) {\n    if (forceMode) {\n      console.log(`⚠ Tag ${tag} exists on remote, will be replaced (--force)`);\n      // Delete remote tag - will be recreated on push\n      await exec(`git push origin --delete ${tag}`, {\n        cwd: publicDir,\n        silent: true,\n      }).catch(() => {});\n    } else {\n      console.error(\n        `Error: Tag ${tag} already exists on remote. Cannot overwrite.`,\n      );\n      console.error(\n        \"Delete the tag from the public repo first, or use --force for initial sync.\",\n      );\n      process.exit(1);\n    }\n  }\n\n  await exec(`git tag ${tag}`, { cwd: publicDir });\n  console.log(`✓ Created tag ${tag}`);\n}\n\n/**\n * Push to public repo\n * Use --force flag for initial sync (replaces existing history)\n */\nasync function push(): Promise<void> {\n  if (!version) {\n    console.error(\"Error: --version required\");\n    process.exit(1);\n  }\n\n  const publicDir = resolve(process.cwd(), \"public\");\n  const forceFlag = args.includes(\"--force\") ? \" --force\" : \"\";\n\n  if (forceFlag) {\n    console.log(\"=== Force pushing to public repo (initial sync) ===\");\n    console.log(\"⚠️  This will replace existing history in the public repo\");\n  } else {\n    console.log(\"=== Pushing to public repo ===\");\n  }\n\n  await exec(`git push${forceFlag} origin release/alpha`, { cwd: publicDir });\n  console.log(\"✓ Pushed release/alpha branch\");\n\n  await exec(`git push${forceFlag} origin v${version}`, { cwd: publicDir });\n  console.log(`✓ Pushed tag v${version}`);\n}\n\n// Main command router\nasync function main() {\n  switch (command) {\n    case \"extract-changelog\":\n      if (!version) {\n        console.error(\"Error: --version required\");\n        process.exit(1);\n      }\n      const content = await extractChangelogRange(\n        version,\n        sinceVersion,\n        join(process.cwd(), \"private\", \"CHANGELOG.md\"),\n      );\n      await writeFile(resolve(process.cwd(), \"changelog-section.md\"), content);\n      break;\n\n    case \"prepare-snapshot\":\n      await prepareSnapshot();\n      break;\n\n    case \"initial-sync\":\n      await initialSync();\n      break;\n\n    case \"snapshot-sync\":\n      await snapshotSync();\n      break;\n\n    case \"create-tag\":\n      await createTag();\n      break;\n\n    case \"push\":\n      await push();\n      break;\n\n    default:\n      console.error(`Unknown command: ${command}`);\n      console.error(\n        \"Commands: extract-changelog, prepare-snapshot, initial-sync, snapshot-sync, create-tag, push\",\n      );\n      process.exit(1);\n  }\n}\n\nmain().catch((error) => {\n  console.error(\"Error:\", error.message);\n  process.exit(1);\n});\n","numLines":537,"startLine":1,"totalLines":537}},"timestamp":"2026-03-05T12:49:06.781Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LBVbCtGKnp9kiUizHP75QA","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→\n     3→/**\n     4→ * Release automation script for Hankweave\n     5→ *\n     6→ * Two-phase release: validate everything first (dry-run), then execute.\n     7→ * Automatic rollback on failure. Headless-friendly.\n     8→ *\n     9→ * Usage:\n    10→ *   bun run release:patch              # Interactive release\n    11→ *   bun run release:minor              # Minor version bump\n    12→ *   bun run release:major              # Major version bump\n    13→ *   bun scripts/release.ts patch --yes # Headless (no prompts)\n    14→ *   bun scripts/release.ts minor --dry-run  # Validate only\n    15→ *\n    16→ * Flags:\n    17→ *   --yes, -y       Skip all interactive prompts (for agents/CI)\n    18→ *   --dry-run       Validate everything but don't make changes\n    19→ *   --skip-checks   Skip typecheck and lint during validation\n    20→ */\n    21→\n    22→import { existsSync } from \"node:fs\";\n    23→import { resolve } from \"node:path\";\n    24→\n    25→// ─── Argument parsing ────────────────────────────────────────────────\n    26→\n    27→const args = process.argv.slice(2);\n    28→const BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\n    29→const VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\n    30→type BumpType = (typeof VALID_BUMP_TYPES)[number];\n    31→\n    32→const YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\n    33→const DRY_RUN = args.includes(\"--dry-run\");\n    34→const SKIP_CHECKS = args.includes(\"--skip-checks\");\n    35→\n    36→if (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n    37→  console.error(\"Error: Invalid or missing bump type\");\n    38→  console.error(\"\");\n    39→  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n    40→  console.error(\"\");\n    41→  console.error(\"Flags:\");\n    42→  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n    43→  console.error(\"  --dry-run       Validate everything without making changes\");\n    44→  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n    45→  process.exit(1);\n    46→}\n    47→\n    48→const ROOT = resolve(process.cwd());\n    49→const CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\n    50→const PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n    51→\n    52→/** Files/dirs stripped from release/alpha after each merge from develop.\n    53→ *  Used by both the dry-run merge check and the actual merge step. */\n    54→const INTERNAL_FILES_TO_STRIP = [\n    55→  \"intermediates/\",\n    56→  \"external-docs/\",\n    57→  \"CLAUDE.md\",\n    58→  \"CONTRIBUTING.md\",\n    59→  \"standard-operating-procedures.md\",\n    60→];\n    61→\n    62→// ─── Saved state for rollback ────────────────────────────────────────\n    63→\n    64→interface ReleaseState {\n    65→  developHead: string;\n    66→  releaseAlphaHead: string;\n    67→  startBranch: string;\n    68→  newVersion: string | null;\n    69→  developPushed: boolean;\n    70→  releaseAlphaPushed: boolean;\n    71→  tagPushed: boolean;\n    72→  tagName: string | null;\n    73→}\n    74→\n    75→const state: ReleaseState = {\n    76→  developHead: \"\",\n    77→  releaseAlphaHead: \"\",\n    78→  startBranch: \"\",\n    79→  newVersion: null,\n    80→  developPushed: false,\n    81→  releaseAlphaPushed: false,\n    82→  tagPushed: false,\n    83→  tagName: null,\n    84→};\n    85→\n    86→// ─── Helpers ─────────────────────────────────────────────────────────\n    87→\n    88→async function exec(\n    89→  command: string,\n    90→  options: { silent?: boolean; allowFailure?: boolean } = {},\n    91→): Promise<string> {\n    92→  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    93→    stdout: \"pipe\",\n    94→    stderr: options.silent ? \"pipe\" : \"inherit\",\n    95→  });\n    96→\n    97→  const exitCode = await proc.exited;\n    98→  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n    99→\n   100→  if (exitCode !== 0 && !options.allowFailure) {\n   101→    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n   102→  }\n   103→\n   104→  return output.trim();\n   105→}\n   106→\n   107→function log(msg: string) {\n   108→  console.log(msg);\n   109→}\n   110→\n   111→function logStep(msg: string) {\n   112→  console.log(`\\n  ${msg}`);\n   113→}\n   114→\n   115→function logOk(msg: string) {\n   116→  console.log(`  ✓ ${msg}`);\n   117→}\n   118→\n   119→function logWarn(msg: string) {\n   120→  console.log(`  ! ${msg}`);\n   121→}\n   122→\n   123→function logErr(msg: string) {\n   124→  console.error(`  ✗ ${msg}`);\n   125→}\n   126→\n   127→/**\n   128→ * Prompt the user for confirmation. In --yes mode, auto-confirms.\n   129→ * Returns true if confirmed, false if cancelled.\n   130→ */\n   131→async function confirm(message: string): Promise<boolean> {\n   132→  if (YES_MODE) {\n   133→    log(`  ${message} (auto-confirmed: --yes)`);\n   134→    return true;\n   135→  }\n   136→\n   137→  process.stdout.write(`  ${message} [y/N] `);\n   138→\n   139→  // Read a single line from stdin\n   140→  const reader = Bun.stdin.stream().getReader();\n   141→  const { value } = await reader.read();\n   142→  reader.releaseLock();\n   143→\n   144→  const answer = value\n   145→    ? new TextDecoder().decode(value).trim().toLowerCase()\n   146→    : \"\";\n   147→  return answer === \"y\" || answer === \"yes\";\n   148→}\n   149→\n   150→/**\n   151→ * Compute what the new version would be without modifying package.json\n   152→ */\n   153→function computeNewVersion(currentVersion: string, bumpType: string): string {\n   154→  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n   155→  switch (bumpType) {\n   156→    case \"major\":\n   157→      return `${major + 1}.0.0`;\n   158→    case \"minor\":\n   159→      return `${major}.${minor + 1}.0`;\n   160→    case \"patch\":\n   161→      return `${major}.${minor}.${patch + 1}`;\n   162→    default:\n   163→      throw new Error(`Invalid bump type: ${bumpType}`);\n   164→  }\n   165→}\n   166→\n   167→// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n   168→\n   169→interface ValidationResult {\n   170→  currentVersion: string;\n   171→  newVersion: string;\n   172→  changelogEntryCount: number;\n   173→  changelogPreview: string[];\n   174→  mergeWouldSucceed: boolean;\n   175→  schemasWouldGenerate: boolean;\n   176→  typecheckPassed: boolean | null; // null = skipped\n   177→  lintPassed: boolean | null;\n   178→}\n   179→\n   180→async function validate(): Promise<ValidationResult> {\n   181→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   182→  log(\"║  Phase 1: Validation                                     ║\");\n   183→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   184→\n   185→  const result: ValidationResult = {\n   186→    currentVersion: \"\",\n   187→    newVersion: \"\",\n   188→    changelogEntryCount: 0,\n   189→    changelogPreview: [],\n   190→    mergeWouldSucceed: false,\n   191→    schemasWouldGenerate: false,\n   192→    typecheckPassed: null,\n   193→    lintPassed: null,\n   194→  };\n   195→\n   196→  // 1. Check branch\n   197→  logStep(\"Checking branch...\");\n   198→  const currentBranch = await exec(\"git branch --show-current\", {\n   199→    silent: true,\n   200→  });\n   201→  if (currentBranch !== \"develop\") {\n   202→    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n   203→    process.exit(1);\n   204→  }\n   205→  state.startBranch = currentBranch;\n   206→  logOk(`On develop branch`);\n   207→\n   208→  // 2. Check clean working directory\n   209→  logStep(\"Checking working directory...\");\n   210→  const status = await exec(\"git status --porcelain\", { silent: true });\n   211→  if (status) {\n   212→    logErr(\"Uncommitted changes detected:\");\n   213→    console.error(status);\n   214→    process.exit(1);\n   215→  }\n   216→  logOk(\"Working directory is clean\");\n   217→\n   218→  // 3. Check remote sync\n   219→  logStep(\"Checking remote sync...\");\n   220→  await exec(\"git fetch origin\", { silent: true });\n   221→\n   222→  for (const branch of [\"develop\", \"release/alpha\"]) {\n   223→    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n   224→    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n   225→      silent: true,\n   226→    });\n   227→\n   228→    if (localCommit !== remoteCommit) {\n   229→      const ahead = parseInt(\n   230→        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n   231→          silent: true,\n   232→        }),\n   233→      );\n   234→      const behind = parseInt(\n   235→        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n   236→          silent: true,\n   237→        }),\n   238→      );\n   239→\n   240→      if (behind > 0 && ahead > 0) {\n   241→        logErr(\n   242→          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n   243→        );\n   244→        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   245→        process.exit(1);\n   246→      } else if (behind > 0) {\n   247→        logErr(`${branch} is ${behind} commit(s) behind remote`);\n   248→        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   249→        process.exit(1);\n   250→      } else if (ahead > 0) {\n   251→        logWarn(\n   252→          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n   253→        );\n   254→      }\n   255→    } else {\n   256→      logOk(`${branch} is in sync with origin/${branch}`);\n   257→    }\n   258→  }\n   259→\n   260→  // Save pre-release state for rollback\n   261→  state.developHead = await exec(\"git rev-parse develop\", { silent: true });\n   262→  state.releaseAlphaHead = await exec(\"git rev-parse release/alpha\", {\n   263→    silent: true,\n   264→  });\n   265→\n   266→  // 4. Compute new version\n   267→  logStep(\"Computing version...\");\n   268→  const packageJson = await Bun.file(PACKAGE_JSON_PATH).json();\n   269→  result.currentVersion = packageJson.version;\n   270→  result.newVersion = computeNewVersion(\n   271→    result.currentVersion,\n   272→    BUMP_TYPE as string,\n   273→  );\n   274→  state.newVersion = result.newVersion;\n   275→  logOk(`${result.currentVersion} → ${result.newVersion} (${BUMP_TYPE})`);\n   276→\n   277→  // 5. Check tag doesn't exist\n   278→  logStep(\"Checking tag availability...\");\n   279→  const tag = `v${result.newVersion}`;\n   280→  const remoteTag = await exec(`git ls-remote --tags origin ${tag}`, {\n   281→    silent: true,\n   282→  });\n   283→  if (remoteTag) {\n   284→    logErr(\n   285→      `Tag ${tag} already exists on remote. The version may already be released.`,\n   286→    );\n   287→    process.exit(1);\n   288→  }\n   289→  // Also check locally\n   290→  const localTag = await exec(`git tag -l ${tag}`, { silent: true });\n   291→  if (localTag) {\n   292→    logWarn(\n   293→      `Tag ${tag} exists locally (stale). Will be deleted before re-creation.`,\n   294→    );\n   295→  }\n   296→  logOk(`Tag ${tag} is available`);\n   297→\n   298→  // 6. Validate changelog\n   299→  logStep(\"Validating CHANGELOG.md...\");\n   300→  if (!existsSync(CHANGELOG_PATH)) {\n   301→    logErr(\"CHANGELOG.md not found\");\n   302→    process.exit(1);\n   303→  }\n   304→\n   305→  const changelog = await Bun.file(CHANGELOG_PATH).text();\n   306→  if (!changelog.includes(\"## [Unreleased]\")) {\n   307→    logErr(\"No [Unreleased] section found in CHANGELOG.md\");\n   308→    process.exit(1);\n   309→  }\n   310→\n   311→  const unreleasedMatch = changelog.match(\n   312→    /## \\[Unreleased\\]([\\s\\S]*?)(?=\\n## |$)/,\n   313→  );\n   314→  if (!unreleasedMatch) {\n   315→    logErr(\"Could not parse [Unreleased] section\");\n   316→    process.exit(1);\n   317→  }\n   318→\n   319→  const bulletPoints = unreleasedMatch[1].match(/^- .+\\S/gm) || [];\n   320→  result.changelogEntryCount = bulletPoints.length;\n   321→  result.changelogPreview = bulletPoints.slice(0, 5);\n   322→\n   323→  if (result.changelogEntryCount === 0) {\n   324→    logWarn(\"CHANGELOG [Unreleased] section has no entries\");\n   325→    logWarn(\"The release will have empty release notes\");\n   326→    if (!YES_MODE) {\n   327→      const proceed = await confirm(\"Continue with empty changelog?\");\n   328→      if (!proceed) {\n   329→        log(\"\\nRelease cancelled. Add entries to [Unreleased] and try again.\");\n   330→        process.exit(0);\n   331→      }\n   332→    }\n   333→  } else {\n   334→    logOk(\n   335→      `CHANGELOG has ${result.changelogEntryCount} entries in [Unreleased]:`,\n   336→    );\n   337→    for (const entry of result.changelogPreview) {\n   338→      console.log(`      ${entry}`);\n   339→    }\n   340→    if (result.changelogEntryCount > 5) {\n   341→      console.log(`      ... and ${result.changelogEntryCount - 5} more`);\n   342→    }\n   343→  }\n   344→\n   345→  // 7. Test merge feasibility\n   346→  logStep(\"Testing merge feasibility (develop → release/alpha)...\");\n   347→  try {\n   348→    // Use merge-tree to check for conflicts without touching the working tree\n   349→    // merge-tree returns 0 even with conflicts, but outputs conflict markers\n   350→    // Instead, do a merge --no-commit --no-ff and then abort\n   351→    await exec(\"git checkout release/alpha\", { silent: true });\n   352→    const mergeResult = await exec(\n   353→      \"git merge --no-commit --no-ff develop 2>&1\",\n   354→      {\n   355→        silent: true,\n   356→        allowFailure: true,\n   357→      },\n   358→    );\n   359→    // Check for conflicts — any unmerged entry in porcelain status.\n   360→    // Codes: UU (both modified), AA (both added), DD (both deleted),\n   361→    // DU/UD (modify/delete — e.g. file stripped on release but modified on develop)\n   362→    const mergeStatus = await exec(\"git status --porcelain\", { silent: true });\n   363→    const conflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) /m;\n   364→    const hasConflicts = conflictPattern.test(mergeStatus);\n   365→\n   366→    // For modify/delete conflicts, check if ALL conflicting files are in the\n   367→    // strip list — if so, the merge step will auto-resolve them.\n   368→    let conflictsAreStrippable = false;\n   369→    if (hasConflicts) {\n   370→      const modifyDeletePattern = /^(DU|UD) (.+)$/gm;\n   371→      const allConflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) (.+)$/gm;\n   372→\n   373→      const modifyDeleteFiles = [...mergeStatus.matchAll(modifyDeletePattern)].map((m) => m[2].trim());\n   374→      const allConflictFiles = [...mergeStatus.matchAll(allConflictPattern)].map((m) => m[2].trim());\n   375→\n   376→      if (\n   377→        allConflictFiles.length > 0 &&\n   378→        allConflictFiles.length === modifyDeleteFiles.length &&\n   379→        modifyDeleteFiles.every((f) =>\n   380→          INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n   381→        )\n   382→      ) {\n   383→        conflictsAreStrippable = true;\n   384→      }\n   385→    }\n   386→\n   387→    // Abort the merge\n   388→    await exec(\"git merge --abort 2>/dev/null || git reset --hard HEAD\", {\n   389→      silent: true,\n   390→      allowFailure: true,\n   391→    });\n   392→    await exec(\"git checkout develop\", { silent: true });\n   393→\n   394→    if (hasConflicts && !conflictsAreStrippable) {\n   395→      logErr(\"Merge would have conflicts. Resolve before releasing:\");\n   396→      logErr(\"  git checkout release/alpha\");\n   397→      logErr(\"  git merge develop\");\n   398→      logErr(\"  # resolve conflicts, commit, then:\");\n   399→      logErr(\"  git checkout develop\");\n   400→      process.exit(1);\n   401→    }\n   402→    result.mergeWouldSucceed = true;\n   403→    if (conflictsAreStrippable) {\n   404→      logOk(\"Merge has modify/delete conflicts on stripped files (will auto-resolve)\");\n   405→    } else {\n   406→      logOk(\"Merge would succeed cleanly\");\n   407→    }\n   408→  } catch (error) {\n   409→    // Make sure we're back on develop\n   410→    await exec(\"git merge --abort 2>/dev/null || true\", {\n   411→      silent: true,\n   412→      allowFailure: true,\n   413→    });\n   414→    await exec(\"git checkout develop 2>/dev/null || true\", {\n   415→      silent: true,\n   416→      allowFailure: true,\n   417→    });\n   418→    logErr(`Merge test failed: ${(error as Error).message}`);\n   419→    process.exit(1);\n   420→  }\n   421→\n   422→  // 8. Test schema generation\n   423→  logStep(\"Testing schema generation...\");\n   424→  try {\n   425→    await exec(\"bun run generate-schemas\", { silent: true });\n   426→    // Check if schemas directory changed (would indicate schemas need regenerating)\n   427→    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n   428→      silent: true,\n   429→    });\n   430→    if (schemaChanges) {\n   431→      logWarn(\n   432→        \"Schema generation produced changes (will be included in release commit)\",\n   433→      );\n   434→    }\n   435→    // Reset any changes from test generation\n   436→    await exec(\"git checkout -- schemas/ 2>/dev/null || true\", {\n   437→      silent: true,\n   438→      allowFailure: true,\n   439→    });\n   440→    result.schemasWouldGenerate = true;\n   441→    logOk(\"Schema generation works\");\n   442→  } catch {\n   443→    logErr(\"Schema generation failed. Fix before releasing.\");\n   444→    process.exit(1);\n   445→  }\n   446→\n   447→  // 9. Optional: typecheck + lint\n   448→  if (!SKIP_CHECKS) {\n   449→    logStep(\"Running typecheck...\");\n   450→    try {\n   451→      await exec(\"bun run tc\", { silent: true });\n   452→      result.typecheckPassed = true;\n   453→      logOk(\"Typecheck passed\");\n   454→    } catch {\n   455→      logErr(\"Typecheck failed. Fix errors or use --skip-checks to skip.\");\n   456→      process.exit(1);\n   457→    }\n   458→\n   459→    logStep(\"Running lint...\");\n   460→    try {\n   461→      await exec(\"bun run lint\", { silent: true });\n   462→      result.lintPassed = true;\n   463→      logOk(\"Lint passed\");\n   464→    } catch {\n   465→      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n   466→      process.exit(1);\n   467→    }\n   468→  } else {\n   469→    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n   470→    result.typecheckPassed = null;\n   471→    result.lintPassed = null;\n   472→  }\n   473→\n   474→  return result;\n   475→}\n   476→\n   477→// ─── PHASE 2: Execute ────────────────────────────────────────────────\n   478→\n   479→async function execute(validation: ValidationResult): Promise<void> {\n   480→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   481→  log(\"║  Phase 2: Execute                                        ║\");\n   482→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   483→\n   484→  const { newVersion } = validation;\n   485→  const tag = `v${newVersion}`;\n   486→  state.tagName = tag;\n   487→\n   488→  try {\n   489→    // ── Step 1: Local changes on develop ──────────────────────────\n   490→\n   491→    logStep(`Bumping version to ${newVersion}...`);\n   492→    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n   493→    logOk(`package.json updated to ${newVersion}`);\n   494→\n   495→    logStep(\"Stamping CHANGELOG...\");\n   496→    const changelog = await Bun.file(CHANGELOG_PATH).text();\n   497→    const date = new Date().toISOString().split(\"T\")[0];\n   498→    const stampedChangelog = changelog.replace(\n   499→      \"## [Unreleased]\",\n   500→      `## [${newVersion}] - ${date}`,\n   501→    );\n   502→    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n   503→    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n   504→\n   505→    logStep(\"Regenerating schemas...\");\n   506→    await exec(\"bun run generate-schemas\");\n   507→    logOk(\"Schemas regenerated\");\n   508→\n   509→    logStep(\"Creating release commit...\");\n   510→    await exec(\"git add package.json CHANGELOG.md schemas/\");\n   511→    await exec(`git commit -m \"Release v${newVersion}\"`);\n   512→    logOk(`Committed \"Release v${newVersion}\" on develop`);\n   513→\n   514→    logStep(\"Adding [Unreleased] section...\");\n   515→    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n   516→    const lines = updatedChangelog.split(\"\\n\");\n   517→    const firstHeadingIndex = lines.findIndex((line) =>\n   518→      line.startsWith(\"## [\"),\n   519→    );\n   520→    if (firstHeadingIndex !== -1) {\n   521→      lines.splice(\n   522→        firstHeadingIndex,\n   523→        0,\n   524→        ...[\n   525→          \"## [Unreleased]\",\n   526→          \"\",\n   527→          \"### Added\",\n   528→          \"- \",\n   529→          \"\",\n   530→          \"### Changed\",\n   531→          \"- \",\n   532→          \"\",\n   533→          \"### Fixed\",\n   534→          \"- \",\n   535→          \"\",\n   536→        ],\n   537→      );\n   538→      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n   539→    }\n   540→    await exec(\"git add CHANGELOG.md\");\n   541→    await exec(\n   542→      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n   543→    );\n   544→    logOk(\"Committed [Unreleased] template\");\n   545→\n   546→    // ── Step 2: Push develop ──────────────────────────────────────\n   547→\n   548→    logStep(\"Pushing develop to origin...\");\n   549→    await exec(\"git push origin develop\");\n   550→    state.developPushed = true;\n   551→    logOk(\"Pushed develop\");\n   552→\n   553→    // ── Step 3: Merge to release/alpha ────────────────────────────\n   554→\n   555→    logStep(\"Merging develop → release/alpha...\");\n   556→    await exec(\"git checkout release/alpha\");\n   557→\n   558→    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n   559→      allowFailure: true,\n   560→      silent: true,\n   561→    });\n   562→\n   563→    // Handle modify/delete conflicts on files we're about to strip anyway.\n   564→    // This happens when a file is modified on develop but was deleted from\n   565→    // release/alpha during a previous release's strip step.\n   566→    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n   567→      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n   568→      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n   569→\n   570→      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n   571→        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n   572→      );\n   573→\n   574→      if (!allStrippable) {\n   575→        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n   576→        throw new Error(\n   577→          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n   578→        );\n   579→      }\n   580→\n   581→      for (const file of conflictFiles) {\n   582→        await exec(`git rm -f \"${file}\"`, { silent: true });\n   583→      }\n   584→      await exec('git -c core.editor=true merge --continue', { silent: true });\n   585→      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n   586→    } else {\n   587→      logOk(\"Merged develop into release/alpha\");\n   588→    }\n   589→\n   590→    // Strip internal files\n   591→    logStep(\"Stripping internal files...\");\n   592→    const filesToRemove: string[] = [];\n   593→    for (const file of INTERNAL_FILES_TO_STRIP) {\n   594→      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n   595→        silent: true,\n   596→      });\n   597→      if (exists) filesToRemove.push(file);\n   598→    }\n   599→    if (filesToRemove.length > 0) {\n   600→      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n   601→      await exec(\n   602→        'git commit -m \"chore: strip intermediates and planning files\"',\n   603→      );\n   604→      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n   605→    } else {\n   606→      logOk(\"No internal files to strip\");\n   607→    }\n   608→\n   609→    // ── Step 4: Create tag ────────────────────────────────────────\n   610→\n   611→    logStep(`Creating tag ${tag}...`);\n   612→    // Delete stale local tag if exists\n   613→    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n   614→    if (staleTag) {\n   615→      await exec(`git tag -d ${tag}`);\n   616→    }\n   617→    await exec(`git tag ${tag}`);\n   618→    logOk(`Created tag ${tag} on release/alpha`);\n   619→\n   620→    // ── Step 5: Push release/alpha + tag ──────────────────────────\n   621→\n   622→    logStep(\"Pushing release/alpha to origin...\");\n   623→    await exec(\"git push origin release/alpha\");\n   624→    state.releaseAlphaPushed = true;\n   625→    logOk(\"Pushed release/alpha\");\n   626→\n   627→    logStep(`Pushing tag ${tag} to origin...`);\n   628→    await exec(`git push origin ${tag}`);\n   629→    state.tagPushed = true;\n   630→    logOk(`Pushed tag ${tag} (this triggers CI)`);\n   631→\n   632→    // ── Step 6: Return to develop ─────────────────────────────────\n   633→\n   634→    await exec(\"git checkout develop\");\n   635→    logOk(\"Back on develop branch\");\n   636→  } catch (error) {\n   637→    logErr(`Release failed: ${(error as Error).message}`);\n   638→\n   639→    // Attempt automatic rollback\n   640→    await rollback();\n   641→    throw error;\n   642→  }\n   643→}\n   644→\n   645→// ─── Rollback ────────────────────────────────────────────────────────\n   646→\n   647→async function rollback(): Promise<void> {\n   648→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   649→  log(\"║  Automatic Rollback                                      ║\");\n   650→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   651→\n   652→  const actions: string[] = [];\n   653→\n   654→  try {\n   655→    // Make sure we can get back to a branch\n   656→    const currentBranch = await exec(\"git branch --show-current\", {\n   657→      silent: true,\n   658→      allowFailure: true,\n   659→    });\n   660→\n   661→    // If we're mid-merge, abort it\n   662→    await exec(\"git merge --abort 2>/dev/null || true\", {\n   663→      silent: true,\n   664→      allowFailure: true,\n   665→    });\n   666→\n   667→    // Delete local tag if created\n   668→    if (state.tagName) {\n   669→      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n   670→        silent: true,\n   671→      });\n   672→      if (tagExists) {\n   673→        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n   674→        actions.push(`Deleted local tag ${state.tagName}`);\n   675→      }\n   676→    }\n   677→\n   678→    // Reset release/alpha to pre-release state\n   679→    if (state.releaseAlphaHead) {\n   680→      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n   681→        silent: true,\n   682→        allowFailure: true,\n   683→      });\n   684→      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n   685→        allowFailure: true,\n   686→      });\n   687→      actions.push(\n   688→        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n   689→      );\n   690→    }\n   691→\n   692→    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n   693→    if (state.developHead) {\n   694→      await exec(\"git checkout develop\", { allowFailure: true });\n   695→      if (!state.developPushed) {\n   696→        await exec(`git reset --hard ${state.developHead}`, {\n   697→          allowFailure: true,\n   698→        });\n   699→        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n   700→      } else {\n   701→        // develop was pushed — we need to force-push to undo\n   702→        logWarn(\"develop was already pushed to remote. Local reset only.\");\n   703→        await exec(`git reset --hard ${state.developHead}`, {\n   704→          allowFailure: true,\n   705→        });\n   706→        actions.push(\n   707→          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n   708→        );\n   709→        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n   710→        actions.push(`  git push origin develop --force-with-lease`);\n   711→      }\n   712→    } else {\n   713→      // At minimum get back to develop\n   714→      await exec(\"git checkout develop 2>/dev/null || true\", {\n   715→        silent: true,\n   716→        allowFailure: true,\n   717→      });\n   718→    }\n   719→\n   720→    if (state.releaseAlphaPushed) {\n   721→      actions.push(\n   722→        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n   723→      );\n   724→      actions.push(`  git push origin release/alpha --force-with-lease`);\n   725→    }\n   726→\n   727→    if (state.tagPushed) {\n   728→      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n   729→      actions.push(`  git push origin --delete ${state.tagName}`);\n   730→    }\n   731→\n   732→    log(\"\\n  Rollback actions:\");\n   733→    for (const action of actions) {\n   734→      if (action.startsWith(\"WARNING\")) {\n   735→        logWarn(action);\n   736→      } else {\n   737→        logOk(action);\n   738→      }\n   739→    }\n   740→\n   741→    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n   742→      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n   743→    } else {\n   744→      log(\n   745→        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n   746→      );\n   747→    }\n   748→  } catch (rollbackError) {\n   749→    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n   750→    log(\"\\n  Manual recovery steps:\");\n   751→    log(`    git checkout develop`);\n   752→    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n   753→    log(`    git checkout release/alpha`);\n   754→    log(\n   755→      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n   756→    );\n   757→    if (state.tagName) {\n   758→      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n   759→    }\n   760→    log(`    git checkout develop`);\n   761→  }\n   762→}\n   763→\n   764→// ─── Main ────────────────────────────────────────────────────────────\n   765→\n   766→async function main(): Promise<void> {\n   767→  log(\"╔════════════════════════════════════════════════════════════╗\");\n   768→  log(\"║  Hankweave Release                                       ║\");\n   769→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   770→  log(\"\");\n   771→  log(`  Bump type:    ${BUMP_TYPE}`);\n   772→  log(\n   773→    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n   774→  );\n   775→  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n   776→\n   777→  // Phase 1: Validate\n   778→  const validation = await validate();\n   779→\n   780→  // Print plan\n   781→  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n   782→  log(\"│  Release Plan                                              │\");\n   783→  log(\"├────────────────────────────────────────────────────────────┤\");\n   784→  log(\n   785→    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n   786→  );\n   787→  log(`│  Tag:         v${validation.newVersion}`);\n   788→  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n   789→  log(\n   790→    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`,\n   791→  );\n   792→  log(`│  Schemas:     ${validation.schemasWouldGenerate ? \"ok\" : \"failed!\"}`);\n   793→  if (validation.typecheckPassed !== null) {\n   794→    log(`│  Typecheck:   ${validation.typecheckPassed ? \"passed\" : \"failed!\"}`);\n   795→  }\n   796→  if (validation.lintPassed !== null) {\n   797→    log(`│  Lint:        ${validation.lintPassed ? \"passed\" : \"failed!\"}`);\n   798→  }\n   799→  log(\"│                                                            │\");\n   800→  log(\"│  Steps:                                                    │\");\n   801→  log(\"│    1. Bump version + stamp changelog + commit on develop   │\");\n   802→  log(\"│    2. Add [Unreleased] template + commit                   │\");\n   803→  log(\"│    3. Push develop                                         │\");\n   804→  log(\"│    4. Merge develop → release/alpha, strip internal files  │\");\n   805→  log(\"│    5. Create tag, push release/alpha + tag                 │\");\n   806→  log(\"│    6. Return to develop                                    │\");\n   807→  log(\"│                                                            │\");\n   808→  log(\"│  Tag push will trigger CI: tests → npm → binaries → GH    │\");\n   809→  log(\"└────────────────────────────────────────────────────────────┘\");\n   810→\n   811→  if (DRY_RUN) {\n   812→    log(\"\\n  ✓ Dry-run complete. All validations passed.\");\n   813→    log(\"  Run without --dry-run to execute the release.\");\n   814→    process.exit(0);\n   815→  }\n   816→\n   817→  // Confirm before proceeding\n   818→  if (!YES_MODE) {\n   819→    const proceed = await confirm(\"Proceed with release?\");\n   820→    if (!proceed) {\n   821→      log(\"\\nRelease cancelled.\");\n   822→      process.exit(0);\n   823→    }\n   824→  } else {\n   825→    log(\"\\n  Proceeding with release (--yes mode)...\");\n   826→  }\n   827→\n   828→  // Phase 2: Execute\n   829→  await execute(validation);\n   830→\n   831→  // Success!\n   832→  const repoUrl = await exec(\"git remote get-url origin\", { silent: true });\n   833→  const cleanUrl = repoUrl\n   834→    .replace(/\\.git$/, \"\")\n   835→    .replace(/.*github\\.com[:/]/, \"\");\n   836→\n   837→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   838→  log(\"║  Release complete                                         ║\");\n   839→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   840→  log(`\\n  Version: v${validation.newVersion}`);\n   841→  log(\"\");\n   842→  log(\"  What happened:\");\n   843→  log(\"    ✓ Release commits created on develop\");\n   844→  log(\"    ✓ develop pushed to origin\");\n   845→  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n   846→  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n   847→  log(\"\");\n   848→  log(\"  CI will now:\");\n   849→  log(\"    1. Run tests\");\n   850→  log(\n   851→    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n   852→  );\n   853→  log(\"    3. Build platform executables\");\n   854→  log(\"    4. Create GitHub release\");\n   855→  log(\"\");\n   856→  log(`  Track: https://github.com/${cleanUrl}/actions`);\n   857→  log(\"\");\n   858→  log(\"  Next (when CI passes):\");\n   859→  log(\n   860→    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n   861→  );\n   862→}\n   863→\n   864→main().catch((error) => {\n   865→  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n   866→  process.exit(1);\n   867→});\n   868→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a77b2755-3bdb-4c5a-a31c-e6ef769bd1ab","uuid":"5667e040-06f3-40bc-bed0-d877d4f94860","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/release.ts","content":"#!/usr/bin/env bun\n\n/**\n * Release automation script for Hankweave\n *\n * Two-phase release: validate everything first (dry-run), then execute.\n * Automatic rollback on failure. Headless-friendly.\n *\n * Usage:\n *   bun run release:patch              # Interactive release\n *   bun run release:minor              # Minor version bump\n *   bun run release:major              # Major version bump\n *   bun scripts/release.ts patch --yes # Headless (no prompts)\n *   bun scripts/release.ts minor --dry-run  # Validate only\n *\n * Flags:\n *   --yes, -y       Skip all interactive prompts (for agents/CI)\n *   --dry-run       Validate everything but don't make changes\n *   --skip-checks   Skip typecheck and lint during validation\n */\n\nimport { existsSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\n// ─── Argument parsing ────────────────────────────────────────────────\n\nconst args = process.argv.slice(2);\nconst BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\nconst VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\ntype BumpType = (typeof VALID_BUMP_TYPES)[number];\n\nconst YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\nconst DRY_RUN = args.includes(\"--dry-run\");\nconst SKIP_CHECKS = args.includes(\"--skip-checks\");\n\nif (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n  console.error(\"Error: Invalid or missing bump type\");\n  console.error(\"\");\n  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n  console.error(\"\");\n  console.error(\"Flags:\");\n  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n  console.error(\"  --dry-run       Validate everything without making changes\");\n  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n  process.exit(1);\n}\n\nconst ROOT = resolve(process.cwd());\nconst CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\nconst PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n\n/** Files/dirs stripped from release/alpha after each merge from develop.\n *  Used by both the dry-run merge check and the actual merge step. */\nconst INTERNAL_FILES_TO_STRIP = [\n  \"intermediates/\",\n  \"external-docs/\",\n  \"CLAUDE.md\",\n  \"CONTRIBUTING.md\",\n  \"standard-operating-procedures.md\",\n];\n\n// ─── Saved state for rollback ────────────────────────────────────────\n\ninterface ReleaseState {\n  developHead: string;\n  releaseAlphaHead: string;\n  startBranch: string;\n  newVersion: string | null;\n  developPushed: boolean;\n  releaseAlphaPushed: boolean;\n  tagPushed: boolean;\n  tagName: string | null;\n}\n\nconst state: ReleaseState = {\n  developHead: \"\",\n  releaseAlphaHead: \"\",\n  startBranch: \"\",\n  newVersion: null,\n  developPushed: false,\n  releaseAlphaPushed: false,\n  tagPushed: false,\n  tagName: null,\n};\n\n// ─── Helpers ─────────────────────────────────────────────────────────\n\nasync function exec(\n  command: string,\n  options: { silent?: boolean; allowFailure?: boolean } = {},\n): Promise<string> {\n  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    stdout: \"pipe\",\n    stderr: options.silent ? \"pipe\" : \"inherit\",\n  });\n\n  const exitCode = await proc.exited;\n  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.allowFailure) {\n    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n  }\n\n  return output.trim();\n}\n\nfunction log(msg: string) {\n  console.log(msg);\n}\n\nfunction logStep(msg: string) {\n  console.log(`\\n  ${msg}`);\n}\n\nfunction logOk(msg: string) {\n  console.log(`  ✓ ${msg}`);\n}\n\nfunction logWarn(msg: string) {\n  console.log(`  ! ${msg}`);\n}\n\nfunction logErr(msg: string) {\n  console.error(`  ✗ ${msg}`);\n}\n\n/**\n * Prompt the user for confirmation. In --yes mode, auto-confirms.\n * Returns true if confirmed, false if cancelled.\n */\nasync function confirm(message: string): Promise<boolean> {\n  if (YES_MODE) {\n    log(`  ${message} (auto-confirmed: --yes)`);\n    return true;\n  }\n\n  process.stdout.write(`  ${message} [y/N] `);\n\n  // Read a single line from stdin\n  const reader = Bun.stdin.stream().getReader();\n  const { value } = await reader.read();\n  reader.releaseLock();\n\n  const answer = value\n    ? new TextDecoder().decode(value).trim().toLowerCase()\n    : \"\";\n  return answer === \"y\" || answer === \"yes\";\n}\n\n/**\n * Compute what the new version would be without modifying package.json\n */\nfunction computeNewVersion(currentVersion: string, bumpType: string): string {\n  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n  switch (bumpType) {\n    case \"major\":\n      return `${major + 1}.0.0`;\n    case \"minor\":\n      return `${major}.${minor + 1}.0`;\n    case \"patch\":\n      return `${major}.${minor}.${patch + 1}`;\n    default:\n      throw new Error(`Invalid bump type: ${bumpType}`);\n  }\n}\n\n// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n\ninterface ValidationResult {\n  currentVersion: string;\n  newVersion: string;\n  changelogEntryCount: number;\n  changelogPreview: string[];\n  mergeWouldSucceed: boolean;\n  schemasWouldGenerate: boolean;\n  typecheckPassed: boolean | null; // null = skipped\n  lintPassed: boolean | null;\n}\n\nasync function validate(): Promise<ValidationResult> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 1: Validation                                     ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const result: ValidationResult = {\n    currentVersion: \"\",\n    newVersion: \"\",\n    changelogEntryCount: 0,\n    changelogPreview: [],\n    mergeWouldSucceed: false,\n    schemasWouldGenerate: false,\n    typecheckPassed: null,\n    lintPassed: null,\n  };\n\n  // 1. Check branch\n  logStep(\"Checking branch...\");\n  const currentBranch = await exec(\"git branch --show-current\", {\n    silent: true,\n  });\n  if (currentBranch !== \"develop\") {\n    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n    process.exit(1);\n  }\n  state.startBranch = currentBranch;\n  logOk(`On develop branch`);\n\n  // 2. Check clean working directory\n  logStep(\"Checking working directory...\");\n  const status = await exec(\"git status --porcelain\", { silent: true });\n  if (status) {\n    logErr(\"Uncommitted changes detected:\");\n    console.error(status);\n    process.exit(1);\n  }\n  logOk(\"Working directory is clean\");\n\n  // 3. Check remote sync\n  logStep(\"Checking remote sync...\");\n  await exec(\"git fetch origin\", { silent: true });\n\n  for (const branch of [\"develop\", \"release/alpha\"]) {\n    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n      silent: true,\n    });\n\n    if (localCommit !== remoteCommit) {\n      const ahead = parseInt(\n        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n          silent: true,\n        }),\n      );\n      const behind = parseInt(\n        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n          silent: true,\n        }),\n      );\n\n      if (behind > 0 && ahead > 0) {\n        logErr(\n          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n        );\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (behind > 0) {\n        logErr(`${branch} is ${behind} commit(s) behind remote`);\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (ahead > 0) {\n        logWarn(\n          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n        );\n      }\n    } else {\n      logOk(`${branch} is in sync with origin/${branch}`);\n    }\n  }\n\n  // Save pre-release state for rollback\n  state.developHead = await exec(\"git rev-parse develop\", { silent: true });\n  state.releaseAlphaHead = await exec(\"git rev-parse release/alpha\", {\n    silent: true,\n  });\n\n  // 4. Compute new version\n  logStep(\"Computing version...\");\n  const packageJson = await Bun.file(PACKAGE_JSON_PATH).json();\n  result.currentVersion = packageJson.version;\n  result.newVersion = computeNewVersion(\n    result.currentVersion,\n    BUMP_TYPE as string,\n  );\n  state.newVersion = result.newVersion;\n  logOk(`${result.currentVersion} → ${result.newVersion} (${BUMP_TYPE})`);\n\n  // 5. Check tag doesn't exist\n  logStep(\"Checking tag availability...\");\n  const tag = `v${result.newVersion}`;\n  const remoteTag = await exec(`git ls-remote --tags origin ${tag}`, {\n    silent: true,\n  });\n  if (remoteTag) {\n    logErr(\n      `Tag ${tag} already exists on remote. The version may already be released.`,\n    );\n    process.exit(1);\n  }\n  // Also check locally\n  const localTag = await exec(`git tag -l ${tag}`, { silent: true });\n  if (localTag) {\n    logWarn(\n      `Tag ${tag} exists locally (stale). Will be deleted before re-creation.`,\n    );\n  }\n  logOk(`Tag ${tag} is available`);\n\n  // 6. Validate changelog\n  logStep(\"Validating CHANGELOG.md...\");\n  if (!existsSync(CHANGELOG_PATH)) {\n    logErr(\"CHANGELOG.md not found\");\n    process.exit(1);\n  }\n\n  const changelog = await Bun.file(CHANGELOG_PATH).text();\n  if (!changelog.includes(\"## [Unreleased]\")) {\n    logErr(\"No [Unreleased] section found in CHANGELOG.md\");\n    process.exit(1);\n  }\n\n  const unreleasedMatch = changelog.match(\n    /## \\[Unreleased\\]([\\s\\S]*?)(?=\\n## |$)/,\n  );\n  if (!unreleasedMatch) {\n    logErr(\"Could not parse [Unreleased] section\");\n    process.exit(1);\n  }\n\n  const bulletPoints = unreleasedMatch[1].match(/^- .+\\S/gm) || [];\n  result.changelogEntryCount = bulletPoints.length;\n  result.changelogPreview = bulletPoints.slice(0, 5);\n\n  if (result.changelogEntryCount === 0) {\n    logWarn(\"CHANGELOG [Unreleased] section has no entries\");\n    logWarn(\"The release will have empty release notes\");\n    if (!YES_MODE) {\n      const proceed = await confirm(\"Continue with empty changelog?\");\n      if (!proceed) {\n        log(\"\\nRelease cancelled. Add entries to [Unreleased] and try again.\");\n        process.exit(0);\n      }\n    }\n  } else {\n    logOk(\n      `CHANGELOG has ${result.changelogEntryCount} entries in [Unreleased]:`,\n    );\n    for (const entry of result.changelogPreview) {\n      console.log(`      ${entry}`);\n    }\n    if (result.changelogEntryCount > 5) {\n      console.log(`      ... and ${result.changelogEntryCount - 5} more`);\n    }\n  }\n\n  // 7. Test merge feasibility\n  logStep(\"Testing merge feasibility (develop → release/alpha)...\");\n  try {\n    // Use merge-tree to check for conflicts without touching the working tree\n    // merge-tree returns 0 even with conflicts, but outputs conflict markers\n    // Instead, do a merge --no-commit --no-ff and then abort\n    await exec(\"git checkout release/alpha\", { silent: true });\n    const mergeResult = await exec(\n      \"git merge --no-commit --no-ff develop 2>&1\",\n      {\n        silent: true,\n        allowFailure: true,\n      },\n    );\n    // Check for conflicts — any unmerged entry in porcelain status.\n    // Codes: UU (both modified), AA (both added), DD (both deleted),\n    // DU/UD (modify/delete — e.g. file stripped on release but modified on develop)\n    const mergeStatus = await exec(\"git status --porcelain\", { silent: true });\n    const conflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) /m;\n    const hasConflicts = conflictPattern.test(mergeStatus);\n\n    // For modify/delete conflicts, check if ALL conflicting files are in the\n    // strip list — if so, the merge step will auto-resolve them.\n    let conflictsAreStrippable = false;\n    if (hasConflicts) {\n      const modifyDeletePattern = /^(DU|UD) (.+)$/gm;\n      const allConflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) (.+)$/gm;\n\n      const modifyDeleteFiles = [...mergeStatus.matchAll(modifyDeletePattern)].map((m) => m[2].trim());\n      const allConflictFiles = [...mergeStatus.matchAll(allConflictPattern)].map((m) => m[2].trim());\n\n      if (\n        allConflictFiles.length > 0 &&\n        allConflictFiles.length === modifyDeleteFiles.length &&\n        modifyDeleteFiles.every((f) =>\n          INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n        )\n      ) {\n        conflictsAreStrippable = true;\n      }\n    }\n\n    // Abort the merge\n    await exec(\"git merge --abort 2>/dev/null || git reset --hard HEAD\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop\", { silent: true });\n\n    if (hasConflicts && !conflictsAreStrippable) {\n      logErr(\"Merge would have conflicts. Resolve before releasing:\");\n      logErr(\"  git checkout release/alpha\");\n      logErr(\"  git merge develop\");\n      logErr(\"  # resolve conflicts, commit, then:\");\n      logErr(\"  git checkout develop\");\n      process.exit(1);\n    }\n    result.mergeWouldSucceed = true;\n    if (conflictsAreStrippable) {\n      logOk(\"Merge has modify/delete conflicts on stripped files (will auto-resolve)\");\n    } else {\n      logOk(\"Merge would succeed cleanly\");\n    }\n  } catch (error) {\n    // Make sure we're back on develop\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    logErr(`Merge test failed: ${(error as Error).message}`);\n    process.exit(1);\n  }\n\n  // 8. Test schema generation\n  logStep(\"Testing schema generation...\");\n  try {\n    await exec(\"bun run generate-schemas\", { silent: true });\n    // Check if schemas directory changed (would indicate schemas need regenerating)\n    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n      silent: true,\n    });\n    if (schemaChanges) {\n      logWarn(\n        \"Schema generation produced changes (will be included in release commit)\",\n      );\n    }\n    // Reset any changes from test generation\n    await exec(\"git checkout -- schemas/ 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    result.schemasWouldGenerate = true;\n    logOk(\"Schema generation works\");\n  } catch {\n    logErr(\"Schema generation failed. Fix before releasing.\");\n    process.exit(1);\n  }\n\n  // 9. Optional: typecheck + lint\n  if (!SKIP_CHECKS) {\n    logStep(\"Running typecheck...\");\n    try {\n      await exec(\"bun run tc\", { silent: true });\n      result.typecheckPassed = true;\n      logOk(\"Typecheck passed\");\n    } catch {\n      logErr(\"Typecheck failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n\n    logStep(\"Running lint...\");\n    try {\n      await exec(\"bun run lint\", { silent: true });\n      result.lintPassed = true;\n      logOk(\"Lint passed\");\n    } catch {\n      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n  } else {\n    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n    result.typecheckPassed = null;\n    result.lintPassed = null;\n  }\n\n  return result;\n}\n\n// ─── PHASE 2: Execute ────────────────────────────────────────────────\n\nasync function execute(validation: ValidationResult): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 2: Execute                                        ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const { newVersion } = validation;\n  const tag = `v${newVersion}`;\n  state.tagName = tag;\n\n  try {\n    // ── Step 1: Local changes on develop ──────────────────────────\n\n    logStep(`Bumping version to ${newVersion}...`);\n    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n    logOk(`package.json updated to ${newVersion}`);\n\n    logStep(\"Stamping CHANGELOG...\");\n    const changelog = await Bun.file(CHANGELOG_PATH).text();\n    const date = new Date().toISOString().split(\"T\")[0];\n    const stampedChangelog = changelog.replace(\n      \"## [Unreleased]\",\n      `## [${newVersion}] - ${date}`,\n    );\n    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n\n    logStep(\"Regenerating schemas...\");\n    await exec(\"bun run generate-schemas\");\n    logOk(\"Schemas regenerated\");\n\n    logStep(\"Creating release commit...\");\n    await exec(\"git add package.json CHANGELOG.md schemas/\");\n    await exec(`git commit -m \"Release v${newVersion}\"`);\n    logOk(`Committed \"Release v${newVersion}\" on develop`);\n\n    logStep(\"Adding [Unreleased] section...\");\n    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n    const lines = updatedChangelog.split(\"\\n\");\n    const firstHeadingIndex = lines.findIndex((line) =>\n      line.startsWith(\"## [\"),\n    );\n    if (firstHeadingIndex !== -1) {\n      lines.splice(\n        firstHeadingIndex,\n        0,\n        ...[\n          \"## [Unreleased]\",\n          \"\",\n          \"### Added\",\n          \"- \",\n          \"\",\n          \"### Changed\",\n          \"- \",\n          \"\",\n          \"### Fixed\",\n          \"- \",\n          \"\",\n        ],\n      );\n      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n    }\n    await exec(\"git add CHANGELOG.md\");\n    await exec(\n      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n    );\n    logOk(\"Committed [Unreleased] template\");\n\n    // ── Step 2: Push develop ──────────────────────────────────────\n\n    logStep(\"Pushing develop to origin...\");\n    await exec(\"git push origin develop\");\n    state.developPushed = true;\n    logOk(\"Pushed develop\");\n\n    // ── Step 3: Merge to release/alpha ────────────────────────────\n\n    logStep(\"Merging develop → release/alpha...\");\n    await exec(\"git checkout release/alpha\");\n\n    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n      allowFailure: true,\n      silent: true,\n    });\n\n    // Handle modify/delete conflicts on files we're about to strip anyway.\n    // This happens when a file is modified on develop but was deleted from\n    // release/alpha during a previous release's strip step.\n    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n\n      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n      );\n\n      if (!allStrippable) {\n        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n        throw new Error(\n          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n        );\n      }\n\n      for (const file of conflictFiles) {\n        await exec(`git rm -f \"${file}\"`, { silent: true });\n      }\n      await exec('git -c core.editor=true merge --continue', { silent: true });\n      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n    } else {\n      logOk(\"Merged develop into release/alpha\");\n    }\n\n    // Strip internal files\n    logStep(\"Stripping internal files...\");\n    const filesToRemove: string[] = [];\n    for (const file of INTERNAL_FILES_TO_STRIP) {\n      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n        silent: true,\n      });\n      if (exists) filesToRemove.push(file);\n    }\n    if (filesToRemove.length > 0) {\n      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n      await exec(\n        'git commit -m \"chore: strip intermediates and planning files\"',\n      );\n      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n    } else {\n      logOk(\"No internal files to strip\");\n    }\n\n    // ── Step 4: Create tag ────────────────────────────────────────\n\n    logStep(`Creating tag ${tag}...`);\n    // Delete stale local tag if exists\n    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n    if (staleTag) {\n      await exec(`git tag -d ${tag}`);\n    }\n    await exec(`git tag ${tag}`);\n    logOk(`Created tag ${tag} on release/alpha`);\n\n    // ── Step 5: Push release/alpha + tag ──────────────────────────\n\n    logStep(\"Pushing release/alpha to origin...\");\n    await exec(\"git push origin release/alpha\");\n    state.releaseAlphaPushed = true;\n    logOk(\"Pushed release/alpha\");\n\n    logStep(`Pushing tag ${tag} to origin...`);\n    await exec(`git push origin ${tag}`);\n    state.tagPushed = true;\n    logOk(`Pushed tag ${tag} (this triggers CI)`);\n\n    // ── Step 6: Return to develop ─────────────────────────────────\n\n    await exec(\"git checkout develop\");\n    logOk(\"Back on develop branch\");\n  } catch (error) {\n    logErr(`Release failed: ${(error as Error).message}`);\n\n    // Attempt automatic rollback\n    await rollback();\n    throw error;\n  }\n}\n\n// ─── Rollback ────────────────────────────────────────────────────────\n\nasync function rollback(): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Automatic Rollback                                      ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const actions: string[] = [];\n\n  try {\n    // Make sure we can get back to a branch\n    const currentBranch = await exec(\"git branch --show-current\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // If we're mid-merge, abort it\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // Delete local tag if created\n    if (state.tagName) {\n      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n        silent: true,\n      });\n      if (tagExists) {\n        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n        actions.push(`Deleted local tag ${state.tagName}`);\n      }\n    }\n\n    // Reset release/alpha to pre-release state\n    if (state.releaseAlphaHead) {\n      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n        allowFailure: true,\n      });\n      actions.push(\n        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n      );\n    }\n\n    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n    if (state.developHead) {\n      await exec(\"git checkout develop\", { allowFailure: true });\n      if (!state.developPushed) {\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n      } else {\n        // develop was pushed — we need to force-push to undo\n        logWarn(\"develop was already pushed to remote. Local reset only.\");\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(\n          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n        );\n        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n        actions.push(`  git push origin develop --force-with-lease`);\n      }\n    } else {\n      // At minimum get back to develop\n      await exec(\"git checkout develop 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n    }\n\n    if (state.releaseAlphaPushed) {\n      actions.push(\n        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n      );\n      actions.push(`  git push origin release/alpha --force-with-lease`);\n    }\n\n    if (state.tagPushed) {\n      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n      actions.push(`  git push origin --delete ${state.tagName}`);\n    }\n\n    log(\"\\n  Rollback actions:\");\n    for (const action of actions) {\n      if (action.startsWith(\"WARNING\")) {\n        logWarn(action);\n      } else {\n        logOk(action);\n      }\n    }\n\n    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n    } else {\n      log(\n        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n      );\n    }\n  } catch (rollbackError) {\n    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n    log(\"\\n  Manual recovery steps:\");\n    log(`    git checkout develop`);\n    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n    log(`    git checkout release/alpha`);\n    log(\n      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n    );\n    if (state.tagName) {\n      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n    }\n    log(`    git checkout develop`);\n  }\n}\n\n// ─── Main ────────────────────────────────────────────────────────────\n\nasync function main(): Promise<void> {\n  log(\"╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Hankweave Release                                       ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(\"\");\n  log(`  Bump type:    ${BUMP_TYPE}`);\n  log(\n    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n  );\n  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n\n  // Phase 1: Validate\n  const validation = await validate();\n\n  // Print plan\n  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n  log(\"│  Release Plan                                              │\");\n  log(\"├────────────────────────────────────────────────────────────┤\");\n  log(\n    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n  );\n  log(`│  Tag:         v${validation.newVersion}`);\n  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n  log(\n    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`,\n  );\n  log(`│  Schemas:     ${validation.schemasWouldGenerate ? \"ok\" : \"failed!\"}`);\n  if (validation.typecheckPassed !== null) {\n    log(`│  Typecheck:   ${validation.typecheckPassed ? \"passed\" : \"failed!\"}`);\n  }\n  if (validation.lintPassed !== null) {\n    log(`│  Lint:        ${validation.lintPassed ? \"passed\" : \"failed!\"}`);\n  }\n  log(\"│                                                            │\");\n  log(\"│  Steps:                                                    │\");\n  log(\"│    1. Bump version + stamp changelog + commit on develop   │\");\n  log(\"│    2. Add [Unreleased] template + commit                   │\");\n  log(\"│    3. Push develop                                         │\");\n  log(\"│    4. Merge develop → release/alpha, strip internal files  │\");\n  log(\"│    5. Create tag, push release/alpha + tag                 │\");\n  log(\"│    6. Return to develop                                    │\");\n  log(\"│                                                            │\");\n  log(\"│  Tag push will trigger CI: tests → npm → binaries → GH    │\");\n  log(\"└────────────────────────────────────────────────────────────┘\");\n\n  if (DRY_RUN) {\n    log(\"\\n  ✓ Dry-run complete. All validations passed.\");\n    log(\"  Run without --dry-run to execute the release.\");\n    process.exit(0);\n  }\n\n  // Confirm before proceeding\n  if (!YES_MODE) {\n    const proceed = await confirm(\"Proceed with release?\");\n    if (!proceed) {\n      log(\"\\nRelease cancelled.\");\n      process.exit(0);\n    }\n  } else {\n    log(\"\\n  Proceeding with release (--yes mode)...\");\n  }\n\n  // Phase 2: Execute\n  await execute(validation);\n\n  // Success!\n  const repoUrl = await exec(\"git remote get-url origin\", { silent: true });\n  const cleanUrl = repoUrl\n    .replace(/\\.git$/, \"\")\n    .replace(/.*github\\.com[:/]/, \"\");\n\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Release complete                                         ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(`\\n  Version: v${validation.newVersion}`);\n  log(\"\");\n  log(\"  What happened:\");\n  log(\"    ✓ Release commits created on develop\");\n  log(\"    ✓ develop pushed to origin\");\n  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n  log(\"\");\n  log(\"  CI will now:\");\n  log(\"    1. Run tests\");\n  log(\n    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n  );\n  log(\"    3. Build platform executables\");\n  log(\"    4. Create GitHub release\");\n  log(\"\");\n  log(`  Track: https://github.com/${cleanUrl}/actions`);\n  log(\"\");\n  log(\"  Next (when CI passes):\");\n  log(\n    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n  );\n}\n\nmain().catch((error) => {\n  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n  process.exit(1);\n});\n","numLines":868,"startLine":1,"totalLines":868}},"timestamp":"2026-03-05T12:49:07.001Z"}
