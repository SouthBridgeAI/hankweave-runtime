nc-local.ts\",\n  \"scripts/release.ts\",\n  \"reference/telemetry.md\", // Internal version has credentials; replaced by public-release-files version","numLines":40,"startLine":1,"totalLines":540}},"timestamp":"2026-03-05T13:31:14.319Z"}
