{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCTVWrNTecKWQUDHpJunUA","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→\n     3→/**\n     4→ * Release automation script for Hankweave\n     5→ *\n     6→ * Two-phase release: validate everything first (dry-run), then execute.\n     7→ * Automatic rollback on failure. Headless-friendly.\n     8→ *\n     9→ * Usage:\n    10→ *   bun run release:patch              # Interactive release\n    11→ *   bun run release:minor              # Minor version bump\n    12→ *   bun run release:major              # Major version bump\n    13→ *   bun scripts/release.ts patch --yes # Headless (no prompts)\n    14→ *   bun scripts/release.ts minor --dry-run  # Validate only\n    15→ *\n    16→ * Flags:\n    17→ *   --yes, -y       Skip all interactive prompts (for agents/CI)\n    18→ *   --dry-run       Validate everything but don't make changes\n    19→ *   --skip-checks   Skip typecheck and lint during validation\n    20→ */\n    21→\n    22→import { existsSync } from \"node:fs\";\n    23→import { resolve } from \"node:path\";\n    24→\n    25→// ─── Argument parsing ────────────────────────────────────────────────\n    26→\n    27→const args = process.argv.slice(2);\n    28→const BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\n    29→const VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\n    30→type BumpType = (typeof VALID_BUMP_TYPES)[number];\n    31→\n    32→const YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\n    33→const DRY_RUN = args.includes(\"--dry-run\");\n    34→const SKIP_CHECKS = args.includes(\"--skip-checks\");\n    35→\n    36→if (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n    37→  console.error(\"Error: Invalid or missing bump type\");\n    38→  console.error(\"\");\n    39→  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n    40→  console.error(\"\");\n    41→  console.error(\"Flags:\");\n    42→  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n    43→  console.error(\"  --dry-run       Validate everything without making changes\");\n    44→  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n    45→  process.exit(1);\n    46→}\n    47→\n    48→const ROOT = resolve(process.cwd());\n    49→const CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\n    50→const PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n    51→\n    52→/** Files/dirs stripped from release/alpha after each merge from develop.\n    53→ *  Used by both the dry-run merge check and the actual merge step. */\n    54→const INTERNAL_FILES_TO_STRIP = [\n    55→  \"intermediates/\",\n    56→  \"external-docs/\",\n    57→  \"CLAUDE.md\",\n    58→  \"CONTRIBUTING.md\",\n    59→  \"standard-operating-procedures.md\",\n    60→  \"docs/\",\n    61→];\n    62→\n    63→// ─── Saved state for rollback ────────────────────────────────────────\n    64→\n    65→interface ReleaseState {\n    66→  developHead: string;\n    67→  releaseAlphaHead: string;\n    68→  startBranch: string;\n    69→  newVersion: string | null;\n    70→  developPushed: boolean;\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"774524ca-ef80-4770-b634-d06c9d7eeed4","uuid":"e237f318-6360-4b4f-bde1-51ce09f39d43","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/release.ts","content":"#!/usr/bin/env bun\n\n/**\n * Release automation script for Hankweave\n *\n * Two-phase release: validate everything first (dry-run), then execute.\n * Automatic rollback on failure. Headless-friendly.\n *\n * Usage:\n *   bun run release:patch              # Interactive release\n *   bun run release:minor              # Minor version bump\n *   bun run release:major              # Major version bump\n *   bun scripts/release.ts patch --yes # Headless (no prompts)\n *   bun scripts/release.ts minor --dry-run  # Validate only\n *\n * Flags:\n *   --yes, -y       Skip all interactive prompts (for agents/CI)\n *   --dry-run       Validate everything but don't make changes\n *   --skip-checks   Skip typecheck and lint during validation\n */\n\nimport { existsSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\n// ─── Argument parsing ────────────────────────────────────────────────\n\nconst args = process.argv.slice(2);\nconst BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\nconst VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\ntype BumpType = (typeof VALID_BUMP_TYPES)[number];\n\nconst YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\nconst DRY_RUN = args.includes(\"--dry-run\");\nconst SKIP_CHECKS = args.includes(\"--skip-checks\");\n\nif (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n  console.error(\"Error: Invalid or missing bump type\");\n  console.error(\"\");\n  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n  console.error(\"\");\n  console.error(\"Flags:\");\n  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n  console.error(\"  --dry-run       Validate everything without making changes\");\n  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n  process.exit(1);\n}\n\nconst ROOT = resolve(process.cwd());\nconst CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\nconst PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n\n/** Files/dirs stripped from release/alpha after each merge from develop.\n *  Used by both the dry-run merge check and the actual merge step. */\nconst INTERNAL_FILES_TO_STRIP = [\n  \"intermediates/\",\n  \"external-docs/\",\n  \"CLAUDE.md\",\n  \"CONTRIBUTING.md\",\n  \"standard-operating-procedures.md\",\n  \"docs/\",\n];\n\n// ─── Saved state for rollback ────────────────────────────────────────\n\ninterface ReleaseState {\n  developHead: string;\n  releaseAlphaHead: string;\n  startBranch: string;\n  newVersion: string | null;\n  developPushed: boolean;","numLines":70,"startLine":1,"totalLines":869}},"timestamp":"2026-03-05T13:31:14.303Z"}
