de, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"774524ca-ef80-4770-b634-d06c9d7eeed4","uuid":"5611bece-6808-49fa-8541-60c3ae6d735c","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/sync-public.ts","content":"// Scripts to remove from package.json for public release.\n// These reference files that are stripped (release.ts, sync-public.ts, etc.)\nconst STRIP_SCRIPTS = [\n  \"release:patch\",\n  \"release:minor\",\n  \"release:major\",\n];\n\nasync function transformPackageJson(packagePath: string): Promise<void> {\n  const content = await readFile(packagePath, \"utf-8\");\n  const pkg = JSON.parse(content);\n\n  pkg.name = \"hankweave\";\n  pkg.publishConfig = { access: \"public\" };\n  pkg.homepage = \"https://github.com/SouthBridgeAI/hankweave-runtime\";\n\n  // Remove monorepo-only fields that don't apply to the public repo\n  delete pkg.workspaces;\n\n  // Remove scripts that reference stripped internal files\n  if (pkg.scripts) {\n    for (const script of STRIP_SCRIPTS) {\n      delete pkg.scripts[script];\n    }\n  }\n\n  await writeFile(packagePath, JSON.stringify(pkg, null, 2) + \"\\n\");\n  console.log(\"✓ Transformed package.json:\");\n  console.log(\"    name: hankweave\");\n  console.log(\"    publishConfig.access: public\");\n  console.log(\n    \"    homepage: https://github.com/SouthBridgeAI/hankweave-runtime\",\n  );\n  console.log(`    removed scripts: ${STRIP_SCRIPTS.join(\", \")}`);\n}\n\n/**\n * Prepare snapshot directory from private repo\n */\nasync function prepareSnapshot(): Promise<void> {","numLines":40,"startLine":165,"totalLines":540}},"timestamp":"2026-03-05T13:31:27.159Z"}
