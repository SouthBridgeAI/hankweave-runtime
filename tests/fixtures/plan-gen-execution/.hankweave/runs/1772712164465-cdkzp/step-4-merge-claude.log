 tests/e2e/rollback-improved-1-e2e.test.ts && bun tests/unit/cleanup-after-tests.ts\",\n    45→    \"test:long\": \"LONG_TESTS=true bun test tests/long-running\",\n    46→    \"test:unit\": \"bun tests/unit/cleanup-after-tests.ts && bun test tests/unit && bun tests/unit/cleanup-after-tests.ts\",\n    47→    \"test:integration\": \"bun tests/integration\",\n    48→    \"test:e2e:check\": \"bun tests/utils/check-test-ready.ts\",\n    49→    \"test:e2e:init\": \"bun scripts/e2e/init.ts normal\",\n    50→    \"test:e2e:init:npx\": \"bun scripts/e2e/init.ts npx\",\n    51→    \"test:e2e:init:bunx\": \"bun scripts/e2e/init.ts bunx\",\n    52→    \"test:e2e:init:binary\": \"bun scripts/e2e/init.ts binary\",\n    53→    \"test:e2e:sanity\": \"bun tests/utils/sanity-check.ts\",\n    54→    \"test:e2e:cleanup\": \"./tests/utils/cleanup-test.sh\",\n    55→    \"pre-test\": \"bun run test:e2e:check && bun run pre-test:cleanup\",\n    56→    \"pre-test:cleanup\": \"rm -rf tests/test-area && mkdir -p tests/test-area && rm -rf tests/test-results && mkdir -p tests/test-results && echo '✅ Test area and results cleaned'\",\n    57→    \"cleanup\": \"echo 'Error: --cleanup requires --config' && exit 1\",\n    58→    \"cleanup:example\": \"bun server/index.ts --cleanup --config=hank.json\",\n    59→    \"cleanup:force\": \"bun server/index.ts --cleanup --config=hank.json -y\",\n    60→    \"test:cross-runtime:bun\": \"bun scripts/run-cross-runtime-tests.ts bun\",\n    61→    \"test:cross-runtime:node\": \"bun scripts/run-cross-runtime-tests.ts node\",\n    62→    \"test:cross-runtime:deno\": \"bun scripts/run-cross-runtime-tests.ts deno\",\n    63→    \"test:cross-runtime:all\": \"bun run test:cross-runtime:bun && bun run test:cross-runtime:node && bun run test:cross-runtime:deno\"\n    64→  },\n    65→  \"devDependencies\": {\n    66→    \"@biomejs/biome\": \"2.0.6\",\n    67→    \"@types/bun\": \"latest\",\n    68→    \"@types/lodash.merge\": \"^4.6.9\",\n    69→    \"ajv\": \"^8.17.