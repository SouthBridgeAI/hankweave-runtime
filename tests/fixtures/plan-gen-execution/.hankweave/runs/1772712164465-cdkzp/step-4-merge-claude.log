         git clone https://x-access-token:${{ secrets.PUBLIC_REPO_PAT }}@github.com/SouthBridgeAI/hankweave-runtime.git public\n          cd public\n          if git ls-remote --heads origin release/alpha | grep -q release/alpha; then\n            git checkout release/alpha\n            echo \"✓ Checked out existing release/alpha branch\"\n          else\n            git checkout --orphan release/alpha\n            git rm -rf . 2>/dev/null || true\n            echo \"✓ Created new release/alpha branch\"\n          fi\n\n      - name: Get last public version\n        id: last-public\n        run: |\n          cd public\n          LAST_VERSION=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo \"\")\n          echo \"version=${LAST_VERSION}\" >> $GITHUB_OUTPUT\n          if [ -n \"$LAST_VERSION\" ]; then\n            echo \"✓ Last public version: v${LAST_VERSION}\"\n          else\n            echo \"ℹ No previous public version found (first sync)\"\n          fi\n\n      - name: Extract changelog\n        run: |\n          SINCE_FLAG=\"\"\n          if [ -n \"${{ steps.last-public.outputs.version }}\" ]; then\n            SINCE_FLAG=\"--since ${{ steps.last-public.outputs.version }}\"\n          fi\n          bun private/scripts/sync-public.ts extract-changelog --version ${{ inputs.version }} $SINCE_FLAG\n\n      - name: Prepare snapshot\n        if: \"!inputs.initial_sync\"\n        run: |\n          SINCE_FLAG=\"\"\n          if [ -n \"${{ steps.last-public.outputs.version }}\" ]; then\n            SINCE_FLAG=\"--since ${{ steps.last-public.outputs.version }}\"\n          fi\n          bun private/scripts/sync-public.ts prepare-snapshot --version ${{ inputs.version }} $SINCE_FLAG\n\n      - name: Initial sync (full history)\n        if: inputs.initial_sync\n        run: bun private/scripts/sync-public.ts initial-sync --version ${{ inputs.version }}\n\n      - name: Snapshot sync\n        if: \"!inputs.initial_sync\"\n        run: bun private/scripts/sync-public.ts snapshot-sync --version ${{ inputs.version }}\n\n      - name: Create tag\n        run: bun private/scripts/sync-public.ts create-tag --version ${{ inputs.version }} ${{ inputs.initial_sync && '--force' || '' }}\n\n      - name: Push to public repo\n        run: bun private/scripts/sync-public.ts push --version ${{ inputs.version }} ${{ inputs.initial_sync && '--force' || '' }}\n\n      - name: Summary\n        run: |\n          echo \"\"\n          echo \"╔════════════════════════════════════════════════════════════╗\"\n          echo \"║                    Sync Complete! 🎉                        ║\"\n          echo \"╚════════════════════════════════════════════════════════════╝\"\n          echo \"\"\n          echo \"Version: v${{ inputs.version }}\"\n          echo \"Sync type: ${{ inputs.initial_sync && 'Initial (full history)' || 'Snapshot' }}\"\n          echo \"\"\n          echo \"What happens next:\"\n          echo \"  1. Public repo's release.yml will trigger on the tag push\"\n          echo \"  2. It will publish 'hankweave' to npm\"\n          echo \"  3. It will build binaries and create a GitHub release\"\n          echo \"\"\n          echo \"Public repo: https://github.com/SouthBridgeAI/hankweave-runtime\"\n          echo \"Public release: https://github.com/SouthBridgeAI/hankweave-runtime/releases/tag/v${{ inputs.version }}\"\n","numLines":126,"startLine":1,"totalLines":126}},"timestamp":"2026-03-05T12:29:38.014Z"}
