{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019EndJtYNJHgfZo3NrrQnFq","type":"tool_result","content":"     1→{\n     2→  \"name\": \"@southbridgeai/hankweave\",\n     3→  \"version\": \"0.5.6\",\n     4→  \"description\": \"Orchestration runtime for antibrittle agentic workflows\",\n     5→  \"author\": {\n     6→    \"name\": \"Southbridge AI\",\n     7→    \"url\": \"https://southbridge.ai\"\n     8→  },\n     9→  \"keywords\": [\n    10→    \"hankweave\"\n    11→  ],\n    12→  \"homepage\": \"https://www.southbridge.ai/blog/terms-of-service\",\n    13→  \"type\": \"module\",\n    14→  \"publishConfig\": {\n    15→    \"access\": \"restricted\"\n    16→  },\n    17→  \"bin\": {\n    18→    \"hankweave\": \"dist/index.js\"\n    19→  },\n    20→  \"main\": \"./dist/index.js\",\n    21→  \"files\": [\n    22→    \"dist\",\n    23→    \"shims\",\n    24→    \"schemas\"\n    25→  ],\n    26→  \"engines\": {\n    27→    \"node\": \">=20.0.0\"\n    28→  },\n    29→  \"scripts\": {\n    30→    \"generate-schemas\": \"bun scripts/generate-schemas.ts\",\n    31→    \"build\": \"bun run generate-schemas && bun scripts/build.ts\",\n    32→    \"prepublishOnly\": \"bun run build\",\n    33→    \"typecheck\": \"bun run tsc --noEmit && echo 'Type check passed ✅'\",\n    34→    \"tc\": \"bun typecheck\",\n    35→    \"lint\": \"biome check .\",\n    36→    \"lint:fix\": \"biome check --write .\",\n    37→    \"format\": \"biome format --write .\",\n    38→    \"release:patch\": \"bun scripts/release.ts patch\",\n    39→    \"release:minor\": \"bun scripts/release.ts minor\",\n    40→    \"release:major\": \"bun scripts/release.ts major\",\n    41→    \"fetch-models\": \"bun scripts/fetch-models-dev.ts\",\n    42→    \"server\": \"bun server/index.ts\",\n    43→    \"server:headless\": \"bun server/index.ts --headless\",\n    44→    \"test\": \"bun tests/utils/check-test-ready.ts && bun test tests/unit tests/integration tests/e2e/happy-path-e2e.test.ts