clone https://x-access-token:${{ secrets.PUBLIC_REPO_PAT }}@github.com/SouthBridgeAI/hankweave-runtime.git public\n    56→          cd public\n    57→          if git ls-remote --heads origin release/alpha | grep -q release/alpha; then\n    58→            git checkout release/alpha\n    59→            echo \"✓ Checked out existing release/alpha branch\"\n    60→          else\n    61→            git checkout --orphan release/alpha\n    62→            git rm -rf . 2>/dev/null || true\n    63→            echo \"✓ Created new release/alpha branch\"\n    64→          fi\n    65→\n    66→      - name: Get last public version\n    67→        id: last-public\n    68→        run: |\n    69→          cd public\n    70→          LAST_VERSION=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo \"\")\n    71→          echo \"version=${LAST_VERSION}\" >> $GITHUB_OUTPUT\n    72→          if [ -n \"$LAST_VERSION\" ]; then\n    73→            echo \"✓ Last public version: v${LAST_VERSION}\"\n    74→          else\n    75→            echo \"ℹ No previous public version found (first sync)\"\n    76→          fi\n    77→\n    78→      - name: Extract changelog\n    79→        run: |\n    80→          SINCE_FLAG=\"\"\n    81→          if [ -n \"${{ steps.last-public.outputs.version }}\" ]; then\n    82→            SINCE_FLAG=\"--since ${{ steps.last-public.outputs.version }}\"\n    83→          fi\n    84→          bun private/scripts/sync-public.ts extract-changelog --version ${{ inputs.version }} $SINCE_FLAG\n    85→\n    86→      - name: Prepare snapshot\n    87→        if: \"!inputs.initial_sync\"\n    88→        run: |\n    89→          SINCE_FLAG=\"\"\n    90→          if [ -n \"${{ steps.last-public.outputs.version }}\" ]; then\n    91→            SINCE_FLAG=\"--since ${{ steps.last-public.outputs.version }}\"\n    92→          fi\n    93→          bun private/scripts/sync-public.ts prepare-snapshot --version ${{ inputs.version }} $SINCE_FLAG\n    94→\n    95→   