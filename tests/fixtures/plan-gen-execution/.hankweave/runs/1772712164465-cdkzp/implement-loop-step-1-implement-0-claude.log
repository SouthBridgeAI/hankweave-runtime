{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016GcLNxbj6n8uN4491yby9V","type":"tool_result","content":"The file /Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/release.ts has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"a10b5aa3-09ea-414c-b37c-8b03ba239eca","uuid":"b3d80f0d-238d-4ce8-a28d-f3311a7f18ec","tool_use_result":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/release.ts","oldString":"    // Check if schemas directory changed (would indicate schemas need regenerating)\n    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n      silent: true,\n    });","newString":"    // Check if schemas directory changed (would indicate schemas need regenerating)\n    const schemaChanges = await exec(\"git diff --name-only schemas/ docs/public/schemas/\", {\n      silent: true,\n    });","originalFile":"#!/usr/bin/env bun\n\n/**\n * Release automation script for Hankweave\n *\n * Two-phase release: validate everything first (dry-run), then execute.\n * Automatic rollback on failure. Headless-friendly.\n *\n * Usage:\n *   bun run release:patch              # Interactive release\n *   bun run release:minor              # Minor version bump\n *   bun run release:major              # Major version bump\n *   bun scripts/release.ts patch --yes # Headless (no prompts)\n *   bun scripts/release.ts minor --dry-run  # Validate only\n *\n * Flags:\n *   --yes, -y       Skip all interactive prompts (for agents/CI)\n *   --dry-run       Validate everything but don't make changes\n *   --skip-checks   Skip typecheck and lint during validation\n */\n\nimport { existsSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\n// ─── Argument parsing ────────────────────────────────────────────────\n\nconst args = process.argv.slice(2);\nconst BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\nconst VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\ntype BumpType = (typeof VALID_BUMP_TYPES)[number];\n\nconst YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\nconst DRY_RUN = args.includes(\"--dry-run\");\nconst SKIP_CHECKS = args.includes(\"--skip-checks\");\n\nif (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n  console.error(\"Error: Invalid or missing bump type\");\n  console.error(\"\");\n  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n  console.error(\"\");\n  console.error(\"Flags:\");\n  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n  console.error(\"  --dry-run       Validate everything without making changes\");\n  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n  process.exit(1);\n}\n\nconst ROOT = resolve(process.cwd());\nconst CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\nconst PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n\n/** Files/dirs stripped from release/alpha after each merge from develop.\n *  Used by both the dry-run merge check and the actual merge step. */\nconst INTERNAL_FILES_TO_STRIP = [\n  \"intermediates/\",\n  \"external-docs/\",\n  \"CLAUDE.md\",\n  \"CONTRIBUTING.md\",\n  \"standard-operating-procedures.md\",\n  \"docs/\",\n];\n\n// ─── Saved state for rollback ────────────────────────────────────────\n\ninterface ReleaseState {\n  developHead: string;\n  releaseAlphaHead: string;\n  startBranch: string;\n  newVersion: string | null;\n  developPushed: boolean;\n  releaseAlphaPushed: boolean;\n  tagPushed: boolean;\n  tagName: string | null;\n}\n\nconst state: ReleaseState = {\n  developHead: \"\",\n  releaseAlphaHead: \"\",\n  startBranch: \"\",\n  newVersion: null,\n  developPushed: false,\n  releaseAlphaPushed: false,\n  tagPushed: false,\n  tagName: null,\n};\n\n// ─── Helpers ─────────────────────────────────────────────────────────\n\nasync function exec(\n  command: string,\n  options: { silent?: boolean; allowFailure?: boolean } = {},\n): Promise<string> {\n  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    stdout: \"pipe\",\n    stderr: options.silent ? \"pipe\" : \"inherit\",\n  });\n\n  const exitCode = await proc.exited;\n  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.allowFailure) {\n    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n  }\n\n  return output.trim();\n}\n\nfunction log(msg: string) {\n  console.log(msg);\n}\n\nfunction logStep(msg: string) {\n  console.log(`\\n  ${msg}`);\n}\n\nfunction logOk(msg: string) {\n  console.log(`  ✓ ${msg}`);\n}\n\nfunction logWarn(msg: string) {\n  console.log(`  ! ${msg}`);\n}\n\nfunction logErr(msg: string) {\n  console.error(`  ✗ ${msg}`);\n}\n\n/**\n * Prompt the user for confirmation. In --yes mode, auto-confirms.\n * Returns true if confirmed, false if cancelled.\n */\nasync function confirm(message: string): Promise<boolean> {\n  if (YES_MODE) {\n    log(`  ${message} (auto-confirmed: --yes)`);\n    return true;\n  }\n\n  process.stdout.write(`  ${message} [y/N] `);\n\n  // Read a single line from stdin\n  const reader = Bun.stdin.stream().getReader();\n  const { value } = await reader.read();\n  reader.releaseLock();\n\n  const answer = value\n    ? new TextDecoder().decode(value).trim().toLowerCase()\n    : \"\";\n  return answer === \"y\" || answer === \"yes\";\n}\n\n/**\n * Compute what the new version would be without modifying package.json\n */\nfunction computeNewVersion(currentVersion: string, bumpType: string): string {\n  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n  switch (bumpType) {\n    case \"major\":\n      return `${major + 1}.0.0`;\n    case \"minor\":\n      return `${major}.${minor + 1}.0`;\n    case \"patch\":\n      return `${major}.${minor}.${patch + 1}`;\n    default:\n      throw new Error(`Invalid bump type: ${bumpType}`);\n  }\n}\n\n// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n\ninterface ValidationResult {\n  currentVersion: string;\n  newVersion: string;\n  changelogEntryCount: number;\n  changelogPreview: string[];\n  mergeWouldSucceed: boolean;\n  schemasWouldGenerate: boolean;\n  typecheckPassed: boolean | null; // null = skipped\n  lintPassed: boolean | null;\n}\n\nasync function validate(): Promise<ValidationResult> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 1: Validation                                     ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const result: ValidationResult = {\n    currentVersion: \"\",\n    newVersion: \"\",\n    changelogEntryCount: 0,\n    changelogPreview: [],\n    mergeWouldSucceed: false,\n    schemasWouldGenerate: false,\n    typecheckPassed: null,\n    lintPassed: null,\n  };\n\n  // 1. Check branch\n  logStep(\"Checking branch...\");\n  const currentBranch = await exec(\"git branch --show-current\", {\n    silent: true,\n  });\n  if (currentBranch !== \"develop\") {\n    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n    process.exit(1);\n  }\n  state.startBranch = currentBranch;\n  logOk(`On develop branch`);\n\n  // 2. Check clean working directory\n  logStep(\"Checking working directory...\");\n  const status = await exec(\"git status --porcelain\", { silent: true });\n  if (status) {\n    logErr(\"Uncommitted changes detected:\");\n    console.error(status);\n    process.exit(1);\n  }\n  logOk(\"Working directory is clean\");\n\n  // 3. Check remote sync\n  logStep(\"Checking remote sync...\");\n  await exec(\"git fetch origin\", { silent: true });\n\n  for (const branch of [\"develop\", \"release/alpha\"]) {\n    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n      silent: true,\n    });\n\n    if (localCommit !== remoteCommit) {\n      const ahead = parseInt(\n        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n          silent: true,\n        }),\n      );\n      const behind = parseInt(\n        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n          silent: true,\n        }),\n      );\n\n      if (behind > 0 && ahead > 0) {\n        logErr(\n          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n        );\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (behind > 0) {\n        logErr(`${branch} is ${behind} commit(s) behind remote`);\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (ahead > 0) {\n        logWarn(\n          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n        );\n      }\n    } else {\n      logOk(`${branch} is in sync with origin/${branch}`);\n    }\n  }\n\n  // Save pre-release state for rollback\n  state.developHead = await exec(\"git rev-parse develop\", { silent: true });\n  state.releaseAlphaHead = await exec(\"git rev-parse release/alpha\", {\n    silent: true,\n  });\n\n  // 4. Compute new version\n  logStep(\"Computing version...\");\n  const packageJson = await Bun.file(PACKAGE_JSON_PATH).json();\n  result.currentVersion = packageJson.version;\n  result.newVersion = computeNewVersion(\n    result.currentVersion,\n    BUMP_TYPE as string,\n  );\n  state.newVersion = result.newVersion;\n  logOk(`${result.currentVersion} → ${result.newVersion} (${BUMP_TYPE})`);\n\n  // 5. Check tag doesn't exist\n  logStep(\"Checking tag availability...\");\n  const tag = `v${result.newVersion}`;\n  const remoteTag = await exec(`git ls-remote --tags origin ${tag}`, {\n    silent: true,\n  });\n  if (remoteTag) {\n    logErr(\n      `Tag ${tag} already exists on remote. The version may already be released.`,\n    );\n    process.exit(1);\n  }\n  // Also check locally\n  const localTag = await exec(`git tag -l ${tag}`, { silent: true });\n  if (localTag) {\n    logWarn(\n      `Tag ${tag} exists locally (stale). Will be deleted before re-creation.`,\n    );\n  }\n  logOk(`Tag ${tag} is available`);\n\n  // 6. Validate changelog\n  logStep(\"Validating CHANGELOG.md...\");\n  if (!existsSync(CHANGELOG_PATH)) {\n    logErr(\"CHANGELOG.md not found\");\n    process.exit(1);\n  }\n\n  const changelog = await Bun.file(CHANGELOG_PATH).text();\n  if (!changelog.includes(\"## [Unreleased]\")) {\n    logErr(\"No [Unreleased] section found in CHANGELOG.md\");\n    process.exit(1);\n  }\n\n  const unreleasedMatch = changelog.match(\n    /## \\[Unreleased\\]([\\s\\S]*?)(?=\\n## |$)/,\n  );\n  if (!unreleasedMatch) {\n    logErr(\"Could not parse [Unreleased] section\");\n    process.exit(1);\n  }\n\n  const bulletPoints = unreleasedMatch[1].match(/^- .+\\S/gm) || [];\n  result.changelogEntryCount = bulletPoints.length;\n  result.changelogPreview = bulletPoints.slice(0, 5);\n\n  if (result.changelogEntryCount === 0) {\n    logWarn(\"CHANGELOG [Unreleased] section has no entries\");\n    logWarn(\"The release will have empty release notes\");\n    if (!YES_MODE) {\n      const proceed = await confirm(\"Continue with empty changelog?\");\n      if (!proceed) {\n        log(\"\\nRelease cancelled. Add entries to [Unreleased] and try again.\");\n        process.exit(0);\n      }\n    }\n  } else {\n    logOk(\n      `CHANGELOG has ${result.changelogEntryCount} entries in [Unreleased]:`,\n    );\n    for (const entry of result.changelogPreview) {\n      console.log(`      ${entry}`);\n    }\n    if (result.changelogEntryCount > 5) {\n      console.log(`      ... and ${result.changelogEntryCount - 5} more`);\n    }\n  }\n\n  // 7. Test merge feasibility\n  logStep(\"Testing merge feasibility (develop → release/alpha)...\");\n  try {\n    // Use merge-tree to check for conflicts without touching the working tree\n    // merge-tree returns 0 even with conflicts, but outputs conflict markers\n    // Instead, do a merge --no-commit --no-ff and then abort\n    await exec(\"git checkout release/alpha\", { silent: true });\n    const mergeResult = await exec(\n      \"git merge --no-commit --no-ff develop 2>&1\",\n      {\n        silent: true,\n        allowFailure: true,\n      },\n    );\n    // Check for conflicts — any unmerged entry in porcelain status.\n    // Codes: UU (both modified), AA (both added), DD (both deleted),\n    // DU/UD (modify/delete — e.g. file stripped on release but modified on develop)\n    const mergeStatus = await exec(\"git status --porcelain\", { silent: true });\n    const conflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) /m;\n    const hasConflicts = conflictPattern.test(mergeStatus);\n\n    // For modify/delete conflicts, check if ALL conflicting files are in the\n    // strip list — if so, the merge step will auto-resolve them.\n    let conflictsAreStrippable = false;\n    if (hasConflicts) {\n      const modifyDeletePattern = /^(DU|UD) (.+)$/gm;\n      const allConflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) (.+)$/gm;\n\n      const modifyDeleteFiles = [...mergeStatus.matchAll(modifyDeletePattern)].map((m) => m[2].trim());\n      const allConflictFiles = [...mergeStatus.matchAll(allConflictPattern)].map((m) => m[2].trim());\n\n      if (\n        allConflictFiles.length > 0 &&\n        allConflictFiles.length === modifyDeleteFiles.length &&\n        modifyDeleteFiles.every((f) =>\n          INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n        )\n      ) {\n        conflictsAreStrippable = true;\n      }\n    }\n\n    // Abort the merge\n    await exec(\"git merge --abort 2>/dev/null || git reset --hard HEAD\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop\", { silent: true });\n\n    if (hasConflicts && !conflictsAreStrippable) {\n      logErr(\"Merge would have conflicts. Resolve before releasing:\");\n      logErr(\"  git checkout release/alpha\");\n      logErr(\"  git merge develop\");\n      logErr(\"  # resolve conflicts, commit, then:\");\n      logErr(\"  git checkout develop\");\n      process.exit(1);\n    }\n    result.mergeWouldSucceed = true;\n    if (conflictsAreStrippable) {\n      logOk(\"Merge has modify/delete conflicts on stripped files (will auto-resolve)\");\n    } else {\n      logOk(\"Merge would succeed cleanly\");\n    }\n  } catch (error) {\n    // Make sure we're back on develop\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    logErr(`Merge test failed: ${(error as Error).message}`);\n    process.exit(1);\n  }\n\n  // 8. Test schema generation\n  logStep(\"Testing schema generation...\");\n  try {\n    await exec(\"bun run generate-schemas\", { silent: true });\n    // Check if schemas directory changed (would indicate schemas need regenerating)\n    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n      silent: true,\n    });\n    if (schemaChanges) {\n      logWarn(\n        \"Schema generation produced changes (will be included in release commit)\",\n      );\n    }\n    // Reset any changes from test generation\n    await exec(\"git checkout -- schemas/ 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    result.schemasWouldGenerate = true;\n    logOk(\"Schema generation works\");\n  } catch {\n    logErr(\"Schema generation failed. Fix before releasing.\");\n    process.exit(1);\n  }\n\n  // 9. Optional: typecheck + lint\n  if (!SKIP_CHECKS) {\n    logStep(\"Running typecheck...\");\n    try {\n      await exec(\"bun run tc\", { silent: true });\n      result.typecheckPassed = true;\n      logOk(\"Typecheck passed\");\n    } catch {\n      logErr(\"Typecheck failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n\n    logStep(\"Running lint...\");\n    try {\n      await exec(\"bun run lint\", { silent: true });\n      result.lintPassed = true;\n      logOk(\"Lint passed\");\n    } catch {\n      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n  } else {\n    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n    result.typecheckPassed = null;\n    result.lintPassed = null;\n  }\n\n  return result;\n}\n\n// ─── PHASE 2: Execute ────────────────────────────────────────────────\n\nasync function execute(validation: ValidationResult): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 2: Execute                                        ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const { newVersion } = validation;\n  const tag = `v${newVersion}`;\n  state.tagName = tag;\n\n  try {\n    // ── Step 1: Local changes on develop ──────────────────────────\n\n    logStep(`Bumping version to ${newVersion}...`);\n    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n    logOk(`package.json updated to ${newVersion}`);\n\n    logStep(\"Stamping CHANGELOG...\");\n    const changelog = await Bun.file(CHANGELOG_PATH).text();\n    const date = new Date().toISOString().split(\"T\")[0];\n    const stampedChangelog = changelog.replace(\n      \"## [Unreleased]\",\n      `## [${newVersion}] - ${date}`,\n    );\n    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n\n    logStep(\"Regenerating schemas...\");\n    await exec(\"bun run generate-schemas\");\n    logOk(\"Schemas regenerated\");\n\n    logStep(\"Creating release commit...\");\n    await exec(\"git add package.json CHANGELOG.md schemas/\");\n    await exec(`git commit -m \"Release v${newVersion}\"`);\n    logOk(`Committed \"Release v${newVersion}\" on develop`);\n\n    logStep(\"Adding [Unreleased] section...\");\n    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n    const lines = updatedChangelog.split(\"\\n\");\n    const firstHeadingIndex = lines.findIndex((line) =>\n      line.startsWith(\"## [\"),\n    );\n    if (firstHeadingIndex !== -1) {\n      lines.splice(\n        firstHeadingIndex,\n        0,\n        ...[\n          \"## [Unreleased]\",\n          \"\",\n          \"### Added\",\n          \"- \",\n          \"\",\n          \"### Changed\",\n          \"- \",\n          \"\",\n          \"### Fixed\",\n          \"- \",\n          \"\",\n        ],\n      );\n      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n    }\n    await exec(\"git add CHANGELOG.md\");\n    await exec(\n      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n    );\n    logOk(\"Committed [Unreleased] template\");\n\n    // ── Step 2: Push develop ──────────────────────────────────────\n\n    logStep(\"Pushing develop to origin...\");\n    await exec(\"git push origin develop\");\n    state.developPushed = true;\n    logOk(\"Pushed develop\");\n\n    // ── Step 3: Merge to release/alpha ────────────────────────────\n\n    logStep(\"Merging develop → release/alpha...\");\n    await exec(\"git checkout release/alpha\");\n\n    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n      allowFailure: true,\n      silent: true,\n    });\n\n    // Handle modify/delete conflicts on files we're about to strip anyway.\n    // This happens when a file is modified on develop but was deleted from\n    // release/alpha during a previous release's strip step.\n    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n\n      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n      );\n\n      if (!allStrippable) {\n        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n        throw new Error(\n          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n        );\n      }\n\n      for (const file of conflictFiles) {\n        await exec(`git rm -f \"${file}\"`, { silent: true });\n      }\n      await exec('git -c core.editor=true merge --continue', { silent: true });\n      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n    } else {\n      logOk(\"Merged develop into release/alpha\");\n    }\n\n    // Strip internal files\n    logStep(\"Stripping internal files...\");\n    const filesToRemove: string[] = [];\n    for (const file of INTERNAL_FILES_TO_STRIP) {\n      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n        silent: true,\n      });\n      if (exists) filesToRemove.push(file);\n    }\n    if (filesToRemove.length > 0) {\n      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n      await exec(\n        'git commit -m \"chore: strip intermediates and planning files\"',\n      );\n      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n    } else {\n      logOk(\"No internal files to strip\");\n    }\n\n    // ── Step 4: Create tag ────────────────────────────────────────\n\n    logStep(`Creating tag ${tag}...`);\n    // Delete stale local tag if exists\n    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n    if (staleTag) {\n      await exec(`git tag -d ${tag}`);\n    }\n    await exec(`git tag ${tag}`);\n    logOk(`Created tag ${tag} on release/alpha`);\n\n    // ── Step 5: Push release/alpha + tag ──────────────────────────\n\n    logStep(\"Pushing release/alpha to origin...\");\n    await exec(\"git push origin release/alpha\");\n    state.releaseAlphaPushed = true;\n    logOk(\"Pushed release/alpha\");\n\n    logStep(`Pushing tag ${tag} to origin...`);\n    await exec(`git push origin ${tag}`);\n    state.tagPushed = true;\n    logOk(`Pushed tag ${tag} (this triggers CI)`);\n\n    // ── Step 6: Return to develop ─────────────────────────────────\n\n    await exec(\"git checkout develop\");\n    logOk(\"Back on develop branch\");\n  } catch (error) {\n    logErr(`Release failed: ${(error as Error).message}`);\n\n    // Attempt automatic rollback\n    await rollback();\n    throw error;\n  }\n}\n\n// ─── Rollback ────────────────────────────────────────────────────────\n\nasync function rollback(): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Automatic Rollback                                      ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const actions: string[] = [];\n\n  try {\n    // Make sure we can get back to a branch\n    const currentBranch = await exec(\"git branch --show-current\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // If we're mid-merge, abort it\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // Delete local tag if created\n    if (state.tagName) {\n      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n        silent: true,\n      });\n      if (tagExists) {\n        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n        actions.push(`Deleted local tag ${state.tagName}`);\n      }\n    }\n\n    // Reset release/alpha to pre-release state\n    if (state.releaseAlphaHead) {\n      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n        allowFailure: true,\n      });\n      actions.push(\n        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n      );\n    }\n\n    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n    if (state.developHead) {\n      await exec(\"git checkout develop\", { allowFailure: true });\n      if (!state.developPushed) {\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n      } else {\n        // develop was pushed — we need to force-push to undo\n        logWarn(\"develop was already pushed to remote. Local reset only.\");\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(\n          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n        );\n        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n        actions.push(`  git push origin develop --force-with-lease`);\n      }\n    } else {\n      // At minimum get back to develop\n      await exec(\"git checkout develop 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n    }\n\n    if (state.releaseAlphaPushed) {\n      actions.push(\n        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n      );\n      actions.push(`  git push origin release/alpha --force-with-lease`);\n    }\n\n    if (state.tagPushed) {\n      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n      actions.push(`  git push origin --delete ${state.tagName}`);\n    }\n\n    log(\"\\n  Rollback actions:\");\n    for (const action of actions) {\n      if (action.startsWith(\"WARNING\")) {\n        logWarn(action);\n      } else {\n        logOk(action);\n      }\n    }\n\n    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n    } else {\n      log(\n        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n      );\n    }\n  } catch (rollbackError) {\n    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n    log(\"\\n  Manual recovery steps:\");\n    log(`    git checkout develop`);\n    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n    log(`    git checkout release/alpha`);\n    log(\n      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n    );\n    if (state.tagName) {\n      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n    }\n    log(`    git checkout develop`);\n  }\n}\n\n// ─── Main ────────────────────────────────────────────────────────────\n\nasync function main(): Promise<void> {\n  log(\"╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Hankweave Release                                       ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(\"\");\n  log(`  Bump type:    ${BUMP_TYPE}`);\n  log(\n    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n  );\n  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n\n  // Phase 1: Validate\n  const validation = await validate();\n\n  // Print plan\n  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n  log(\"│  Release Plan                                              │\");\n  log(\"├────────────────────────────────────────────────────────────┤\");\n  log(\n    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n  );\n  log(`│  Tag:         v${validation.newVersion}`);\n  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n  log(\n    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`,\n  );\n  log(`│  Schemas:     ${validation.schemasWouldGenerate ? \"ok\" : \"failed!\"}`);\n  if (validation.typecheckPassed !== null) {\n    log(`│  Typecheck:   ${validation.typecheckPassed ? \"passed\" : \"failed!\"}`);\n  }\n  if (validation.lintPassed !== null) {\n    log(`│  Lint:        ${validation.lintPassed ? \"passed\" : \"failed!\"}`);\n  }\n  log(\"│                                                            │\");\n  log(\"│  Steps:                                                    │\");\n  log(\"│    1. Bump version + stamp changelog + commit on develop   │\");\n  log(\"│    2. Add [Unreleased] template + commit                   │\");\n  log(\"│    3. Push develop                                         │\");\n  log(\"│    4. Merge develop → release/alpha, strip internal files  │\");\n  log(\"│    5. Create tag, push release/alpha + tag                 │\");\n  log(\"│    6. Return to develop                                    │\");\n  log(\"│                                                            │\");\n  log(\"│  Tag push will trigger CI: tests → npm → binaries → GH    │\");\n  log(\"└────────────────────────────────────────────────────────────┘\");\n\n  if (DRY_RUN) {\n    log(\"\\n  ✓ Dry-run complete. All validations passed.\");\n    log(\"  Run without --dry-run to execute the release.\");\n    process.exit(0);\n  }\n\n  // Confirm before proceeding\n  if (!YES_MODE) {\n    const proceed = await confirm(\"Proceed with release?\");\n    if (!proceed) {\n      log(\"\\nRelease cancelled.\");\n      process.exit(0);\n    }\n  } else {\n    log(\"\\n  Proceeding with release (--yes mode)...\");\n  }\n\n  // Phase 2: Execute\n  await execute(validation);\n\n  // Success!\n  const repoUrl = await exec(\"git remote get-url origin\", { silent: true });\n  const cleanUrl = repoUrl\n    .replace(/\\.git$/, \"\")\n    .replace(/.*github\\.com[:/]/, \"\");\n\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Release complete                                         ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(`\\n  Version: v${validation.newVersion}`);\n  log(\"\");\n  log(\"  What happened:\");\n  log(\"    ✓ Release commits created on develop\");\n  log(\"    ✓ develop pushed to origin\");\n  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n  log(\"\");\n  log(\"  CI will now:\");\n  log(\"    1. Run tests\");\n  log(\n    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n  );\n  log(\"    3. Build platform executables\");\n  log(\"    4. Create GitHub release\");\n  log(\"\");\n  log(`  Track: https://github.com/${cleanUrl}/actions`);\n  log(\"\");\n  log(\"  Next (when CI passes):\");\n  log(\n    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n  );\n}\n\nmain().catch((error) => {\n  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n  process.exit(1);\n});\n","structuredPatch":[{"oldStart":425,"oldLines":7,"newStart":425,"newLines":7,"lines":["   try {","     await exec(\"bun run generate-schemas\", { silent: true });","     // Check if schemas directory changed (would indicate schemas need regenerating)","-    const schemaChanges = await exec(\"git diff --name-only schemas/\", {","+    const schemaChanges = await exec(\"git diff --name-only schemas/ docs/public/schemas/\", {","       silent: true,","     });","     if (schemaChanges) {"]}],"userModified":false,"replaceAll":false},"timestamp":"2026-03-05T13:18:19.278Z"}
