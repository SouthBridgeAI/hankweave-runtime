xclude\": [\n    \"node_modules\",\n    \".logs/**/*\",\n    \"intermediates/**/*\",\n    \"learning/**/*\",\n    \"tests/test-area/**/*\"\n  ]\n}\n","numLines":25,"startLine":1,"totalLines":25}},"timestamp":"2026-03-05T12:43:14.428Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KP74nB8MTpkRsZPbiwvTq5","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→\n     3→/**\n     4→ * Release automation script for Hankweave\n     5→ *\n     6→ * Two-phase release: validate everything first (dry-run), then execute.\n     7→ * Automatic rollback on failure. Headless-friendly.\n     8→ *\n     9→ * Usage:\n    10→ *   bun run release:patch              # Interactive release\n    11→ *   bun run release:minor              # Minor version bump\n    12→ *   bun run release:major              # Major version bump\n    13→ *   bun scripts/release.ts patch --yes # Headless (no prompts)\n    14→ *   bun scripts/release.ts minor --dry-run  # Validate only\n    15→ *\n    16→ * Flags:\n    17→ *   --yes, -y       Skip all interactive prompts (for agents/CI)\n    18→ *   --dry-run       Validate everything but don't make changes\n    19→ *   --skip-checks   Skip typecheck and lint during validation\n    20→ */\n    21→\n    22→import { existsSync } from \"node:fs\";\n    23→import { resolve } from \"node:path\";\n    24→\n    25→// ─── Argument parsing ────────────────────────────────────────────────\n    26→\n    27→const args = process.argv.slice(2);\n    28→const BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\n    29→const VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\n    30→type BumpType = (typeof VALID_BUMP_TYPES)[number];\n    31→\n    32→const YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\n    33→const DRY_RUN = args.includes(\"--dry-run\");\n    34→const SKIP_CHECKS = args.includes(\"--skip-checks\");\n    35→\n    36→if (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n    37→  console.error(\"Error: Invalid or missing bump type\");\n    38→  console.error(\"\");\n    39→  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n    40→  console.error(\"\");\n    41→  console.error(\"Flags:\");\n    42→  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n    43→  console.error(\"  --dry-run       Validate everything without making changes\");\n    44→  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n    45→  process.exit(1);\n    46→}\n    47→\n    48→const ROOT = resolve(process.cwd());\n    49→const CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\n    50→const PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n    51→\n    52→/** Files/dirs stripped from release/alpha after each merge from develop.\n    53→ *  Used by both the dry-run merge check and the actual merge step. */\n    54→const INTERNAL_FILES_TO_STRIP = [\n    55→  \"intermediates/\",\n    56→  \"external-docs/\",\n    57→  \"CLAUDE.md\",\n    58→  \"CONTRIBUTING.md\",\n    59→  \"standard-operating-procedures.md\",\n    60→];\n    61→\n    62→// ─── Saved state for rollback ────────────────────────────────────────\n    63→\n    64→interface ReleaseState {\n    65→  developHead: string;\n    66→  releaseAlphaHead: string;\n    67→  startBranch: string;\n    68→  newVersion: string | null;\n    69→  developPushed: boolean;\n    70→  releaseAlphaPushed: boolean;\n    71→  tagPushed: boolean;\n    72→  tagName: string | null;\n    73→}\n    74→\n    75→const state: ReleaseState = {\n    76→  developHead: \"\",\n    77→  releaseAlphaHead: \"\",\n    78→  startBranch: \"\",\n    79→  newVersion: null,\n    80→  developPushed: false,\n    81→  releaseAlphaPushed: false,\n    82→  tagPushed: false,\n    83→  tagName: null,\n    84→};\n    85→\n    86→// ─── Helpers ─────────────────────────────────────────────────────────\n    87→\n    88→async function exec(\n    89→  command: string,\n    90→  options: { silent?: boolean; allowFailure?: boolean } = {},\n    91→): Promise<string> {\n    92→  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    93→    stdout: \"pipe\",\n    94→    stderr: options.silent ? \"pipe\" : \"inherit\",\n    95→  });\n    96→\n    97→  const exitCode = await proc.exited;\n    98→  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n    99→\n   100→  if (exitCode !== 0 && !options.allowFailure) {\n   101→    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n   102→  }\n   103→\n   104→  return output.trim();\n   105→}\n   106→\n   107→function log(msg: string) {\n   108→  console.log(msg);\n   109→}\n   110→\n   111→function logStep(msg: string) {\n   112→  console.log(`\\n  ${msg}`);\n   113→}\n   114→\n   115→function logOk(msg: string) {\n   116→  console.log(`  ✓ ${msg}`);\n   117→}\n   118→\n   119→function logWarn(msg: string) {\n   120→  console.log(`  ! ${msg}`);\n   121→}\n   122→\n   123→function logErr(msg: string) {\n   124→  console.error(`  ✗ ${msg}`);\n   125→}\n   126→\n   127→/**\n   128→ * Prompt the user for confirmation. In --yes mode, auto-confirms.\n   129→ * Returns true if confirmed, false if cancelled.\n   130→ */\n   131→async function confirm(message: string): Promise<boolean> {\n   132→  if (YES_MODE) {\n   133→    log(`  ${message} (auto-confirmed: --yes)`);\n   134→    return true;\n   135→  }\n   136→\n   137→  process.stdout.write(`  ${message} [y/N] `);\n   138→\n   139→  // Read a single line from stdin\n   140→  const reader = Bun.stdin.stream().getReader();\n   141→  const { value } = await reader.read();\n   142→  reader.releaseLock();\n   143→\n   144→  const answer = value\n   145→    ? new TextDecoder().decode(value).trim().toLowerCase()\n   146→    : \"\";\n   147→  return answer === \"y\" || answer === \"yes\";\n   148→}\n   149→\n   150→/**\n   151→ * Compute what the new version would be without modifying package.json\n   152→ */\n   153→function computeNewVersion(currentVersion: string, bumpType: string): string {\n   154→  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n   155→  switch (bumpType) {\n   156→    case \"major\":\n   157→      return `${major + 1}.0.0`;\n   158→    case \"minor\":\n   159→      return `${major}.${minor + 1}.0`;\n   160→    case \"patch\":\n   161→      return `${major}.${minor}.${patch + 1}`;\n   162→    default:\n   163→      throw new Error(`Invalid bump type: ${bumpType}`);\n   164→  }\n   165→}\n   166→\n   167→// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n   168→\n   169→interface ValidationResult {\n   170→  currentVersion: string;\n   171→  newVersion: string;\n   172→  changelogEntryCount: number;\n   173→  changelogPreview: string[];\n   174→  mergeWouldSucceed: boolean;\n   175→  schemasWouldGenerate: boolean;\n   176→  typecheckPassed: boolean | null; // null = skipped\n   177→  lintPassed: boolean | null;\n   178→}\n   179→\n   180→async function validate(): Promise<ValidationResult> {\n   181→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   182→  log(\"║  Phase 1: Validation                                     ║\");\n   183→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   184→\n   185→  const result: ValidationResult = {\n   186→    currentVersion: \"\",\n   187→    newVersion: \"\",\n   188→    changelogEntryCount: 0,\n   189→    changelogPreview: [],\n   190→    mergeWouldSucceed: false,\n   191→    schemasWouldGenerate: false,\n   192→    typecheckPassed: null,\n   193→    lintPassed: null,\n   194→  };\n   195→\n   196→  // 1. Check branch\n   197→  logStep(\"Checking branch...\");\n   198→  const currentBranch = await exec(\"git branch --show-current\", {\n   199→    silent: true,\n   200→  });\n   201→  if (currentBranch !== \"develop\") {\n   202→    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n   203→    process.exit(1);\n   204→  }\n   205→  state.startBranch = currentBranch;\n   206→  logOk(`On develop branch`);\n   207→\n   208→  // 2. Check clean working directory\n   209→  logStep(\"Checking working directory...\");\n   210→  const status = await exec(\"git status --porcelain\", { silent: true });\n   211→  if (status) {\n   212→    logErr(\"Uncommitted changes detected:\");\n   213→    console.error(status);\n   214→    process.exit(1);\n   215→  }\n   216→  logOk(\"Working directory is clean\");\n   217→\n   218→  // 3. Check remote sync\n   219→  logStep(\"Checking remote sync...\");\n   220→  await exec(\"git fetch origin\", { silent: true });\n   221→\n   222→  for (const branch of [\"develop\", \"release/alpha\"]) {\n   223→    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n   224→    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n   225→      silent: true,\n   226→    });\n   227→\n   228→    if (localCommit !== remoteCommit) {\n   229→      const ahead = parseInt(\n   230→        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n   231→          silent: true,\n   232→        }),\n   233→      );\n   234→      const behind = parseInt(\n   235→        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n   236→          silent: true,\n   237→        }),\n   238→      );\n   239→\n   240→      if (behind > 0 && ahead > 0) {\n   241→        logErr(\n   242→          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n   243→        );\n   244→        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   245→        process.exit(1);\n   246→      } else if (behind > 0) {\n   247→        logErr(`${branch} is ${behind} commit(s) behind remote`);\n   248→        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   249→        process.exit(1);\n   250→      } else if (ahead > 0) {\n   251→        logWarn(\n   252→          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n   253→        );\n   254→      }\n   255→    } else {\n   256→      logOk(`${branch} is in sync with origin/${branch}`);\n   257→    }\n   258→  }\n   259→\n   260→  // Save pre-release state for rollback\n   261→  state.developHead = await exec(\"git rev-parse develop\", { silent: true });\n   262→  state.releaseAlphaHead = await exec(\"git rev-parse release/alpha\", {\n   263→    silent: true,\n   264→  });\n   265→\n   266→  // 4. Compute new version\n   267→  logStep(\"Computing version...\");\n   268→  const packageJson = await Bun.file(PACKAGE_JSON_PATH).json();\n   269→  result.currentVersion = packageJson.version;\n   270→  result.newVersion = computeNewVersion(\n   271→    result.currentVersion,\n   272→    BUMP_TYPE as string,\n   273→  );\n   274→  state.newVersion = result.newVersion;\n   275→  logOk(`${result.currentVersion} → ${result.newVersion} (${BUMP_TYPE})`);\n   276→\n   277→  // 5. Check tag doesn't exist\n   278→  logStep(\"Checking tag availability...\");\n   279→  const tag = `v${result.newVersion}`;\n   280→  const remoteTag = await exec(`git ls-remote --tags origin ${tag}`, {\n   281→    silent: true,\n   282→  });\n   283→  if (remoteTag) {\n   284→    logErr(\n   285→      `Tag ${tag} already exists on remote. The version may already be released.`,\n   286→    );\n   287→    process.exit(1);\n   288→  }\n   289→  // Also check locally\n   290→  const localTag = await exec(`git tag -l ${tag}`, { silent: true });\n   291→  if (localTag) {\n   292→    logWarn(\n   293→      `Tag ${tag} exists locally (stale). Will be deleted before re-creation.`,\n   294→    );\n   295→  }\n   296→  logOk(`Tag ${tag} is available`);\n   297→\n   298→  // 6. Validate changelog\n   299→  logStep(\"Validating CHANGELOG.md...\");\n   300→  if (!existsSync(CHANGELOG_PATH)) {\n   301→    logErr(\"CHANGELOG.md not found\");\n   302→    process.exit(1);\n   303→  }\n   304→\n   305→  const changelog = await Bun.file(CHANGELOG_PATH).text();\n   306→  if (!changelog.includes(\"## [Unreleased]\")) {\n   307→    logErr(\"No [Unreleased] section found in CHANGELOG.md\");\n   308→    process.exit(1);\n   309→  }\n   310→\n   311→  const unreleasedMatch = changelog.match(\n   312→    /## \\[Unreleased\\]([\\s\\S]*?)(?=\\n## |$)/,\n   313→  );\n   314→  if (!unreleasedMatch) {\n   315→    logErr(\"Could not parse [Unreleased] section\");\n   316→    process.exit(1);\n   317→  }\n   318→\n   319→  const bulletPoints = unreleasedMatch[1].match(/^- .+\\S/gm) || [];\n   320→  result.changelogEntryCount = bulletPoints.length;\n   321→  result.changelogPreview = bulletPoints.slice(0, 5);\n   322→\n   323→  if (result.changelogEntryCount === 0) {\n   324→    logWarn(\"CHANGELOG [Unreleased] section has no entries\");\n   325→    logWarn(\"The release will have empty release notes\");\n   326→    if (!YES_MODE) {\n   327→      const proceed = await confirm(\"Continue with empty changelog?\");\n   328→      if (!proceed) {\n   329→        log(\"\\nRelease cancelled. Add entries to [Unreleased] and try again.\");\n   330→        process.exit(0);\n   331→      }\n   332→    }\n   333→  } else {\n   334→    logOk(\n   335→      `CHANGELOG has ${result.changelogEntryCount} entries in [Unreleased]:`,\n   336→    );\n   337→    for (const entry of result.changelogPreview) {\n   338→      console.log(`      ${entry}`);\n   339→    }\n   340→    if (result.changelogEntryCount > 5) {\n   341→      console.log(`      ... and ${result.changelogEntryCount - 5} more`);\n   342→    }\n   343→  }\n   344→\n   345→  // 7. Test merge feasibility\n   346→  logStep(\"Testing merge feasibility (develop → release/alpha)...\");\n   347→  try {\n   348→    // Use merge-tree to check for conflicts without touching the working tree\n   349→    // merge-tree returns 0 even with conflicts, but outputs conflict markers\n   350→    // Instead, do a merge --no-commit --no-ff and then abort\n   351→    await exec(\"git checkout release/alpha\", { silent: true });\n   352→    const mergeResult = await exec(\n   353→      \"git merge --no-commit --no-ff develop 2>&1\",\n   354→      {\n   355→        silent: true,\n   356→        allowFailure: true,\n   357→      },\n   358→    );\n   359→    // Check for conflicts — any unmerged entry in porcelain status.\n   360→    // Codes: UU (both modified), AA (both added), DD (both deleted),\n   361→    // DU/UD (modify/delete — e.g. file stripped on release but modified on develop)\n   362→    const mergeStatus = await exec(\"git status --porcelain\", { silent: true });\n   363→    const conflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) /m;\n   364→    const hasConflicts = conflictPattern.test(mergeStatus);\n   365→\n   366→    // For modify/delete conflicts, check if ALL conflicting files are in the\n   367→    // strip list — if so, the merge step will auto-resolve them.\n   368→    let conflictsAreStrippable = false;\n   369→    if (hasConflicts) {\n   370→      const modifyDeletePattern = /^(DU|UD) (.+)$/gm;\n   371→      const allConflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) (.+)$/gm;\n   372→\n   373→      const modifyDeleteFiles = [...mergeStatus.matchAll(modifyDeletePattern)].map((m) => m[2].trim());\n   374→      const allConflictFiles = [...mergeStatus.matchAll(allConflictPattern)].map((m) => m[2].trim());\n   375→\n   376→      if (\n   377→        allConflictFiles.length > 0 &&\n   378→        allConflictFiles.length === modifyDeleteFiles.length &&\n   379→        modifyDeleteFiles.every((f) =>\n   380→          INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n   381→        )\n   382→      ) {\n   383→        conflictsAreStrippable = true;\n   384→      }\n   385→    }\n   386→\n   387→    // Abort the merge\n   388→    await exec(\"git merge --abort 2>/dev/null || git reset --hard HEAD\", {\n   389→      silent: true,\n   390→      allowFailure: true,\n   391→    });\n   392→    await exec(\"git checkout develop\", { silent: true });\n   393→\n   394→    if (hasConflicts && !conflictsAreStrippable) {\n   395→      logErr(\"Merge would have conflicts. Resolve before releasing:\");\n   396→      logErr(\"  git checkout release/alpha\");\n   397→      logErr(\"  git merge develop\");\n   398→      logErr(\"  # resolve conflicts, commit, then:\");\n   399→      logErr(\"  git checkout develop\");\n   400→      process.exit(1);\n   401→    }\n   402→    result.mergeWouldSucceed = true;\n   403→    if (conflictsAreStrippable) {\n   404→      logOk(\"Merge has modify/delete conflicts on stripped files (will auto-resolve)\");\n   405→    } else {\n   406→      logOk(\"Merge would succeed cleanly\");\n   407→    }\n   408→  } catch (error) {\n   409→    // Make sure we're back on develop\n   410→    await exec(\"git merge --abort 2>/dev/null || true\", {\n   411→      silent: true,\n   412→      allowFailure: true,\n   413→    });\n   414→    await exec(\"git checkout develop 2>/dev/null || true\", {\n   415→      silent: true,\n   416→      allowFailure: true,\n   417→    });\n   418→    logErr(`Merge test failed: ${(error as Error).message}`);\n   419→    process.exit(1);\n   420→  }\n   421→\n   422→  // 8. Test schema generation\n   423→  logStep(\"Testing schema generation...\");\n   424→  try {\n   425→    await exec(\"bun run generate-schemas\", { silent: true });\n   426→    // Check if schemas directory changed (would indicate schemas need regenerating)\n   427→    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n   428→      silent: true,\n   429→    });\n   430→    if (schemaChanges) {\n   431→      logWarn(\n   432→        \"Schema generation produced changes (will be included in release commit)\",\n   433→      );\n   434→    }\n   435→    // Reset any changes from test generation\n   436→    await exec(\"git checkout -- schemas/ 2>/dev/null || true\", {\n   437→      silent: true,\n   438→      allowFailure: true,\n   439→    });\n   440→    result.schemasWouldGenerate = true;\n   441→    logOk(\"Schema generation works\");\n   442→  } catch {\n   443→    logErr(\"Schema generation failed. Fix before releasing.\");\n   444→    process.exit(1);\n   445→  }\n   446→\n   447→  // 9. Optional: typecheck + lint\n   448→  if (!SKIP_CHECKS) {\n   449→    logStep(\"Running typecheck...\");\n   450→    try {\n   451→      await exec(\"bun run tc\", { silent: true });\n   452→      result.typecheckPassed = true;\n   453→      logOk(\"Typecheck passed\");\n   454→    } catch {\n   455→      logErr(\"Typecheck failed. Fix errors or use --skip-checks to skip.\");\n   456→      process.exit(1);\n   457→    }\n   458→\n   459→    logStep(\"Running lint...\");\n   460→    try {\n   461→      await exec(\"bun run lint\", { silent: true });\n   462→      result.lintPassed = true;\n   463→      logOk(\"Lint passed\");\n   464→    } catch {\n   465→      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n   466→      process.exit(1);\n   467→    }\n   468→  } else {\n   469→    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n   470→    result.typecheckPassed = null;\n   471→    result.lintPassed = null;\n   472→  }\n   473→\n   474→  return result;\n   475→}\n   476→\n   477→// ─── PHASE 2: Execute ────────────────────────────────────────────────\n   478→\n   479→async function execute(validation: ValidationResult): Promise<void> {\n   480→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   481→  log(\"║  Phase 2: Execute                                        ║\");\n   482→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   483→\n   484→  const { newVersion } = validation;\n   485→  const tag = `v${newVersion}`;\n   486→  state.tagName = tag;\n   487→\n   488→  try {\n   489→    // ── Step 1: Local changes on develop ──────────────────────────\n   490→\n   491→    logStep(`Bumping version to ${newVersion}...`);\n   492→    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n   493→    logOk(`package.json updated to ${newVersion}`);\n   494→\n   495→    logStep(\"Stamping CHANGELOG...\");\n   496→    const changelog = await Bun.file(CHANGELOG_PATH).text();\n   497→    const date = new Date().toISOString().split(\"T\")[0];\n   498→    const stampedChangelog = changelog.replace(\n   499→      \"## [Unreleased]\",\n   500→      `## [${newVersion}] - ${date}`,\n   501→    );\n   502→    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n   503→    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n   504→\n   505→    logStep(\"Regenerating schemas...\");\n   506→    await exec(\"bun run generate-schemas\");\n   507→    logOk(\"Schemas regenerated\");\n   508→\n   509→    logStep(\"Creating release commit...\");\n   510→    await exec(\"git add package.json CHANGELOG.md schemas/\");\n   511→    await exec(`git commit -m \"Release v${newVersion}\"`);\n   512→    logOk(`Committed \"Release v${newVersion}\" on develop`);\n   513→\n   514→    logStep(\"Adding [Unreleased] section...\");\n   515→    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n   516→    const lines = updatedChangelog.split(\"\\n\");\n   517→    const firstHeadingIndex = lines.findIndex((line) =>\n   518→      line.startsWith(\"## [\"),\n   519→    );\n   520→    if (firstHeadingIndex !== -1) {\n   521→      lines.splice(\n   522→        firstHeadingIndex,\n   523→        0,\n   524→        ...[\n   525→          \"## [Unreleased]\",\n   526→          \"\",\n   527→          \"### Added\",\n   528→          \"- \",\n   529→          \"\",\n   530→          \"### Changed\",\n   531→          \"- \",\n   532→          \"\",\n   533→          \"### Fixed\",\n   534→          \"- \",\n   535→          \"\",\n   536→        ],\n   537→      );\n   538→      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n   539→    }\n   540→    await exec(\"git add CHANGELOG.md\");\n   541→    await exec(\n   542→      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n   543→    );\n   544→    logOk(\"Committed [Unreleased] template\");\n   545→\n   546→    // ── Step 2: Push develop ──────────────────────────────────────\n   547→\n   548→    logStep(\"Pushing develop to origin...\");\n   549→    await exec(\"git push origin develop\");\n   550→    state.developPushed = true;\n   551→    logOk(\"Pushed develop\");\n   552→\n   553→    // ── Step 3: Merge to release/alpha ────────────────────────────\n   554→\n   555→    logStep(\"Merging develop → release/alpha...\");\n   556→    await exec(\"git checkout release/alpha\");\n   557→\n   558→    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n   559→      allowFailure: true,\n   560→      silent: true,\n   561→    });\n   562→\n   563→    // Handle modify/delete conflicts on files we're about to strip anyway.\n   564→    // This happens when a file is modified on develop but was deleted from\n   565→    // release/alpha during a previous release's strip step.\n   566→    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n   567→      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n   568→      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n   569→\n   570→      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n   571→        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n   572→      );\n   573→\n   574→      if (!allStrippable) {\n   575→        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n   576→        throw new Error(\n   577→          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n   578→        );\n   579→      }\n   580→\n   581→      for (const file of conflictFiles) {\n   582→        await exec(`git rm -f \"${file}\"`, { silent: true });\n   583→      }\n   584→      await exec('git -c core.editor=true merge --continue', { silent: true });\n   585→      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n   586→    } else {\n   587→      logOk(\"Merged develop into release/alpha\");\n   588→    }\n   589→\n   590→    // Strip internal files\n   591→    logStep(\"Stripping internal files...\");\n   592→    const filesToRemove: string[] = [];\n   593→    for (const file of INTERNAL_FILES_TO_STRIP) {\n   594→      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n   595→        silent: true,\n   596→      });\n   597→      if (exists) filesToRemove.push(file);\n   598→    }\n   599→    if (filesToRemove.length > 0) {\n   600→      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n   601→      await exec(\n   602→        'git commit -m \"chore: strip intermediates and planning files\"',\n   603→      );\n   604→      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n   605→    } else {\n   606→      logOk(\"No internal files to strip\");\n   607→    }\n   608→\n   609→    // ── Step 4: Create tag ────────────────────────────────────────\n   610→\n   611→    logStep(`Creating tag ${tag}...`);\n   612→    // Delete stale local tag if exists\n   613→    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n   614→    if (staleTag) {\n   615→      await exec(`git tag -d ${tag}`);\n   616→    }\n   617→    await exec(`git tag ${tag}`);\n   618→    logOk(`Created tag ${tag} on release/alpha`);\n   619→\n   620→    // ── Step 5: Push release/alpha + tag ──────────────────────────\n   621→\n   622→    logStep(\"Pushing release/alpha to origin...\");\n   623→    await exec(\"git push origin release/alpha\");\n   624→    state.releaseAlphaPushed = true;\n   625→    logOk(\"Pushed release/alpha\");\n   626→\n   627→    logStep(`Pushing tag ${tag} to origin...`);\n   628→    await exec(`git push origin ${tag}`);\n   629→    state.tagPushed = true;\n   630→    logOk(`Pushed tag ${tag} (this triggers CI)`);\n   631→\n   632→    // ── Step 6: Return to develop ─────────────────────────────────\n   633→\n   634→    await exec(\"git checkout develop\");\n   635→    logOk(\"Back on develop branch\");\n   636→  } catch (error) {\n   637→    logErr(`Release failed: ${(error as Error).message}`);\n   638→\n   639→    // Attempt automatic rollback\n   640→    await rollback();\n   641→    throw error;\n   642→  }\n   643→}\n   644→\n   645→// ─── Rollback ────────────────────────────────────────────────────────\n   646→\n   647→async function rollback(): Promise<void> {\n   648→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   649→  log(\"║  Automatic Rollback                                      ║\");\n   650→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   651→\n   652→  const actions: string[] = [];\n   653→\n   654→  try {\n   655→    // Make sure we can get back to a branch\n   656→    const currentBranch = await exec(\"git branch --show-current\", {\n   657→      silent: true,\n   658→      allowFailure: true,\n   659→    });\n   660→\n   661→    // If we're mid-merge, abort it\n   662→    await exec(\"git merge --abort 2>/dev/null || true\", {\n   663→      silent: true,\n   664→      allowFailure: true,\n   665→    });\n   666→\n   667→    // Delete local tag if created\n   668→    if (state.tagName) {\n   669→      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n   670→        silent: true,\n   671→      });\n   672→      if (tagExists) {\n   673→        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n   674→        actions.push(`Deleted local tag ${state.tagName}`);\n   675→      }\n   676→    }\n   677→\n   678→    // Reset release/alpha to pre-release state\n   679→    if (state.releaseAlphaHead) {\n   680→      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n   681→        silent: true,\n   682→        allowFailure: true,\n   683→      });\n   684→      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n   685→        allowFailure: true,\n   686→      });\n   687→      actions.push(\n   688→        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n   689→      );\n   690→    }\n   691→\n   692→    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n   693→    if (state.developHead) {\n   694→      await exec(\"git checkout develop\", { allowFailure: true });\n   695→      if (!state.developPushed) {\n   696→        await exec(`git reset --hard ${state.developHead}`, {\n   697→          allowFailure: true,\n   698→        });\n   699→        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n   700→      } else {\n   701→        // develop was pushed — we need to force-push to undo\n   702→        logWarn(\"develop was already pushed to remote. Local reset only.\");\n   703→        await exec(`git reset --hard ${state.developHead}`, {\n   704→          allowFailure: true,\n   705→        });\n   706→        actions.push(\n   707→          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n   708→        );\n   709→        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n   710→        actions.push(`  git push origin develop --force-with-lease`);\n   711→      }\n   712→    } else {\n   713→      // At minimum get back to develop\n   714→      await exec(\"git checkout develop 2>/dev/null || true\", {\n   715→        silent: true,\n   716→        allowFailure: true,\n   717→      });\n   718→    }\n   719→\n   720→    if (state.releaseAlphaPushed) {\n   721→      actions.push(\n   722→        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n   723→      );\n   724→      actions.push(`  git push origin release/alpha --force-with-lease`);\n   725→    }\n   726→\n   727→    if (state.tagPushed) {\n   728→      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n   729→      actions.push(`  git push origin --delete ${state.tagName}`);\n   730→    }\n   731→\n   732→    log(\"\\n  Rollback actions:\");\n   733→    for (const action of actions) {\n   734→      if (action.startsWith(\"WARNING\")) {\n   735→        logWarn(action);\n   736→      } else {\n   737→        logOk(action);\n   738→      }\n   739→    }\n   740→\n   741→    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n   742→      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n   743→    } else {\n   744→      log(\n   745→        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n   746→      );\n   747→    }\n   748→  } catch (rollbackError) {\n   749→    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n   750→    log(\"\\n  Manual recovery steps:\");\n   751→    log(`    git checkout develop`);\n   752→    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n   753→    log(`    git checkout release/alpha`);\n   754→    log(\n   755→      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n   756→    );\n   757→    if (state.tagName) {\n   758→      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n   759→    }\n   760→    log(`    git checkout develop`);\n   761→  }\n   762→}\n   763→\n   764→// ─── Main ────────────────────────────────────────────────────────────\n   765→\n   766→async function main(): Promise<void> {\n   767→  log(\"╔════════════════════════════════════════════════════════════╗\");\n   768→  log(\"║  Hankweave Release                                       ║\");\n   769→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   770→  log(\"\");\n   771→  log(`  Bump type:    ${BUMP_TYPE}`);\n   772→  log(\n   773→    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n   774→  );\n   775→  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n   776→\n   777→  // Phase 1: Validate\n   778→  const validation = await validate();\n   779→\n   780→  // Print plan\n   781→  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n   782→  log(\"│  Release Plan                                              │\");\n   783→  log(\"├────────────────────────────────────────────────────────────┤\");\n   784→  log(\n   785→    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n   786→  );\n   787→  log(`│  Tag:         v${validation.newVersion}`);\n   788→  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n   789→  log(\n   790→    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`,\n   791→  );\n   792→  log(`│  Schemas:     ${validation.schemasWouldGenerate ? \"ok\" : \"failed!\"}`);\n   793→  if (validation.typecheckPassed !== null) {\n   794→    log(`│  Typecheck:   ${validation.typecheckPassed ? \"passed\" : \"failed!\"}`);\n   795→  }\n   796→  if (validation.lintPassed !== null) {\n   797→    log(`│  Lint:        ${validation.lintPassed ? \"passed\" : \"failed!\"}`);\n   798→  }\n   799→  log(\"│                                                            │\");\n   800→  log(\"│  Steps:                                                    │\");\n   801→  log(\"│    1. Bump version + stamp changelog + commit on develop   │\");\n   802→  log(\"│    2. Add [Unreleased] template + commit                   │\");\n   803→  log(\"│    3. Push develop                                         │\");\n   804→  log(\"│    4. Merge develop → release/alpha, strip internal files  │\");\n   805→  log(\"│    5. Create tag, push release/alpha + tag                 │\");\n   806→  log(\"│    6. Return to develop                                    │\");\n   807→  log(\"│                                                            │\");\n   808→  log(\"│  Tag push will trigger CI: tests → npm → binaries → GH    │\");\n   809→  log(\"└────────────────────────────────────────────────────────────┘\");\n   810→\n   811→  if (DRY_RUN) {\n   812→    log(\"\\n  ✓ Dry-run complete. All validations passed.\");\n   813→    log(\"  Run without --dry-run to execute the release.\");\n   814→    process.exit(0);\n   815→  }\n   816→\n   817→  // Confirm before proceeding\n   818→  if (!YES_MODE) {\n   819→    const proceed = await confirm(\"Proceed with release?\");\n   820→    if (!proceed) {\n   821→      log(\"\\nRelease cancelled.\");\n   822→      process.exit(0);\n   823→    }\n   824→  } else {\n   825→    log(\"\\n  Proceeding with release (--yes mode)...\");\n   826→  }\n   827→\n   828→  // Phase 2: Execute\n   829→  await execute(validation);\n   830→\n   831→  // Success!\n   832→  const repoUrl = await exec(\"git remote get-url origin\", { silent: true });\n   833→  const cleanUrl = repoUrl\n   834→    .replace(/\\.git$/, \"\")\n   835→    .replace(/.*github\\.com[:/]/, \"\");\n   836→\n   837→  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   838→  log(\"║  Release complete                                         ║\");\n   839→  log(\"╚════════════════════════════════════════════════════════════╝\");\n   840→  log(`\\n  Version: v${validation.newVersion}`);\n   841→  log(\"\");\n   842→  log(\"  What happened:\");\n   843→  log(\"    ✓ Release commits created on develop\");\n   844→  log(\"    ✓ develop pushed to origin\");\n   845→  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n   846→  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n   847→  log(\"\");\n   848→  log(\"  CI will now:\");\n   849→  log(\"    1. Run tests\");\n   850→  log(\n   851→    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n   852→  );\n   853→  log(\"    3. Build platform executables\");\n   854→  log(\"    4. Create GitHub release\");\n   855→  log(\"\");\n   856→  log(`  Track: https://github.com/${cleanUrl}/actions`);\n   857→  log(\"\");\n   858→  log(\"  Next (when CI passes):\");\n   859→  log(\n   860→    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n   861→  );\n   862→}\n   863→\n   864→main().catch((error) => {\n   865→  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n   866→  process.exit(1);\n   867→});\n   868→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"776a0f8a-96ed-40de-9838-b3734a846e63","uuid":"d3723f34-308f-4be3-b028-16a581f05d28","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/release.ts","content":"#!/usr/bin/env bun\n\n/**\n * Release automation script for Hankweave\n *\n * Two-phase release: validate everything first (dry-run), then execute.\n * Automatic rollback on failure. Headless-friendly.\n *\n * Usage:\n *   bun run release:patch              # Interactive release\n *   bun run release:minor              # Minor version bump\n *   bun run release:major              # Major version bump\n *   bun scripts/release.ts patch --yes # Headless (no prompts)\n *   bun scripts/release.ts minor --dry-run  # Validate only\n *\n * Flags:\n *   --yes, -y       Skip all interactive prompts (for agents/CI)\n *   --dry-run       Validate everything but don't make changes\n *   --skip-checks   Skip typecheck and lint during validation\n */\n\nimport { existsSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\n// ─── Argument parsing ────────────────────────────────────────────────\n\nconst args = process.argv.slice(2);\nconst BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\nconst VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\ntype BumpType = (typeof VALID_BUMP_TYPES)[number];\n\nconst YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\nconst DRY_RUN = args.includes(\"--dry-run\");\nconst SKIP_CHECKS = args.includes(\"--skip-checks\");\n\nif (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n  console.error(\"Error: Invalid or missing bump type\");\n  console.error(\"\");\n  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n  console.error(\"\");\n  console.error(\"Flags:\");\n  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n  console.error(\"  --dry-run       Validate everything without making changes\");\n  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n  process.exit(1);\n}\n\nconst ROOT = resolve(process.cwd());\nconst CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\nconst PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n\n/** Files/dirs stripped from release/alpha after each merge from develop.\n *  Used by both the dry-run merge check and the actual merge step. */\nconst INTERNAL_FILES_TO_STRIP = [\n  \"intermediates/\",\n  \"external-docs/\",\n  \"CLAUDE.md\",\n  \"CONTRIBUTING.md\",\n  \"standard-operating-procedures.md\",\n];\n\n// ─── Saved state for rollback ────────────────────────────────────────\n\ninterface ReleaseState {\n  developHead: string;\n  releaseAlphaHead: string;\n  startBranch: string;\n  newVersion: string | null;\n  developPushed: boolean;\n  releaseAlphaPushed: boolean;\n  tagPushed: boolean;\n  tagName: string | null;\n}\n\nconst state: ReleaseState = {\n  developHead: \"\",\n  releaseAlphaHead: \"\",\n  startBranch: \"\",\n  newVersion: null,\n  developPushed: false,\n  releaseAlphaPushed: false,\n  tagPushed: false,\n  tagName: null,\n};\n\n// ─── Helpers ─────────────────────────────────────────────────────────\n\nasync function exec(\n  command: string,\n  options: { silent?: boolean; allowFailure?: boolean } = {},\n): Promise<string> {\n  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    stdout: \"pipe\",\n    stderr: options.silent ? \"pipe\" : \"inherit\",\n  });\n\n  const exitCode = await proc.exited;\n  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.allowFailure) {\n    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n  }\n\n  return output.trim();\n}\n\nfunction log(msg: string) {\n  console.log(msg);\n}\n\nfunction logStep(msg: string) {\n  console.log(`\\n  ${msg}`);\n}\n\nfunction logOk(msg: string) {\n  console.log(`  ✓ ${msg}`);\n}\n\nfunction logWarn(msg: string) {\n  console.log(`  ! ${msg}`);\n}\n\nfunction logErr(msg: string) {\n  console.error(`  ✗ ${msg}`);\n}\n\n/**\n * Prompt the user for confirmation. In --yes mode, auto-confirms.\n * Returns true if confirmed, false if cancelled.\n */\nasync function confirm(message: string): Promise<boolean> {\n  if (YES_MODE) {\n    log(`  ${message} (auto-confirmed: --yes)`);\n    return true;\n  }\n\n  process.stdout.write(`  ${message} [y/N] `);\n\n  // Read a single line from stdin\n  const reader = Bun.stdin.stream().getReader();\n  const { value } = await reader.read();\n  reader.releaseLock();\n\n  const answer = value\n    ? new TextDecoder().decode(value).trim().toLowerCase()\n    : \"\";\n  return answer === \"y\" || answer === \"yes\";\n}\n\n/**\n * Compute what the new version would be without modifying package.json\n */\nfunction computeNewVersion(currentVersion: string, bumpType: string): string {\n  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n  switch (bumpType) {\n    case \"major\":\n      return `${major + 1}.0.0`;\n    case \"minor\":\n      return `${major}.${minor + 1}.0`;\n    case \"patch\":\n      return `${major}.${minor}.${patch + 1}`;\n    default:\n      throw new Error(`Invalid bump type: ${bumpType}`);\n  }\n}\n\n// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n\ninterface ValidationResult {\n  currentVersion: string;\n  newVersion: string;\n  changelogEntryCount: number;\n  changelogPreview: string[];\n  mergeWouldSucceed: boolean;\n  schemasWouldGenerate: boolean;\n  typecheckPassed: boolean | null; // null = skipped\n  lintPassed: boolean | null;\n}\n\nasync function validate(): Promise<ValidationResult> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 1: Validation                                     ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const result: ValidationResult = {\n    currentVersion: \"\",\n    newVersion: \"\",\n    changelogEntryCount: 0,\n    changelogPreview: [],\n    mergeWouldSucceed: false,\n    schemasWouldGenerate: false,\n    typecheckPassed: null,\n    lintPassed: null,\n  };\n\n  // 1. Check branch\n  logStep(\"Checking branch...\");\n  const currentBranch = await exec(\"git branch --show-current\", {\n    silent: true,\n  });\n  if (currentBranch !== \"develop\") {\n    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n    process.exit(1);\n  }\n  state.startBranch = currentBranch;\n  logOk(`On develop branch`);\n\n  // 2. Check clean working directory\n  logStep(\"Checking working directory...\");\n  const status = await exec(\"git status --porcelain\", { silent: true });\n  if (status) {\n    logErr(\"Uncommitted changes detected:\");\n    console.error(status);\n    process.exit(1);\n  }\n  logOk(\"Working directory is clean\");\n\n  // 3. Check remote sync\n  logStep(\"Checking remote sync...\");\n  await exec(\"git fetch origin\", { silent: true });\n\n  for (const branch of [\"develop\", \"release/alpha\"]) {\n    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n      silent: true,\n    });\n\n    if (localCommit !== remoteCommit) {\n      const ahead = parseInt(\n        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n          silent: true,\n        }),\n      );\n      const behind = parseInt(\n        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n          silent: true,\n        }),\n      );\n\n      if (behind > 0 && ahead > 0) {\n        logErr(\n          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n        );\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (behind > 0) {\n        logErr(`${branch} is ${behind} commit(s) behind remote`);\n        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n        process.exit(1);\n      } else if (ahead > 0) {\n        logWarn(\n          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n        );\n      }\n    } else {\n      logOk(`${branch} is in sync with origin/${branch}`);\n    }\n  }\n\n  // Save pre-release state for rollback\n  state.developHead = await exec(\"git rev-parse develop\", { silent: true });\n  state.releaseAlphaHead = await exec(\"git rev-parse release/alpha\", {\n    silent: true,\n  });\n\n  // 4. Compute new version\n  logStep(\"Computing version...\");\n  const packageJson = await Bun.file(PACKAGE_JSON_PATH).json();\n  result.currentVersion = packageJson.version;\n  result.newVersion = computeNewVersion(\n    result.currentVersion,\n    BUMP_TYPE as string,\n  );\n  state.newVersion = result.newVersion;\n  logOk(`${result.currentVersion} → ${result.newVersion} (${BUMP_TYPE})`);\n\n  // 5. Check tag doesn't exist\n  logStep(\"Checking tag availability...\");\n  const tag = `v${result.newVersion}`;\n  const remoteTag = await exec(`git ls-remote --tags origin ${tag}`, {\n    silent: true,\n  });\n  if (remoteTag) {\n    logErr(\n      `Tag ${tag} already exists on remote. The version may already be released.`,\n    );\n    process.exit(1);\n  }\n  // Also check locally\n  const localTag = await exec(`git tag -l ${tag}`, { silent: true });\n  if (localTag) {\n    logWarn(\n      `Tag ${tag} exists locally (stale). Will be deleted before re-creation.`,\n    );\n  }\n  logOk(`Tag ${tag} is available`);\n\n  // 6. Validate changelog\n  logStep(\"Validating CHANGELOG.md...\");\n  if (!existsSync(CHANGELOG_PATH)) {\n    logErr(\"CHANGELOG.md not found\");\n    process.exit(1);\n  }\n\n  const changelog = await Bun.file(CHANGELOG_PATH).text();\n  if (!changelog.includes(\"## [Unreleased]\")) {\n    logErr(\"No [Unreleased] section found in CHANGELOG.md\");\n    process.exit(1);\n  }\n\n  const unreleasedMatch = changelog.match(\n    /## \\[Unreleased\\]([\\s\\S]*?)(?=\\n## |$)/,\n  );\n  if (!unreleasedMatch) {\n    logErr(\"Could not parse [Unreleased] section\");\n    process.exit(1);\n  }\n\n  const bulletPoints = unreleasedMatch[1].match(/^- .+\\S/gm) || [];\n  result.changelogEntryCount = bulletPoints.length;\n  result.changelogPreview = bulletPoints.slice(0, 5);\n\n  if (result.changelogEntryCount === 0) {\n    logWarn(\"CHANGELOG [Unreleased] section has no entries\");\n    logWarn(\"The release will have empty release notes\");\n    if (!YES_MODE) {\n      const proceed = await confirm(\"Continue with empty changelog?\");\n      if (!proceed) {\n        log(\"\\nRelease cancelled. Add entries to [Unreleased] and try again.\");\n        process.exit(0);\n      }\n    }\n  } else {\n    logOk(\n      `CHANGELOG has ${result.changelogEntryCount} entries in [Unreleased]:`,\n    );\n    for (const entry of result.changelogPreview) {\n      console.log(`      ${entry}`);\n    }\n    if (result.changelogEntryCount > 5) {\n      console.log(`      ... and ${result.changelogEntryCount - 5} more`);\n    }\n  }\n\n  // 7. Test merge feasibility\n  logStep(\"Testing merge feasibility (develop → release/alpha)...\");\n  try {\n    // Use merge-tree to check for conflicts without touching the working tree\n    // merge-tree returns 0 even with conflicts, but outputs conflict markers\n    // Instead, do a merge --no-commit --no-ff and then abort\n    await exec(\"git checkout release/alpha\", { silent: true });\n    const mergeResult = await exec(\n      \"git merge --no-commit --no-ff develop 2>&1\",\n      {\n        silent: true,\n        allowFailure: true,\n      },\n    );\n    // Check for conflicts — any unmerged entry in porcelain status.\n    // Codes: UU (both modified), AA (both added), DD (both deleted),\n    // DU/UD (modify/delete — e.g. file stripped on release but modified on develop)\n    const mergeStatus = await exec(\"git status --porcelain\", { silent: true });\n    const conflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) /m;\n    const hasConflicts = conflictPattern.test(mergeStatus);\n\n    // For modify/delete conflicts, check if ALL conflicting files are in the\n    // strip list — if so, the merge step will auto-resolve them.\n    let conflictsAreStrippable = false;\n    if (hasConflicts) {\n      const modifyDeletePattern = /^(DU|UD) (.+)$/gm;\n      const allConflictPattern = /^(UU|AA|DD|DU|UD|AU|UA) (.+)$/gm;\n\n      const modifyDeleteFiles = [...mergeStatus.matchAll(modifyDeletePattern)].map((m) => m[2].trim());\n      const allConflictFiles = [...mergeStatus.matchAll(allConflictPattern)].map((m) => m[2].trim());\n\n      if (\n        allConflictFiles.length > 0 &&\n        allConflictFiles.length === modifyDeleteFiles.length &&\n        modifyDeleteFiles.every((f) =>\n          INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n        )\n      ) {\n        conflictsAreStrippable = true;\n      }\n    }\n\n    // Abort the merge\n    await exec(\"git merge --abort 2>/dev/null || git reset --hard HEAD\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop\", { silent: true });\n\n    if (hasConflicts && !conflictsAreStrippable) {\n      logErr(\"Merge would have conflicts. Resolve before releasing:\");\n      logErr(\"  git checkout release/alpha\");\n      logErr(\"  git merge develop\");\n      logErr(\"  # resolve conflicts, commit, then:\");\n      logErr(\"  git checkout develop\");\n      process.exit(1);\n    }\n    result.mergeWouldSucceed = true;\n    if (conflictsAreStrippable) {\n      logOk(\"Merge has modify/delete conflicts on stripped files (will auto-resolve)\");\n    } else {\n      logOk(\"Merge would succeed cleanly\");\n    }\n  } catch (error) {\n    // Make sure we're back on develop\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    await exec(\"git checkout develop 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    logErr(`Merge test failed: ${(error as Error).message}`);\n    process.exit(1);\n  }\n\n  // 8. Test schema generation\n  logStep(\"Testing schema generation...\");\n  try {\n    await exec(\"bun run generate-schemas\", { silent: true });\n    // Check if schemas directory changed (would indicate schemas need regenerating)\n    const schemaChanges = await exec(\"git diff --name-only schemas/\", {\n      silent: true,\n    });\n    if (schemaChanges) {\n      logWarn(\n        \"Schema generation produced changes (will be included in release commit)\",\n      );\n    }\n    // Reset any changes from test generation\n    await exec(\"git checkout -- schemas/ 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n    result.schemasWouldGenerate = true;\n    logOk(\"Schema generation works\");\n  } catch {\n    logErr(\"Schema generation failed. Fix before releasing.\");\n    process.exit(1);\n  }\n\n  // 9. Optional: typecheck + lint\n  if (!SKIP_CHECKS) {\n    logStep(\"Running typecheck...\");\n    try {\n      await exec(\"bun run tc\", { silent: true });\n      result.typecheckPassed = true;\n      logOk(\"Typecheck passed\");\n    } catch {\n      logErr(\"Typecheck failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n\n    logStep(\"Running lint...\");\n    try {\n      await exec(\"bun run lint\", { silent: true });\n      result.lintPassed = true;\n      logOk(\"Lint passed\");\n    } catch {\n      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n  } else {\n    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n    result.typecheckPassed = null;\n    result.lintPassed = null;\n  }\n\n  return result;\n}\n\n// ─── PHASE 2: Execute ────────────────────────────────────────────────\n\nasync function execute(validation: ValidationResult): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 2: Execute                                        ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const { newVersion } = validation;\n  const tag = `v${newVersion}`;\n  state.tagName = tag;\n\n  try {\n    // ── Step 1: Local changes on develop ──────────────────────────\n\n    logStep(`Bumping version to ${newVersion}...`);\n    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n    logOk(`package.json updated to ${newVersion}`);\n\n    logStep(\"Stamping CHANGELOG...\");\n    const changelog = await Bun.file(CHANGELOG_PATH).text();\n    const date = new Date().toISOString().split(\"T\")[0];\n    const stampedChangelog = changelog.replace(\n      \"## [Unreleased]\",\n      `## [${newVersion}] - ${date}`,\n    );\n    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n\n    logStep(\"Regenerating schemas...\");\n    await exec(\"bun run generate-schemas\");\n    logOk(\"Schemas regenerated\");\n\n    logStep(\"Creating release commit...\");\n    await exec(\"git add package.json CHANGELOG.md schemas/\");\n    await exec(`git commit -m \"Release v${newVersion}\"`);\n    logOk(`Committed \"Release v${newVersion}\" on develop`);\n\n    logStep(\"Adding [Unreleased] section...\");\n    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n    const lines = updatedChangelog.split(\"\\n\");\n    const firstHeadingIndex = lines.findIndex((line) =>\n      line.startsWith(\"## [\"),\n    );\n    if (firstHeadingIndex !== -1) {\n      lines.splice(\n        firstHeadingIndex,\n        0,\n        ...[\n          \"## [Unreleased]\",\n          \"\",\n          \"### Added\",\n          \"- \",\n          \"\",\n          \"### Changed\",\n          \"- \",\n          \"\",\n          \"### Fixed\",\n          \"- \",\n          \"\",\n        ],\n      );\n      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n    }\n    await exec(\"git add CHANGELOG.md\");\n    await exec(\n      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n    );\n    logOk(\"Committed [Unreleased] template\");\n\n    // ── Step 2: Push develop ──────────────────────────────────────\n\n    logStep(\"Pushing develop to origin...\");\n    await exec(\"git push origin develop\");\n    state.developPushed = true;\n    logOk(\"Pushed develop\");\n\n    // ── Step 3: Merge to release/alpha ────────────────────────────\n\n    logStep(\"Merging develop → release/alpha...\");\n    await exec(\"git checkout release/alpha\");\n\n    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n      allowFailure: true,\n      silent: true,\n    });\n\n    // Handle modify/delete conflicts on files we're about to strip anyway.\n    // This happens when a file is modified on develop but was deleted from\n    // release/alpha during a previous release's strip step.\n    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n\n      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n      );\n\n      if (!allStrippable) {\n        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n        throw new Error(\n          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n        );\n      }\n\n      for (const file of conflictFiles) {\n        await exec(`git rm -f \"${file}\"`, { silent: true });\n      }\n      await exec('git -c core.editor=true merge --continue', { silent: true });\n      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n    } else {\n      logOk(\"Merged develop into release/alpha\");\n    }\n\n    // Strip internal files\n    logStep(\"Stripping internal files...\");\n    const filesToRemove: string[] = [];\n    for (const file of INTERNAL_FILES_TO_STRIP) {\n      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n        silent: true,\n      });\n      if (exists) filesToRemove.push(file);\n    }\n    if (filesToRemove.length > 0) {\n      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n      await exec(\n        'git commit -m \"chore: strip intermediates and planning files\"',\n      );\n      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n    } else {\n      logOk(\"No internal files to strip\");\n    }\n\n    // ── Step 4: Create tag ────────────────────────────────────────\n\n    logStep(`Creating tag ${tag}...`);\n    // Delete stale local tag if exists\n    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n    if (staleTag) {\n      await exec(`git tag -d ${tag}`);\n    }\n    await exec(`git tag ${tag}`);\n    logOk(`Created tag ${tag} on release/alpha`);\n\n    // ── Step 5: Push release/alpha + tag ──────────────────────────\n\n    logStep(\"Pushing release/alpha to origin...\");\n    await exec(\"git push origin release/alpha\");\n    state.releaseAlphaPushed = true;\n    logOk(\"Pushed release/alpha\");\n\n    logStep(`Pushing tag ${tag} to origin...`);\n    await exec(`git push origin ${tag}`);\n    state.tagPushed = true;\n    logOk(`Pushed tag ${tag} (this triggers CI)`);\n\n    // ── Step 6: Return to develop ─────────────────────────────────\n\n    await exec(\"git checkout develop\");\n    logOk(\"Back on develop branch\");\n  } catch (error) {\n    logErr(`Release failed: ${(error as Error).message}`);\n\n    // Attempt automatic rollback\n    await rollback();\n    throw error;\n  }\n}\n\n// ─── Rollback ────────────────────────────────────────────────────────\n\nasync function rollback(): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Automatic Rollback                                      ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const actions: string[] = [];\n\n  try {\n    // Make sure we can get back to a branch\n    const currentBranch = await exec(\"git branch --show-current\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // If we're mid-merge, abort it\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // Delete local tag if created\n    if (state.tagName) {\n      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n        silent: true,\n      });\n      if (tagExists) {\n        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n        actions.push(`Deleted local tag ${state.tagName}`);\n      }\n    }\n\n    // Reset release/alpha to pre-release state\n    if (state.releaseAlphaHead) {\n      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n        allowFailure: true,\n      });\n      actions.push(\n        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n      );\n    }\n\n    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n    if (state.developHead) {\n      await exec(\"git checkout develop\", { allowFailure: true });\n      if (!state.developPushed) {\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n      } else {\n        // develop was pushed — we need to force-push to undo\n        logWarn(\"develop was already pushed to remote. Local reset only.\");\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(\n          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n        );\n        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n        actions.push(`  git push origin develop --force-with-lease`);\n      }\n    } else {\n      // At minimum get back to develop\n      await exec(\"git checkout develop 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n    }\n\n    if (state.releaseAlphaPushed) {\n      actions.push(\n        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n      );\n      actions.push(`  git push origin release/alpha --force-with-lease`);\n    }\n\n    if (state.tagPushed) {\n      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n      actions.push(`  git push origin --delete ${state.tagName}`);\n    }\n\n    log(\"\\n  Rollback actions:\");\n    for (const action of actions) {\n      if (action.startsWith(\"WARNING\")) {\n        logWarn(action);\n      } else {\n        logOk(action);\n      }\n    }\n\n    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n    } else {\n      log(\n        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n      );\n    }\n  } catch (rollbackError) {\n    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n    log(\"\\n  Manual recovery steps:\");\n    log(`    git checkout develop`);\n    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n    log(`    git checkout release/alpha`);\n    log(\n      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n    );\n    if (state.tagName) {\n      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n    }\n    log(`    git checkout develop`);\n  }\n}\n\n// ─── Main ────────────────────────────────────────────────────────────\n\nasync function main(): Promise<void> {\n  log(\"╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Hankweave Release                                       ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(\"\");\n  log(`  Bump type:    ${BUMP_TYPE}`);\n  log(\n    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n  );\n  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n\n  // Phase 1: Validate\n  const validation = await validate();\n\n  // Print plan\n  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n  log(\"│  Release Plan                                              │\");\n  log(\"├────────────────────────────────────────────────────────────┤\");\n  log(\n    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n  );\n  log(`│  Tag:         v${validation.newVersion}`);\n  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n  log(\n    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`,\n  );\n  log(`│  Schemas:     ${validation.schemasWouldGenerate ? \"ok\" : \"failed!\"}`);\n  if (validation.typecheckPassed !== null) {\n    log(`│  Typecheck:   ${validation.typecheckPassed ? \"passed\" : \"failed!\"}`);\n  }\n  if (validation.lintPassed !== null) {\n    log(`│  Lint:        ${validation.lintPassed ? \"passed\" : \"failed!\"}`);\n  }\n  log(\"│                                                            │\");\n  log(\"│  Steps:                                                    │\");\n  log(\"│    1. Bump version + stamp changelog + commit on develop   │\");\n  log(\"│    2. Add [Unreleased] template + commit                   │\");\n  log(\"│    3. Push develop                                         │\");\n  log(\"│    4. Merge develop → release/alpha, strip internal files  │\");\n  log(\"│    5. Create tag, push release/alpha + tag                 │\");\n  log(\"│    6. Return to develop                                    │\");\n  log(\"│                                                            │\");\n  log(\"│  Tag push will trigger CI: tests → npm → binaries → GH    │\");\n  log(\"└────────────────────────────────────────────────────────────┘\");\n\n  if (DRY_RUN) {\n    log(\"\\n  ✓ Dry-run complete. All validations passed.\");\n    log(\"  Run without --dry-run to execute the release.\");\n    process.exit(0);\n  }\n\n  // Confirm before proceeding\n  if (!YES_MODE) {\n    const proceed = await confirm(\"Proceed with release?\");\n    if (!proceed) {\n      log(\"\\nRelease cancelled.\");\n      process.exit(0);\n    }\n  } else {\n    log(\"\\n  Proceeding with release (--yes mode)...\");\n  }\n\n  // Phase 2: Execute\n  await execute(validation);\n\n  // Success!\n  const repoUrl = await exec(\"git remote get-url origin\", { silent: true });\n  const cleanUrl = repoUrl\n    .replace(/\\.git$/, \"\")\n    .replace(/.*github\\.com[:/]/, \"\");\n\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Release complete                                         ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(`\\n  Version: v${validation.newVersion}`);\n  log(\"\");\n  log(\"  What happened:\");\n  log(\"    ✓ Release commits created on develop\");\n  log(\"    ✓ develop pushed to origin\");\n  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n  log(\"\");\n  log(\"  CI will now:\");\n  log(\"    1. Run tests\");\n  log(\n    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n  );\n  log(\"    3. Build platform executables\");\n  log(\"    4. Create GitHub release\");\n  log(\"\");\n  log(`  Track: https://github.com/${cleanUrl}/actions`);\n  log(\"\");\n  log(\"  Next (when CI passes):\");\n  log(\n    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n  );\n}\n\nmain().catch((error) => {\n  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n  process.exit(1);\n});\n","numLines":868,"startLine":1,"totalLines":868}},"timestamp":"2026-03-05T12:43:14.578Z"}
