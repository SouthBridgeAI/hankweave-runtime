       os: [ubuntu-latest, windows-latest, macos-latest]\n    57→\n    58→    steps:\n    59→      - name: Checkout code\n    60→        uses: actions/checkout@v4\n    61→\n    62→      - name: Setup environment\n    63→        uses: ./.github/actions/setup-environment\n    64→        with:\n    65→          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n    66→\n    67→      - name: Run tests\n    68→        uses: ./.github/actions/run-tests\n    69→\n    70→  init-e2e-normal:\n    71→    name: Init E2E - Normal Mode (${{ matrix.os }})\n    72→    runs-on: ${{ matrix.os }}\n    73→    timeout-minutes: ${{ matrix.os == 'windows-latest' && 30 || 15 }}\n    74→\n    75→    strategy:\n    76→      fail-fast: false\n    77→      matrix:\n    78→        os: [ubuntu-latest, windows-latest, macos-latest]\n    79→\n    80→    steps:\n    81→      - name: Checkout code\n    82→        uses: actions/checkout@v4\n    83→\n    84→      - name: Setup environment\n    85→        uses: ./.github/actions/setup-environment\n    86→        with:\n    87→          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n    88→\n    89→      - name: Run init E2E test (normal mode) with retry\n    90→        uses: nick-fields/retry@v3\n    91→        with:\n    92→          timeout_minutes: ${{ matrix.os == 'windows-latest' && 20 || 15 }}\n    93→          max_attempts: 3\n    94→          retry_wait_seconds: 10\n    95→          command: bun run test:e2e:init\n    96→\n    97→      - name: Dump server logs on failure\n    98→        if: failure()\n    99→        uses: ./.github/actions/dump-test-logs\n   100→\n   101→  init-e2e-npx:\n   102→    name: Init E2E - NPX Mode (${{ matrix.os }})\n   103→    runs-on: ${{ matrix.os }}\n   104→    timeout-minutes: 15\n   105→\n   106→    strategy:\n   107→      fail-fast: false\n   108→      matrix:\n   109→        os: [ubuntu-latest, macos-latest]\n   110→\n   111→    steps:\n   112→      - name: Checkout code\n   113→        uses: actions/checkout@