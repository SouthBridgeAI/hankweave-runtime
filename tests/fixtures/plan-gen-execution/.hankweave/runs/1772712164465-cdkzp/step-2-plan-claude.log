{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VM1b3eoibsCyEmivfedPMF","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→/**\n     3→ * Build script for Hankweave standalone executable\n     4→ *\n     5→ * This script compiles the Hankweave server into a single standalone\n     6→ * executable that includes all necessary Claude SDK files embedded.\n     7→ *\n     8→ * Usage:\n     9→ *   bun scripts/build-executable.ts [target] [output]\n    10→ *\n    11→ * Arguments:\n    12→ *   target   - Build target: linux-x64, linux-arm64, darwin-x64, darwin-arm64, windows-x64\n    13→ *              Defaults to current platform\n    14→ *   output   - Output filename (defaults to 'hankweave' or 'hankweave.exe' for Windows)\n    15→ *\n    16→ * Examples:\n    17→ *   bun scripts/build-executable.ts                          # Build for current platform\n    18→ *   bun scripts/build-executable.ts linux-x64                # Build for Linux x64\n    19→ *   bun scripts/build-executable.ts darwin-arm64 my-binary   # Build for macOS ARM64 with custom name\n    20→ */\n    21→\n    22→import { spawn } from \"node:child_process\";\n    23→import fs from \"node:fs\";\n    24→import os from \"node:os\";\n    25→import path from \"node:path\";\n    26→import { getCodexPlatform } from \"../server/codex-runtime-extractor.js\";\n    27→\n    28→// Configuration\n    29→const SDK_PATH = \"node_modules/@anthropic-ai/claude-agent-sdk\";\n    30→const ENTRY_POINT = \"server/index.ts\";\n    31→const OUTPUT_DIR = \"releases\";\n    32→\n    33→// Get the platform-specific ripgrep directory\n    34→function getRipgrepPlatform(target?: string): string {\n    35→  if (target) {\n    36→    // Parse target like \"linux-x64\", \"darwin-arm64\"\n    37→    const [platform, arch] = target.split(\"-\");\n    38→    if (platform === \"darwin\") {\n    39→      return arch === \"arm64\" ? \"arm64-darwin\" : \"x64-darwin\";\n    40→    }\n    41→    if (platform === \"linux\") {\n    42→      return arch === \"arm64\" ? \"arm64-linux\" : \"x64-linux\";\n    43→    }\n    44→    if (platform === \"windows\") {\n    45→      return \"x64-win32\";\n    46→    }\n    47→  }\n    48→\n    49→  // Default to current platform\n    50→  const arch = os.arch();\n    51→  const platform = os.platform();\n    52→\n    53→  if (platform === \"darwin\") {\n    54→    return arch === \"arm64\" ? \"arm64-darwin\" : \"x64-darwin\";\n    55→  }\n    56→  if (platform === \"linux\") {\n    57→    return arch === \"arm64\" ? \"arm64-linux\" : \"x64-linux\";\n    58→  }\n    59→  if (platform === \"win32\") {\n    60→    return \"x64-win32\";\n    61→  }\n    62→  throw new Error(`Unsupported platform: ${platform}-${arch}`);\n    63→}\n    64→\n    65→// Get the platform-specific codex package directory name\n    66→// In codex-sdk v0.101.0+, binaries are in @openai/codex-<platform>-<arch>/vendor/\n    67→function getCodexPackageDir(target?: string): string {\n    68→  let platform: string;\n    69→  let arch: string;\n    70→\n    71→  if (target) {\n    72→    [platform, arch] = target.split(\"-\");\n    73→    // Map 'windows' to 'win32' to match npm package naming\n    74→    if (platform === \"windows\") platform = \"win32\";\n    75→  } else {\n    76→    platform = os.platform() === \"win32\" ? \"win32\" : os.platform();\n    77→    arch = os.arch() === \"arm64\" ? \"arm64\" : \"x64\";\n    78→  }\n    79→\n    80→  return `node_modules/@openai/codex-${platform}-${arch}`;\n    81→}\n    82→\n    83→// Get Bun target string\n    84→function getBunTarget(target?: string): string | undefined {\n    85→  if (!target) {\n    86→    return undefined;\n    87→  }\n    88→\n    89→  const targetMap: Record<string, string> = {\n    90→    \"linux-x64\": \"bun-linux-x64\",\n    91→    \"linux-arm64\": \"bun-linux-arm64\",\n    92→    \"darwin-x64\": \"bun-darwin-x64\",\n    93→    \"darwin-arm64\": \"bun-darwin-arm64\",\n    94→    \"windows-x64\": \"bun-windows-x64\",\n    95→  };\n    96→\n    97→  const bunTarget = targetMap[target];\n    98→  if (!bunTarget) {\n    99→    throw new Error(`Unknown target: ${target}. Valid targets: ${Object.keys(targetMap).join(\", \")}`);\n   100→  }\n   101→  return bunTarget;\n   102→}\n   103→\n   104→async function main() {\n   105→  const args = process.argv.slice(2);\n   106→  const target = args[0];\n   107→  const outputBase = args[1] || \"hankweave\";\n   108→\n   109→  // Ensure output directory exists\n   110→  if (!fs.existsSync(OUTPUT_DIR)) {\n   111→    fs.mkdirSync(OUTPUT_DIR, { recursive: true });\n   112→  }\n   113→\n   114→  // Determine output filename (in releases directory)\n   115→  const isWindows = target?.startsWith(\"windows\");\n   116→  const outputFileName = isWindows && !outputBase.endsWith(\".exe\") ? `${outputBase}.exe` : outputBase;\n   117→  const outputFile = path.join(OUTPUT_DIR, outputFileName);\n   118→\n   119→  // Prepare cli.bundle path for cleanup in finally block\n   120→  const cliSource = path.join(SDK_PATH, \"cli.js\");\n   121→  const cliBundle = path.join(SDK_PATH, \"cli.bundle\");\n   122→\n   123→  try {\n   124→    console.log(\"🔨 Building Hankweave standalone executable\\n\");\n   125→\n   126→    // Read version from package.json for build-time constants\n   127→    const packageJson = JSON.parse(fs.readFileSync(\"package.json\", \"utf-8\"));\n   128→    const buildVersion = packageJson.version;\n   129→    const buildDate = new Date().toISOString();\n   130→    const buildTarget = target || \"current-platform\";\n   131→\n   132→    console.log(`📝 Build metadata:`);\n   133→    console.log(`   Version: ${buildVersion}`);\n   134→    console.log(`   Target: ${buildTarget}`);\n   135→    console.log(`   Date: ${buildDate}\\n`);\n   136→\n   137→    // Verify SDKs exist\n   138→    if (!fs.existsSync(SDK_PATH)) {\n   139→      console.error(`❌ Claude Agent SDK not found at ${SDK_PATH}`);\n   140→      console.error(\"   Run 'bun install' first.\");\n   141→      process.exit(1);\n   142→    }\n   143→\n   144→    const codexPackageDir = getCodexPackageDir(target);\n   145→    if (!fs.existsSync(codexPackageDir)) {\n   146→      console.error(`❌ Codex platform package not found at ${codexPackageDir}`);\n   147→      console.error(\"   Run 'bun install' first. For cross-compilation, ensure the target platform package is available.\");\n   148→      process.exit(1);\n   149→    }\n   150→\n   151→    // Determine ripgrep and codex platforms\n   152→    const ripgrepPlatform = getRipgrepPlatform(target);\n   153→    const codexPlatform = getCodexPlatform(target);\n   154→    console.log(`📦 Target: ${target || \"current platform\"}`);\n   155→    console.log(`📦 Ripgrep platform: ${ripgrepPlatform}`);\n   156→    console.log(`📦 Codex platform: ${codexPlatform}`);\n   157→\n   158→    // Copy cli.js to cli.bundle to avoid Bun treating it as an entry point\n   159→    // Bun has special handling for .js files that prevents them from being embedded properly\n   160→    console.log(`\\n📋 Preparing cli.js for embedding...`);\n   161→    fs.copyFileSync(cliSource, cliBundle);\n   162→    console.log(`   ✓ Created temporary cli.bundle`);\n   163→\n   164→    // Build the list of files to embed (use relative paths - they work better with embedding)\n   165→    const codexBinaryName = isWindows ? \"codex.exe\" : \"codex\";\n   166→\n   167→    const filesToEmbed = [\n   168→      // Claude Agent SDK files\n   169→      // Note: We embed cli.bundle instead of cli.js to avoid Bun's special .js handling\n   170→      cliBundle,\n   171→      path.join(SDK_PATH, \"resvg.wasm\"),\n   172→      path.join(SDK_PATH, \"tree-sitter.wasm\"),\n   173→      path.join(SDK_PATH, \"tree-sitter-bash.wasm\"),\n   174→      path.join(SDK_PATH, \"vendor/ripgrep\", ripgrepPlatform, ripgrepPlatform === \"x64-win32\" ? \"rg.exe\" : \"rg\"),\n   175→      path.join(SDK_PATH, \"vendor/ripgrep\", ripgrepPlatform, \"ripgrep.node\"),\n   176→      // Codex SDK binary (platform-specific, v0.101.0+ uses separate @openai/codex-<platform>-<arch> packages)\n   177→      path.join(codexPackageDir, \"vendor\", codexPlatform, \"codex\", codexBinaryName),\n   178→      // Shim files (use .js extension for embedding compatibility)\n   179→      path.join(\"shims\", \"gemini\", \"index.js\"),\n   180→      path.join(\"shims\", \"codex\", \"index.js\"),\n   181→    ];\n   182→\n   183→    // Verify all files exist\n   184→    console.log(\"\\n📁 Files to embed:\");\n   185→    let totalEmbedSize = 0;\n   186→    for (const file of filesToEmbed) {\n   187→      if (!fs.existsSync(file)) {\n   188→        console.error(`❌ Required file not found: ${file}`);\n   189→        process.exit(1);\n   190→      }\n   191→      const size = fs.statSync(file).size;\n   192→      totalEmbedSize += size;\n   193→      console.log(`   ✓ ${file} (${(size / 1024 / 1024).toFixed(2)} MB)`);\n   194→    }\n   195→    console.log(`   Total: ${(totalEmbedSize / 1024 / 1024).toFixed(2)} MB`);\n   196→\n   197→    // Build target flag\n   198→    const bunTarget = getBunTarget(target);\n   199→\n   200→    // Build the arguments array for spawn\n   201→    // IMPORTANT: Entry point MUST come BEFORE --compile to avoid embedded .js files being treated as entry points\n   202→    const buildArgs = [\"build\", ENTRY_POINT, \"--compile\"];\n   203→\n   204→    if (bunTarget) {\n   205→      buildArgs.push(`--target=${bunTarget}`);\n   206→    }\n   207→\n   208→    // Disable content hashing for embedded files to preserve original names\n   209→    buildArgs.push(\"--asset-naming\", \"[name].[ext]\");\n   210→\n   211→    // Add embed flags\n   212→    for (const file of filesToEmbed) {\n   213→      buildArgs.push(\"--embed\", file);\n   214→    }\n   215→\n   216→    // Add build-time constants via --define\n   217→    // Note: Values must be valid JavaScript expressions (e.g., strings need quotes)\n   218→    buildArgs.push(\"--define\", `BUILD_VERSION=${JSON.stringify(buildVersion)}`);\n   219→    buildArgs.push(\"--define\", `BUILD_DATE=${JSON.stringify(buildDate)}`);\n   220→    buildArgs.push(\"--define\", `BUILD_TARGET=${JSON.stringify(buildTarget)}`);\n   221→\n   222→    buildArgs.push(\"--outfile\", outputFile);\n   223→\n   224→    console.log(`\\n🛠️  Build command:\\n   bun ${buildArgs.join(\" \")}\\n`);\n   225→    console.log(\"⏳ Building (this may take a moment)...\\n\");\n   226→\n   227→    // Run the build using spawn\n   228→    // Note: shell:false to avoid quote escaping issues with --define\n   229→    const buildProc = spawn(\"bun\", buildArgs, {\n   230→      cwd: process.cwd(),\n   231→      stdio: \"inherit\",\n   232→      shell: false,\n   233→    });\n   234→\n   235→    await new Promise<void>((resolve, reject) => {\n   236→      buildProc.on(\"exit\", (code) => {\n   237→        if (code === 0) {\n   238→          resolve();\n   239→        } else {\n   240→          reject(new Error(`Build process exited with code ${code}`));\n   241→        }\n   242→      });\n   243→      buildProc.on(\"error\", (error) => {\n   244→        reject(error);\n   245→      });\n   246→    });\n   247→\n   248→    // Verify output exists\n   249→    if (!fs.existsSync(outputFile)) {\n   250→      throw new Error(`Build appeared to succeed but output file not found: ${outputFile}`);\n   251→    }\n   252→\n   253→    const outputSize = fs.statSync(outputFile).size;\n   254→    console.log(`✅ Build complete!`);\n   255→    console.log(`📄 Output: ${outputFile} (${(outputSize / 1024 / 1024).toFixed(2)} MB)`);\n   256→\n   257→    // Make executable on Unix\n   258→    if (!isWindows) {\n   259→      fs.chmodSync(outputFile, 0o755);\n   260→      console.log(\"🔐 Made executable\");\n   261→    }\n   262→\n   263→    console.log(`\\n🎉 You can now run: ./${outputFile} --help`);\n   264→  } catch (error) {\n   265→    console.error(`\\n❌ Build failed: ${(error as Error).message}`);\n   266→    process.exit(1);\n   267→  } finally {\n   268→    // Clean up temporary cli.bundle file\n   269→    if (fs.existsSync(cliBundle)) {\n   270→      fs.unlinkSync(cliBundle);\n   271→      console.log(`\\n🧹 Cleaned up temporary cli.bundle`);\n   272→    }\n   273→  }\n   274→}\n   275→\n   276→main();\n   277→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6f6abf3a-0b5f-4251-a578-7f2d66ac9b9a","uuid":"2afba8d1-2266-4db2-97d9-1307e868f8fa","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/build-executable.ts","content":"#!/usr/bin/env bun\n/**\n * Build script for Hankweave standalone executable\n *\n * This script compiles the Hankweave server into a single standalone\n * executable that includes all necessary Claude SDK files embedded.\n *\n * Usage:\n *   bun scripts/build-executable.ts [target] [output]\n *\n * Arguments:\n *   target   - Build target: linux-x64, linux-arm64, darwin-x64, darwin-arm64, windows-x64\n *              Defaults to current platform\n *   output   - Output filename (defaults to 'hankweave' or 'hankweave.exe' for Windows)\n *\n * Examples:\n *   bun scripts/build-executable.ts                          # Build for current platform\n *   bun scripts/build-executable.ts linux-x64                # Build for Linux x64\n *   bun scripts/build-executable.ts darwin-arm64 my-binary   # Build for macOS ARM64 with custom name\n */\n\nimport { spawn } from \"node:child_process\";\nimport fs from \"node:fs\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport { getCodexPlatform } from \"../server/codex-runtime-extractor.js\";\n\n// Configuration\nconst SDK_PATH = \"node_modules/@anthropic-ai/claude-agent-sdk\";\nconst ENTRY_POINT = \"server/index.ts\";\nconst OUTPUT_DIR = \"releases\";\n\n// Get the platform-specific ripgrep directory\nfunction getRipgrepPlatform(target?: string): string {\n  if (target) {\n    // Parse target like \"linux-x64\", \"darwin-arm64\"\n    const [platform, arch] = target.split(\"-\");\n    if (platform === \"darwin\") {\n      return arch === \"arm64\" ? \"arm64-darwin\" : \"x64-darwin\";\n    }\n    if (platform === \"linux\") {\n      return arch === \"arm64\" ? \"arm64-linux\" : \"x64-linux\";\n    }\n    if (platform === \"windows\") {\n      return \"x64-win32\";\n    }\n  }\n\n  // Default to current platform\n  const arch = os.arch();\n  const platform = os.platform();\n\n  if (platform === \"darwin\") {\n    return arch === \"arm64\" ? \"arm64-darwin\" : \"x64-darwin\";\n  }\n  if (platform === \"linux\") {\n    return arch === \"arm64\" ? \"arm64-linux\" : \"x64-linux\";\n  }\n  if (platform === \"win32\") {\n    return \"x64-win32\";\n  }\n  throw new Error(`Unsupported platform: ${platform}-${arch}`);\n}\n\n// Get the platform-specific codex package directory name\n// In codex-sdk v0.101.0+, binaries are in @openai/codex-<platform>-<arch>/vendor/\nfunction getCodexPackageDir(target?: string): string {\n  let platform: string;\n  let arch: string;\n\n  if (target) {\n    [platform, arch] = target.split(\"-\");\n    // Map 'windows' to 'win32' to match npm package naming\n    if (platform === \"windows\") platform = \"win32\";\n  } else {\n    platform = os.platform() === \"win32\" ? \"win32\" : os.platform();\n    arch = os.arch() === \"arm64\" ? \"arm64\" : \"x64\";\n  }\n\n  return `node_modules/@openai/codex-${platform}-${arch}`;\n}\n\n// Get Bun target string\nfunction getBunTarget(target?: string): string | undefined {\n  if (!target) {\n    return undefined;\n  }\n\n  const targetMap: Record<string, string> = {\n    \"linux-x64\": \"bun-linux-x64\",\n    \"linux-arm64\": \"bun-linux-arm64\",\n    \"darwin-x64\": \"bun-darwin-x64\",\n    \"darwin-arm64\": \"bun-darwin-arm64\",\n    \"windows-x64\": \"bun-windows-x64\",\n  };\n\n  const bunTarget = targetMap[target];\n  if (!bunTarget) {\n    throw new Error(`Unknown target: ${target}. Valid targets: ${Object.keys(targetMap).join(\", \")}`);\n  }\n  return bunTarget;\n}\n\nasync function main() {\n  const args = process.argv.slice(2);\n  const target = args[0];\n  const outputBase = args[1] || \"hankweave\";\n\n  // Ensure output directory exists\n  if (!fs.existsSync(OUTPUT_DIR)) {\n    fs.mkdirSync(OUTPUT_DIR, { recursive: true });\n  }\n\n  // Determine output filename (in releases directory)\n  const isWindows = target?.startsWith(\"windows\");\n  const outputFileName = isWindows && !outputBase.endsWith(\".exe\") ? `${outputBase}.exe` : outputBase;\n  const outputFile = path.join(OUTPUT_DIR, outputFileName);\n\n  // Prepare cli.bundle path for cleanup in finally block\n  const cliSource = path.join(SDK_PATH, \"cli.js\");\n  const cliBundle = path.join(SDK_PATH, \"cli.bundle\");\n\n  try {\n    console.log(\"🔨 Building Hankweave standalone executable\\n\");\n\n    // Read version from package.json for build-time constants\n    const packageJson = JSON.parse(fs.readFileSync(\"package.json\", \"utf-8\"));\n    const buildVersion = packageJson.version;\n    const buildDate = new Date().toISOString();\n    const buildTarget = target || \"current-platform\";\n\n    console.log(`📝 Build metadata:`);\n    console.log(`   Version: ${buildVersion}`);\n    console.log(`   Target: ${buildTarget}`);\n    console.log(`   Date: ${buildDate}\\n`);\n\n    // Verify SDKs exist\n    if (!fs.existsSync(SDK_PATH)) {\n      console.error(`❌ Claude Agent SDK not found at ${SDK_PATH}`);\n      console.error(\"   Run 'bun install' first.\");\n      process.exit(1);\n    }\n\n    const codexPackageDir = getCodexPackageDir(target);\n    if (!fs.existsSync(codexPackageDir)) {\n      console.error(`❌ Codex platform package not found at ${codexPackageDir}`);\n      console.error(\"   Run 'bun install' first. For cross-compilation, ensure the target platform package is available.\");\n      process.exit(1);\n    }\n\n    // Determine ripgrep and codex platforms\n    const ripgrepPlatform = getRipgrepPlatform(target);\n    const codexPlatform = getCodexPlatform(target);\n    console.log(`📦 Target: ${target || \"current platform\"}`);\n    console.log(`📦 Ripgrep platform: ${ripgrepPlatform}`);\n    console.log(`📦 Codex platform: ${codexPlatform}`);\n\n    // Copy cli.js to cli.bundle to avoid Bun treating it as an entry point\n    // Bun has special handling for .js files that prevents them from being embedded properly\n    console.log(`\\n📋 Preparing cli.js for embedding...`);\n    fs.copyFileSync(cliSource, cliBundle);\n    console.log(`   ✓ Created temporary cli.bundle`);\n\n    // Build the list of files to embed (use relative paths - they work better with embedding)\n    const codexBinaryName = isWindows ? \"codex.exe\" : \"codex\";\n\n    const filesToEmbed = [\n      // Claude Agent SDK files\n      // Note: We embed cli.bundle instead of cli.js to avoid Bun's special .js handling\n      cliBundle,\n      path.join(SDK_PATH, \"resvg.wasm\"),\n      path.join(SDK_PATH, \"tree-sitter.wasm\"),\n      path.join(SDK_PATH, \"tree-sitter-bash.wasm\"),\n      path.join(SDK_PATH, \"vendor/ripgrep\", ripgrepPlatform, ripgrepPlatform === \"x64-win32\" ? \"rg.exe\" : \"rg\"),\n      path.join(SDK_PATH, \"vendor/ripgrep\", ripgrepPlatform, \"ripgrep.node\"),\n      // Codex SDK binary (platform-specific, v0.101.0+ uses separate @openai/codex-<platform>-<arch> packages)\n      path.join(codexPackageDir, \"vendor\", codexPlatform, \"codex\", codexBinaryName),\n      // Shim files (use .js extension for embedding compatibility)\n      path.join(\"shims\", \"gemini\", \"index.js\"),\n      path.join(\"shims\", \"codex\", \"index.js\"),\n    ];\n\n    // Verify all files exist\n    console.log(\"\\n📁 Files to embed:\");\n    let totalEmbedSize = 0;\n    for (const file of filesToEmbed) {\n      if (!fs.existsSync(file)) {\n        console.error(`❌ Required file not found: ${file}`);\n        process.exit(1);\n      }\n      const size = fs.statSync(file).size;\n      totalEmbedSize += size;\n      console.log(`   ✓ ${file} (${(size / 1024 / 1024).toFixed(2)} MB)`);\n    }\n    console.log(`   Total: ${(totalEmbedSize / 1024 / 1024).toFixed(2)} MB`);\n\n    // Build target flag\n    const bunTarget = getBunTarget(target);\n\n    // Build the arguments array for spawn\n    // IMPORTANT: Entry point MUST come BEFORE --compile to avoid embedded .js files being treated as entry points\n    const buildArgs = [\"build\", ENTRY_POINT, \"--compile\"];\n\n    if (bunTarget) {\n      buildArgs.push(`--target=${bunTarget}`);\n    }\n\n    // Disable content hashing for embedded files to preserve original names\n    buildArgs.push(\"--asset-naming\", \"[name].[ext]\");\n\n    // Add embed flags\n    for (const file of filesToEmbed) {\n      buildArgs.push(\"--embed\", file);\n    }\n\n    // Add build-time constants via --define\n    // Note: Values must be valid JavaScript expressions (e.g., strings need quotes)\n    buildArgs.push(\"--define\", `BUILD_VERSION=${JSON.stringify(buildVersion)}`);\n    buildArgs.push(\"--define\", `BUILD_DATE=${JSON.stringify(buildDate)}`);\n    buildArgs.push(\"--define\", `BUILD_TARGET=${JSON.stringify(buildTarget)}`);\n\n    buildArgs.push(\"--outfile\", outputFile);\n\n    console.log(`\\n🛠️  Build command:\\n   bun ${buildArgs.join(\" \")}\\n`);\n    console.log(\"⏳ Building (this may take a moment)...\\n\");\n\n    // Run the build using spawn\n    // Note: shell:false to avoid quote escaping issues with --define\n    const buildProc = spawn(\"bun\", buildArgs, {\n      cwd: process.cwd(),\n      stdio: \"inherit\",\n      shell: false,\n    });\n\n    await new Promise<void>((resolve, reject) => {\n      buildProc.on(\"exit\", (code) => {\n        if (code === 0) {\n          resolve();\n        } else {\n          reject(new Error(`Build process exited with code ${code}`));\n        }\n      });\n      buildProc.on(\"error\", (error) => {\n        reject(error);\n      });\n    });\n\n    // Verify output exists\n    if (!fs.existsSync(outputFile)) {\n      throw new Error(`Build appeared to succeed but output file not found: ${outputFile}`);\n    }\n\n    const outputSize = fs.statSync(outputFile).size;\n    console.log(`✅ Build complete!`);\n    console.log(`📄 Output: ${outputFile} (${(outputSize / 1024 / 1024).toFixed(2)} MB)`);\n\n    // Make executable on Unix\n    if (!isWindows) {\n      fs.chmodSync(outputFile, 0o755);\n      console.log(\"🔐 Made executable\");\n    }\n\n    console.log(`\\n🎉 You can now run: ./${outputFile} --help`);\n  } catch (error) {\n    console.error(`\\n❌ Build failed: ${(error as Error).message}`);\n    process.exit(1);\n  } finally {\n    // Clean up temporary cli.bundle file\n    if (fs.existsSync(cliBundle)) {\n      fs.unlinkSync(cliBundle);\n      console.log(`\\n🧹 Cleaned up temporary cli.bundle`);\n    }\n  }\n}\n\nmain();\n","numLines":277,"startLine":1,"totalLines":277}},"timestamp":"2026-03-05T12:12:54.723Z"}
