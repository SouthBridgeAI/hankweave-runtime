      # Create ~/.codex directory\n        mkdir -p ~/.codex\n\n        # Create auth.json from input (codex binary is bundled with @openai/codex-sdk package)\n        echo '${{ inputs.codex-auth-json }}' > ~/.codex/auth.json\n\n        # Verify file was created (for debugging)\n        if [ -f ~/.codex/auth.json ]; then\n          echo \"✓ auth.json created successfully\"\n        else\n          echo \"✗ Failed to create auth.json\"\n          exit 1\n        fi\n","numLines":58,"startLine":1,"totalLines":58}},"timestamp":"2026-03-05T12:12:45.814Z"}
