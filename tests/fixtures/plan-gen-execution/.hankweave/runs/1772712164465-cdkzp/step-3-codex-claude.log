{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mmdfron39825s6fz7k","content":"378:export function getMetadata(): AppMetadata {\n     1\timport fs from \"node:fs\";\n     2\timport os from \"node:os\";\n     3\timport path from \"node:path\";\n     4\timport { fileURLToPath } from \"node:url\";\n     5\timport type { Message, Peer } from \"crossws\";\n     6\timport { serve as crosswsServe } from \"crossws/server\";\n     7\t// Import cross-platform WebSocket client from crossws\n     8\t// This works in Node.js (18+), Bun, Deno, and browsers\n     9\timport WebSocket from \"crossws/websocket\";\n    10\timport glob from \"fast-glob\";\n    11\timport merge from \"lodash.merge\";\n    12\timport { z } from \"zod\";\n    13\timport { fileResolver } from \"./file-resolver.js\";\n    14\timport type { ClientCommand, FileNode, ServerEvent } from \"./types/types.js\";\n    15\timport type { WebSocketLogEntry } from \"./types/websocket-log-types.js\";\n    16\t\n    17\t// Re-export WebSocket for use throughout the codebase\n    18\t// This hides the crossws dependency as an implementation detail\n    19\texport { WebSocket };\n    20\t\n    21\t// -------------\n    22\t// ID Generation\n    23\t// -------------\n    24\t\n    25\texport function generateId(): string {\n    26\t  return `${Date.now()}-${Math.random().toString(36).substring(2, 11)}`;\n    27\t}\n    28\t\n    29\t// -------------\n    30\t// Logger\n    31\t// -------------\n    32\t\n    33\texport class Logger {\n    34\t  constructor(private logFile: string) {}\n    35\t\n    36\t  log(message: string, level: \"info\" | \"error\" | \"debug\" = \"info\"): void {\n    37\t    const timestamp = new Date().toISOString();\n    38\t    const logLine = `[${timestamp}] [${level.toUpperCase()}] ${message}\\n`;\n    39\t\n    40\t    try {\n    41\t      const logsDir = path.dirname(this.logFile);\n    42\t      if (!fs.existsSync(logsDir)) {\n    43\t        fs.mkdirSync(logsDir, { recursive: true });\n    44\t      }\n    45\t\n    46\t      fs.appendFileSync(this.logFile, logLine);\n    47\t    } catch (error) {\n    48\t      // If we can't write to file (e.g., during shutdown), just log to console\n    49\t      console.error(`Failed to write to log file: ${error}`);\n    50\t    }\n    51\t\n    52\t    if (level === \"error\") {\n    53\t      console.error(logLine.trim());\n    54\t    }\n    55\t  }\n    56\t\n    57\t  /**\n    58\t   * Log WebSocket traffic as JSONL (JSON Lines format).\n    59\t   * Each line is a complete JSON object representing a WebSocket message.\n    60\t   *\n    61\t   * @param socketLogFile - Path to the websocket log file\n    62\t   * @param direction - Whether this is an incoming or outgoing message\n    63\t   * @param data - The actual WebSocket message (ClientCommand or ServerEvent)\n    64\t   */\n    65\t  logWebSocketMessage(\n    66\t    socketLogFile: string,\n    67\t    direction: \"in\" | \"out\",\n    68\t    data: ClientCommand | ServerEvent,\n    69\t  ): void {\n    70\t    try {\n    71\t      // Create the log entry with minimal wrapper\n    72\t      const logEntry: WebSocketLogEntry = {\n    73\t        loggedAt: new Date().toISOString(),\n    74\t        direction,\n    75\t        message: data,\n    76\t        metadata: {\n    77\t          // Calculate message size\n    78\t          size: JSON.stringify(data).length,\n    79\t        },\n    80\t      };\n    81\t\n    82\t      // Write as a single line of JSON (JSONL format)\n    83\t      const logLine = `${JSON.stringify(logEntry)}\\n`;\n    84\t\n    85\t      const logsDir = path.dirname(socketLogFile);\n    86\t      if (!fs.existsSync(logsDir)) {\n    87\t        fs.mkdirSync(logsDir, { recursive: true });\n    88\t      }\n    89\t\n    90\t      fs.appendFileSync(socketLogFile, logLine);\n    91\t    } catch (error) {\n    92\t      // If we can't log to file, at least log the error\n    93\t      console.error(`Failed to log WebSocket message: ${error}`);\n    94\t    }\n    95\t  }\n    96\t\n    97\t  /**\n    98\t   * @deprecated Use logWebSocketMessage instead\n    99\t   */\n   100\t  logSocketTraffic(socketLogFile: string, direction: \"in\" | \"out\", data: unknown): void {\n   101\t    // For backward compatibility, convert to new format\n   102\t    this.logWebSocketMessage(socketLogFile, direction, data as ClientCommand | ServerEvent);\n   103\t  }\n   104\t}\n   105\t\n   106\t// -------------\n   107\t// File System Utilities\n   108\t// -------------\n   109\t\n   110\t/**\n   111\t * Build a hierarchical file tree from files matching a pattern.\n   112\t *\n   113\t * Creates a tree structure suitable for UI display, with directories\n   114\t * as nodes containing their children. Used for filetree.updated events.\n   115\t * Includes last modified times for files.\n   116\t *\n   117\t * @param projectPath - Base directory\n   118\t * @param pattern - Glob pattern to match files\n   119\t * @returns Root nodes of the file tree\n   120\t */\n"}]},"timestamp":"2026-03-05T12:28:32.913Z"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mmdfrq1ahh7jh1xkdx","content":"   340\t  }\n   341\t\n   342\t  /**\n   343\t   * Get the build date (if available)\n   344\t   */\n   345\t  get buildDate(): string | undefined {\n   346\t    return this.data.buildDate;\n   347\t  }\n   348\t\n   349\t  /**\n   350\t   * Get the build target (if available)\n   351\t   */\n   352\t  get buildTarget(): string | undefined {\n   353\t    return this.data.buildTarget;\n   354\t  }\n   355\t\n   356\t  /**\n   357\t   * Get raw metadata object\n   358\t   */\n   359\t  toObject(): Metadata {\n   360\t    return { ...this.data };\n   361\t  }\n   362\t}\n   363\t\n   364\t// Cached metadata to avoid repeated file reads/imports\n   365\tlet cachedMetadata: AppMetadata | null = null;\n   366\tconst FALLBACK_VERSION = \"1.0.0\";\n   367\t\n   368\t/**\n   369\t * Get application metadata (version, build info, etc.).\n   370\t * Works in both development (reads from filesystem) and compiled executable\n   371\t * (uses build-time constants) contexts.\n   372\t *\n   373\t * In compiled mode: Uses BUILD_VERSION, BUILD_DATE, BUILD_TARGET constants\n   374\t * In dev mode: Reads from package.json\n   375\t *\n   376\t * @returns AppMetadata instance, or metadata with fallback version\n   377\t */\n   378\texport function getMetadata(): AppMetadata {\n   379\t  if (cachedMetadata) return cachedMetadata;\n   380\t\n   381\t  try {\n   382\t    // For compiled executables, use build-time constants\n   383\t    // These are injected via Bun's --define flag and replaced at compile-time\n   384\t    if (isCompiledExecutable()) {\n   385\t      try {\n   386\t        // Build-time constants are compile-time replacements\n   387\t        // They will be replaced with their actual values during compilation\n   388\t        const buildMetadata = {\n   389\t          version: BUILD_VERSION,\n   390\t          buildDate: BUILD_DATE,\n   391\t          buildTarget: BUILD_TARGET,\n   392\t        };\n   393\t        cachedMetadata = AppMetadata.create(buildMetadata);\n   394\t        return cachedMetadata as AppMetadata;\n   395\t      } catch {\n   396\t        // Fallback if constants are somehow not defined\n   397\t        cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n   398\t        return cachedMetadata as AppMetadata;\n   399\t      }\n   400\t    }\n   401\t\n   402\t    // Fallback: Read from package.json (dev mode)\n   403\t    const __dirname = path.dirname(fileURLToPath(import.meta.url));\n   404\t    const packageJsonPath = path.resolve(__dirname, \"../package.json\");\n   405\t    if (fs.existsSync(packageJsonPath)) {\n   406\t      const content = fs.readFileSync(packageJsonPath, \"utf-8\");\n   407\t      const pkg = JSON.parse(content);\n   408\t      cachedMetadata = AppMetadata.create({\n   409\t        version: pkg.version || FALLBACK_VERSION,\n   410\t      });\n   411\t    } else {\n   412\t      // Ultimate fallback\n   413\t      cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n   414\t    }\n   415\t  } catch {\n   416\t    cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n   417\t  }\n   418\t\n   419\t  return cachedMetadata as AppMetadata;\n   420\t}\n   421\t\n   422\t// ANSI color codes for terminal output\n   423\tconst STARTUP_COLORS = {\n   424\t  reset: \"\\x1b[0m\",\n   425\t  bold: \"\\x1b[1m\",\n   426\t  dim: \"\\x1b[2m\",\n   427\t  cyan: \"\\x1b[36m\",\n   428\t};\n   429\t\n   430\t/**\n   431\t * Render the startup banner box with version and platform info.\n   432\t * Matches the style of the codon structure boxes.\n   433\t */\n   434\texport function renderStartupBanner(): void {\n   435\t  const version = getMetadata().version;\n   436\t  const platform = process.platform;\n   437\t  const arch = process.arch;\n   438\t  const runtime = getRuntimeVersion();\n   439\t\n   440\t  const useColor = process.stdout.isTTY !== false;\n   441\t  const terminalWidth = process.stdout.columns || 80;\n   442\t  const boxWidth = Math.min(terminalWidth - 2, 70);\n   443\t  const innerWidth = boxWidth - 4;\n   444\t\n   445\t  const c = useColor ? STARTUP_COLORS : { reset: \"\", bold: \"\", dim: \"\", cyan: \"\" };\n   446\t\n   447\t  const titleLine = `Hankweave v${version}`;\n   448\t  const platformLine = `${platform} ${arch} • ${runtime}`;\n   449\t\n   450\t  console.log();\n   451\t  console.log(`${c.cyan}╭${\"─\".repeat(boxWidth - 2)}╮${c.reset}`);\n   452\t  console.log(\n   453\t    `${c.cyan}│${c.reset}  ${c.bold}${c.cyan}${titleLine.padEnd(innerWidth)}${c.reset}${c.cyan}│${c.reset}`,\n   454\t  );\n   455\t  console.log(\n   456\t    `${c.cyan}│${c.reset}  ${c.dim}${platformLine.padEnd(innerWidth)}${c.reset}${c.cyan}│${c.reset}`,\n   457\t  );\n   458\t  console.log(`${c.cyan}╰${\"─\".repeat(boxWidth - 2)}╯${c.reset}`);\n   459\t  console.log();\n   460\t}\n"}]},"timestamp":"2026-03-05T12:28:32.913Z"}
