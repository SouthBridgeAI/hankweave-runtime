{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mmdfsinao8ok6o6vg0","content":"     1\t#!/usr/bin/env bun\n     2\t\n     3\t/**\n     4\t * Release automation script for Hankweave\n     5\t *\n     6\t * Two-phase release: validate everything first (dry-run), then execute.\n     7\t * Automatic rollback on failure. Headless-friendly.\n     8\t *\n     9\t * Usage:\n    10\t *   bun run release:patch              # Interactive release\n    11\t *   bun run release:minor              # Minor version bump\n    12\t *   bun run release:major              # Major version bump\n    13\t *   bun scripts/release.ts patch --yes # Headless (no prompts)\n    14\t *   bun scripts/release.ts minor --dry-run  # Validate only\n    15\t *\n    16\t * Flags:\n    17\t *   --yes, -y       Skip all interactive prompts (for agents/CI)\n    18\t *   --dry-run       Validate everything but don't make changes\n    19\t *   --skip-checks   Skip typecheck and lint during validation\n    20\t */\n    21\t\n    22\timport { existsSync } from \"node:fs\";\n    23\timport { resolve } from \"node:path\";\n    24\t\n    25\t// ─── Argument parsing ────────────────────────────────────────────────\n    26\t\n    27\tconst args = process.argv.slice(2);\n    28\tconst BUMP_TYPE = args.find((a) => !a.startsWith(\"-\"));\n    29\tconst VALID_BUMP_TYPES = [\"patch\", \"minor\", \"major\"] as const;\n    30\ttype BumpType = (typeof VALID_BUMP_TYPES)[number];\n    31\t\n    32\tconst YES_MODE = args.includes(\"--yes\") || args.includes(\"-y\");\n    33\tconst DRY_RUN = args.includes(\"--dry-run\");\n    34\tconst SKIP_CHECKS = args.includes(\"--skip-checks\");\n    35\t\n    36\tif (!BUMP_TYPE || !VALID_BUMP_TYPES.includes(BUMP_TYPE as BumpType)) {\n    37\t  console.error(\"Error: Invalid or missing bump type\");\n    38\t  console.error(\"\");\n    39\t  console.error(\"Usage: bun scripts/release.ts <patch|minor|major> [flags]\");\n    40\t  console.error(\"\");\n    41\t  console.error(\"Flags:\");\n    42\t  console.error(\"  --yes, -y       Skip all prompts (headless/agent mode)\");\n    43\t  console.error(\"  --dry-run       Validate everything without making changes\");\n    44\t  console.error(\"  --skip-checks   Skip typecheck and lint during validation\");\n    45\t  process.exit(1);\n    46\t}\n    47\t\n    48\tconst ROOT = resolve(process.cwd());\n    49\tconst CHANGELOG_PATH = resolve(ROOT, \"CHANGELOG.md\");\n    50\tconst PACKAGE_JSON_PATH = resolve(ROOT, \"package.json\");\n    51\t\n    52\t/** Files/dirs stripped from release/alpha after each merge from develop.\n    53\t *  Used by both the dry-run merge check and the actual merge step. */\n    54\tconst INTERNAL_FILES_TO_STRIP = [\n    55\t  \"intermediates/\",\n    56\t  \"external-docs/\",\n    57\t  \"CLAUDE.md\",\n    58\t  \"CONTRIBUTING.md\",\n    59\t  \"standard-operating-procedures.md\",\n    60\t];\n    61\t\n    62\t// ─── Saved state for rollback ────────────────────────────────────────\n    63\t\n    64\tinterface ReleaseState {\n    65\t  developHead: string;\n    66\t  releaseAlphaHead: string;\n    67\t  startBranch: string;\n    68\t  newVersion: string | null;\n    69\t  developPushed: boolean;\n    70\t  releaseAlphaPushed: boolean;\n    71\t  tagPushed: boolean;\n    72\t  tagName: string | null;\n    73\t}\n    74\t\n    75\tconst state: ReleaseState = {\n    76\t  developHead: \"\",\n    77\t  releaseAlphaHead: \"\",\n    78\t  startBranch: \"\",\n    79\t  newVersion: null,\n    80\t  developPushed: false,\n    81\t  releaseAlphaPushed: false,\n    82\t  tagPushed: false,\n    83\t  tagName: null,\n    84\t};\n    85\t\n    86\t// ─── Helpers ─────────────────────────────────────────────────────────\n    87\t\n    88\tasync function exec(\n    89\t  command: string,\n    90\t  options: { silent?: boolean; allowFailure?: boolean } = {},\n    91\t): Promise<string> {\n    92\t  const proc = Bun.spawn([\"sh\", \"-c\", command], {\n    93\t    stdout: \"pipe\",\n    94\t    stderr: options.silent ? \"pipe\" : \"inherit\",\n    95\t  });\n    96\t\n    97\t  const exitCode = await proc.exited;\n    98\t  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n    99\t\n   100\t  if (exitCode !== 0 && !options.allowFailure) {\n   101\t    throw new Error(`Command failed (exit ${exitCode}): ${command}`);\n   102\t  }\n   103\t\n   104\t  return output.trim();\n   105\t}\n   106\t\n   107\tfunction log(msg: string) {\n   108\t  console.log(msg);\n   109\t}\n   110\t\n   111\tfunction logStep(msg: string) {\n   112\t  console.log(`\\n  ${msg}`);\n   113\t}\n   114\t\n   115\tfunction logOk(msg: string) {\n   116\t  console.log(`  ✓ ${msg}`);\n   117\t}\n   118\t\n   119\tfunction logWarn(msg: string) {\n   120\t  console.log(`  ! ${msg}`);\n   121\t}\n   122\t\n   123\tfunction logErr(msg: string) {\n   124\t  console.error(`  ✗ ${msg}`);\n   125\t}\n   126\t\n   127\t/**\n   128\t * Prompt the user for confirmation. In --yes mode, auto-confirms.\n   129\t * Returns true if confirmed, false if cancelled.\n   130\t */\n   131\tasync function confirm(message: string): Promise<boolean> {\n   132\t  if (YES_MODE) {\n   133\t    log(`  ${message} (auto-confirmed: --yes)`);\n   134\t    return true;\n   135\t  }\n   136\t\n   137\t  process.stdout.write(`  ${message} [y/N] `);\n   138\t\n   139\t  // Read a single line from stdin\n   140\t  const reader = Bun.stdin.stream().getReader();\n   141\t  const { value } = await reader.read();\n   142\t  reader.releaseLock();\n   143\t\n   144\t  const answer = value\n   145\t    ? new TextDecoder().decode(value).trim().toLowerCase()\n   146\t    : \"\";\n   147\t  return answer === \"y\" || answer === \"yes\";\n   148\t}\n   149\t\n   150\t/**\n   151\t * Compute what the new version would be without modifying package.json\n   152\t */\n   153\tfunction computeNewVersion(currentVersion: string, bumpType: string): string {\n   154\t  const [major, minor, patch] = currentVersion.split(\".\").map(Number);\n   155\t  switch (bumpType) {\n   156\t    case \"major\":\n   157\t      return `${major + 1}.0.0`;\n   158\t    case \"minor\":\n   159\t      return `${major}.${minor + 1}.0`;\n   160\t    case \"patch\":\n   161\t      return `${major}.${minor}.${patch + 1}`;\n   162\t    default:\n   163\t      throw new Error(`Invalid bump type: ${bumpType}`);\n   164\t  }\n   165\t}\n   166\t\n   167\t// ─── PHASE 1: Validation (dry-run safe) ──────────────────────────────\n   168\t\n   169\tinterface ValidationResult {\n   170\t  currentVersion: string;\n   171\t  newVersion: string;\n   172\t  changelogEntryCount: number;\n   173\t  changelogPreview: string[];\n   174\t  mergeWouldSucceed: boolean;\n   175\t  schemasWouldGenerate: boolean;\n   176\t  typecheckPassed: boolean | null; // null = skipped\n   177\t  lintPassed: boolean | null;\n   178\t}\n   179\t\n   180\tasync function validate(): Promise<ValidationResult> {\n   181\t  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n   182\t  log(\"║  Phase 1: Validation                                     ║\");\n   183\t  log(\"╚════════════════════════════════════════════════════════════╝\");\n   184\t\n   185\t  const result: ValidationResult = {\n   186\t    currentVersion: \"\",\n   187\t    newVersion: \"\",\n   188\t    changelogEntryCount: 0,\n   189\t    changelogPreview: [],\n   190\t    mergeWouldSucceed: false,\n   191\t    schemasWouldGenerate: false,\n   192\t    typecheckPassed: null,\n   193\t    lintPassed: null,\n   194\t  };\n   195\t\n   196\t  // 1. Check branch\n   197\t  logStep(\"Checking branch...\");\n   198\t  const currentBranch = await exec(\"git branch --show-current\", {\n   199\t    silent: true,\n   200\t  });\n   201\t  if (currentBranch !== \"develop\") {\n   202\t    logErr(`Must be on develop branch (currently on: ${currentBranch})`);\n   203\t    process.exit(1);\n   204\t  }\n   205\t  state.startBranch = currentBranch;\n   206\t  logOk(`On develop branch`);\n   207\t\n   208\t  // 2. Check clean working directory\n   209\t  logStep(\"Checking working directory...\");\n   210\t  const status = await exec(\"git status --porcelain\", { silent: true });\n   211\t  if (status) {\n   212\t    logErr(\"Uncommitted changes detected:\");\n   213\t    console.error(status);\n   214\t    process.exit(1);\n   215\t  }\n   216\t  logOk(\"Working directory is clean\");\n   217\t\n   218\t  // 3. Check remote sync\n   219\t  logStep(\"Checking remote sync...\");\n   220\t  await exec(\"git fetch origin\", { silent: true });\n   221\t\n   222\t  for (const branch of [\"develop\", \"release/alpha\"]) {\n   223\t    const localCommit = await exec(`git rev-parse ${branch}`, { silent: true });\n   224\t    const remoteCommit = await exec(`git rev-parse origin/${branch}`, {\n   225\t      silent: true,\n   226\t    });\n   227\t\n   228\t    if (localCommit !== remoteCommit) {\n   229\t      const ahead = parseInt(\n   230\t        await exec(`git rev-list --count origin/${branch}..${branch}`, {\n   231\t          silent: true,\n   232\t        }),\n   233\t      );\n   234\t      const behind = parseInt(\n   235\t        await exec(`git rev-list --count ${branch}..origin/${branch}`, {\n   236\t          silent: true,\n   237\t        }),\n   238\t      );\n   239\t\n   240\t      if (behind > 0 && ahead > 0) {\n   241\t        logErr(\n   242\t          `${branch} has diverged from remote (${ahead} ahead, ${behind} behind)`,\n   243\t        );\n   244\t        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   245\t        process.exit(1);\n   246\t      } else if (behind > 0) {\n   247\t        logErr(`${branch} is ${behind} commit(s) behind remote`);\n   248\t        logErr(`  Fix: git checkout ${branch} && git pull origin ${branch}`);\n   249\t        process.exit(1);\n   250\t      } else if (ahead > 0) {\n   251\t        logWarn(\n   252\t          `${branch} is ${ahead} commit(s) ahead of remote (will be pushed)`,\n   253\t        );\n   254\t      }\n   255\t    } else {\n   256\t      logOk(`${branch} is in sync with origin/${branch}`);\n   257\t    }\n   258\t  }\n   259\t\n   260\t  // Save pre-release state for rollback\n"}]},"timestamp":"2026-03-05T12:28:32.914Z"}
