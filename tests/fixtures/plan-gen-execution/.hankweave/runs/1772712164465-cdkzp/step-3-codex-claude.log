{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mmdfsrry5e4xzk0jbz","content":"source/hankweave-docs/nextra-site/content/index.mdx\nsource/hankweave-docs/nextra-site/content/guides/philosophy.mdx\nsource/hankweave-docs/nextra-site/content/guides/testing-hanks.mdx\nsource/hankweave-docs/nextra-site/content/guides/debugging.mdx\nsource/hankweave-docs/nextra-site/content/guides/advanced-patterns.mdx\nsource/hankweave-docs/nextra-site/content/guides/use-cases.mdx\nsource/hankweave-docs/nextra-site/content/guides/docker.mdx\nsource/hankweave-docs/nextra-site/content/guides/getting-started.mdx\nsource/hankweave-docs/nextra-site/content/guides/building-a-hank.mdx\nsource/hankweave-docs/nextra-site/content/guides/_meta.ts\nsource/hankweave-docs/nextra-site/content/examples/data-codebook.mdx\nsource/hankweave-docs/nextra-site/content/examples/_meta.ts\nsource/hankweave-docs/nextra-site/content/concepts/hanks.mdx\nsource/hankweave-docs/nextra-site/content/concepts/state-machine.mdx\nsource/hankweave-docs/nextra-site/content/concepts/checkpoints.mdx\nsource/hankweave-docs/nextra-site/content/concepts/rigs.mdx\nsource/hankweave-docs/nextra-site/content/concepts/loops.mdx\nsource/hankweave-docs/nextra-site/content/concepts/execution-flow.mdx\nsource/hankweave-docs/nextra-site/content/concepts/sentinels.mdx\nsource/hankweave-docs/nextra-site/content/concepts/execution-thread.mdx\nsource/hankweave-docs/nextra-site/content/concepts/codons.mdx\nsource/hankweave-docs/nextra-site/content/concepts/_meta.ts\nsource/hankweave-docs/nextra-site/content/_meta.ts\nsource/hankweave-docs/nextra-site/content/reference/llm-proxy.mdx\nsource/hankweave-docs/nextra-site/content/reference/configuration.mdx\nsource/hankweave-docs/nextra-site/content/reference/cli.mdx\nsource/hankweave-docs/nextra-site/content/reference/harnesses-and-shims.mdx\nsource/hankweave-docs/nextra-site/content/reference/sentinel-config.mdx\nsource/hankweave-docs/nextra-site/content/reference/api-keys-and-models.mdx\nsource/hankweave-docs/nextra-site/content/reference/client-libraries.mdx\nsource/hankweave-docs/nextra-site/content/reference/event-journal.mdx\nsource/hankweave-docs/nextra-site/content/reference/protocol.mdx\nsource/hankweave-docs/nextra-site/content/reference/files-and-directories.mdx\nsource/hankweave-docs/nextra-site/content/reference/telemetry.mdx\nsource/hankweave-docs/nextra-site/content/reference/performance.mdx\nsource/hankweave-docs/nextra-site/content/reference/state-file.mdx\nsource/hankweave-docs/nextra-site/content/reference/_meta.ts\n"}]},"timestamp":"2026-03-05T12:28:32.914Z"}
