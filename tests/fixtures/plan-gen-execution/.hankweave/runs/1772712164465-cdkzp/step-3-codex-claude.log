{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mmdfr9uu6a7qx5fndk","content":"     1\timport crypto from \"node:crypto\";\n     2\timport fs from \"node:fs\";\n     3\timport os from \"node:os\";\n     4\timport path from \"node:path\";\n     5\timport readline from \"node:readline\";\n     6\timport { DEFAULT_CONFIG } from \"./config.js\";\n     7\timport { findExecutionDirs, hashDataSource } from \"./data-hasher.js\";\n     8\timport { detectRuntime, getMetadata, getRuntimeVersion, isCompiledExecutable } from \"./utils.js\";\n     9\t\n    10\t/**\n    11\t * Check if we're in a non-interactive environment (CI, tests, pipes, etc.)\n    12\t */\n    13\tfunction isNonInteractive(): boolean {\n    14\t  // Check for common CI environment variables\n    15\t  if (\n    16\t    process.env.CI ||\n    17\t    process.env.GITHUB_ACTIONS ||\n    18\t    process.env.GITLAB_CI ||\n    19\t    process.env.JENKINS ||\n    20\t    process.env.CIRCLECI ||\n    21\t    process.env.TRAVIS\n    22\t  ) {\n    23\t    return true;\n    24\t  }\n    25\t\n    26\t  // Check for test environment (Bun sets NODE_ENV=test)\n    27\t  if (process.env.NODE_ENV === \"test\") {\n    28\t    return true;\n    29\t  }\n    30\t\n    31\t  // Both stdin and stdout must be TTY for interactive mode\n    32\t  if (!process.stdin.isTTY || !process.stdout.isTTY) {\n    33\t    return true;\n    34\t  }\n    35\t\n    36\t  return false;\n    37\t}\n    38\t\n    39\t/**\n    40\t * Prompt user for confirmation.\n    41\t * Returns true if user confirms, false otherwise.\n    42\t * In non-interactive environments, returns false immediately.\n    43\t */\n    44\tasync function promptConfirmation(message: string): Promise<boolean> {\n    45\t  // In non-interactive mode (CI, tests, pipes), default to false (don't continue)\n    46\t  if (isNonInteractive()) {\n    47\t    console.warn(\"⚠️  Non-interactive mode, skipping confirmation prompt.\");\n    48\t    return false;\n    49\t  }\n    50\t\n    51\t  const rl = readline.createInterface({\n    52\t    input: process.stdin,\n    53\t    output: process.stdout,\n    54\t  });\n    55\t\n    56\t  return new Promise((resolve) => {\n    57\t    // Add a timeout in case stdin hangs (defensive measure)\n    58\t    const timeout = setTimeout(() => {\n    59\t      rl.close();\n    60\t      console.warn(\"\\n⚠️  Prompt timed out, defaulting to no.\");\n    61\t      resolve(false);\n    62\t    }, 30000); // 30 second timeout\n    63\t\n    64\t    rl.question(`${message} [y/N] `, (answer) => {\n    65\t      clearTimeout(timeout);\n    66\t      rl.close();\n    67\t      resolve(answer.toLowerCase() === \"y\" || answer.toLowerCase() === \"yes\");\n    68\t    });\n    69\t  });\n    70\t}\n    71\t\n    72\t/**\n    73\t * Count files and directories in a path.\n    74\t */\n    75\tasync function countDirectoryContents(\n    76\t  dirPath: string,\n    77\t): Promise<{ files: number; directories: number }> {\n    78\t  const entries = await fs.promises.readdir(dirPath, { withFileTypes: true });\n    79\t  let files = 0;\n    80\t  let directories = 0;\n    81\t\n    82\t  for (const entry of entries) {\n    83\t    if (entry.isDirectory()) {\n    84\t      directories++;\n    85\t    } else {\n    86\t      files++;\n    87\t    }\n    88\t  }\n    89\t\n    90\t  return { files, directories };\n    91\t}\n    92\t\n    93\texport interface ExecutionSetup {\n    94\t  readOnlySourceDataPath: string; // Absolute path to original data\n    95\t  executionPath: string; // Absolute path where we run (outer directory)\n    96\t  agentRootPath: string; // Absolute path to agent workspace (executionPath + '/agentRoot')\n    97\t  rigArchivePath: string; // Absolute path to archive storage (executionPath + '/rigArchive')\n    98\t  dataPathInExecutionDir: string; // Always agentRootPath + '/read_only_data_source'\n    99\t  dataHash: string;\n   100\t  hankHash?: string; // Hash of hank.json content (for resume detection)\n   101\t  isNewExecution: boolean;\n   102\t  isResuming: boolean;\n   103\t  linkType: \"symlink\" | \"copy\";\n   104\t  configChanged?: boolean; // True if hank.json changed since last run\n   105\t  meta: {\n   106\t    createdAt: string;\n   107\t    lastUsed: string;\n   108\t    readOnlySourceResolvedDataPath: string;\n   109\t    version: string;\n   110\t    hankHash?: string;\n   111\t    hankPath?: string;\n   112\t    hankweaveVersion: string;\n   113\t    environment: {\n   114\t      invocationMethod: string;\n   115\t      platform: string;\n   116\t      arch: string;\n   117\t      osRelease: string;\n   118\t      runtime: string;\n   119\t    };\n   120\t  };\n   121\t}\n   122\t\n   123\texport async function setupExecutionEnvironment(options: {\n   124\t  readOnlySourceDataPath: string; // Already resolved to absolute\n   125\t  executionPath?: string; // Already resolved to absolute, or undefined\n   126\t  useSymlink?: boolean; // Default true, --copy flag sets to false\n   127\t  dataHashTimeLimit?: number; // Time limit for hashing\n   128\t  startNew?: boolean; // Force new execution\n   129\t  forceMode?: boolean; // Force operation in existing directories with .hankweave\n   130\t  skipConfirmation?: boolean; // Skip confirmation prompts (-y flag)\n   131\t  hankPath?: string; // Path to hank.json for hash tracking\n   132\t  ignoreDataMismatch?: boolean; // Skip data hash verification on resume\n   133\t}): Promise<ExecutionSetup> {\n   134\t  const {\n   135\t    readOnlySourceDataPath,\n   136\t    executionPath,\n   137\t    useSymlink = true,\n   138\t    dataHashTimeLimit = DEFAULT_CONFIG.dataHashTimeLimit,\n   139\t    startNew = false,\n   140\t    forceMode = false,\n   141\t    skipConfirmation = false,\n   142\t    hankPath,\n   143\t    ignoreDataMismatch = false,\n   144\t  } = options;\n   145\t\n   146\t  // Verify data source exists\n   147\t  if (!fs.existsSync(readOnlySourceDataPath)) {\n   148\t    throw new Error(`Data source not found: ${readOnlySourceDataPath}`);\n   149\t  }\n   150\t\n   151\t  const stats = await fs.promises.stat(readOnlySourceDataPath);\n   152\t  if (!stats.isDirectory() && !stats.isFile()) {\n   153\t    throw new Error(`Data source is not a file or directory: ${readOnlySourceDataPath}`);\n   154\t  }\n   155\t\n   156\t  // Calculate data hash (silent - the hash is displayed elsewhere)\n   157\t  const dataHash = await hashDataSource(readOnlySourceDataPath, dataHashTimeLimit);\n   158\t\n   159\t  let finalExecutionPath: string;\n   160\t  let isNewExecution = false;\n   161\t  let isResuming = false;\n   162\t  let configChanged = false;\n   163\t  let relinkDataSource = false;\n   164\t\n   165\t  // Calculate hank hash if path provided\n   166\t  let hankHash: string | undefined;\n   167\t  if (hankPath && fs.existsSync(hankPath)) {\n   168\t    const hankContent = await fs.promises.readFile(hankPath, \"utf-8\");\n   169\t    hankHash = crypto.createHash(\"sha256\").update(hankContent).digest(\"hex\");\n   170\t  }\n   171\t\n   172\t  if (executionPath) {\n   173\t    // Explicit execution path provided\n   174\t\n   175\t    // Tier 1: Managed execution directory safety\n   176\t    const managedExecBase = path.join(os.homedir(), \".hankweave-executions\");\n   177\t    if (executionPath.startsWith(managedExecBase)) {\n   178\t      // Allow resuming existing executions (they have .hankweave/execution-meta.json)\n   179\t      const metaPath = path.join(executionPath, \".hankweave\", \"execution-meta.json\");\n   180\t      if (!fs.existsSync(metaPath)) {\n   181\t        throw new Error(\n   182\t          `❌ Cannot create new execution in ~/.hankweave-executions/.\\n` +\n   183\t            `This location is reserved for auto-managed executions.\\n` +\n   184\t            `Use a different path for --execution, or omit --execution to auto-create here.`,\n   185\t        );\n   186\t      }\n   187\t      // Existing execution found — allow resume\n   188\t    }\n   189\t\n   190\t    if (startNew) {\n   191\t      // With --start-new, implement tiered safety\n   192\t      if (fs.existsSync(executionPath)) {\n   193\t        const entries = await fs.promises.readdir(executionPath);\n   194\t\n   195\t        if (entries.length > 0) {\n   196\t          const hasHankweave = entries.includes(\".hankweave\");\n   197\t\n   198\t          // Tier 2: Directory already has Hankweave execution\n   199\t          if (hasHankweave) {\n   200\t            if (forceMode) {\n   201\t              // Backup existing .hankweave\n   202\t              const timestamp = new Date().toISOString().replace(/[:.]/g, \"-\").slice(0, 19);\n   203\t              const backupPath = path.join(executionPath, `.hankweave.backup-${timestamp}`);\n   204\t              await fs.promises.rename(path.join(executionPath, \".hankweave\"), backupPath);\n   205\t              console.log(`📦 Backed up existing execution to: ${backupPath}`);\n   206\t            } else {\n   207\t              throw new Error(\n   208\t                `❌ Directory already contains execution state: ${executionPath}/.hankweave\\n` +\n   209\t                  `This directory has an existing Hankweave execution.\\n` +\n   210\t                  `Options:\\n` +\n   211\t                  `  • Resume this execution (default):\\n` +\n   212\t                  `      hankweave --execution ${executionPath}\\n` +\n   213\t                  `  • Start fresh, backup existing state:\\n` +\n   214\t                  `      hankweave --execution ${executionPath} --start-new --force\\n` +\n   215\t                  `      (state backed up to .hankweave.backup-{timestamp})\\n` +\n   216\t                  `  • Use a different directory:\\n` +\n   217\t                  `      hankweave --execution ./other-dir`,\n   218\t              );\n   219\t            }\n   220\t          } else {\n"}]},"timestamp":"2026-03-05T12:28:32.912Z"}
