lease complete                                         ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(`\\n  Version: v${validation.newVersion}`);\n  log(\"\");\n  log(\"  What happened:\");\n  log(\"    ✓ Release commits created on develop\");\n  log(\"    ✓ develop pushed to origin\");\n  log(\"    ✓ develop merged → release/alpha (internal files stripped)\");\n  log(`    ✓ Tag v${validation.newVersion} created and pushed`);\n  log(\"\");\n  log(\"  CI will now:\");\n  log(\"    1. Run tests\");\n  log(\n    `    2. Publish @southbridgeai/hankweave@${validation.newVersion} to npm`,\n  );\n  log(\"    3. Build platform executables\");\n  log(\"    4. Create GitHub release\");\n  log(\"\");\n  log(`  Track: https://github.com/${cleanUrl}/actions`);\n  log(\"\");\n  log(\"  Next (when CI passes):\");\n  log(\n    `    Trigger 'Sync to Public' workflow with version ${validation.newVersion}`,\n  );\n}\n\nmain().catch((error) => {\n  console.error(`\\n✗ Release failed: ${(error as Error).message}`);\n  process.exit(1);\n});\n","numLines":868,"startLine":1,"totalLines":868}},"timestamp":"2026-03-05T13:03:02.986Z"}
