{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M3hXPXpptHoNj3b84FFxdu","type":"tool_result","content":"     1→import { beforeAll, describe, expect, test } from \"bun:test\";\n     2→import * as fs from \"node:fs\";\n     3→import * as path from \"node:path\";\n     4→import Ajv, { type ValidateFunction } from \"ajv\";\n     5→import addFormats from \"ajv-formats\";\n     6→\n     7→// Helper to create a fresh AJV instance (needed to avoid schema ID conflicts)\n     8→function createAjv(): Ajv {\n     9→  const ajv = new Ajv({ allErrors: true, strict: false });\n    10→  addFormats(ajv);\n    11→  return ajv;\n    12→}\n    13→\n    14→// Helper to get the root definition from a schema with $ref\n    15→function getRootDefinition(schema: Record<string, unknown>): Record<string, unknown> | null {\n    16→  if (schema.definitions && schema.$ref) {\n    17→    const refPath = (schema.$ref as string).replace(\"#/definitions/\", \"\");\n    18→    return (schema.definitions as Record<string, Record<string, unknown>>)[refPath] || null;\n    19→  }\n    20→  return schema;\n    21→}\n    22→\n    23→describe(\"JSON Schema Generation\", () => {\n    24→  const schemaDir = path.join(import.meta.dir, \"../../schemas\");\n    25→\n    26→  describe(\"Schema file existence\", () => {\n    27→    test(\"hank.schema.json exists\", () => {\n    28→      expect(fs.existsSync(path.join(schemaDir, \"hank.schema.json\"))).toBe(true);\n    29→    });\n    30→\n    31→    test(\"hankweave.schema.json exists\", () => {\n    32→      expect(fs.existsSync(path.join(schemaDir, \"hankweave.schema.json\"))).toBe(true);\n    33→    });\n    34→\n    35→    test(\"sentinel.schema.json exists\", () => {\n    36→      expect(fs.existsSync(path.join(schemaDir, \"sentinel.schema.json\"))).toBe(true);\n    37→    });\n    38→  });\n    39→\n    40→  describe(\"Schema validity\", () => {\n    41→    test(\"hank.schema.json is valid JSON Schema draft-07\", () => {\n    42→      const ajv = createAjv();\n    43→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n    44→      expect(schema.$schema).toBe(\"http://json-schema.org/draft-07/schema#\");\n    45→      expect(schema.title).toContain(\"Hank\");\n    46→\n    47→      const validate = ajv.compile(schema);\n    48→      expect(typeof validate).toBe(\"function\");\n    49→    });\n    50→\n    51→    test(\"hankweave.schema.json is valid JSON Schema\", () => {\n    52→      const ajv = createAjv();\n    53→      const schema = JSON.parse(\n    54→        fs.readFileSync(path.join(schemaDir, \"hankweave.schema.json\"), \"utf-8\"),\n    55→      );\n    56→      const validate = ajv.compile(schema);\n    57→      expect(typeof validate).toBe(\"function\");\n    58→    });\n    59→\n    60→    test(\"sentinel.schema.json is valid JSON Schema\", () => {\n    61→      const ajv = createAjv();\n    62→      const schema = JSON.parse(\n    63→        fs.readFileSync(path.join(schemaDir, \"sentinel.schema.json\"), \"utf-8\"),\n    64→      );\n    65→      const validate = ajv.compile(schema);\n    66→      expect(typeof validate).toBe(\"function\");\n    67→    });\n    68→  });\n    69→\n    70→  describe(\"Schema structure\", () => {\n    71→    test(\"hank schema has required properties\", () => {\n    72→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n    73→\n    74→      // Schema uses $ref to definitions, so get the root definition\n    75→      const rootDef = getRootDefinition(schema);\n    76→      expect(rootDef).not.toBeNull();\n    77→\n    78→      // Should have top-level properties for hank files\n    79→      const properties = rootDef?.properties as Record<string, unknown>;\n    80→      expect(properties).toBeDefined();\n    81→      expect(properties.hank).toBeDefined();\n    82→      expect(properties.meta).toBeDefined();\n    83→      expect(properties.overrides).toBeDefined();\n    84→      expect(properties.$schema).toBeDefined(); // Must allow $schema\n    85→    });\n    86→\n    87→    test(\"hank schema requires hank array\", () => {\n    88→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n    89→      const rootDef = getRootDefinition(schema);\n    90→      expect(rootDef?.required).toContain(\"hank\");\n    91→    });\n    92→  });\n    93→\n    94→  describe(\"Hank schema validation\", () => {\n    95→    let validate: ValidateFunction;\n    96→\n    97→    beforeAll(() => {\n    98→      const ajv = createAjv();\n    99→      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n   100→      validate = ajv.compile(schema);\n   101→    });\n   102→\n   103→    test(\"accepts minimal valid hank config\", () => {\n   104→      const config = {\n   105→        hank: [\n   106→          {\n   107→            id: \"test-codon\",\n   108→            name: \"Test Codon\",\n   109→            model: \"sonnet\",\n   110→            continuationMode: \"fresh\",\n   111→            promptText: \"Hello world\",\n   112→          },\n   113→        ],\n   114→      };\n   115→      expect(validate(config)).toBe(true);\n   116→    });\n   117→\n   118→    test(\"accepts hank with $schema property\", () => {\n   119→      const config = {\n   120→        $schema: \"https://unpkg.com/hankweave@latest/schemas/hank.schema.json\",\n   121→        hank: [\n   122→          {\n   123→            id: \"test\",\n   124→            name: \"Test\",\n   125→            model: \"sonnet\",\n   126→            continuationMode: \"fresh\",\n   127→            promptText: \"test\",\n   128→          },\n   129→        ],\n   130→      };\n   131→      expect(validate(config)).toBe(true);\n   132→    });\n   133→\n   134→    test(\"accepts hank with loop\", () => {\n   135→      const config = {\n   136→        hank: [\n   137→          {\n   138→            type: \"loop\",\n   139→            id: \"test-loop\",\n   140→            name: \"Test Loop\",\n   141→            terminateOn: { type: \"iterationLimit\", limit: 3 },\n   142→            codons: [\n   143→              {\n   144→                id: \"loop-codon\",\n   145→                name: \"Loop Codon\",\n   146→                model: \"sonnet\",\n   147→                continuationMode: \"continue-previous\",\n   148→                promptText: \"iterate\",\n   149→              },\n   150→            ],\n   151→          },\n   152→        ],\n   153→      };\n   154→      expect(validate(config)).toBe(true);\n   155→    });\n   156→\n   157→    test(\"accepts config with meta\", () => {\n   158→      const config = {\n   159→        meta: { name: \"My Hank\", version: \"1.0.0\" },\n   160→        hank: [\n   161→          {\n   162→            id: \"test\",\n   163→            name: \"Test\",\n   164→            model: \"sonnet\",\n   165→            continuationMode: \"fresh\",\n   166→            promptText: \"test\",\n   167→          },\n   168→        ],\n   169→      };\n   170→      expect(validate(config)).toBe(true);\n   171→    });\n   172→\n   173→    test(\"accepts config with overrides\", () => {\n   174→      const config = {\n   175→        overrides: { model: \"opus\", dataHashTimeLimit: 10000 },\n   176→        hank: [\n   177→          {\n   178→            id: \"test\",\n   179→            name: \"Test\",\n   180→            model: \"sonnet\",\n   181→            continuationMode: \"fresh\",\n   182→            promptText: \"test\",\n   183→          },\n   184→        ],\n   185→      };\n   186→      expect(validate(config)).toBe(true);\n   187→    });\n   188→\n   189→    test(\"accepts config with promptFile instead of promptText\", () => {\n   190→      const config = {\n   191→        hank: [\n   192→          {\n   193→            id: \"test\",\n   194→            name: \"Test\",\n   195→            model: \"sonnet\",\n   196→            continuationMode: \"fresh\",\n   197→            promptFile: \"./prompts/test.md\",\n   198→          },\n   199→        ],\n   200→      };\n   201→      expect(validate(config)).toBe(true);\n   202→    });\n   203→\n   204→    test(\"accepts config with array promptFile\", () => {\n   205→      const config = {\n   206→        hank: [\n   207→          {\n   208→            id: \"test\",\n   209→            name: \"Test\",\n   210→            model: \"sonnet\",\n   211→            continuationMode: \"fresh\",\n   212→            promptFile: [\"./prompts/part1.md\", \"./prompts/part2.md\"],\n   213→          },\n   214→        ],\n   215→      };\n   216→      expect(validate(config)).toBe(true);\n   217→    });\n   218→\n   219→    test(\"rejects empty hank array\", () => {\n   220→      const config = { hank: [] };\n   221→      expect(validate(config)).toBe(false);\n   222→    });\n   223→\n   224→    test(\"rejects codon missing required id\", () => {\n   225→      const config = {\n   226→        hank: [{ name: \"Test\", model: \"sonnet\", continuationMode: \"fresh\", promptText: \"test\" }],\n   227→      };\n   228→      expect(validate(config)).toBe(false);\n   229→    });\n   230→\n   231→    test(\"rejects invalid continuationMode\", () => {\n   232→      const config = {\n   233→        hank: [\n   234→          {\n   235→            id: \"test\",\n   236→            name: \"Test\",\n   237→            model: \"sonnet\",\n   238→            continuationMode: \"invalid\",\n   239→            promptText: \"test\",\n   240→          },\n   241→        ],\n   242→      };\n   243→      expect(validate(config)).toBe(false);\n   244→    });\n   245→  });\n   246→\n   247→  describe(\"Runtime config schema validation\", () => {\n   248→    let validate: ValidateFunction;\n   249→\n   250→    beforeAll(() => {\n   251→      const ajv = createAjv();\n   252→      const schema = JSON.parse(\n   253→        fs.readFileSync(path.join(schemaDir, \"hankweave.schema.json\"), \"utf-8\"),\n   254→      );\n   255→      validate = ajv.compile(schema);\n   256→    });\n   257→\n   258→    test(\"accepts empty config (all fields optional)\", () => {\n   259→      expect(validate({})).toBe(true);\n   260→    });\n   261→\n   262→    test(\"accepts valid runtime config\", () => {\n   263→      const config = {\n   264→        port: 8080,\n   265→        autostart: false,\n   266→        model: \"opus\",\n   267→      };\n   268→      expect(validate(config)).toBe(true);\n   269→    });\n   270→\n   271→    test(\"rejects port as string\", () => {\n   272→      expect(validate({ port: \"8080\" })).toBe(false);\n   273→    });\n   274→  });\n   275→});\n   276→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_0152G7qmX7Ab8Jb7ebmwUoMZ","session_id":"c6374b5f-86c6-4583-a2d5-1355f78fbe1d","uuid":"099b7d8c-2ed5-4c9c-856d-07523ca1bb3f","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/tests/unit/json-schema.test.ts","content":"import { beforeAll, describe, expect, test } from \"bun:test\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport Ajv, { type ValidateFunction } from \"ajv\";\nimport addFormats from \"ajv-formats\";\n\n// Helper to create a fresh AJV instance (needed to avoid schema ID conflicts)\nfunction createAjv(): Ajv {\n  const ajv = new Ajv({ allErrors: true, strict: false });\n  addFormats(ajv);\n  return ajv;\n}\n\n// Helper to get the root definition from a schema with $ref\nfunction getRootDefinition(schema: Record<string, unknown>): Record<string, unknown> | null {\n  if (schema.definitions && schema.$ref) {\n    const refPath = (schema.$ref as string).replace(\"#/definitions/\", \"\");\n    return (schema.definitions as Record<string, Record<string, unknown>>)[refPath] || null;\n  }\n  return schema;\n}\n\ndescribe(\"JSON Schema Generation\", () => {\n  const schemaDir = path.join(import.meta.dir, \"../../schemas\");\n\n  describe(\"Schema file existence\", () => {\n    test(\"hank.schema.json exists\", () => {\n      expect(fs.existsSync(path.join(schemaDir, \"hank.schema.json\"))).toBe(true);\n    });\n\n    test(\"hankweave.schema.json exists\", () => {\n      expect(fs.existsSync(path.join(schemaDir, \"hankweave.schema.json\"))).toBe(true);\n    });\n\n    test(\"sentinel.schema.json exists\", () => {\n      expect(fs.existsSync(path.join(schemaDir, \"sentinel.schema.json\"))).toBe(true);\n    });\n  });\n\n  describe(\"Schema validity\", () => {\n    test(\"hank.schema.json is valid JSON Schema draft-07\", () => {\n      const ajv = createAjv();\n      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n      expect(schema.$schema).toBe(\"http://json-schema.org/draft-07/schema#\");\n      expect(schema.title).toContain(\"Hank\");\n\n      const validate = ajv.compile(schema);\n      expect(typeof validate).toBe(\"function\");\n    });\n\n    test(\"hankweave.schema.json is valid JSON Schema\", () => {\n      const ajv = createAjv();\n      const schema = JSON.parse(\n        fs.readFileSync(path.join(schemaDir, \"hankweave.schema.json\"), \"utf-8\"),\n      );\n      const validate = ajv.compile(schema);\n      expect(typeof validate).toBe(\"function\");\n    });\n\n    test(\"sentinel.schema.json is valid JSON Schema\", () => {\n      const ajv = createAjv();\n      const schema = JSON.parse(\n        fs.readFileSync(path.join(schemaDir, \"sentinel.schema.json\"), \"utf-8\"),\n      );\n      const validate = ajv.compile(schema);\n      expect(typeof validate).toBe(\"function\");\n    });\n  });\n\n  describe(\"Schema structure\", () => {\n    test(\"hank schema has required properties\", () => {\n      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n\n      // Schema uses $ref to definitions, so get the root definition\n      const rootDef = getRootDefinition(schema);\n      expect(rootDef).not.toBeNull();\n\n      // Should have top-level properties for hank files\n      const properties = rootDef?.properties as Record<string, unknown>;\n      expect(properties).toBeDefined();\n      expect(properties.hank).toBeDefined();\n      expect(properties.meta).toBeDefined();\n      expect(properties.overrides).toBeDefined();\n      expect(properties.$schema).toBeDefined(); // Must allow $schema\n    });\n\n    test(\"hank schema requires hank array\", () => {\n      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n      const rootDef = getRootDefinition(schema);\n      expect(rootDef?.required).toContain(\"hank\");\n    });\n  });\n\n  describe(\"Hank schema validation\", () => {\n    let validate: ValidateFunction;\n\n    beforeAll(() => {\n      const ajv = createAjv();\n      const schema = JSON.parse(fs.readFileSync(path.join(schemaDir, \"hank.schema.json\"), \"utf-8\"));\n      validate = ajv.compile(schema);\n    });\n\n    test(\"accepts minimal valid hank config\", () => {\n      const config = {\n        hank: [\n          {\n            id: \"test-codon\",\n            name: \"Test Codon\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptText: \"Hello world\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts hank with $schema property\", () => {\n      const config = {\n        $schema: \"https://unpkg.com/hankweave@latest/schemas/hank.schema.json\",\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptText: \"test\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts hank with loop\", () => {\n      const config = {\n        hank: [\n          {\n            type: \"loop\",\n            id: \"test-loop\",\n            name: \"Test Loop\",\n            terminateOn: { type: \"iterationLimit\", limit: 3 },\n            codons: [\n              {\n                id: \"loop-codon\",\n                name: \"Loop Codon\",\n                model: \"sonnet\",\n                continuationMode: \"continue-previous\",\n                promptText: \"iterate\",\n              },\n            ],\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts config with meta\", () => {\n      const config = {\n        meta: { name: \"My Hank\", version: \"1.0.0\" },\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptText: \"test\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts config with overrides\", () => {\n      const config = {\n        overrides: { model: \"opus\", dataHashTimeLimit: 10000 },\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptText: \"test\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts config with promptFile instead of promptText\", () => {\n      const config = {\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptFile: \"./prompts/test.md\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"accepts config with array promptFile\", () => {\n      const config = {\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"fresh\",\n            promptFile: [\"./prompts/part1.md\", \"./prompts/part2.md\"],\n          },\n        ],\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"rejects empty hank array\", () => {\n      const config = { hank: [] };\n      expect(validate(config)).toBe(false);\n    });\n\n    test(\"rejects codon missing required id\", () => {\n      const config = {\n        hank: [{ name: \"Test\", model: \"sonnet\", continuationMode: \"fresh\", promptText: \"test\" }],\n      };\n      expect(validate(config)).toBe(false);\n    });\n\n    test(\"rejects invalid continuationMode\", () => {\n      const config = {\n        hank: [\n          {\n            id: \"test\",\n            name: \"Test\",\n            model: \"sonnet\",\n            continuationMode: \"invalid\",\n            promptText: \"test\",\n          },\n        ],\n      };\n      expect(validate(config)).toBe(false);\n    });\n  });\n\n  describe(\"Runtime config schema validation\", () => {\n    let validate: ValidateFunction;\n\n    beforeAll(() => {\n      const ajv = createAjv();\n      const schema = JSON.parse(\n        fs.readFileSync(path.join(schemaDir, \"hankweave.schema.json\"), \"utf-8\"),\n      );\n      validate = ajv.compile(schema);\n    });\n\n    test(\"accepts empty config (all fields optional)\", () => {\n      expect(validate({})).toBe(true);\n    });\n\n    test(\"accepts valid runtime config\", () => {\n      const config = {\n        port: 8080,\n        autostart: false,\n        model: \"opus\",\n      };\n      expect(validate(config)).toBe(true);\n    });\n\n    test(\"rejects port as string\", () => {\n      expect(validate({ port: \"8080\" })).toBe(false);\n    });\n  });\n});\n","numLines":276,"startLine":1,"totalLines":276}},"timestamp":"2026-03-05T13:03:25.647Z"}
