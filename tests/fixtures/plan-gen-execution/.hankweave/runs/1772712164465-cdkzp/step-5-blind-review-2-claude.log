{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L4kMJjSPXUWMEnHaswkba3","type":"tool_result","content":"     1→#!/usr/bin/env bun\n     2→\n     3→/**\n     4→ * Local test script for sync-public.ts\n     5→ *\n     6→ * Tests the sync workflow locally before running in CI.\n     7→ *\n     8→ * Usage:\n     9→ *   bun scripts/test-sync-local.ts --version 0.1.40\n    10→ *   bun scripts/test-sync-local.ts --version 0.1.40 --push   # Actually push to public repo\n    11→ */\n    12→\n    13→import { existsSync } from \"node:fs\";\n    14→import { mkdir, rm } from \"node:fs/promises\";\n    15→import { resolve } from \"node:path\";\n    16→\n    17→const args = process.argv.slice(2);\n    18→\n    19→function getArg(name: string): string | undefined {\n    20→  const index = args.indexOf(`--${name}`);\n    21→  return index !== -1 ? args[index + 1] : undefined;\n    22→}\n    23→\n    24→const version = getArg(\"version\");\n    25→const shouldPush = args.includes(\"--push\");\n    26→const initialSync = args.includes(\"--initial\");\n    27→const useHead = args.includes(\"--use-head\");\n    28→\n    29→if (!version) {\n    30→  console.error(\"Usage: bun scripts/test-sync-local.ts --version X.Y.Z [--push] [--initial] [--use-head]\");\n    31→  console.error(\"  --push       Actually push to public repo (default: dry run)\");\n    32→  console.error(\"  --initial    Perform initial sync (full history) instead of snapshot\");\n    33→  console.error(\"  --use-head   Use current HEAD instead of the tag (for testing uncommitted changes)\");\n    34→  process.exit(1);\n    35→}\n    36→\n    37→const TEST_DIR = \"/tmp/hankweave-sync-test\";\n    38→const REPO_ROOT = resolve(import.meta.dir, \"..\");\n    39→const SYNC_SCRIPT = resolve(import.meta.dir, \"sync-public.ts\");\n    40→\n    41→async function exec(cmd: string, options: { cwd?: string; silent?: boolean } = {}): Promise<string> {\n    42→  console.log(`$ ${cmd}`);\n    43→  const proc = Bun.spawn([\"sh\", \"-c\", cmd], {\n    44→    cwd: options.cwd,\n    45→    stdout: \"pipe\",\n    46→    stderr: options.silent ? \"pipe\" : \"inherit\",\n    47→  });\n    48→\n    49→  const exitCode = await proc.exited;\n    50→  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n    51→\n    52→  if (exitCode !== 0 && !options.silent) {\n    53→    throw new Error(`Command failed (exit ${exitCode}): ${cmd}`);\n    54→  }\n    55→\n    56→  return output.trim();\n    57→}\n    58→\n    59→async function main() {\n    60→  console.log(\"╔════════════════════════════════════════════════════════════╗\");\n    61→  console.log(\"║              Testing Sync to Public Repo                   ║\");\n    62→  console.log(\"╚════════════════════════════════════════════════════════════╝\");\n    63→  console.log(`Version: v${version}`);\n    64→  console.log(`Mode: ${initialSync ? \"Initial sync (full history)\" : \"Snapshot sync\"}`);\n    65→  console.log(`Source: ${useHead ? \"Current HEAD (uncommitted changes included)\" : `Tag v${version}`}`);\n    66→  console.log(`Push: ${shouldPush ? \"YES - will push to public repo\" : \"No (dry run)\"}`);\n    67→  console.log(`Test directory: ${TEST_DIR}`);\n    68→  console.log(\"\");\n    69→\n    70→  // Clean up and create test directory\n    71→  if (existsSync(TEST_DIR)) {\n    72→    await rm(TEST_DIR, { recursive: true });\n    73→  }\n    74→  await mkdir(TEST_DIR, { recursive: true });\n    75→\n    76→  // Step 1: Clone the private repo\n    77→  if (useHead) {\n    78→    console.log(\"\\n=== Step 1: Copy current repo (HEAD) ===\");\n    79→    // Copy the current working directory (including uncommitted changes)\n    80→    await exec(`rsync -av --exclude='.git' --exclude='node_modules' --exclude='intermediates' ${REPO_ROOT}/ private/`, { cwd: TEST_DIR });\n    81→    // Initialize a git repo for the sync script to work\n    82→    await exec(`git init && git add -A && git commit -m \"Test snapshot\"`, { cwd: `${TEST_DIR}/private` });\n    83→  } else {\n    84→    console.log(\"\\n=== Step 1: Clone private repo at tag ===\");\n    85→    await exec(`git clone --branch v${version} ${REPO_ROOT} private`, { cwd: TEST_DIR });\n    86→  }\n    87→\n    88→  // Step 2: Clone public repo (before changelog extraction so we can detect last version)\n    89→  console.log(\"\\n=== Step 2: Clone public repo ===\");\n    90→  let lastPublicVersion = \"\";\n    91→  try {\n    92→    await exec(`git clone git@github.com:SouthBridgeAI/hankweave-runtime.git public`, { cwd: TEST_DIR });\n    93→    // Check out or create release/alpha\n    94→    const branchExists = await exec(`git ls-remote --heads origin release/alpha`, { cwd: `${TEST_DIR}/public`, silent: true });\n    95→    if (branchExists.includes(\"release/alpha\")) {\n    96→      await exec(`git checkout release/alpha`, { cwd: `${TEST_DIR}/public` });\n    97→      // Detect last public version from tags\n    98→      try {\n    99→        lastPublicVersion = await exec(`git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//'`, { cwd: `${TEST_DIR}/public`, silent: true });\n   100→      } catch {}\n   101→    } else {\n   102→      await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n   103→      await exec(`git rm -rf . 2>/dev/null || true`, { cwd: `${TEST_DIR}/public` });\n   104→    }\n   105→  } catch {\n   106→    console.log(\"⚠ Could not clone public repo - creating empty directory for testing\");\n   107→    await mkdir(`${TEST_DIR}/public`, { recursive: true });\n   108→    await exec(`git init`, { cwd: `${TEST_DIR}/public` });\n   109→    await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n   110→  }\n   111→\n   112→  if (lastPublicVersion) {\n   113→    console.log(`✓ Last public version: v${lastPublicVersion}`);\n   114→  } else {\n   115→    console.log(\"ℹ No previous public version found (first sync)\");\n   116→  }\n   117→\n   118→  const sinceFlag = lastPublicVersion ? ` --since ${lastPublicVersion}` : \"\";\n   119→\n   120→  // Step 3: Extract changelog\n   121→  console.log(\"\\n=== Step 3: Extract changelog ===\");\n   122→  await exec(`bun ${SYNC_SCRIPT} extract-changelog --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n   123→\n   124→  // Step 4: Prepare snapshot (for snapshot sync only)\n   125→  if (!initialSync) {\n   126→    console.log(\"\\n=== Step 4: Prepare snapshot ===\");\n   127→    await exec(`bun ${SYNC_SCRIPT} prepare-snapshot --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n   128→  }\n   129→\n   130→  // Step 5: Run sync\n   131→  if (initialSync) {\n   132→    console.log(\"\\n=== Step 5: Initial sync ===\");\n   133→    await exec(`bun ${SYNC_SCRIPT} initial-sync --version ${version}`, { cwd: TEST_DIR });\n   134→  } else {\n   135→    console.log(\"\\n=== Step 5: Snapshot sync ===\");\n   136→    await exec(`bun ${SYNC_SCRIPT} snapshot-sync --version ${version}`, { cwd: TEST_DIR });\n   137→  }\n   138→\n   139→  // Step 6: Create tag\n   140→  console.log(\"\\n=== Step 6: Create tag ===\");\n   141→  const forceFlag = initialSync ? \" --force\" : \"\";\n   142→  await exec(`bun ${SYNC_SCRIPT} create-tag --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n   143→\n   144→  // Show results\n   145→  console.log(\"\\n=== Results ===\");\n   146→  console.log(\"\\nFiles in public repo:\");\n   147→  await exec(`ls -la`, { cwd: `${TEST_DIR}/public` });\n   148→  \n   149→  console.log(\"\\nGit log:\");\n   150→  await exec(`git log --oneline -5`, { cwd: `${TEST_DIR}/public` });\n   151→\n   152→  console.log(\"\\npackage.json name:\");\n   153→  await exec(`node -p 'require(\"./package.json\").name'`, { cwd: `${TEST_DIR}/public` });\n   154→\n   155→  console.log(\"\\nRELEASE_NOTES.md:\");\n   156→  await exec(`cat RELEASE_NOTES.md`, { cwd: `${TEST_DIR}/public` });\n   157→\n   158→  // Check for files that should NOT be there\n   159→  console.log(\"\\n=== Verification ===\");\n   160→  const shouldNotExist = [\n   161→    \"intermediates\",\n   162→    \"external-docs\", \n   163→    \"CLAUDE.md\",\n   164→    \"Claude.md\",  // Check both cases\n   165→    \"CONTRIBUTING.md\",\n   166→    \"PUBLISHING-PLAN.md\",\n   167→    \"public-release-files\",\n   168→    \".github/actions\",  // Composite actions only used by private CI\n   169→    \"scripts/sync-public.ts\",\n   170→    \"scripts/test-sync-local.ts\",\n   171→    \"scripts/release.ts\",\n   172→    \"telemetry.md\",\n   173→    \"standard-operating-procedures.md\",\n   174→    \".github/workflows/ci.yml\",\n   175→  ];\n   176→\n   177→  let allGood = true;\n   178→  for (const path of shouldNotExist) {\n   179→    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n   180→      console.log(`❌ Should not exist: ${path}`);\n   181→      allGood = false;\n   182→    } else {\n   183→      console.log(`✓ Correctly removed: ${path}`);\n   184→    }\n   185→  }\n   186→\n   187→  // Check for files that SHOULD be there\n   188→  const shouldExist = [\n   189→    \"package.json\",\n   190→    \"README.md\",\n   191→    \".github/workflows/release.yml\",\n   192→    \"server\",  // Main source directory\n   193→  ];\n   194→\n   195→  for (const path of shouldExist) {\n   196→    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n   197→      console.log(`✓ Exists: ${path}`);\n   198→    } else {\n   199→      console.log(`❌ Missing: ${path}`);\n   200→      allGood = false;\n   201→    }\n   202→  }\n   203→\n   204→  if (!allGood) {\n   205→    console.log(\"\\n⚠ Some verification checks failed!\");\n   206→  } else {\n   207→    console.log(\"\\n✓ All verification checks passed!\");\n   208→  }\n   209→\n   210→  // Step 7: Push (optional)\n   211→  if (shouldPush) {\n   212→    console.log(\"\\n=== Step 7: Pushing to public repo ===\");\n   213→    await exec(`bun ${SYNC_SCRIPT} push --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n   214→    console.log(\"\\n✓ Pushed to public repo!\");\n   215→    console.log(`Check: https://github.com/SouthBridgeAI/hankweave-runtime/tree/release/alpha`);\n   216→  } else {\n   217→    console.log(\"\\n=== Dry run complete ===\");\n   218→    console.log(`Test directory: ${TEST_DIR}`);\n   219→    console.log(`To inspect: cd ${TEST_DIR}/public && ls -la`);\n   220→    console.log(`To push: bun scripts/test-sync-local.ts --version ${version} --push`);\n   221→  }\n   222→}\n   223→\n   224→main().catch((error) => {\n   225→  console.error(\"Error:\", error.message);\n   226→  process.exit(1);\n   227→});\n   228→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c6374b5f-86c6-4583-a2d5-1355f78fbe1d","uuid":"ce0800f5-4515-49c2-adac-762ad3b273e5","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/scripts/test-sync-local.ts","content":"#!/usr/bin/env bun\n\n/**\n * Local test script for sync-public.ts\n *\n * Tests the sync workflow locally before running in CI.\n *\n * Usage:\n *   bun scripts/test-sync-local.ts --version 0.1.40\n *   bun scripts/test-sync-local.ts --version 0.1.40 --push   # Actually push to public repo\n */\n\nimport { existsSync } from \"node:fs\";\nimport { mkdir, rm } from \"node:fs/promises\";\nimport { resolve } from \"node:path\";\n\nconst args = process.argv.slice(2);\n\nfunction getArg(name: string): string | undefined {\n  const index = args.indexOf(`--${name}`);\n  return index !== -1 ? args[index + 1] : undefined;\n}\n\nconst version = getArg(\"version\");\nconst shouldPush = args.includes(\"--push\");\nconst initialSync = args.includes(\"--initial\");\nconst useHead = args.includes(\"--use-head\");\n\nif (!version) {\n  console.error(\"Usage: bun scripts/test-sync-local.ts --version X.Y.Z [--push] [--initial] [--use-head]\");\n  console.error(\"  --push       Actually push to public repo (default: dry run)\");\n  console.error(\"  --initial    Perform initial sync (full history) instead of snapshot\");\n  console.error(\"  --use-head   Use current HEAD instead of the tag (for testing uncommitted changes)\");\n  process.exit(1);\n}\n\nconst TEST_DIR = \"/tmp/hankweave-sync-test\";\nconst REPO_ROOT = resolve(import.meta.dir, \"..\");\nconst SYNC_SCRIPT = resolve(import.meta.dir, \"sync-public.ts\");\n\nasync function exec(cmd: string, options: { cwd?: string; silent?: boolean } = {}): Promise<string> {\n  console.log(`$ ${cmd}`);\n  const proc = Bun.spawn([\"sh\", \"-c\", cmd], {\n    cwd: options.cwd,\n    stdout: \"pipe\",\n    stderr: options.silent ? \"pipe\" : \"inherit\",\n  });\n\n  const exitCode = await proc.exited;\n  const output = proc.stdout ? await new Response(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.silent) {\n    throw new Error(`Command failed (exit ${exitCode}): ${cmd}`);\n  }\n\n  return output.trim();\n}\n\nasync function main() {\n  console.log(\"╔════════════════════════════════════════════════════════════╗\");\n  console.log(\"║              Testing Sync to Public Repo                   ║\");\n  console.log(\"╚════════════════════════════════════════════════════════════╝\");\n  console.log(`Version: v${version}`);\n  console.log(`Mode: ${initialSync ? \"Initial sync (full history)\" : \"Snapshot sync\"}`);\n  console.log(`Source: ${useHead ? \"Current HEAD (uncommitted changes included)\" : `Tag v${version}`}`);\n  console.log(`Push: ${shouldPush ? \"YES - will push to public repo\" : \"No (dry run)\"}`);\n  console.log(`Test directory: ${TEST_DIR}`);\n  console.log(\"\");\n\n  // Clean up and create test directory\n  if (existsSync(TEST_DIR)) {\n    await rm(TEST_DIR, { recursive: true });\n  }\n  await mkdir(TEST_DIR, { recursive: true });\n\n  // Step 1: Clone the private repo\n  if (useHead) {\n    console.log(\"\\n=== Step 1: Copy current repo (HEAD) ===\");\n    // Copy the current working directory (including uncommitted changes)\n    await exec(`rsync -av --exclude='.git' --exclude='node_modules' --exclude='intermediates' ${REPO_ROOT}/ private/`, { cwd: TEST_DIR });\n    // Initialize a git repo for the sync script to work\n    await exec(`git init && git add -A && git commit -m \"Test snapshot\"`, { cwd: `${TEST_DIR}/private` });\n  } else {\n    console.log(\"\\n=== Step 1: Clone private repo at tag ===\");\n    await exec(`git clone --branch v${version} ${REPO_ROOT} private`, { cwd: TEST_DIR });\n  }\n\n  // Step 2: Clone public repo (before changelog extraction so we can detect last version)\n  console.log(\"\\n=== Step 2: Clone public repo ===\");\n  let lastPublicVersion = \"\";\n  try {\n    await exec(`git clone git@github.com:SouthBridgeAI/hankweave-runtime.git public`, { cwd: TEST_DIR });\n    // Check out or create release/alpha\n    const branchExists = await exec(`git ls-remote --heads origin release/alpha`, { cwd: `${TEST_DIR}/public`, silent: true });\n    if (branchExists.includes(\"release/alpha\")) {\n      await exec(`git checkout release/alpha`, { cwd: `${TEST_DIR}/public` });\n      // Detect last public version from tags\n      try {\n        lastPublicVersion = await exec(`git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//'`, { cwd: `${TEST_DIR}/public`, silent: true });\n      } catch {}\n    } else {\n      await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n      await exec(`git rm -rf . 2>/dev/null || true`, { cwd: `${TEST_DIR}/public` });\n    }\n  } catch {\n    console.log(\"⚠ Could not clone public repo - creating empty directory for testing\");\n    await mkdir(`${TEST_DIR}/public`, { recursive: true });\n    await exec(`git init`, { cwd: `${TEST_DIR}/public` });\n    await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n  }\n\n  if (lastPublicVersion) {\n    console.log(`✓ Last public version: v${lastPublicVersion}`);\n  } else {\n    console.log(\"ℹ No previous public version found (first sync)\");\n  }\n\n  const sinceFlag = lastPublicVersion ? ` --since ${lastPublicVersion}` : \"\";\n\n  // Step 3: Extract changelog\n  console.log(\"\\n=== Step 3: Extract changelog ===\");\n  await exec(`bun ${SYNC_SCRIPT} extract-changelog --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n\n  // Step 4: Prepare snapshot (for snapshot sync only)\n  if (!initialSync) {\n    console.log(\"\\n=== Step 4: Prepare snapshot ===\");\n    await exec(`bun ${SYNC_SCRIPT} prepare-snapshot --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n  }\n\n  // Step 5: Run sync\n  if (initialSync) {\n    console.log(\"\\n=== Step 5: Initial sync ===\");\n    await exec(`bun ${SYNC_SCRIPT} initial-sync --version ${version}`, { cwd: TEST_DIR });\n  } else {\n    console.log(\"\\n=== Step 5: Snapshot sync ===\");\n    await exec(`bun ${SYNC_SCRIPT} snapshot-sync --version ${version}`, { cwd: TEST_DIR });\n  }\n\n  // Step 6: Create tag\n  console.log(\"\\n=== Step 6: Create tag ===\");\n  const forceFlag = initialSync ? \" --force\" : \"\";\n  await exec(`bun ${SYNC_SCRIPT} create-tag --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n\n  // Show results\n  console.log(\"\\n=== Results ===\");\n  console.log(\"\\nFiles in public repo:\");\n  await exec(`ls -la`, { cwd: `${TEST_DIR}/public` });\n  \n  console.log(\"\\nGit log:\");\n  await exec(`git log --oneline -5`, { cwd: `${TEST_DIR}/public` });\n\n  console.log(\"\\npackage.json name:\");\n  await exec(`node -p 'require(\"./package.json\").name'`, { cwd: `${TEST_DIR}/public` });\n\n  console.log(\"\\nRELEASE_NOTES.md:\");\n  await exec(`cat RELEASE_NOTES.md`, { cwd: `${TEST_DIR}/public` });\n\n  // Check for files that should NOT be there\n  console.log(\"\\n=== Verification ===\");\n  const shouldNotExist = [\n    \"intermediates\",\n    \"external-docs\", \n    \"CLAUDE.md\",\n    \"Claude.md\",  // Check both cases\n    \"CONTRIBUTING.md\",\n    \"PUBLISHING-PLAN.md\",\n    \"public-release-files\",\n    \".github/actions\",  // Composite actions only used by private CI\n    \"scripts/sync-public.ts\",\n    \"scripts/test-sync-local.ts\",\n    \"scripts/release.ts\",\n    \"telemetry.md\",\n    \"standard-operating-procedures.md\",\n    \".github/workflows/ci.yml\",\n  ];\n\n  let allGood = true;\n  for (const path of shouldNotExist) {\n    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n      console.log(`❌ Should not exist: ${path}`);\n      allGood = false;\n    } else {\n      console.log(`✓ Correctly removed: ${path}`);\n    }\n  }\n\n  // Check for files that SHOULD be there\n  const shouldExist = [\n    \"package.json\",\n    \"README.md\",\n    \".github/workflows/release.yml\",\n    \"server\",  // Main source directory\n  ];\n\n  for (const path of shouldExist) {\n    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n      console.log(`✓ Exists: ${path}`);\n    } else {\n      console.log(`❌ Missing: ${path}`);\n      allGood = false;\n    }\n  }\n\n  if (!allGood) {\n    console.log(\"\\n⚠ Some verification checks failed!\");\n  } else {\n    console.log(\"\\n✓ All verification checks passed!\");\n  }\n\n  // Step 7: Push (optional)\n  if (shouldPush) {\n    console.log(\"\\n=== Step 7: Pushing to public repo ===\");\n    await exec(`bun ${SYNC_SCRIPT} push --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n    console.log(\"\\n✓ Pushed to public repo!\");\n    console.log(`Check: https://github.com/SouthBridgeAI/hankweave-runtime/tree/release/alpha`);\n  } else {\n    console.log(\"\\n=== Dry run complete ===\");\n    console.log(`Test directory: ${TEST_DIR}`);\n    console.log(`To inspect: cd ${TEST_DIR}/public && ls -la`);\n    console.log(`To push: bun scripts/test-sync-local.ts --version ${version} --push`);\n  }\n}\n\nmain().catch((error) => {\n  console.error(\"Error:\", error.message);\n  process.exit(1);\n});\n","numLines":228,"startLine":1,"totalLines":228}},"timestamp":"2026-03-05T13:03:08.950Z"}
