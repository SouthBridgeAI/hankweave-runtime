esponse(proc.stdout).text() : \"\";\n\n  if (exitCode !== 0 && !options.silent) {\n    throw new Error(`Command failed (exit ${exitCode}): ${cmd}`);\n  }\n\n  return output.trim();\n}\n\nasync function main() {\n  console.log(\"╔════════════════════════════════════════════════════════════╗\");\n  console.log(\"║              Testing Sync to Public Repo                   ║\");\n  console.log(\"╚════════════════════════════════════════════════════════════╝\");\n  console.log(`Version: v${version}`);\n  console.log(`Mode: ${initialSync ? \"Initial sync (full history)\" : \"Snapshot sync\"}`);\n  console.log(`Source: ${useHead ? \"Current HEAD (uncommitted changes included)\" : `Tag v${version}`}`);\n  console.log(`Push: ${shouldPush ? \"YES - will push to public repo\" : \"No (dry run)\"}`);\n  console.log(`Test directory: ${TEST_DIR}`);\n  console.log(\"\");\n\n  // Clean up and create test directory\n  if (existsSync(TEST_DIR)) {\n    await rm(TEST_DIR, { recursive: true });\n  }\n  await mkdir(TEST_DIR, { recursive: true });\n\n  // Step 1: Clone the private repo\n  if (useHead) {\n    console.log(\"\\n=== Step 1: Copy current repo (HEAD) ===\");\n    // Copy the current working directory (including uncommitted changes)\n    await exec(`rsync -av --exclude='.git' --exclude='node_modules' --exclude='intermediates' ${REPO_ROOT}/ private/`, { cwd: TEST_DIR });\n    // Initialize a git repo for the sync script to work\n    await exec(`git init && git add -A && git commit -m \"Test snapshot\"`, { cwd: `${TEST_DIR}/private` });\n  } else {\n    console.log(\"\\n=== Step 1: Clone private repo at tag ===\");\n    await exec(`git clone --branch v${version} ${REPO_ROOT} private`, { cwd: TEST_DIR });\n  }\n\n  // Step 2: Clone public repo (before changelog extraction so we can detect last version)\n  console.log(\"\\n=== Step 2: Clone public repo ===\");\n  let lastPublicVersion = \"\";\n  try {\n    await exec(`git clone git@github.com:SouthBridgeAI/hankweave-runtime.git public`, { cwd: TEST_DIR });\n    // Check out or create release/alpha\n    const branchExists = await exec(`git ls-remote --heads origin release/alpha`, { cwd: `${TEST_DIR}/public`, silent: true });\n    if (branchExists.includes(\"release/alpha\")) {\n      await exec(`git checkout release/alpha`, { cwd: `${TEST_DIR}/public` });\n      // Detect last public version from tags\n      try {\n        lastPublicVersion = await exec(`git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//'`, { cwd: `${TEST_DIR}/public`, silent: true });\n      } catch {}\n    } else {\n      await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n      await exec(`git rm -rf . 2>/dev/null || true`, { cwd: `${TEST_DIR}/public` });\n    }\n  } catch {\n    console.log(\"⚠ Could not clone public repo - creating empty directory for testing\");\n    await mkdir(`${TEST_DIR}/public`, { recursive: true });\n    await exec(`git init`, { cwd: `${TEST_DIR}/public` });\n    await exec(`git checkout --orphan release/alpha`, { cwd: `${TEST_DIR}/public` });\n  }\n\n  if (lastPublicVersion) {\n    console.log(`✓ Last public version: v${lastPublicVersion}`);\n  } else {\n    console.log(\"ℹ No previous public version found (first sync)\");\n  }\n\n  const sinceFlag = lastPublicVersion ? ` --since ${lastPublicVersion}` : \"\";\n\n  // Step 3: Extract changelog\n  console.log(\"\\n=== Step 3: Extract changelog ===\");\n  await exec(`bun ${SYNC_SCRIPT} extract-changelog --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n\n  // Step 4: Prepare snapshot (for snapshot sync only)\n  if (!initialSync) {\n    console.log(\"\\n=== Step 4: Prepare snapshot ===\");\n    await exec(`bun ${SYNC_SCRIPT} prepare-snapshot --version ${version}${sinceFlag}`, { cwd: TEST_DIR });\n  }\n\n  // Step 5: Run sync\n  if (initialSync) {\n    console.log(\"\\n=== Step 5: Initial sync ===\");\n    await exec(`bun ${SYNC_SCRIPT} initial-sync --version ${version}`, { cwd: TEST_DIR });\n  } else {\n    console.log(\"\\n=== Step 5: Snapshot sync ===\");\n    await exec(`bun ${SYNC_SCRIPT} snapshot-sync --version ${version}`, { cwd: TEST_DIR });\n  }\n\n  // Step 6: Create tag\n  console.log(\"\\n=== Step 6: Create tag ===\");\n  const forceFlag = initialSync ? \" --force\" : \"\";\n  await exec(`bun ${SYNC_SCRIPT} create-tag --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n\n  // Show results\n  console.log(\"\\n=== Results ===\");\n  console.log(\"\\nFiles in public repo:\");\n  await exec(`ls -la`, { cwd: `${TEST_DIR}/public` });\n  \n  console.log(\"\\nGit log:\");\n  await exec(`git log --oneline -5`, { cwd: `${TEST_DIR}/public` });\n\n  console.log(\"\\npackage.json name:\");\n  await exec(`node -p 'require(\"./package.json\").name'`, { cwd: `${TEST_DIR}/public` });\n\n  console.log(\"\\nRELEASE_NOTES.md:\");\n  await exec(`cat RELEASE_NOTES.md`, { cwd: `${TEST_DIR}/public` });\n\n  // Check for files that should NOT be there\n  console.log(\"\\n=== Verification ===\");\n  const shouldNotExist = [\n    \"intermediates\",\n    \"external-docs\", \n    \"CLAUDE.md\",\n    \"Claude.md\",  // Check both cases\n    \"CONTRIBUTING.md\",\n    \"PUBLISHING-PLAN.md\",\n    \"public-release-files\",\n    \".github/actions\",  // Composite actions only used by private CI\n    \"scripts/sync-public.ts\",\n    \"scripts/test-sync-local.ts\",\n    \"scripts/release.ts\",\n    \"telemetry.md\",\n    \"standard-operating-procedures.md\",\n    \".github/workflows/ci.yml\",\n  ];\n\n  let allGood = true;\n  for (const path of shouldNotExist) {\n    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n      console.log(`❌ Should not exist: ${path}`);\n      allGood = false;\n    } else {\n      console.log(`✓ Correctly removed: ${path}`);\n    }\n  }\n\n  // Check for files that SHOULD be there\n  const shouldExist = [\n    \"package.json\",\n    \"README.md\",\n    \".github/workflows/release.yml\",\n    \"server\",  // Main source directory\n  ];\n\n  for (const path of shouldExist) {\n    if (existsSync(`${TEST_DIR}/public/${path}`)) {\n      console.log(`✓ Exists: ${path}`);\n    } else {\n      console.log(`❌ Missing: ${path}`);\n      allGood = false;\n    }\n  }\n\n  if (!allGood) {\n    console.log(\"\\n⚠ Some verification checks failed!\");\n  } else {\n    console.log(\"\\n✓ All verification checks passed!\");\n  }\n\n  // Step 7: Push (optional)\n  if (shouldPush) {\n    console.log(\"\\n=== Step 7: Pushing to public repo ===\");\n    await exec(`bun ${SYNC_SCRIPT} push --version ${version}${forceFlag}`, { cwd: TEST_DIR });\n    console.log(\"\\n✓ Pushed to public repo!\");\n    console.log(`Check: https://github.com/SouthBridgeAI/hankweave-runtime/tree/release/alpha`);\n  } else {\n    console.log(\"\\n=== Dry run complete ===\");\n    console.log(`Test directory: ${TEST_DIR}`);\n    console.log(`To inspect: cd ${TEST_DIR}/public && ls -la`);\n    console.log(`To push: bun scripts/test-sync-local.ts --version ${version} --push`);\n  }\n}\n\nmain().catch((error) => {\n  console.error(\"Error:\", error.message);\n  process.exit(1);\n});\n```\n\n#### 10. **server/utils.ts** (lines 370-429)\n\n```typescript\n * Works in both development (reads from filesystem) and compiled executable\n * (uses build-time constants) contexts.\n *\n * In compiled mode: Uses BUILD_VERSION, BUILD_DATE, BUILD_TARGET constants\n * In dev mode: Reads from package.json\n *\n * @returns AppMetadata instance, or metadata with fallback version\n */\nexport function getMetadata(): AppMetadata {\n  if (cachedMetadata) return cachedMetadata;\n\n  try {\n    // For compiled executables, use build-time constants\n    // These are injected via Bun's --define flag and replaced at compile-time\n    if (isCompiledExecutable()) {\n      try {\n        // Build-time constants are compile-time replacements\n        // They will be replaced with their actual values during compilation\n        const buildMetadata = {\n          version: BUILD_VERSION,\n          buildDate: BUILD_DATE,\n          buildTarget: BUILD_TARGET,\n        };\n        cachedMetadata = AppMetadata.create(buildMetadata);\n        return cachedMetadata as AppMetadata;\n      } catch {\n        // Fallback if constants are somehow not defined\n        cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n        return cachedMetadata as AppMetadata;\n      }\n    }\n\n    // Fallback: Read from package.json (dev mode)\n    const __dirname = path.dirname(fileURLToPath(import.meta.url));\n    const packageJsonPath = path.resolve(__dirname, \"../package.json\");\n    if (fs.existsSync(packageJsonPath)) {\n      const content = fs.readFileSync(packageJsonPath, \"utf-8\");\n      const pkg = JSON.parse(content);\n      cachedMetadata = AppMetadata.create({\n        version: pkg.version || FALLBACK_VERSION,\n      });\n    } else {\n      // Ultimate fallback\n      cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n    }\n  } catch {\n    cachedMetadata = AppMetadata.create({ version: FALLBACK_VERSION });\n  }\n\n  return cachedMetadata as AppMetadata;\n}\n\n// ANSI color codes for terminal output\nconst STARTUP_COLORS = {\n  reset: \"\\x1b[0m\",\n  bold: \"\\x1b[1m\",\n  dim: \"\\x1b[2m\",\n  cyan: \"\\x1b[36m\",\n};\n```\n\n#### 11. **standard-operating-procedures.md** (Selected sections 1, 3, 4, 9)\n\n**Section 1: Repository Structure** (lines 9-42)\n```markdown\n## 1. Repository Structure\n\nhankweave-dev/              ← private repo (SouthBridgeAI/hankweave)\n├── server/                 ← runtime source code (TypeScript, Bun)\n├── scripts/                ← build, release, sync, and dev tooling\n├── tests/                  ← unit, integration, e2e, cross-runtime\n├── schemas/                ← generated JSON schemas (from Zod)\n├── shims/                  ← agent harness adapters\n├── learning/               ← example hanks and guides (ships to public)\n├── intermediates/          ← planning docs, numbered by feature (internal only)\n├── external-docs/          ← SDK reference docs for agent context (internal only)\n├── public-release-files/   ← files overlaid onto the public repo during sync\n├── assets/                 ← images, demo GIFs\n├── .github/                ← CI workflows and composite actions\n├── CHANGELOG.md            ← Keep a Changelog format, [Unreleased] workflow\n├── CONTRIBUTING.md         ← branch model and PR guidelines (internal only)\n└── package.json            ← @southbridgeai/hankweave (private npm)\n\nThere is a separate public repo at `SouthBridgeAI/hankweave-runtime` which receives sanitized snapshots via the sync workflow. It publishes the public `hankweave` npm package.\n\n### What gets stripped before public release\n\nThe sync process (`scripts/sync-public.ts`) removes internal-only content:\n\n- **Directories**: `intermediates/`, `external-docs/`, `public-release-files/`, `.github/actions/`\n- **Files**: `CLAUDE.md`, `CONTRIBUTING.md`, `PUBLISHING-PLAN.md`, `telemetry.md` (root), `reference/telemetry.md` (internal version), `.github/workflows/ci.yml`, `.github/workflows/sync-public.yml`, `scripts/sync-public.ts`, `scripts/test-sync-local.ts`, `scripts/release.ts`, `.DS_Store`\n\nThe `public-release-files/` directory contains replacements that get overlaid: a public-facing `README.md`, `LICENSE.md`, `NOTICE.md`, a sanitized `reference/telemetry.md`, and a simplified `.github/workflows/release.yml`.\n\nThe `package.json` is transformed: name becomes `hankweave`, `publishConfig.access` becomes `public`, `homepage` points to the public repo, and `release:*` scripts are removed.\n```\n\n**Section 3: Development Workflow** (lines 66-98)\n```markdown\n## 3. Development Workflow\n\n### The four-eyes principle\n\nWe operate on a **four-eyes principle** (ideally six, counting agents). The workflow for non-trivial changes:\n\n1. **Plan** — discuss the approach, often with an AI agent. Write a plan in `intermediates/<number>-<name>/plan.md` for larger features.\n2. **Review the plan** — read it critically. Replan if needed.\n3. **Implement** — have an agent write the code, or write it yourself.\n4. **Lint and test locally** — `bun run lint`, `bun run tc`, then tests (see testing order below).\n5. **Review the code line by line** — the author reads every line before pushing.\n6. **Push as a PR** — target `develop`. Include ticket numbers in the title.\n7. **Peer review** — another team member reviews before merging (~90% of the time, depending on size and risk).\n8. **Squash merge** — standard merge method. Keeps develop history clean.\n\n**Less code is more.** Hankweave has concurrent components and is deployed across multiple environments. Every line should be considered for its implications. Get as much reviewed locally before opening the PR.\n\nALL changes have at least two pairs of eyes reviewing them, and have enough deliberation. Often a review is requested from whoever is the implicit owner or originator of a section.\n\n### Intermediates\n\nThe `intermediates/` directory holds planning documents for features and investigations. Numbered sequentially (not tied to Linear tickets). Structure varies:\n\n- Single file: `intermediates/7-cleanup-integration-improvements.md`\n- Multi-phase: `intermediates/12-execution-isolation/1-plan.md` → `2-test-fixes.md` → `3-start-new.md` → `4-completed.md`\n- Bug reports: `intermediates/39-QoL-3/BUG_REPORT_HEADLESS_HTTP_CRASH.md`\n\nThese are stripped from release/alpha and the public repo.\n\n### External docs\n\n`external-docs/` holds SDK documentation and reference material (Claude Code SDK, AI SDK, Gemini CLI, etc.). These exist primarily so AI agents have context when working on integrations. Stripped before release.\n```\n\n**Section 4: PR Conventions** (lines 101-155)\n```markdown\n## 4. PR Conventions\n\n### Title format\n\nInclude Linear ticket numbers when applicable:\n\nFixes: Sentinel drains, telemetry fixes, rollback QoL (ENG-194, ENG-193)\nQuality-of-Life Improvements Batch 3 (ENG-158, ENG-180, ENG-179)\nCC not exiting Bug (ENG-186)\n\nLinear is connected to GitHub — including the ticket number in the PR title updates the issue status when the PR merges.\n\n### Body format\n\nPR bodies are detailed. For each change, include:\n\n- **Problem** — what was wrong or what was needed\n- **Fix/Approach** — what was done and why\n- **Files** — which files were touched\n\nBatched PRs (multiple related changes) number each change. See PR #110 for the canonical example (22 numbered sections covering sentinel fixes, telemetry, TUI improvements, docs, and tests).\n\n### Changelog entries\n\nChangelog entries are typically **assembled in the PR body first**, then cleaned up or redacted at release time. The format is:\n\n- **Bold feature/fix name** — Description covering the what and why in one sentence.\n\nExamples from the codebase:\n\n- **Sentinels watching `codon.completed` now reliably fire** — Added a second sentinel queue drain after the `codon.completed` event emission.\n- **Remote hank cache: hash-based freshness** — Branch caches now validate via `git ls-remote` instead of a 1-hour TTL.\n\n### Labels and milestones\n\nNot actively used. Tracking lives in Linear.\n\n### Merge method\n\n**Squash merge** is the standard. This collapses the branch into a single commit on develop with the PR title as the message.\n\nRebasing is used when working on sequential changes on the same branch. Force-push to a feature branch is okay if you're sure nobody else is on it. Otherwise, cross-merge.\n\n### Attribution and accountability\n\n- **Humans are responsible for all activity.** Nothing is committed or written that hasn't been read end-to-end by a human. Agents operate under their human's supervision and responsibility.\n- **Always quote AI agents.** If a PR body, plan, or document was written by an agent, say so (e.g., \"generated by Opus 4.6, reviewed by @hrishioa\"). If an agent produced a code change, the PR should note which parts were agent-generated. See PR #113 for an example.\n- **Do not add AI tools as committers** in git commits. The human who reviewed and approved the work is the author.\n```\n\n**Section 9: Key Files Reference** (lines 337-355)\n```markdown\n## 9. Key Files Reference\n\n| File                                   | Purpose                                                                       |\n| -------------------------------------- | ----------------------------------------------------------------------------- |\n| `server/index.ts`                      | CLI entry point — arg parsing, routing to commands                            |\n| `server/hankweave-runtime.ts`          | Core runtime — codon execution, state management, event emission              |\n| `server/config.ts`                     | 5-layer config resolution (defaults → hankweave.json → hank.json → env → CLI) |\n| `server/basic-tui.ts`                  | Built-in terminal UI (WebSocket client)                                       |\n| `server/codon-runner.ts`               | Runs individual codons via harness managers                                   |\n| `server/claude-agent-sdk-manager.ts`   | Claude Code SDK integration                                                   |\n| `server/shim-process-manager.ts`       | Process manager for shim-based harnesses (Codex, Gemini)                      |\n| `server/remote-hank.ts`                | Git-based remote hank fetching and caching                                    |\n| `server/sentinels/`                    | Sentinel system (event-triggered observers)                                   |\n| `server/telemetry/`                    | Anonymous usage telemetry (PostHog)                                           |\n| `server/schemas/event-schemas.ts`      | WebSocket event type definitions (Zod)                                        |\n| `server/config-validation/`            | Validation schemas for hank files and configs                                 |\n| `tests/utils/sentinel-test-harness.ts` | Shared test utilities for sentinel tests                                      |\n| `tests/utils/mock-llm.ts`              | Mock LLM provider for integration tests                                       |\n```\n\n#### 12. **.github/actions/setup-environment/action.yml** (lines 1-58)\n\n```yaml\nname: 'Setup Environment'\ndescription: 'Sets up Node.js, Bun, and project dependencies'\n\ninputs:\n  install-gemini:\n    description: 'Install gemini-cli globally'\n    required: false\n    default: 'true'\n  codex-auth-json:\n    description: 'Codex auth.json content for authentication (codex binary is bundled with @openai/codex-sdk)'\n    required: false\n    default: ''\n  registry-url:\n    description: 'Optional registry URL for npm publishing'\n    required: false\n    default: ''\n\nruns:\n  using: 'composite'\n  steps:\n    - name: Setup Node.js\n      uses: actions/setup-node@v4\n      with:\n        node-version: '20'\n        registry-url: ${{ inputs.registry-url || '' }}\n\n    - name: Setup Bun\n      uses: oven-sh/setup-bun@v2\n      with:\n        bun-version: latest\n\n    - name: Install dependencies\n      shell: bash\n      run: bun install --frozen-lockfile\n\n    - name: Install gemini-cli globally\n      if: inputs.install-gemini == 'true'\n      shell: bash\n      run: npm install -g @google/gemini-cli\n\n    - name: Setup Codex authentication\n      if: inputs.codex-auth-json != ''\n      shell: bash\n      run: |\n        # Create ~/.codex directory\n        mkdir -p ~/.codex\n\n        # Create auth.json from input (codex binary is bundled with @openai/codex-sdk package)\n        echo '${{ inputs.codex-auth-json }}' > ~/.codex/auth.json\n\n        # Verify file was created (for debugging)\n        if [ -f ~/.codex/auth.json ]; then\n          echo \"✓ auth.json created successfully\"\n        else\n          echo \"✗ Failed to create auth.json\"\n          exit 1\n        fi\n```\n\n#### 13. **.github/workflows/ci.yml** (lines 1-181)\n\n```yaml\nname: CI\n\non:\n  push:\n    branches:\n      - develop\n      - release/alpha\n  pull_request:\n    branches:\n      - develop\n\n# Codex binary is bundled with @openai/codex-sdk package (no system installation required)\n# Authentication is handled via ~/.codex/auth.json\n# Set CODEX_AUTH_JSON secret to a JSON string like: {\"apiKey\":\"sk-proj-...\"}\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\nenv:\n  CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}\n  GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}\n  # CODEX_API_KEY removed - now using auth.json from CODEX_AUTH_JSON secret\n  HANKWEAVE_SENTINEL_ANTHROPIC_API_KEY: ${{ secrets.HANKWEAVE_SENTINEL_ANTHROPIC_API_KEY }}\n\njobs:\n  lint-and-typecheck:\n    name: Lint and Type Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup environment\n        uses: ./.github/actions/setup-environment\n        with:\n          install-gemini: \"false\"\n          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n\n      - name: Run linting\n        run: bun run lint\n\n      - name: Run type check\n        run: bun run tc\n\n  tests:\n    name: Unit & Integration Tests (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: ${{ matrix.os == 'windows-latest' && 25 || 15 }}\n\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, windows-latest, macos-latest]\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup environment\n        uses: ./.github/actions/setup-environment\n        with:\n          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n\n      - name: Run tests\n        uses: ./.github/actions/run-tests\n\n  init-e2e-normal:\n    name: Init E2E - Normal Mode (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: ${{ matrix.os == 'windows-latest' && 30 || 15 }}\n\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, windows-latest, macos-latest]\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup environment\n        uses: ./.github/actions/setup-environment\n        with:\n          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n\n      - name: Run init E2E test (normal mode) with retry\n        uses: nick-fields/retry@v3\n        with:\n          timeout_minutes: ${{ matrix.os == 'windows-latest' && 20 || 15 }}\n          max_attempts: 3\n          retry_wait_seconds: 10\n          command: bun run test:e2e:init\n\n      - name: Dump server logs on failure\n        if: failure()\n        uses: ./.github/actions/dump-test-logs\n\n  init-e2e-npx:\n    name: Init E2E - NPX Mode (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 15\n\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, macos-latest]\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Setup environment\n        uses: ./.github/actions/setup-environment\n        with:\n          codex-auth-json: ${{ secrets.CODEX_AUTH_JSON }}\n\n      - name: Build package\n        run: bun run build\n\n      - name: Run init E2E test (npx mode) with retry\n        uses: nick-fields/retry@v3\n        env:\n          # Speed up npx by disabling unnecessary checks\n          npm_config_update_notifier: \"false\"\n          npm_config_fund: \"false\"\n          npm_config_audit: \"false\"\n        with:\n          timeout_minutes: ${{ matrix.os == 'windows-latest' && 20 || 15 }}\n          max_attempts: 3\n          retry_wait_seconds: 10\n          command: bun run test:e2e:init:npx\n\n      - name: Dump server logs on failure\n        if: failure()\n        uses: ./.github/actions/dump-test-logs\n\n  init-e2e-binary:\n    name: Init E2E - Binary Mode (${{ matrix.