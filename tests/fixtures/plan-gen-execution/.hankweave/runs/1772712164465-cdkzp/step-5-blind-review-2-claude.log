xclude\": [\n    \"node_modules\",\n    \".logs/**/*\",\n    \"intermediates/**/*\",\n    \"learning/**/*\",\n    \"tests/test-area/**/*\"\n  ]\n}\n","numLines":25,"startLine":1,"totalLines":25}},"timestamp":"2026-03-05T13:03:08.964Z"}
