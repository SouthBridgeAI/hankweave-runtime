use --skip-checks to skip.\");\n      process.exit(1);\n    }\n\n    logStep(\"Running lint...\");\n    try {\n      await exec(\"bun run lint\", { silent: true });\n      result.lintPassed = true;\n      logOk(\"Lint passed\");\n    } catch {\n      logErr(\"Lint failed. Fix errors or use --skip-checks to skip.\");\n      process.exit(1);\n    }\n  } else {\n    logStep(\"Skipping typecheck and lint (--skip-checks)\");\n    result.typecheckPassed = null;\n    result.lintPassed = null;\n  }\n\n  return result;\n}\n\n// ─── PHASE 2: Execute ────────────────────────────────────────────────\n\nasync function execute(validation: ValidationResult): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Phase 2: Execute                                        ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const { newVersion } = validation;\n  const tag = `v${newVersion}`;\n  state.tagName = tag;\n\n  try {\n    // ── Step 1: Local changes on develop ──────────────────────────\n\n    logStep(`Bumping version to ${newVersion}...`);\n    await exec(`npm version ${BUMP_TYPE} --no-git-tag-version`);\n    logOk(`package.json updated to ${newVersion}`);\n\n    logStep(\"Stamping CHANGELOG...\");\n    const changelog = await Bun.file(CHANGELOG_PATH).text();\n    const date = new Date().toISOString().split(\"T\")[0];\n    const stampedChangelog = changelog.replace(\n      \"## [Unreleased]\",\n      `## [${newVersion}] - ${date}`,\n    );\n    await Bun.write(CHANGELOG_PATH, stampedChangelog);\n    logOk(`[Unreleased] → [${newVersion}] - ${date}`);\n\n    logStep(\"Regenerating schemas...\");\n    await exec(\"bun run generate-schemas\");\n    logOk(\"Schemas regenerated\");\n\n    logStep(\"Creating release commit...\");\n    await exec(\"git add package.json CHANGELOG.md schemas/\");\n    await exec(`git commit -m \"Release v${newVersion}\"`);\n    logOk(`Committed \"Release v${newVersion}\" on develop`);\n\n    logStep(\"Adding [Unreleased] section...\");\n    const updatedChangelog = await Bun.file(CHANGELOG_PATH).text();\n    const lines = updatedChangelog.split(\"\\n\");\n    const firstHeadingIndex = lines.findIndex((line) =>\n      line.startsWith(\"## [\"),\n    );\n    if (firstHeadingIndex !== -1) {\n      lines.splice(\n        firstHeadingIndex,\n        0,\n        ...[\n          \"## [Unreleased]\",\n          \"\",\n          \"### Added\",\n          \"- \",\n          \"\",\n          \"### Changed\",\n          \"- \",\n          \"\",\n          \"### Fixed\",\n          \"- \",\n          \"\",\n        ],\n      );\n      await Bun.write(CHANGELOG_PATH, lines.join(\"\\n\"));\n    }\n    await exec(\"git add CHANGELOG.md\");\n    await exec(\n      'git commit -m \"chore: add [Unreleased] section to CHANGELOG.md\"',\n    );\n    logOk(\"Committed [Unreleased] template\");\n\n    // ── Step 2: Push develop ──────────────────────────────────────\n\n    logStep(\"Pushing develop to origin...\");\n    await exec(\"git push origin develop\");\n    state.developPushed = true;\n    logOk(\"Pushed develop\");\n\n    // ── Step 3: Merge to release/alpha ────────────────────────────\n\n    logStep(\"Merging develop → release/alpha...\");\n    await exec(\"git checkout release/alpha\");\n\n    const mergeAttempt = await exec(\"git merge develop --no-edit 2>&1\", {\n      allowFailure: true,\n      silent: true,\n    });\n\n    // Handle modify/delete conflicts on files we're about to strip anyway.\n    // This happens when a file is modified on develop but was deleted from\n    // release/alpha during a previous release's strip step.\n    if (mergeAttempt.includes(\"CONFLICT\") || mergeAttempt.includes(\"fix conflicts\")) {\n      const unmerged = await exec(\"git diff --name-only --diff-filter=U\", { silent: true });\n      const conflictFiles = unmerged.split(\"\\n\").map((f) => f.trim()).filter(Boolean);\n\n      const allStrippable = conflictFiles.length > 0 && conflictFiles.every((f) =>\n        INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s)),\n      );\n\n      if (!allStrippable) {\n        await exec(\"git merge --abort\", { silent: true, allowFailure: true });\n        throw new Error(\n          `Merge conflicts on files that aren't in the strip list: ${conflictFiles.filter((f) => !INTERNAL_FILES_TO_STRIP.some((s) => f === s || f.startsWith(s))).join(\", \")}`,\n        );\n      }\n\n      for (const file of conflictFiles) {\n        await exec(`git rm -f \"${file}\"`, { silent: true });\n      }\n      await exec('git -c core.editor=true merge --continue', { silent: true });\n      logOk(`Merged develop into release/alpha (auto-resolved ${conflictFiles.length} modify/delete conflict(s) on stripped files)`);\n    } else {\n      logOk(\"Merged develop into release/alpha\");\n    }\n\n    // Strip internal files\n    logStep(\"Stripping internal files...\");\n    const filesToRemove: string[] = [];\n    for (const file of INTERNAL_FILES_TO_STRIP) {\n      const exists = await exec(`git ls-files ${file} | head -n 1`, {\n        silent: true,\n      });\n      if (exists) filesToRemove.push(file);\n    }\n    if (filesToRemove.length > 0) {\n      await exec(`git rm -rf ${filesToRemove.join(\" \")}`);\n      await exec(\n        'git commit -m \"chore: strip intermediates and planning files\"',\n      );\n      logOk(`Stripped: ${filesToRemove.join(\", \")}`);\n    } else {\n      logOk(\"No internal files to strip\");\n    }\n\n    // ── Step 4: Create tag ────────────────────────────────────────\n\n    logStep(`Creating tag ${tag}...`);\n    // Delete stale local tag if exists\n    const staleTag = await exec(`git tag -l ${tag}`, { silent: true });\n    if (staleTag) {\n      await exec(`git tag -d ${tag}`);\n    }\n    await exec(`git tag ${tag}`);\n    logOk(`Created tag ${tag} on release/alpha`);\n\n    // ── Step 5: Push release/alpha + tag ──────────────────────────\n\n    logStep(\"Pushing release/alpha to origin...\");\n    await exec(\"git push origin release/alpha\");\n    state.releaseAlphaPushed = true;\n    logOk(\"Pushed release/alpha\");\n\n    logStep(`Pushing tag ${tag} to origin...`);\n    await exec(`git push origin ${tag}`);\n    state.tagPushed = true;\n    logOk(`Pushed tag ${tag} (this triggers CI)`);\n\n    // ── Step 6: Return to develop ─────────────────────────────────\n\n    await exec(\"git checkout develop\");\n    logOk(\"Back on develop branch\");\n  } catch (error) {\n    logErr(`Release failed: ${(error as Error).message}`);\n\n    // Attempt automatic rollback\n    await rollback();\n    throw error;\n  }\n}\n\n// ─── Rollback ────────────────────────────────────────────────────────\n\nasync function rollback(): Promise<void> {\n  log(\"\\n╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Automatic Rollback                                      ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n\n  const actions: string[] = [];\n\n  try {\n    // Make sure we can get back to a branch\n    const currentBranch = await exec(\"git branch --show-current\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // If we're mid-merge, abort it\n    await exec(\"git merge --abort 2>/dev/null || true\", {\n      silent: true,\n      allowFailure: true,\n    });\n\n    // Delete local tag if created\n    if (state.tagName) {\n      const tagExists = await exec(`git tag -l ${state.tagName}`, {\n        silent: true,\n      });\n      if (tagExists) {\n        await exec(`git tag -d ${state.tagName}`, { allowFailure: true });\n        actions.push(`Deleted local tag ${state.tagName}`);\n      }\n    }\n\n    // Reset release/alpha to pre-release state\n    if (state.releaseAlphaHead) {\n      await exec(\"git checkout release/alpha 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n      await exec(`git reset --hard ${state.releaseAlphaHead}`, {\n        allowFailure: true,\n      });\n      actions.push(\n        `Reset release/alpha to ${state.releaseAlphaHead.slice(0, 7)}`,\n      );\n    }\n\n    // Reset develop to pre-release state (only if we haven't pushed, or rollback remote too)\n    if (state.developHead) {\n      await exec(\"git checkout develop\", { allowFailure: true });\n      if (!state.developPushed) {\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(`Reset develop to ${state.developHead.slice(0, 7)}`);\n      } else {\n        // develop was pushed — we need to force-push to undo\n        logWarn(\"develop was already pushed to remote. Local reset only.\");\n        await exec(`git reset --hard ${state.developHead}`, {\n          allowFailure: true,\n        });\n        actions.push(\n          `Reset develop locally to ${state.developHead.slice(0, 7)}`,\n        );\n        actions.push(\"WARNING: develop was pushed. Manual remote fix needed:\");\n        actions.push(`  git push origin develop --force-with-lease`);\n      }\n    } else {\n      // At minimum get back to develop\n      await exec(\"git checkout develop 2>/dev/null || true\", {\n        silent: true,\n        allowFailure: true,\n      });\n    }\n\n    if (state.releaseAlphaPushed) {\n      actions.push(\n        \"WARNING: release/alpha was pushed. Manual remote fix needed:\",\n      );\n      actions.push(`  git push origin release/alpha --force-with-lease`);\n    }\n\n    if (state.tagPushed) {\n      actions.push(\"WARNING: tag was pushed. Manual remote fix needed:\");\n      actions.push(`  git push origin --delete ${state.tagName}`);\n    }\n\n    log(\"\\n  Rollback actions:\");\n    for (const action of actions) {\n      if (action.startsWith(\"WARNING\")) {\n        logWarn(action);\n      } else {\n        logOk(action);\n      }\n    }\n\n    if (!state.developPushed && !state.releaseAlphaPushed && !state.tagPushed) {\n      log(\"\\n  ✓ Full rollback successful. No remote changes were made.\");\n    } else {\n      log(\n        \"\\n  ! Partial rollback. Some changes reached remote — see warnings above.\",\n      );\n    }\n  } catch (rollbackError) {\n    logErr(`Rollback itself failed: ${(rollbackError as Error).message}`);\n    log(\"\\n  Manual recovery steps:\");\n    log(`    git checkout develop`);\n    log(`    git reset --hard ${state.developHead || \"origin/develop\"}`);\n    log(`    git checkout release/alpha`);\n    log(\n      `    git reset --hard ${state.releaseAlphaHead || \"origin/release/alpha\"}`,\n    );\n    if (state.tagName) {\n      log(`    git tag -d ${state.tagName} 2>/dev/null`);\n    }\n    log(`    git checkout develop`);\n  }\n}\n\n// ─── Main ────────────────────────────────────────────────────────────\n\nasync function main(): Promise<void> {\n  log(\"╔════════════════════════════════════════════════════════════╗\");\n  log(\"║  Hankweave Release                                       ║\");\n  log(\"╚════════════════════════════════════════════════════════════╝\");\n  log(\"\");\n  log(`  Bump type:    ${BUMP_TYPE}`);\n  log(\n    `  Mode:         ${DRY_RUN ? \"dry-run (validate only)\" : YES_MODE ? \"headless (--yes)\" : \"interactive\"}`,\n  );\n  if (SKIP_CHECKS) log(`  Skip checks:  yes`);\n\n  // Phase 1: Validate\n  const validation = await validate();\n\n  // Print plan\n  log(\"\\n┌────────────────────────────────────────────────────────────┐\");\n  log(\"│  Release Plan                                              │\");\n  log(\"├────────────────────────────────────────────────────────────┤\");\n  log(\n    `│  Version:     ${validation.currentVersion} → ${validation.newVersion} (${BUMP_TYPE})`,\n  );\n  log(`│  Tag:         v${validation.newVersion}`);\n  log(`│  Changelog:   ${validation.changelogEntryCount} entries`);\n  log(\n    `│  Merge:       ${validation.mergeWouldSucceed ? \"clean\" : \"conflicts!\"}`