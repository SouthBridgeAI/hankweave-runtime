{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YWhyMyt1gLU6hgLAQYq1en","type":"tool_result","content":"     1→import { afterEach, beforeAll, beforeEach, describe, expect, test } from \"bun:test\";\n     2→import * as fs from \"node:fs\";\n     3→import * as path from \"node:path\";\n     4→import {\n     5→  loadCodonSequence,\n     6→  loadHankFile,\n     7→  loadHankweaveRuntimeEnvVars,\n     8→  loadRuntimeConfig,\n     9→  validateHank,\n    10→} from \"../../server/config\";\n    11→import { LlmProviderRegistry } from \"../../server/llm/llm-provider-registry\";\n    12→import { CodonId } from \"../../server/types/branded-types\";\n    13→import type { ModelName } from \"../../server/types/types\";\n    14→import { Logger } from \"../../server/utils\";\n    15→import { captureEnv, restoreEnv } from \"../utils/env-test-helpers\";\n    16→\n    17→// -------------\n    18→// Shared Test Helpers\n    19→// -------------\n    20→\n    21→/**\n    22→ * Helper to create test files with their parent directories.\n    23→ */\n    24→const createTestFile = (filePath: string, content: string) => {\n    25→  const dir = path.dirname(filePath);\n    26→  if (!fs.existsSync(dir)) {\n    27→    fs.mkdirSync(dir, { recursive: true });\n    28→  }\n    29→  fs.writeFileSync(filePath, content);\n    30→};\n    31→\n    32→/**\n    33→ * Helper to clean up a directory recursively.\n    34→ */\n    35→const cleanup = (dir: string) => {\n    36→  if (fs.existsSync(dir)) {\n    37→    fs.rmSync(dir, { recursive: true });\n    38→  }\n    39→};\n    40→\n    41→/**\n    42→ * Helper to write a hank config file in the correct object format.\n    43→ * Uses unknown type to allow test data with plain strings instead of branded types.\n    44→ */\n    45→const writeHankConfig = (filePath: string, codons: unknown[]) => {\n    46→  const hankFile = { hank: codons };\n    47→  fs.writeFileSync(filePath, JSON.stringify(hankFile, null, 2));\n    48→};\n    49→\n    50→// -------------\n    51→// Tests\n    52→// -------------\n    53→\n    54→// -------------\n    55→// Model Validation Tests\n    56→// -------------\n    57→\n    58→describe(\"Model Validation\", () => {\n    59→  beforeAll(() => {\n    60→    // Initialize LLM Provider Registry for model validation\n    61→    const mockLogger = new Logger(\"/dev/null\");\n    62→    LlmProviderRegistry.getInstance({\n    63→      logger: mockLogger,\n    64→      performHealthCheckOnInit: false,\n    65→    });\n    66→  });\n    67→\n    68→  describe(\"in codonSchema (transforms to ModelInfo)\", () => {\n    69→    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-codon-model-test\");\n    70→    const configPath = path.join(tempDir, \"test-config.json\");\n    71→\n    72→    beforeEach(() => {\n    73→      cleanup(tempDir);\n    74→      fs.mkdirSync(tempDir, { recursive: true });\n    75→    });\n    76→\n    77→    afterEach(() => {\n    78→      cleanup(tempDir);\n    79→    });\n    80→\n    81→    test(\"accepts valid Claude model shortcuts (sonnet, opus, haiku)\", () => {\n    82→      const models = [\"sonnet\", \"opus\", \"haiku\"];\n    83→\n    84→      for (const model of models) {\n    85→        const config = [\n    86→          {\n    87→            id: \"test-codon\",\n    88→            name: \"Test Codon\",\n    89→            model,\n    90→            continuationMode: \"fresh\" as const,\n    91→            promptText: \"Test prompt\",\n    92→          },\n    93→        ];\n    94→\n    95→        writeHankConfig(configPath, config);\n    96→        const { codons: result } = loadCodonSequence({ configPath });\n    97→\n    98→        expect(result).toHaveLength(1);\n    99→        const codon = result[0];\n   100→        if (codon.type !== \"loop\") {\n   101→          expect(codon.model).toBeDefined();\n   102→          expect(codon.model.modelId).toContain(model);\n   103→        }\n   104→      }\n   105→    });\n   106→\n   107→    test(\"accepts valid Gemini models\", () => {\n   108→      const models = [\"gemini-2.5-flash\"];\n   109→\n   110→      for (const model of models) {\n   111→        const config = [\n   112→          {\n   113→            id: \"test-codon\",\n   114→            name: \"Test Codon\",\n   115→            model,\n   116→            continuationMode: \"fresh\" as const,\n   117→            promptText: \"Test prompt\",\n   118→          },\n   119→        ];\n   120→\n   121→        writeHankConfig(configPath, config);\n   122→        const { codons: result } = loadCodonSequence({ configPath });\n   123→\n   124→        expect(result).toHaveLength(1);\n   125→        const codon = result[0];\n   126→        if (codon.type !== \"loop\") {\n   127→          expect(codon.model).toBeDefined();\n   128→          expect(typeof codon.model.modelId).toBe(\"string\");\n   129→        }\n   130→      }\n   131→    });\n   132→\n   133→    test(\"throws error for invalid model\", () => {\n   134→      const config = [\n   135→        {\n   136→          id: \"test-codon\",\n   137→          name: \"Test Codon\",\n   138→          model: \"invalid-model-xyz\",\n   139→          continuationMode: \"fresh\" as const,\n   140→          promptText: \"Test prompt\",\n   141→        },\n   142→      ];\n   143→\n   144→      writeHankConfig(configPath, config);\n   145→      expect(() => loadCodonSequence({ configPath })).toThrow(\"Invalid model\");\n   146→    });\n   147→\n   148→    test(\"throws error for empty model string\", () => {\n   149→      const config = [\n   150→        {\n   151→          id: \"test-codon\",\n   152→          name: \"Test Codon\",\n   153→          model: \"\",\n   154→          continuationMode: \"fresh\" as const,\n   155→          promptText: \"Test prompt\",\n   156→        },\n   157→      ];\n   158→\n   159→      writeHankConfig(configPath, config);\n   160→      expect(() => loadCodonSequence({ configPath })).toThrow();\n   161→    });\n   162→\n   163→    test(\"validates model in loop codons\", () => {\n   164→      const config = [\n   165→        {\n   166→          type: \"loop\",\n   167→          id: \"test-loop\",\n   168→          name: \"Test Loop\",\n   169→          terminateOn: {\n   170→            type: \"iterationLimit\" as const,\n   171→            limit: 2,\n   172→          },\n   173→          codons: [\n   174→            {\n   175→              id: \"loop-codon\",\n   176→              name: \"Loop Codon\",\n   177→              model: \"invalid-loop-model\",\n   178→              continuationMode: \"fresh\" as const,\n   179→              promptText: \"Test prompt\",\n   180→            },\n   181→          ],\n   182→        },\n   183→      ];\n   184→\n   185→      writeHankConfig(configPath, config);\n   186→      expect(() => loadCodonSequence({ configPath })).toThrow(\"Invalid model\");\n   187→    });\n   188→  });\n   189→\n   190→  describe(\"in hankOverridesSchema (keeps as string)\", () => {\n   191→    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-overrides-model-test\");\n   192→    const hankPath = path.join(tempDir, \"test-hank.json\");\n   193→\n   194→    beforeEach(() => {\n   195→      cleanup(tempDir);\n   196→      fs.mkdirSync(tempDir, { recursive: true });\n   197→    });\n   198→\n   199→    afterEach(() => {\n   200→      cleanup(tempDir);\n   201→    });\n   202→\n   203→    test(\"accepts valid model in overrides\", () => {\n   204→      const models = [\"sonnet\", \"opus\", \"haiku\"];\n   205→\n   206→      for (const model of models) {\n   207→        const hankContent = {\n   208→          overrides: {\n   209→            model,\n   210→          },\n   211→          hank: [\n   212→            {\n   213→              id: \"test-codon\",\n   214→              name: \"Test Codon\",\n   215→              model: \"sonnet\" as ModelName,\n   216→              continuationMode: \"fresh\" as const,\n   217→              promptText: \"Test prompt\",\n   218→            },\n   219→          ],\n   220→        };\n   221→\n   222→        createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n   223→        const result = loadHankFile({ hankPath: hankPath });\n   224→\n   225→        // Model should stay as string in overrides\n   226→        expect(result.overrides?.model).toBe(model);\n   227→        expect(typeof result.overrides?.model).toBe(\"string\");\n   228→      }\n   229→    });\n   230→\n   231→    test(\"throws error for invalid model in overrides\", () => {\n   232→      const hankContent = {\n   233→        overrides: {\n   234→          model: \"invalid-model-xyz\",\n   235→        },\n   236→        hank: [\n   237→          {\n   238→            id: \"test-codon\",\n   239→            name: \"Test Codon\",\n   240→            model: \"sonnet\" as ModelName,\n   241→            continuationMode: \"fresh\" as const,\n   242→            promptText: \"Test prompt\",\n   243→          },\n   244→        ],\n   245→      };\n   246→\n   247→      createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n   248→      expect(() => loadHankFile({ hankPath: hankPath })).toThrow(\"Invalid\");\n   249→    });\n   250→\n   251→    test(\"allows undefined model in overrides\", () => {\n   252→      const hankContent = {\n   253→        overrides: {\n   254→          dataHashTimeLimit: 5000,\n   255→          // No model field\n   256→        },\n   257→        hank: [\n   258→          {\n   259→            id: \"test-codon\",\n   260→            name: \"Test Codon\",\n   261→            model: \"sonnet\" as ModelName,\n   262→            continuationMode: \"fresh\" as const,\n   263→            promptText: \"Test prompt\",\n   264→          },\n   265→        ],\n   266→      };\n   267→\n   268→      createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n   269→      const result = loadHankFile({ hankPath: hankPath });\n   270→\n   271→      expect(result.overrides?.model).toBeUndefined();\n   272→    });\n   273→  });\n   274→\n   275→  describe(\"in runtimeConfigSchema (keeps as string)\", () => {\n   276→    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-runtime-model-test\");\n   277→    const runtimeConfigPath = path.join(tempDir, \"hankweave.json\");\n   278→\n   279→    beforeEach(() => {\n   280→      cleanup(tempDir);\n   281→      fs.mkdirSync(tempDir, { recursive: true });\n   282→    });\n   283→\n   284→    afterEach(() => {\n   285→      cleanup(tempDir);\n   286→    });\n   287→\n   288→    test(\"accepts valid model in runtime config\", () => {\n   289→      const models = [\"sonnet\", \"opus\", \"haiku\", \"gemini-2.5-flash\"];\n   290→\n   291→      for (const model of models) {\n   292→        const runtimeContent = {\n   293→          model,\n   294→          port: 8080,\n   295→        };\n   296→\n   297→        createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n   298→        const result = loadRuntimeConfig(runtimeConfigPath);\n   299→\n   300→        // Model should stay as string in runtime config\n   301→        expect(result.model).toBe(model);\n   302→        expect(typeof result.model).toBe(\"string\");\n   303→      }\n   304→    });\n   305→\n   306→    test(\"throws error for invalid model in runtime config\", () => {\n   307→      const runtimeContent = {\n   308→        model: \"this is not a model\", // Invalid - not in registry\n   309→        port: 8080,\n   310→      };\n   311→\n   312→      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n   313→      expect(() => loadRuntimeConfig(runtimeConfigPath)).toThrow(\"Invalid\");\n   314→    });\n   315→\n   316→    test(\"allows undefined model in runtime config\", () => {\n   317→      const runtimeContent = {\n   318→        port: 8080,\n   319→        // No model field\n   320→      };\n   321→\n   322→      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n   323→      const result = loadRuntimeConfig(runtimeConfigPath);\n   324→\n   325→      expect(result.model).toBeUndefined();\n   326→    });\n   327→\n   328→    test(\"throws error for empty model string in runtime config\", () => {\n   329→      const runtimeContent = {\n   330→        model: \"\",\n   331→        port: 8080,\n   332→      };\n   333→\n   334→      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n   335→      expect(() => loadRuntimeConfig(runtimeConfigPath)).toThrow();\n   336→    });\n   337→  });\n   338→\n   339→  describe(\"model validation error messages\", () => {\n   340→    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-model-error-test\");\n   341→    const configPath = path.join(tempDir, \"test-config.json\");\n   342→\n   343→    beforeEach(() => {\n   344→      cleanup(tempDir);\n   345→      fs.mkdirSync(tempDir, { recursive: true });\n   346→    });\n   347→\n   348→    afterEach(() => {\n   349→      cleanup(tempDir);\n   350→    });\n   351→\n   352→    test(\"provides helpful error message for invalid model\", () => {\n   353→      const config = [\n   354→        {\n   355→          id: \"test-codon\",\n   356→          name: \"Test Codon\",\n   357→          model: \"nonexistent-model\",\n   358→          continuationMode: \"fresh\" as const,\n   359→          promptText: \"Test prompt\",\n   360→        },\n   361→      ];\n   362→\n   363→      writeHankConfig(configPath, config);\n   364→\n   365→      try {\n   366→        loadCodonSequence({ configPath });\n   367→        throw new Error(\"Should have thrown\");\n   368→      } catch (error) {\n   369→        expect(error).toBeInstanceOf(Error);\n   370→        const message = (error as Error).message;\n   371→        expect(message).toContain(\"Invalid model\");\n   372→        expect(message).toContain(\"nonexistent-model\");\n   373→      }\n   374→    });\n   375→  });\n   376→\n   377→  describe(\"codon field validation error messages\", () => {\n   378→    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-codon-field-error-test\");\n   379→    const configPath = path.join(tempDir, \"test-config.json\");\n   380→\n   381→    beforeEach(() => {\n   382→      cleanup(tempDir);\n   383→      fs.mkdirSync(tempDir, { recursive: true });\n   384→    });\n   385→\n   386→    afterEach(() => {\n   387→      cleanup(tempDir);\n   388→    });\n   389→\n   390→    test(\"provides helpful error for typo: systemPromptFile → appendSystemPromptFile\", () => {\n   391→      const config = [\n   392→        {\n   393→          id: \"test-codon\",\n   394→          name: \"Test Codon\",\n   395→          model: \"opus\",\n   396→          continuationMode: \"fresh\",\n   397→          promptText: \"Test prompt\",\n   398→          systemPromptFile: \"./system.md\", // Wrong field name!\n   399→        },\n   400→      ];\n   401→\n   402→      writeHankConfig(configPath, config);\n   403→\n   404→      try {\n   405→        loadCodonSequence({ configPath });\n   406→        throw new Error(\"Should have thrown\");\n   407→      } catch (error) {\n   408→        const message = (error as Error).message;\n   409→        // Should suggest correct field name\n   410→        expect(message).toContain(\"systemPromptFile\");\n   411→        expect(message).toContain(\"appendSystemPromptFile\");\n   412→        expect(message.toLowerCase()).toContain(\"did you mean\");\n   413→      }\n   414→    });\n   415→\n   416→    test(\"provides helpful error for typo: trackedFiles → checkpointedFiles\", () => {\n   417→      const config = [\n   418→        {\n   419→          id: \"test-codon\",\n   420→          name: \"Test Codon\",\n   421→          model: \"opus\",\n   422→          continuationMode: \"fresh\",\n   423→          promptText: \"Test prompt\",\n   424→          trackedFiles: [\"*.md\"], // Wrong field name!\n   425→        },\n   426→      ];\n   427→\n   428→      writeHankConfig(configPath, config);\n   429→\n   430→      try {\n   431→        loadCodonSequence({ configPath });\n   432→        throw new Error(\"Should have thrown\");\n   433→      } catch (error) {\n   434→        const message = (error as Error).message;\n   435→        expect(message).toContain(\"trackedFiles\");\n   436→        expect(message).toContain(\"checkpointedFiles\");\n   437→        expect(message.toLowerCase()).toContain(\"did you mean\");\n   438→      }\n   439→    });\n   440→\n   441→    test(\"provides helpful error for unknown codon field\", () => {\n   442→      const config = [\n   443→        {\n   444→          id: \"test-codon\",\n   445→          name: \"Test Codon\",\n   446→          model: \"opus\",\n   447→          continuationMode: \"fresh\",\n   448→          promptText: \"Test prompt\",\n   449→          unknownField: \"value\", // Completely unknown\n   450→        },\n   451→      ];\n   452→\n   453→      writeHankConfig(configPath, config);\n   454→\n   455→      try {\n   456→        loadCodonSequence({ configPath });\n   457→        throw new Error(\"Should have thrown\");\n   458→      } catch (error) {\n   459→        const message = (error as Error).message;\n   460→        // Should mention the field name and valid fields\n   461→        expect(message).toContain(\"unknownField\");\n   462→        expect(message.toLowerCase()).toMatch(/unrecognized|unknown/);\n   463→      }\n   464→    });\n   465→\n   466→    test(\"catches unrecognized fields in loop codons\", () => {\n   467→      createTestFile(path.join(tempDir, \"prompt.md\"), \"Test prompt\");\n   468→\n   469→      const config = [\n   470→        {\n   471→          type: \"loop\",\n   472→          id: \"test-loop\",\n   473→          name: \"Test Loop\",\n   474→          terminateOn: { type: \"iterationLimit\", limit: 2 },\n   475→          codons: [\n   476→            {\n   477→              id: \"loop-codon\",\n   478→              name: \"Loop Codon\",\n   479→              model: \"opus\",\n   480→              continuationMode: \"fresh\",\n   481→              promptFile: \"./prompt.md\",\n   482→              trackedFiles: [\"*.md\"], // Wrong! Should be checkpointedFiles\n   483→            },\n   484→          ],\n   485→        },\n   486→      ];\n   487→\n   488→      writeHankConfig(configPath, config);\n   489→\n   490→      try {\n   491→        loadCodonSequence({ configPath });\n   492→        throw new Error(\"Should have thrown\");\n   493→      } catch (error) {\n   494→        const message = (error as Error).message;\n   495→        // Should at least identify the problematic field\n   496→        expect(message).toContain(\"trackedFiles\");\n   497→        // Note: typo suggestions for deeply nested codons within loops\n   498→        // go through loopSchema's inner codonSchema which doesn't have\n   499→        // our detailed error handler, so we don't always get suggestions\n   500→      }\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_0152G7qmX7Ab8Jb7ebmwUoMZ","session_id":"c6374b5f-86c6-4583-a2d5-1355f78fbe1d","uuid":"cc51885d-eb98-4682-94f3-d2940ce881ab","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/tests/unit/config.test.ts","content":"import { afterEach, beforeAll, beforeEach, describe, expect, test } from \"bun:test\";\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport {\n  loadCodonSequence,\n  loadHankFile,\n  loadHankweaveRuntimeEnvVars,\n  loadRuntimeConfig,\n  validateHank,\n} from \"../../server/config\";\nimport { LlmProviderRegistry } from \"../../server/llm/llm-provider-registry\";\nimport { CodonId } from \"../../server/types/branded-types\";\nimport type { ModelName } from \"../../server/types/types\";\nimport { Logger } from \"../../server/utils\";\nimport { captureEnv, restoreEnv } from \"../utils/env-test-helpers\";\n\n// -------------\n// Shared Test Helpers\n// -------------\n\n/**\n * Helper to create test files with their parent directories.\n */\nconst createTestFile = (filePath: string, content: string) => {\n  const dir = path.dirname(filePath);\n  if (!fs.existsSync(dir)) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n  fs.writeFileSync(filePath, content);\n};\n\n/**\n * Helper to clean up a directory recursively.\n */\nconst cleanup = (dir: string) => {\n  if (fs.existsSync(dir)) {\n    fs.rmSync(dir, { recursive: true });\n  }\n};\n\n/**\n * Helper to write a hank config file in the correct object format.\n * Uses unknown type to allow test data with plain strings instead of branded types.\n */\nconst writeHankConfig = (filePath: string, codons: unknown[]) => {\n  const hankFile = { hank: codons };\n  fs.writeFileSync(filePath, JSON.stringify(hankFile, null, 2));\n};\n\n// -------------\n// Tests\n// -------------\n\n// -------------\n// Model Validation Tests\n// -------------\n\ndescribe(\"Model Validation\", () => {\n  beforeAll(() => {\n    // Initialize LLM Provider Registry for model validation\n    const mockLogger = new Logger(\"/dev/null\");\n    LlmProviderRegistry.getInstance({\n      logger: mockLogger,\n      performHealthCheckOnInit: false,\n    });\n  });\n\n  describe(\"in codonSchema (transforms to ModelInfo)\", () => {\n    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-codon-model-test\");\n    const configPath = path.join(tempDir, \"test-config.json\");\n\n    beforeEach(() => {\n      cleanup(tempDir);\n      fs.mkdirSync(tempDir, { recursive: true });\n    });\n\n    afterEach(() => {\n      cleanup(tempDir);\n    });\n\n    test(\"accepts valid Claude model shortcuts (sonnet, opus, haiku)\", () => {\n      const models = [\"sonnet\", \"opus\", \"haiku\"];\n\n      for (const model of models) {\n        const config = [\n          {\n            id: \"test-codon\",\n            name: \"Test Codon\",\n            model,\n            continuationMode: \"fresh\" as const,\n            promptText: \"Test prompt\",\n          },\n        ];\n\n        writeHankConfig(configPath, config);\n        const { codons: result } = loadCodonSequence({ configPath });\n\n        expect(result).toHaveLength(1);\n        const codon = result[0];\n        if (codon.type !== \"loop\") {\n          expect(codon.model).toBeDefined();\n          expect(codon.model.modelId).toContain(model);\n        }\n      }\n    });\n\n    test(\"accepts valid Gemini models\", () => {\n      const models = [\"gemini-2.5-flash\"];\n\n      for (const model of models) {\n        const config = [\n          {\n            id: \"test-codon\",\n            name: \"Test Codon\",\n            model,\n            continuationMode: \"fresh\" as const,\n            promptText: \"Test prompt\",\n          },\n        ];\n\n        writeHankConfig(configPath, config);\n        const { codons: result } = loadCodonSequence({ configPath });\n\n        expect(result).toHaveLength(1);\n        const codon = result[0];\n        if (codon.type !== \"loop\") {\n          expect(codon.model).toBeDefined();\n          expect(typeof codon.model.modelId).toBe(\"string\");\n        }\n      }\n    });\n\n    test(\"throws error for invalid model\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"invalid-model-xyz\",\n          continuationMode: \"fresh\" as const,\n          promptText: \"Test prompt\",\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n      expect(() => loadCodonSequence({ configPath })).toThrow(\"Invalid model\");\n    });\n\n    test(\"throws error for empty model string\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"\",\n          continuationMode: \"fresh\" as const,\n          promptText: \"Test prompt\",\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n      expect(() => loadCodonSequence({ configPath })).toThrow();\n    });\n\n    test(\"validates model in loop codons\", () => {\n      const config = [\n        {\n          type: \"loop\",\n          id: \"test-loop\",\n          name: \"Test Loop\",\n          terminateOn: {\n            type: \"iterationLimit\" as const,\n            limit: 2,\n          },\n          codons: [\n            {\n              id: \"loop-codon\",\n              name: \"Loop Codon\",\n              model: \"invalid-loop-model\",\n              continuationMode: \"fresh\" as const,\n              promptText: \"Test prompt\",\n            },\n          ],\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n      expect(() => loadCodonSequence({ configPath })).toThrow(\"Invalid model\");\n    });\n  });\n\n  describe(\"in hankOverridesSchema (keeps as string)\", () => {\n    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-overrides-model-test\");\n    const hankPath = path.join(tempDir, \"test-hank.json\");\n\n    beforeEach(() => {\n      cleanup(tempDir);\n      fs.mkdirSync(tempDir, { recursive: true });\n    });\n\n    afterEach(() => {\n      cleanup(tempDir);\n    });\n\n    test(\"accepts valid model in overrides\", () => {\n      const models = [\"sonnet\", \"opus\", \"haiku\"];\n\n      for (const model of models) {\n        const hankContent = {\n          overrides: {\n            model,\n          },\n          hank: [\n            {\n              id: \"test-codon\",\n              name: \"Test Codon\",\n              model: \"sonnet\" as ModelName,\n              continuationMode: \"fresh\" as const,\n              promptText: \"Test prompt\",\n            },\n          ],\n        };\n\n        createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n        const result = loadHankFile({ hankPath: hankPath });\n\n        // Model should stay as string in overrides\n        expect(result.overrides?.model).toBe(model);\n        expect(typeof result.overrides?.model).toBe(\"string\");\n      }\n    });\n\n    test(\"throws error for invalid model in overrides\", () => {\n      const hankContent = {\n        overrides: {\n          model: \"invalid-model-xyz\",\n        },\n        hank: [\n          {\n            id: \"test-codon\",\n            name: \"Test Codon\",\n            model: \"sonnet\" as ModelName,\n            continuationMode: \"fresh\" as const,\n            promptText: \"Test prompt\",\n          },\n        ],\n      };\n\n      createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n      expect(() => loadHankFile({ hankPath: hankPath })).toThrow(\"Invalid\");\n    });\n\n    test(\"allows undefined model in overrides\", () => {\n      const hankContent = {\n        overrides: {\n          dataHashTimeLimit: 5000,\n          // No model field\n        },\n        hank: [\n          {\n            id: \"test-codon\",\n            name: \"Test Codon\",\n            model: \"sonnet\" as ModelName,\n            continuationMode: \"fresh\" as const,\n            promptText: \"Test prompt\",\n          },\n        ],\n      };\n\n      createTestFile(hankPath, JSON.stringify(hankContent, null, 2));\n      const result = loadHankFile({ hankPath: hankPath });\n\n      expect(result.overrides?.model).toBeUndefined();\n    });\n  });\n\n  describe(\"in runtimeConfigSchema (keeps as string)\", () => {\n    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-runtime-model-test\");\n    const runtimeConfigPath = path.join(tempDir, \"hankweave.json\");\n\n    beforeEach(() => {\n      cleanup(tempDir);\n      fs.mkdirSync(tempDir, { recursive: true });\n    });\n\n    afterEach(() => {\n      cleanup(tempDir);\n    });\n\n    test(\"accepts valid model in runtime config\", () => {\n      const models = [\"sonnet\", \"opus\", \"haiku\", \"gemini-2.5-flash\"];\n\n      for (const model of models) {\n        const runtimeContent = {\n          model,\n          port: 8080,\n        };\n\n        createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n        const result = loadRuntimeConfig(runtimeConfigPath);\n\n        // Model should stay as string in runtime config\n        expect(result.model).toBe(model);\n        expect(typeof result.model).toBe(\"string\");\n      }\n    });\n\n    test(\"throws error for invalid model in runtime config\", () => {\n      const runtimeContent = {\n        model: \"this is not a model\", // Invalid - not in registry\n        port: 8080,\n      };\n\n      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n      expect(() => loadRuntimeConfig(runtimeConfigPath)).toThrow(\"Invalid\");\n    });\n\n    test(\"allows undefined model in runtime config\", () => {\n      const runtimeContent = {\n        port: 8080,\n        // No model field\n      };\n\n      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n      const result = loadRuntimeConfig(runtimeConfigPath);\n\n      expect(result.model).toBeUndefined();\n    });\n\n    test(\"throws error for empty model string in runtime config\", () => {\n      const runtimeContent = {\n        model: \"\",\n        port: 8080,\n      };\n\n      createTestFile(runtimeConfigPath, JSON.stringify(runtimeContent, null, 2));\n      expect(() => loadRuntimeConfig(runtimeConfigPath)).toThrow();\n    });\n  });\n\n  describe(\"model validation error messages\", () => {\n    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-model-error-test\");\n    const configPath = path.join(tempDir, \"test-config.json\");\n\n    beforeEach(() => {\n      cleanup(tempDir);\n      fs.mkdirSync(tempDir, { recursive: true });\n    });\n\n    afterEach(() => {\n      cleanup(tempDir);\n    });\n\n    test(\"provides helpful error message for invalid model\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"nonexistent-model\",\n          continuationMode: \"fresh\" as const,\n          promptText: \"Test prompt\",\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n\n      try {\n        loadCodonSequence({ configPath });\n        throw new Error(\"Should have thrown\");\n      } catch (error) {\n        expect(error).toBeInstanceOf(Error);\n        const message = (error as Error).message;\n        expect(message).toContain(\"Invalid model\");\n        expect(message).toContain(\"nonexistent-model\");\n      }\n    });\n  });\n\n  describe(\"codon field validation error messages\", () => {\n    const tempDir = path.resolve(\"tests\", \"test-area\", \"temp-codon-field-error-test\");\n    const configPath = path.join(tempDir, \"test-config.json\");\n\n    beforeEach(() => {\n      cleanup(tempDir);\n      fs.mkdirSync(tempDir, { recursive: true });\n    });\n\n    afterEach(() => {\n      cleanup(tempDir);\n    });\n\n    test(\"provides helpful error for typo: systemPromptFile → appendSystemPromptFile\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"opus\",\n          continuationMode: \"fresh\",\n          promptText: \"Test prompt\",\n          systemPromptFile: \"./system.md\", // Wrong field name!\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n\n      try {\n        loadCodonSequence({ configPath });\n        throw new Error(\"Should have thrown\");\n      } catch (error) {\n        const message = (error as Error).message;\n        // Should suggest correct field name\n        expect(message).toContain(\"systemPromptFile\");\n        expect(message).toContain(\"appendSystemPromptFile\");\n        expect(message.toLowerCase()).toContain(\"did you mean\");\n      }\n    });\n\n    test(\"provides helpful error for typo: trackedFiles → checkpointedFiles\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"opus\",\n          continuationMode: \"fresh\",\n          promptText: \"Test prompt\",\n          trackedFiles: [\"*.md\"], // Wrong field name!\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n\n      try {\n        loadCodonSequence({ configPath });\n        throw new Error(\"Should have thrown\");\n      } catch (error) {\n        const message = (error as Error).message;\n        expect(message).toContain(\"trackedFiles\");\n        expect(message).toContain(\"checkpointedFiles\");\n        expect(message.toLowerCase()).toContain(\"did you mean\");\n      }\n    });\n\n    test(\"provides helpful error for unknown codon field\", () => {\n      const config = [\n        {\n          id: \"test-codon\",\n          name: \"Test Codon\",\n          model: \"opus\",\n          continuationMode: \"fresh\",\n          promptText: \"Test prompt\",\n          unknownField: \"value\", // Completely unknown\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n\n      try {\n        loadCodonSequence({ configPath });\n        throw new Error(\"Should have thrown\");\n      } catch (error) {\n        const message = (error as Error).message;\n        // Should mention the field name and valid fields\n        expect(message).toContain(\"unknownField\");\n        expect(message.toLowerCase()).toMatch(/unrecognized|unknown/);\n      }\n    });\n\n    test(\"catches unrecognized fields in loop codons\", () => {\n      createTestFile(path.join(tempDir, \"prompt.md\"), \"Test prompt\");\n\n      const config = [\n        {\n          type: \"loop\",\n          id: \"test-loop\",\n          name: \"Test Loop\",\n          terminateOn: { type: \"iterationLimit\", limit: 2 },\n          codons: [\n            {\n              id: \"loop-codon\",\n              name: \"Loop Codon\",\n              model: \"opus\",\n              continuationMode: \"fresh\",\n              promptFile: \"./prompt.md\",\n              trackedFiles: [\"*.md\"], // Wrong! Should be checkpointedFiles\n            },\n          ],\n        },\n      ];\n\n      writeHankConfig(configPath, config);\n\n      try {\n        loadCodonSequence({ configPath });\n        throw new Error(\"Should have thrown\");\n      } catch (error) {\n        const message = (error as Error).message;\n        // Should at least identify the problematic field\n        expect(message).toContain(\"trackedFiles\");\n        // Note: typo suggestions for deeply nested codons within loops\n        // go through loopSchema's inner codonSchema which doesn't have\n        // our detailed error handler, so we don't always get suggestions\n      }","numLines":500,"startLine":1,"totalLines":3717}},"timestamp":"2026-03-05T13:03:28.856Z"}
