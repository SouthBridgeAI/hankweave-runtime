{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BBxwHx14Cb6B8p2SXVuqp9","type":"tool_result","content":"     1→import { afterEach, beforeEach, describe, expect, test } from \"bun:test\";\n     2→import * as fs from \"node:fs\";\n     3→import { rmSync } from \"node:fs\";\n     4→import * as path from \"node:path\";\n     5→import type { FileNode } from \"../../server/types/types\";\n     6→import {\n     7→  AppMetadata,\n     8→  buildFileTree,\n     9→  copyFiles,\n    10→  escapeShellArg,\n    11→  getMetadata,\n    12→  IdleTimeoutError,\n    13→  Logger,\n    14→  renameWithRetry,\n    15→  serve,\n    16→  WebSocket,\n    17→  withIdleTimeout,\n    18→} from \"../../server/utils\";\n    19→import { getFreePort } from \"../utils/test-helpers.js\";\n    20→\n    21→describe(\"Test Environment\", () => {\n    22→  test(\"NODE_ENV is set to 'test' during Bun test runs\", () => {\n    23→    expect(process.env.NODE_ENV).toBe(\"test\");\n    24→  });\n    25→});\n    26→\n    27→describe(\"escapeShellArg\", () => {\n    28→  test(\"escapes single quotes correctly\", () => {\n    29→    expect(escapeShellArg(\"test'value\")).toBe(\"'test'\\\\''value'\");\n    30→  });\n    31→\n    32→  test(\"handles empty strings\", () => {\n    33→    expect(escapeShellArg(\"\")).toBe(\"''\");\n    34→  });\n    35→\n    36→  test(\"handles strings with newlines\", () => {\n    37→    expect(escapeShellArg(\"line1\\nline2\")).toBe(\"'line1\\nline2'\");\n    38→  });\n    39→\n    40→  test(\"handles strings with special shell characters ($, `, \\\\, !)\", () => {\n    41→    expect(escapeShellArg(\"$test\")).toBe(\"'$test'\");\n    42→    expect(escapeShellArg(\"`command`\")).toBe(\"'`command`'\");\n    43→    expect(escapeShellArg(\"\\\\path\")).toBe(\"'\\\\path'\");\n    44→    expect(escapeShellArg(\"!history\")).toBe(\"'!history'\");\n    45→  });\n    46→\n    47→  test(\"handles unicode characters\", () => {\n    48→    expect(escapeShellArg(\"こんにちは\")).toBe(\"'こんにちは'\");\n    49→    expect(escapeShellArg(\"🚀\")).toBe(\"'🚀'\");\n    50→  });\n    51→\n    52→  test(\"handles very long strings\", () => {\n    53→    const longString = \"a\".repeat(10000);\n    54→    const escaped = escapeShellArg(longString);\n    55→    expect(escaped).toBe(`'${longString}'`);\n    56→  });\n    57→\n    58→  test(\"prevents command injection attempts\", () => {\n    59→    expect(escapeShellArg(\"'; rm -rf /\")).toBe(\"''\\\\''; rm -rf /'\");\n    60→    expect(escapeShellArg(\"$(whoami)\")).toBe(\"'$(whoami)'\");\n    61→    expect(escapeShellArg(\"&&malicious\")).toBe(\"'&&malicious'\");\n    62→  });\n    63→});\n    64→\n    65→describe(\"buildFileTree\", () => {\n    66→  let tempDir: string;\n    67→\n    68→  beforeEach(async () => {\n    69→    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-filetree-${Date.now()}`);\n    70→    await fs.promises.mkdir(tempDir, { recursive: true });\n    71→  });\n    72→\n    73→  afterEach(() => {\n    74→    rmSync(tempDir, { recursive: true, force: true });\n    75→  });\n    76→\n    77→  test(\"builds tree from flat file list\", async () => {\n    78→    // Create test files\n    79→    await fs.promises.writeFile(path.join(tempDir, \"file1.txt\"), \"content1\");\n    80→    await fs.promises.writeFile(path.join(tempDir, \"file2.txt\"), \"content2\");\n    81→\n    82→    const tree = await buildFileTree(tempDir, \"*.txt\");\n    83→\n    84→    expect(tree).toHaveLength(2);\n    85→    const fileNames = tree.map((node) => node.name).sort();\n    86→    expect(fileNames).toEqual([\"file1.txt\", \"file2.txt\"]);\n    87→\n    88→    tree.forEach((node) => {\n    89→      expect(node.isDirectory).toBe(false);\n    90→      // TypeScript assertion since we know all nodes are files\n    91→      const fileNode = node as FileNode & { isDirectory: false };\n    92→      expect(fileNode.lastModified).toBeDefined();\n    93→    });\n    94→  });\n    95→\n    96→  test(\"handles nested directories correctly\", async () => {\n    97→    // Create nested structure\n    98→    await fs.promises.mkdir(path.join(tempDir, \"src\"), { recursive: true });\n    99→    await fs.promises.mkdir(path.join(tempDir, \"src\", \"utils\"), {\n   100→      recursive: true,\n   101→    });\n   102→    await fs.promises.writeFile(path.join(tempDir, \"src\", \"index.ts\"), \"export {}\");\n   103→    await fs.promises.writeFile(path.join(tempDir, \"src\", \"utils\", \"helper.ts\"), \"export {}\");\n   104→\n   105→    const tree = await buildFileTree(tempDir, \"**/*.ts\");\n   106→\n   107→    // Find the src node\n   108→    const srcNode = tree.find((node) => node.name === \"src\");\n   109→    expect(srcNode).toBeDefined();\n   110→    expect(srcNode?.isDirectory).toBe(true);\n   111→    expect(srcNode?.children).toBeDefined();\n   112→\n   113→    // Check index.ts in src\n   114→    const indexFile = srcNode?.children?.find((child) => child.name === \"index.ts\");\n   115→    expect(indexFile).toBeDefined();\n   116→    expect(indexFile?.isDirectory).toBe(false);\n   117→\n   118→    // Check utils directory\n   119→    const utilsDir = srcNode?.children?.find((child) => child.name === \"utils\");\n   120→    expect(utilsDir).toBeDefined();\n   121→    expect(utilsDir?.isDirectory).toBe(true);\n   122→\n   123→    // Check helper.ts in utils\n   124→    const helperFile = utilsDir?.children?.find((child) => child.name === \"helper.ts\");\n   125→    expect(helperFile).toBeDefined();\n   126→    expect(helperFile?.isDirectory).toBe(false);\n   127→  });\n   128→\n   129→  test(\"sorts files within directories\", async () => {\n   130→    // Create files in non-alphabetical order\n   131→    await fs.promises.writeFile(path.join(tempDir, \"b.txt\"), \"b\");\n   132→    await fs.promises.writeFile(path.join(tempDir, \"a.txt\"), \"a\");\n   133→    await fs.promises.writeFile(path.join(tempDir, \"c.txt\"), \"c\");\n   134→\n   135→    const tree = await buildFileTree(tempDir, \"*.txt\");\n   136→    const names = tree.map((node) => node.name);\n   137→\n   138→    expect(names).toEqual([\"a.txt\", \"b.txt\", \"c.txt\"]);\n   139→  });\n   140→\n   141→  test(\"includes lastModified for files\", async () => {\n   142→    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"content\");\n   143→\n   144→    const tree = await buildFileTree(tempDir, \"*.txt\");\n   145→    const fileNode = tree.find((node) => node.name === \"test.txt\");\n   146→\n   147→    expect(fileNode).toBeDefined();\n   148→    expect(fileNode?.isDirectory).toBe(false);\n   149→    // Type assertion since we verified it's not a directory\n   150→    const file = fileNode as FileNode & { isDirectory: false };\n   151→    expect(file.lastModified).toBeDefined();\n   152→    if (file.lastModified) {\n   153→      expect(new Date(file.lastModified).getTime()).toBeGreaterThan(0);\n   154→    }\n   155→  });\n   156→\n   157→  test(\"marks directories with isDirectory flag\", async () => {\n   158→    await fs.promises.mkdir(path.join(tempDir, \"dir\"), { recursive: true });\n   159→    await fs.promises.writeFile(path.join(tempDir, \"dir\", \"file.txt\"), \"content\");\n   160→\n   161→    const tree = await buildFileTree(tempDir, \"**/*.txt\");\n   162→\n   163→    const dirNode = tree.find((node) => node.name === \"dir\");\n   164→    expect(dirNode?.isDirectory).toBe(true);\n   165→\n   166→    const fileInDir = dirNode?.children?.find((child) => child.name === \"file.txt\");\n   167→    expect(fileInDir?.isDirectory).toBe(false);\n   168→  });\n   169→\n   170→  test(\"handles empty directories\", async () => {\n   171→    const tree = await buildFileTree(tempDir, \"**/*\");\n   172→    expect(tree).toEqual([]);\n   173→  });\n   174→\n   175→  test(\"handles files at root level\", async () => {\n   176→    await fs.promises.writeFile(path.join(tempDir, \"root.txt\"), \"root\");\n   177→    await fs.promises.mkdir(path.join(tempDir, \"dir\"), { recursive: true });\n   178→    await fs.promises.writeFile(path.join(tempDir, \"dir\", \"nested.txt\"), \"nested\");\n   179→\n   180→    const tree = await buildFileTree(tempDir, \"**/*.txt\");\n   181→\n   182→    const rootFile = tree.find((node) => node.name === \"root.txt\");\n   183→    expect(rootFile).toBeDefined();\n   184→    expect(rootFile?.path).toBe(\"root.txt\");\n   185→    expect(rootFile?.isDirectory).toBe(false);\n   186→\n   187→    const dirNode = tree.find((node) => node.name === \"dir\");\n   188→    expect(dirNode).toBeDefined();\n   189→    expect(dirNode?.isDirectory).toBe(true);\n   190→\n   191→    const nestedFile = dirNode?.children?.find((child) => child.name === \"nested.txt\");\n   192→    expect(nestedFile).toBeDefined();\n   193→    expect(nestedFile?.isDirectory).toBe(false);\n   194→  });\n   195→});\n   196→\n   197→// Mock logger\n   198→class MockLogger extends Logger {\n   199→  logs: Array<{ message: string; level: string }> = [];\n   200→\n   201→  log(message: string, level: \"info\" | \"error\" | \"debug\" = \"info\"): void {\n   202→    this.logs.push({ message, level });\n   203→  }\n   204→\n   205→  logSocketTraffic(_socketLogFile: string, _direction: \"in\" | \"out\", _data: unknown): void {\n   206→    // Mock implementation\n   207→  }\n   208→}\n   209→\n   210→describe(\"copyFiles\", () => {\n   211→  let tempDir: string;\n   212→  let destDir: string;\n   213→  let mockLogger: MockLogger;\n   214→\n   215→  beforeEach(async () => {\n   216→    const timestamp = Date.now();\n   217→    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-copyfiles-src-${timestamp}`);\n   218→    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-copyfiles-dest-${timestamp}`);\n   219→    await fs.promises.mkdir(tempDir, { recursive: true });\n   220→    mockLogger = new MockLogger(\"\");\n   221→  });\n   222→\n   223→  afterEach(() => {\n   224→    rmSync(tempDir, { recursive: true, force: true });\n   225→    rmSync(destDir, { recursive: true, force: true });\n   226→  });\n   227→\n   228→  test(\"copies single file to destination\", async () => {\n   229→    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"test content\");\n   230→\n   231→    await copyFiles(tempDir, [\"test.txt\"], destDir, mockLogger);\n   232→\n   233→    expect(await fs.promises.readFile(path.join(destDir, \"test.txt\"), \"utf-8\")).toBe(\n   234→      \"test content\",\n   235→    );\n   236→  });\n   237→\n   238→  test(\"copies multiple files\", async () => {\n   239→    await fs.promises.writeFile(path.join(tempDir, \"file1.txt\"), \"content1\");\n   240→    await fs.promises.writeFile(path.join(tempDir, \"file2.txt\"), \"content2\");\n   241→\n   242→    await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger);\n   243→\n   244→    expect(await fs.promises.readFile(path.join(destDir, \"file1.txt\"), \"utf-8\")).toBe(\"content1\");\n   245→    expect(await fs.promises.readFile(path.join(destDir, \"file2.txt\"), \"utf-8\")).toBe(\"content2\");\n   246→  });\n   247→\n   248→  test(\"preserves directory structure\", async () => {\n   249→    await fs.promises.mkdir(path.join(tempDir, \"nested\", \"deep\"), {\n   250→      recursive: true,\n   251→    });\n   252→    await fs.promises.writeFile(path.join(tempDir, \"nested\", \"file.txt\"), \"nested content\");\n   253→    await fs.promises.writeFile(\n   254→      path.join(tempDir, \"nested\", \"deep\", \"deep-file.txt\"),\n   255→      \"deep content\",\n   256→    );\n   257→\n   258→    await copyFiles(tempDir, [\"**/*.txt\"], destDir, mockLogger);\n   259→\n   260→    expect(await fs.promises.readFile(path.join(destDir, \"nested\", \"file.txt\"), \"utf-8\")).toBe(\n   261→      \"nested content\",\n   262→    );\n   263→    expect(\n   264→      await fs.promises.readFile(path.join(destDir, \"nested\", \"deep\", \"deep-file.txt\"), \"utf-8\"),\n   265→    ).toBe(\"deep content\");\n   266→  });\n   267→\n   268→  test(\"creates destination directory if it doesn't exist\", async () => {\n   269→    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"content\");\n   270→\n   271→    rmSync(destDir, { recursive: true, force: true });\n   272→    expect(fs.existsSync(destDir)).toBe(false);\n   273→\n   274→    await copyFiles(tempDir, [\"test.txt\"], destDir, mockLogger);\n   275→\n   276→    expect(fs.existsSync(destDir)).toBe(true);\n   277→    expect(await fs.promises.readFile(path.join(destDir, \"test.txt\"), \"utf-8\")).toBe(\"content\");\n   278→  });\n   279→\n   280→  test(\"handles glob patterns correctly\", async () => {\n   281→    await fs.promises.writeFile(path.join(tempDir, \"file.js\"), \"js content\");\n   282→    await fs.promises.writeFile(path.join(tempDir, \"file.ts\"), \"ts content\");\n   283→    await fs.promises.writeFile(path.join(tempDir, \"readme.md\"), \"md content\");\n   284→\n   285→    await copyFiles(tempDir, [\"*.js\", \"*.ts\"], destDir, mockLogger);\n   286→\n   287→    expect(fs.existsSync(path.join(destDir, \"file.js\"))).toBe(true);\n   288→    expect(fs.existsSync(path.join(destDir, \"file.ts\"))).toBe(true);\n   289→    expect(fs.existsSync(path.join(destDir, \"readme.md\"))).toBe(false);\n   290→  });\n   291→\n   292→  test(\"handles empty file list gracefully\", async () => {\n   293→    await fs.promises.writeFile(path.join(tempDir, \"ignored.txt\"), \"content\");\n   294→\n   295→    await copyFiles(tempDir, [\"*.nonexistent\"], destDir, mockLogger);\n   296→\n   297→    expect(fs.existsSync(path.join(destDir, \"ignored.txt\"))).toBe(false);\n   298→  });\n   299→\n   300→  test(\"copies directories recursively\", async () => {\n   301→    await fs.promises.mkdir(path.join(tempDir, \"source-dir\", \"subdir\"), {\n   302→      recursive: true,\n   303→    });\n   304→    await fs.promises.writeFile(path.join(tempDir, \"source-dir\", \"file.txt\"), \"dir content\");\n   305→    await fs.promises.writeFile(\n   306→      path.join(tempDir, \"source-dir\", \"subdir\", \"nested.txt\"),\n   307→      \"nested dir content\",\n   308→    );\n   309→\n   310→    await copyFiles(tempDir, [\"source-dir/**\"], destDir, mockLogger);\n   311→\n   312→    expect(await fs.promises.readFile(path.join(destDir, \"source-dir\", \"file.txt\"), \"utf-8\")).toBe(\n   313→      \"dir content\",\n   314→    );\n   315→    expect(\n   316→      await fs.promises.readFile(path.join(destDir, \"source-dir\", \"subdir\", \"nested.txt\"), \"utf-8\"),\n   317→    ).toBe(\"nested dir content\");\n   318→  });\n   319→\n   320→  test(\"ignores .gitignore rules and copies all matching files\", async () => {\n   321→    await fs.promises.writeFile(path.join(tempDir, \"include.txt\"), \"included\");\n   322→    await fs.promises.writeFile(path.join(tempDir, \"ignore.txt\"), \"ignored\");\n   323→    await fs.promises.writeFile(path.join(tempDir, \".gitignore\"), \"ignore.txt\\n\");\n   324→\n   325→    await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger);\n   326→\n   327→    expect(fs.existsSync(path.join(destDir, \"include.txt\"))).toBe(true);\n   328→    expect(fs.existsSync(path.join(destDir, \"ignore.txt\"))).toBe(true);\n   329→\n   330→    expect(await fs.promises.readFile(path.join(destDir, \"include.txt\"), \"utf-8\")).toBe(\"included\");\n   331→    expect(await fs.promises.readFile(path.join(destDir, \"ignore.txt\"), \"utf-8\")).toBe(\"ignored\");\n   332→  });\n   333→});\n   334→\n   335→// ENG-125: Symlink tests - skip on Windows where symlinks require elevated privileges\n   336→const isWindows = process.platform === \"win32\";\n   337→const describeSymlinks = isWindows ? describe.skip : describe;\n   338→\n   339→describeSymlinks(\"copyFiles with symlinks (ENG-125)\", () => {\n   340→  let tempDir: string;\n   341→  let destDir: string;\n   342→  let mockLogger: MockLogger;\n   343→\n   344→  beforeEach(async () => {\n   345→    const timestamp = Date.now();\n   346→    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-symlinks-src-${timestamp}`);\n   347→    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-symlinks-dest-${timestamp}`);\n   348→    await fs.promises.mkdir(tempDir, { recursive: true });\n   349→    mockLogger = new MockLogger(\"\");\n   350→  });\n   351→\n   352→  afterEach(() => {\n   353→    rmSync(tempDir, { recursive: true, force: true });\n   354→    rmSync(destDir, { recursive: true, force: true });\n   355→  });\n   356→\n   357→  test(\"should preserve symlinks when copying directory (verbatimSymlinks)\", async () => {\n   358→    // Create a real file\n   359→    const realFile = path.join(tempDir, \"real.txt\");\n   360→    await fs.promises.writeFile(realFile, \"real content\");\n   361→\n   362→    // Create symlink to real file\n   363→    const symlinkFile = path.join(tempDir, \"link.txt\");\n   364→    await fs.promises.symlink(realFile, symlinkFile);\n   365→\n   366→    // Copy using copyFiles\n   367→    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n   368→\n   369→    // Verify symlink is preserved (not dereferenced)\n   370→    const destSymlink = path.join(destDir, \"link.txt\");\n   371→    const stats = await fs.promises.lstat(destSymlink);\n   372→    expect(stats.isSymbolicLink()).toBe(true);\n   373→  });\n   374→\n   375→  // NOTE: Test for nested directory symlinks removed - the copyFiles function uses glob\n   376→  // patterns which interact with symlinks in ways that can cause \"cannot copy to subdirectory\n   377→  // of self\" errors. The verbatimSymlinks fix specifically addresses EINVAL errors for\n   378→  // node_modules/.bin symlinks, not all symlink scenarios.\n   379→\n   380→  test(\"should handle relative symlinks\", async () => {\n   381→    // Create a real file\n   382→    const realFile = path.join(tempDir, \"real.txt\");\n   383→    await fs.promises.writeFile(realFile, \"real content\");\n   384→\n   385→    // Create relative symlink\n   386→    const symlinkFile = path.join(tempDir, \"relative-link.txt\");\n   387→    await fs.promises.symlink(\"./real.txt\", symlinkFile);\n   388→\n   389→    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n   390→\n   391→    const destSymlink = path.join(destDir, \"relative-link.txt\");\n   392→    const stats = await fs.promises.lstat(destSymlink);\n   393→    expect(stats.isSymbolicLink()).toBe(true);\n   394→\n   395→    // Verify the symlink target is preserved\n   396→    const target = await fs.promises.readlink(destSymlink);\n   397→    expect(target).toBe(\"./real.txt\");\n   398→  });\n   399→\n   400→  test(\"should copy symlink alongside regular files\", async () => {\n   401→    // Create regular file\n   402→    await fs.promises.writeFile(path.join(tempDir, \"regular.txt\"), \"regular content\");\n   403→\n   404→    // Create another file and symlink to it\n   405→    const targetFile = path.join(tempDir, \"target.txt\");\n   406→    await fs.promises.writeFile(targetFile, \"target content\");\n   407→    await fs.promises.symlink(targetFile, path.join(tempDir, \"link.txt\"));\n   408→\n   409→    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n   410→\n   411→    // Regular file should be copied\n   412→    expect(await fs.promises.readFile(path.join(destDir, \"regular.txt\"), \"utf-8\")).toBe(\n   413→      \"regular content\",\n   414→    );\n   415→\n   416→    // Symlink should be preserved\n   417→    const linkStats = await fs.promises.lstat(path.join(destDir, \"link.txt\"));\n   418→    expect(linkStats.isSymbolicLink()).toBe(true);\n   419→\n   420→    // Target should also be copied\n   421→    expect(await fs.promises.readFile(path.join(destDir, \"target.txt\"), \"utf-8\")).toBe(\n   422→      \"target content\",\n   423→    );\n   424→  });\n   425→});\n   426→\n   427→describe(\"copyFiles with overwrite option\", () => {\n   428→  let tempDir: string;\n   429→  let destDir: string;\n   430→  let mockLogger: MockLogger;\n   431→\n   432→  beforeEach(async () => {\n   433→    const timestamp = Date.now();\n   434→    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-overwrite-src-${timestamp}`);\n   435→    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-overwrite-dest-${timestamp}`);\n   436→    await fs.promises.mkdir(tempDir, { recursive: true });\n   437→    await fs.promises.mkdir(destDir, { recursive: true });\n   438→    mockLogger = new MockLogger(\"/dev/null\");\n   439→  });\n   440→\n   441→  afterEach(async () => {\n   442→    rmSync(tempDir, { recursive: true, force: true });\n   443→    rmSync(destDir, { recursive: true, force: true });\n   444→  });\n   445→\n   446→  test(\"default behavior renames on conflict\", async () => {\n   447→    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n   448→    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n   449→\n   450→    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger);\n   451→\n   452→    expect(conflicts.length).toBe(1);\n   453→    // Original file should be untouched\n   454→    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n   455→      \"old content\",\n   456→    );\n   457→    // New file should be renamed\n   458→    const renamedFile = conflicts[0].resolved;\n   459→    expect(await fs.promises.readFile(renamedFile, \"utf-8\")).toBe(\"new content\");\n   460→  });\n   461→\n   462→  test(\"overwrite: true replaces existing file\", async () => {\n   463→    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n   464→    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n   465→\n   466→    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger, {\n   467→      overwrite: true,\n   468→    });\n   469→\n   470→    expect(conflicts.length).toBe(0);\n   471→    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n   472→      \"new content\",\n   473→    );\n   474→  });\n   475→\n   476→  test(\"overwrite: true works when destination does not exist\", async () => {\n   477→    await fs.promises.writeFile(path.join(tempDir, \"new-file.txt\"), \"fresh content\");\n   478→\n   479→    const { conflicts } = await copyFiles(tempDir, [\"new-file.txt\"], destDir, mockLogger, {\n   480→      overwrite: true,\n   481→    });\n   482→\n   483→    expect(conflicts.length).toBe(0);\n   484→    expect(await fs.promises.readFile(path.join(destDir, \"new-file.txt\"), \"utf-8\")).toBe(\n   485→      \"fresh content\",\n   486→    );\n   487→  });\n   488→\n   489→  test(\"overwrite: true replaces multiple files\", async () => {\n   490→    await fs.promises.writeFile(path.join(tempDir, \"a.txt\"), \"new-a\");\n   491→    await fs.promises.writeFile(path.join(tempDir, \"b.txt\"), \"new-b\");\n   492→    await fs.promises.writeFile(path.join(destDir, \"a.txt\"), \"old-a\");\n   493→    await fs.promises.writeFile(path.join(destDir, \"b.txt\"), \"old-b\");\n   494→\n   495→    const { conflicts } = await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger, {\n   496→      overwrite: true,\n   497→    });\n   498→\n   499→    expect(conflicts.length).toBe(0);\n   500→    expect(await fs.promises.readFile(path.join(destDir, \"a.txt\"), \"utf-8\")).toBe(\"new-a\");\n   501→    expect(await fs.promises.readFile(path.join(destDir, \"b.txt\"), \"utf-8\")).toBe(\"new-b\");\n   502→  });\n   503→\n   504→  test(\"overwrite: false behaves like default (rename)\", async () => {\n   505→    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n   506→    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n   507→\n   508→    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger, {\n   509→      overwrite: false,\n   510→    });\n   511→\n   512→    expect(conflicts.length).toBe(1);\n   513→    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n   514→      \"old content\",\n   515→    );\n   516→  });\n   517→});\n   518→\n   519→describe(\"serve\", () => {\n   520→  test(\"creates HTTP server that responds to requests\", async () => {\n   521→    const testPort = await getFreePort();\n   522→\n   523→    const server = serve({\n   524→      port: testPort,\n   525→      fetch: async (request: Request) => {\n   526→        if (request.url.includes(\"/test\")) {\n   527→          return new Response(\"Test OK\", { status: 200 });\n   528→        }\n   529→        return new Response(\"Not Found\", { status: 404 });\n   530→      },\n   531→    });\n   532→\n   533→    // Give server time to start\n   534→    await new Promise((resolve) => setTimeout(resolve, 100));\n   535→\n   536→    try {\n   537→      // Make request to server\n   538→      const response = await fetch(`http://localhost:${testPort}/test`);\n   539→      expect(response.status).toBe(200);\n   540→      expect(await response.text()).toBe(\"Test OK\");\n   541→\n   542→      // Test 404 response\n   543→      const notFoundResponse = await fetch(`http://localhost:${testPort}/other`);\n   544→      expect(notFoundResponse.status).toBe(404);\n   545→    } finally {\n   546→      server.stop();\n   547→    }\n   548→  });\n   549→\n   550→  test(\"creates HTTP server with idle timeout\", async () => {\n   551→    const testPort = await getFreePort();\n   552→\n   553→    const server = serve({\n   554→      port: testPort,\n   555→      idleTimeout: 5,\n   556→      fetch: async () => {\n   557→        return new Response(\"OK\", { status: 200 });\n   558→      },\n   559→    });\n   560→\n   561→    // Give server time to start\n   562→    await new Promise((resolve) => setTimeout(resolve, 100));\n   563→\n   564→    try {\n   565→      const response = await fetch(`http://localhost:${testPort}/`);\n   566→      expect(response.status).toBe(200);\n   567→    } finally {\n   568→      server.stop();\n   569→    }\n   570→  });\n   571→\n   572→  test(\"server.stop() shuts down the server\", async () => {\n   573→    const testPort = await getFreePort();\n   574→\n   575→    const server = serve({\n   576→      port: testPort,\n   577→      fetch: async () => new Response(\"OK\"),\n   578→    });\n   579→\n   580→    // Give server time to start\n   581→    await new Promise((resolve) => setTimeout(resolve, 100));\n   582→\n   583→    // Verify server is running\n   584→    const response = await fetch(`http://localhost:${testPort}/`);\n   585→    expect(response.status).toBe(200);\n   586→\n   587→    // Stop the server\n   588→    server.stop();\n   589→\n   590→    // Give server time to stop\n   591→    await new Promise((resolve) => setTimeout(resolve, 100));\n   592→\n   593→    // Verify server is no longer accepting connections\n   594→    try {\n   595→      await fetch(`http://localhost:${testPort}/`);\n   596→      expect(true).toBe(false); // Should not reach here\n   597→    } catch (error) {\n   598→      // Expected error when connecting to stopped server\n   599→      expect(error).toBeDefined();\n   600→    }\n   601→  });\n   602→\n   603→  test(\"creates WebSocket server\", async () => {\n   604→    const testPort = await getFreePort();\n   605→    const connections: Set<unknown> = new Set();\n   606→\n   607→    const server = serve({\n   608→      port: testPort,\n   609→      websocket: {\n   610→        open: (ws) => {\n   611→          connections.add(ws);\n   612→        },\n   613→        message: (ws, message) => {\n   614→          // Echo the message back\n   615→          if (typeof message === \"string\") {\n   616→            ws.send(`echo: ${message}`);\n   617→          }\n   618→        },\n   619→        close: (ws) => {\n   620→          connections.delete(ws);\n   621→        },\n   622→      },\n   623→    });\n   624→\n   625→    // Give server time to start\n   626→    await new Promise((resolve) => setTimeout(resolve, 100));\n   627→\n   628→    try {\n   629→      // Create WebSocket client\n   630→      const ws = new WebSocket(`ws://localhost:${testPort}`);\n   631→\n   632→      // Wait for connection\n   633→      await new Promise<void>((resolve, reject) => {\n   634→        ws.onopen = () => resolve();\n   635→        ws.onerror = (error) => reject(error);\n   636→        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n   637→      });\n   638→\n   639→      expect(connections.size).toBe(1);\n   640→\n   641→      // Send message and receive echo\n   642→      const echoPromise = new Promise<string>((resolve) => {\n   643→        ws.onmessage = (event) => {\n   644→          resolve(event.data);\n   645→        };\n   646→      });\n   647→\n   648→      ws.send(\"hello\");\n   649→      const echo = await echoPromise;\n   650→      expect(echo).toBe(\"echo: hello\");\n   651→\n   652→      // Close connection\n   653→      ws.close();\n   654→\n   655→      // Wait for close to be processed\n   656→      await new Promise((resolve) => setTimeout(resolve, 100));\n   657→\n   658→      expect(connections.size).toBe(0);\n   659→    } finally {\n   660→      server.stop();\n   661→    }\n   662→  });\n   663→\n   664→  test(\"handles multiple HTTP requests concurrently\", async () => {\n   665→    const testPort = await getFreePort();\n   666→    let requestCount = 0;\n   667→\n   668→    const server = serve({\n   669→      port: testPort,\n   670→      fetch: async () => {\n   671→        requestCount++;\n   672→        // Simulate some async work\n   673→        await new Promise((resolve) => setTimeout(resolve, 10));\n   674→        return new Response(`Request ${requestCount}`, { status: 200 });\n   675→      },\n   676→    });\n   677→\n   678→    // Give server time to start\n   679→    await new Promise((resolve) => setTimeout(resolve, 100));\n   680→\n   681→    try {\n   682→      // Make multiple concurrent requests\n   683→      const requests = Array.from({ length: 5 }, (_, i) =>\n   684→        fetch(`http://localhost:${testPort}/test${i}`),\n   685→      );\n   686→\n   687→      const responses = await Promise.all(requests);\n   688→\n   689→      expect(responses.length).toBe(5);\n   690→      responses.forEach((response) => {\n   691→        expect(response.status).toBe(200);\n   692→      });\n   693→\n   694→      expect(requestCount).toBe(5);\n   695→    } finally {\n   696→      server.stop();\n   697→    }\n   698→  });\n   699→\n   700→  test(\"WebSocket upgrade hook initializes connection data\", async () => {\n   701→    const testPort = await getFreePort();\n   702→    interface TestData {\n   703→      id: string;\n   704→      authenticated: boolean;\n   705→    }\n   706→    let capturedData: TestData | null = null;\n   707→\n   708→    const server = serve<TestData>({\n   709→      port: testPort,\n   710→      websocket: {\n   711→        upgrade: (_req) => ({\n   712→          id: \"test-123\",\n   713→          authenticated: false,\n   714→        }),\n   715→        open: (ws) => {\n   716→          capturedData = ws.data;\n   717→        },\n   718→      },\n   719→    });\n   720→\n   721→    await new Promise((resolve) => setTimeout(resolve, 100));\n   722→\n   723→    try {\n   724→      const ws = new WebSocket(`ws://localhost:${testPort}`);\n   725→\n   726→      await new Promise<void>((resolve, reject) => {\n   727→        ws.onopen = () => resolve();\n   728→        ws.onerror = (error) => reject(error);\n   729→        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n   730→      });\n   731→\n   732→      // Give open handler time to execute\n   733→      await new Promise((resolve) => setTimeout(resolve, 100));\n   734→\n   735→      expect(capturedData).not.toBeNull();\n   736→      // biome-ignore lint/style/noNonNullAssertion: checked not null above\n   737→      expect(capturedData!.id).toBe(\"test-123\");\n   738→      // biome-ignore lint/style/noNonNullAssertion: checked not null above\n   739→      expect(capturedData!.authenticated).toBe(false);\n   740→\n   741→      ws.close();\n   742→    } finally {\n   743→      server.stop();\n   744→    }\n   745→  });\n   746→\n   747→  test(\"WebSocket data can be updated and read back\", async () => {\n   748→    const testPort = await getFreePort();\n   749→    interface TestData {\n   750→      id: string;\n   751→      count: number;\n   752→      active: boolean;\n   753→    }\n   754→\n   755→    const server = serve<TestData>({\n   756→      port: testPort,\n   757→      websocket: {\n   758→        upgrade: (_req) => ({\n   759→          id: \"conn-1\",\n   760→          count: 0,\n   761→          active: false,\n   762→        }),\n   763→        message: (ws, message) => {\n   764→          if (message === \"activate\") {\n   765→            // Update data by replacing entire object\n   766→            ws.data = {\n   767→              ...ws.data,\n   768→              active: true,\n   769→              count: ws.data.count + 1,\n   770→            };\n   771→            ws.send(JSON.stringify(ws.data));\n   772→          } else if (message === \"increment\") {\n   773→            // Update data again\n   774→            ws.data = {\n   775→              ...ws.data,\n   776→              count: ws.data.count + 1,\n   777→            };\n   778→            ws.send(JSON.stringify(ws.data));\n   779→          }\n   780→        },\n   781→      },\n   782→    });\n   783→\n   784→    await new Promise((resolve) => setTimeout(resolve, 100));\n   785→\n   786→    try {\n   787→      const ws = new WebSocket(`ws://localhost:${testPort}`);\n   788→\n   789→      await new Promise<void>((resolve, reject) => {\n   790→        ws.onopen = () => resolve();\n   791→        ws.onerror = (error) => reject(error);\n   792→        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n   793→      });\n   794→\n   795→      // Test activate\n   796→      const activateResponse = new Promise<TestData>((resolve) => {\n   797→        ws.onmessage = (event) => {\n   798→          resolve(JSON.parse(event.data));\n   799→        };\n   800→      });\n   801→      ws.send(\"activate\");\n   802→      const activateData = await activateResponse;\n   803→      expect(activateData.active).toBe(true);\n   804→      expect(activateData.count).toBe(1);\n   805→      expect(activateData.id).toBe(\"conn-1\");\n   806→\n   807→      // Test increment\n   808→      const incrementResponse = new Promise<TestData>((resolve) => {\n   809→        ws.onmessage = (event) => {\n   810→          resolve(JSON.parse(event.data));\n   811→        };\n   812→      });\n   813→      ws.send(\"increment\");\n   814→      const incrementData = await incrementResponse;\n   815→      expect(incrementData.active).toBe(true);\n   816→      expect(incrementData.count).toBe(2);\n   817→      expect(incrementData.id).toBe(\"conn-1\");\n   818→\n   819→      ws.close();\n   820→    } finally {\n   821→      server.stop();\n   822→    }\n   823→  });\n   824→\n   825→  test(\"WebSocket data updates persist across handler calls\", async () => {\n   826→    const testPort = await getFreePort();\n   827→    interface ClientData {\n   828→      id: string;\n   829→      handshakeComplete: boolean;\n   830→      messageCount: number;\n   831→    }\n   832→\n   833→    const server = serve<ClientData>({\n   834→      port: testPort,\n   835→      websocket: {\n   836→        upgrade: (_req) => ({\n   837→          id: \"client-xyz\",\n   838→          handshakeComplete: false,\n   839→          messageCount: 0,\n   840→        }),\n   841→        message: (ws, message) => {\n   842→          if (message === \"handshake\") {\n   843→            // Simulate handshake - update data\n   844→            ws.data = {\n   845→              ...ws.data,\n   846→              handshakeComplete: true,\n   847→            };\n   848→            ws.send(\"handshake_ok\");\n   849→          } else if (message === \"ping\") {\n   850→            // Only respond if handshake is complete\n   851→            if (ws.data.handshakeComplete) {\n   852→              ws.data = {\n   853→                ...ws.data,\n   854→                messageCount: ws.data.messageCount + 1,\n   855→              };\n   856→              ws.send(`pong:${ws.data.messageCount}`);\n   857→            } else {\n   858→              ws.send(\"error:not_authenticated\");\n   859→            }\n   860→          }\n   861→        },\n   862→      },\n   863→    });\n   864→\n   865→    await new Promise((resolve) => setTimeout(resolve, 100));\n   866→\n   867→    try {\n   868→      const ws = new WebSocket(`ws://localhost:${testPort}`);\n   869→\n   870→      await new Promise<void>((resolve, reject) => {\n   871→        ws.onopen = () => resolve();\n   872→        ws.onerror = (error) => reject(error);\n   873→        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n   874→      });\n   875→\n   876→      // Test ping before handshake - should fail\n   877→      const pingBeforeHandshake = new Promise<string>((resolve) => {\n   878→        ws.onmessage = (event) => {\n   879→          resolve(event.data);\n   880→        };\n   881→      });\n   882→      ws.send(\"ping\");\n   883→      const errorResponse = await pingBeforeHandshake;\n   884→      expect(errorResponse).toBe(\"error:not_authenticated\");\n   885→\n   886→      // Perform handshake\n   887→      const handshakeResponse = new Promise<string>((resolve) => {\n   888→        ws.onmessage = (event) => {\n   889→          resolve(event.data);\n   890→        };\n   891→      });\n   892→      ws.send(\"handshake\");\n   893→      const handshakeResult = await handshakeResponse;\n   894→      expect(handshakeResult).toBe(\"handshake_ok\");\n   895→\n   896→      // Test ping after handshake - should succeed\n   897→      const ping1Response = new Promise<string>((resolve) => {\n   898→        ws.onmessage = (event) => {\n   899→          resolve(event.data);\n   900→        };\n   901→      });\n   902→      ws.send(\"ping\");\n   903→      const pong1 = await ping1Response;\n   904→      expect(pong1).toBe(\"pong:1\");\n   905→\n   906→      // Test another ping - count should increment\n   907→      const ping2Response = new Promise<string>((resolve) => {\n   908→        ws.onmessage = (event) => {\n   909→          resolve(event.data);\n   910→        };\n   911→      });\n   912→      ws.send(\"ping\");\n   913→      const pong2 = await ping2Response;\n   914→      expect(pong2).toBe(\"pong:2\");\n   915→\n   916→      ws.close();\n   917→    } finally {\n   918→      server.stop();\n   919→    }\n   920→  });\n   921→});\n   922→\n   923→describe(\"renameWithRetry\", () => {\n   924→  let tempDir: string;\n   925→\n   926→  beforeEach(async () => {\n   927→    const timestamp = Date.now();\n   928→    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-rename-${timestamp}`);\n   929→    await fs.promises.mkdir(tempDir, { recursive: true });\n   930→  });\n   931→\n   932→  afterEach(() => {\n   933→    rmSync(tempDir, { recursive: true, force: true });\n   934→  });\n   935→\n   936→  test(\"successfully renames file on first attempt\", async () => {\n   937→    const sourcePath = path.join(tempDir, \"source.txt\");\n   938→    const targetPath = path.join(tempDir, \"target.txt\");\n   939→\n   940→    await fs.promises.writeFile(sourcePath, \"test content\");\n   941→\n   942→    await renameWithRetry(sourcePath, targetPath);\n   943→\n   944→    expect(fs.existsSync(targetPath)).toBe(true);\n   945→    expect(fs.existsSync(sourcePath)).toBe(false);\n   946→    expect(await fs.promises.readFile(targetPath, \"utf-8\")).toBe(\"test content\");\n   947→  });\n   948→\n   949→  test(\"overwrites existing target file\", async () => {\n   950→    const sourcePath = path.join(tempDir, \"source.txt\");\n   951→    const targetPath = path.join(tempDir, \"target.txt\");\n   952→\n   953→    await fs.promises.writeFile(sourcePath, \"new content\");\n   954→    await fs.promises.writeFile(targetPath, \"old content\");\n   955→\n   956→    await renameWithRetry(sourcePath, targetPath);\n   957→\n   958→    expect(fs.existsSync(targetPath)).toBe(true);\n   959→    expect(fs.existsSync(sourcePath)).toBe(false);\n   960→    expect(await fs.promises.readFile(targetPath, \"utf-8\")).toBe(\"new content\");\n   961→  });\n   962→\n   963→  test(\"retries on EPERM error and eventually succeeds\", async () => {\n   964→    const sourcePath = path.join(tempDir, \"source.txt\");\n   965→    const targetPath = path.join(tempDir, \"target.txt\");\n   966→    const mockLogger = new MockLogger(\"\");\n   967→\n   968→    await fs.promises.writeFile(sourcePath, \"content\");\n   969→\n   970→    // Mock fs.promises.rename to fail twice with EPERM, then succeed\n   971→    let attemptCount = 0;\n   972→    const originalRename = fs.promises.rename;\n   973→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n   974→    (fs.promises as any).rename = async (src: string, dest: string) => {\n   975→      attemptCount++;\n   976→      if (attemptCount <= 2) {\n   977→        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n   978→        error.code = \"EPERM\";\n   979→        throw error;\n   980→      }\n   981→      return originalRename.call(fs.promises, src, dest);\n   982→    };\n   983→\n   984→    try {\n   985→      await renameWithRetry(sourcePath, targetPath, {\n   986→        maxRetries: 5,\n   987→        initialDelay: 1, // Use minimal delay for tests\n   988→        logger: mockLogger,\n   989→      });\n   990→\n   991→      expect(fs.existsSync(targetPath)).toBe(true);\n   992→      expect(fs.existsSync(sourcePath)).toBe(false);\n   993→      expect(attemptCount).toBe(3); // Failed twice, succeeded on third attempt\n   994→\n   995→      // Check that retry was logged\n   996→      const retryLogs = mockLogger.logs.filter((log) => log.message.includes(\"File locked\"));\n   997→      expect(retryLogs.length).toBeGreaterThan(0);\n   998→    } finally {\n   999→      // Restore original rename\n  1000→      fs.promises.rename = originalRename;\n  1001→    }\n  1002→  });\n  1003→\n  1004→  test(\"retries on EBUSY error\", async () => {\n  1005→    const sourcePath = path.join(tempDir, \"source.txt\");\n  1006→    const targetPath = path.join(tempDir, \"target.txt\");\n  1007→\n  1008→    await fs.promises.writeFile(sourcePath, \"content\");\n  1009→\n  1010→    let attemptCount = 0;\n  1011→    const originalRename = fs.promises.rename;\n  1012→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n  1013→    (fs.promises as any).rename = async (src: string, dest: string) => {\n  1014→      attemptCount++;\n  1015→      if (attemptCount === 1) {\n  1016→        const error: NodeJS.ErrnoException = new Error(\"EBUSY: resource busy or locked\");\n  1017→        error.code = \"EBUSY\";\n  1018→        throw error;\n  1019→      }\n  1020→      return originalRename.call(fs.promises, src, dest);\n  1021→    };\n  1022→\n  1023→    try {\n  1024→      await renameWithRetry(sourcePath, targetPath, {\n  1025→        maxRetries: 3,\n  1026→        initialDelay: 1,\n  1027→      });\n  1028→\n  1029→      expect(fs.existsSync(targetPath)).toBe(true);\n  1030→      expect(attemptCount).toBe(2);\n  1031→    } finally {\n  1032→      fs.promises.rename = originalRename;\n  1033→    }\n  1034→  });\n  1035→\n  1036→  test(\"retries on EACCES error\", async () => {\n  1037→    const sourcePath = path.join(tempDir, \"source.txt\");\n  1038→    const targetPath = path.join(tempDir, \"target.txt\");\n  1039→\n  1040→    await fs.promises.writeFile(sourcePath, \"content\");\n  1041→\n  1042→    let attemptCount = 0;\n  1043→    const originalRename = fs.promises.rename;\n  1044→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n  1045→    (fs.promises as any).rename = async (src: string, dest: string) => {\n  1046→      attemptCount++;\n  1047→      if (attemptCount === 1) {\n  1048→        const error: NodeJS.ErrnoException = new Error(\"EACCES: permission denied\");\n  1049→        error.code = \"EACCES\";\n  1050→        throw error;\n  1051→      }\n  1052→      return originalRename.call(fs.promises, src, dest);\n  1053→    };\n  1054→\n  1055→    try {\n  1056→      await renameWithRetry(sourcePath, targetPath, {\n  1057→        maxRetries: 3,\n  1058→        initialDelay: 1,\n  1059→      });\n  1060→\n  1061→      expect(fs.existsSync(targetPath)).toBe(true);\n  1062→      expect(attemptCount).toBe(2);\n  1063→    } finally {\n  1064→      fs.promises.rename = originalRename;\n  1065→    }\n  1066→  });\n  1067→\n  1068→  test(\"does not retry on non-retryable errors\", async () => {\n  1069→    const sourcePath = path.join(tempDir, \"nonexistent.txt\");\n  1070→    const targetPath = path.join(tempDir, \"target.txt\");\n  1071→\n  1072→    // ENOENT (file not found) should not trigger retry\n  1073→    try {\n  1074→      await renameWithRetry(sourcePath, targetPath, {\n  1075→        maxRetries: 5,\n  1076→        initialDelay: 1,\n  1077→      });\n  1078→      expect(true).toBe(false); // Should not reach here\n  1079→    } catch (error) {\n  1080→      const err = error as NodeJS.ErrnoException;\n  1081→      expect(err.code).toBe(\"ENOENT\");\n  1082→    }\n  1083→  });\n  1084→\n  1085→  test(\"throws error after max retries exceeded\", async () => {\n  1086→    const sourcePath = path.join(tempDir, \"source.txt\");\n  1087→    const targetPath = path.join(tempDir, \"target.txt\");\n  1088→    const mockLogger = new MockLogger(\"\");\n  1089→\n  1090→    await fs.promises.writeFile(sourcePath, \"content\");\n  1091→\n  1092→    let attemptCount = 0;\n  1093→    const originalRename = fs.promises.rename;\n  1094→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n  1095→    (fs.promises as any).rename = async () => {\n  1096→      attemptCount++;\n  1097→      const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n  1098→      error.code = \"EPERM\";\n  1099→      throw error;\n  1100→    };\n  1101→\n  1102→    try {\n  1103→      await renameWithRetry(sourcePath, targetPath, {\n  1104→        maxRetries: 3,\n  1105→        initialDelay: 1,\n  1106→        logger: mockLogger,\n  1107→      });\n  1108→      expect(true).toBe(false); // Should not reach here\n  1109→    } catch (error) {\n  1110→      const err = error as NodeJS.ErrnoException;\n  1111→      expect(err.code).toBe(\"EPERM\");\n  1112→      expect(attemptCount).toBe(3); // Should try exactly maxRetries times\n  1113→\n  1114→      // Verify retry attempts were logged\n  1115→      const retryLogs = mockLogger.logs.filter((log) => log.message.includes(\"File locked\"));\n  1116→      expect(retryLogs.length).toBe(2); // maxRetries - 1 (no log on final attempt)\n  1117→    } finally {\n  1118→      fs.promises.rename = originalRename;\n  1119→    }\n  1120→  });\n  1121→\n  1122→  test(\"uses exponential backoff for retries\", async () => {\n  1123→    const sourcePath = path.join(tempDir, \"source.txt\");\n  1124→    const targetPath = path.join(tempDir, \"target.txt\");\n  1125→    const mockLogger = new MockLogger(\"\");\n  1126→\n  1127→    await fs.promises.writeFile(sourcePath, \"content\");\n  1128→\n  1129→    const delays: number[] = [];\n  1130→    let attemptCount = 0;\n  1131→    const originalRename = fs.promises.rename;\n  1132→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n  1133→    (fs.promises as any).rename = async (src: string, dest: string) => {\n  1134→      attemptCount++;\n  1135→      if (attemptCount <= 3) {\n  1136→        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n  1137→        error.code = \"EPERM\";\n  1138→        throw error;\n  1139→      }\n  1140→      return originalRename.call(fs.promises, src, dest);\n  1141→    };\n  1142→\n  1143→    // Capture delays from log messages\n  1144→    const originalLog = mockLogger.log.bind(mockLogger);\n  1145→    mockLogger.log = (message: string, level = \"info\" as \"info\" | \"error\" | \"debug\") => {\n  1146→      originalLog(message, level);\n  1147→      const match = message.match(/retrying rename in (\\d+)ms/);\n  1148→      if (match) {\n  1149→        delays.push(Number.parseInt(match[1]));\n  1150→      }\n  1151→    };\n  1152→\n  1153→    try {\n  1154→      await renameWithRetry(sourcePath, targetPath, {\n  1155→        maxRetries: 5,\n  1156→        initialDelay: 10,\n  1157→        logger: mockLogger,\n  1158→      });\n  1159→\n  1160→      // Verify exponential backoff: 10ms, 20ms, 40ms\n  1161→      expect(delays).toEqual([10, 20, 40]);\n  1162→    } finally {\n  1163→      fs.promises.rename = originalRename;\n  1164→    }\n  1165→  });\n  1166→\n  1167→  test(\"works without logger\", async () => {\n  1168→    const sourcePath = path.join(tempDir, \"source.txt\");\n  1169→    const targetPath = path.join(tempDir, \"target.txt\");\n  1170→\n  1171→    await fs.promises.writeFile(sourcePath, \"content\");\n  1172→\n  1173→    let attemptCount = 0;\n  1174→    const originalRename = fs.promises.rename;\n  1175→    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n  1176→    (fs.promises as any).rename = async (src: string, dest: string) => {\n  1177→      attemptCount++;\n  1178→      if (attemptCount === 1) {\n  1179→        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n  1180→        error.code = \"EPERM\";\n  1181→        throw error;\n  1182→      }\n  1183→      return originalRename.call(fs.promises, src, dest);\n  1184→    };\n  1185→\n  1186→    try {\n  1187→      // Should not throw even without logger\n  1188→      await renameWithRetry(sourcePath, targetPath, {\n  1189→        maxRetries: 3,\n  1190→        initialDelay: 1,\n  1191→      });\n  1192→\n  1193→      expect(fs.existsSync(targetPath)).toBe(true);\n  1194→      expect(attemptCount).toBe(2);\n  1195→    } finally {\n  1196→      fs.promises.rename = originalRename;\n  1197→    }\n  1198→  });\n  1199→});\n  1200→\n  1201→describe(\"AppMetadata\", () => {\n  1202→  test(\"creates metadata from valid object\", () => {\n  1203→    const metadata = AppMetadata.create({\n  1204→      version: \"1.0.0\",\n  1205→      buildDate: \"2024-01-01T00:00:00.000Z\",\n  1206→      buildTarget: \"darwin-arm64\",\n  1207→    });\n  1208→\n  1209→    expect(metadata.version).toBe(\"1.0.0\");\n  1210→    expect(metadata.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n  1211→    expect(metadata.buildTarget).toBe(\"darwin-arm64\");\n  1212→  });\n  1213→\n  1214→  test(\"creates metadata with minimal fields\", () => {\n  1215→    const metadata = AppMetadata.create({\n  1216→      version: \"2.0.0\",\n  1217→    });\n  1218→\n  1219→    expect(metadata.version).toBe(\"2.0.0\");\n  1220→    expect(metadata.buildDate).toBeUndefined();\n  1221→    expect(metadata.buildTarget).toBeUndefined();\n  1222→  });\n  1223→\n  1224→  test(\"rejects empty version\", () => {\n  1225→    expect(() => {\n  1226→      AppMetadata.create({\n  1227→        version: \"\",\n  1228→      });\n  1229→    }).toThrow();\n  1230→  });\n  1231→\n  1232→  test(\"rejects missing version\", () => {\n  1233→    expect(() => {\n  1234→      AppMetadata.create({\n  1235→        buildDate: \"2024-01-01T00:00:00.000Z\",\n  1236→      });\n  1237→    }).toThrow();\n  1238→  });\n  1239→\n  1240→  test(\"serializes to JSON\", () => {\n  1241→    const metadata = AppMetadata.create({\n  1242→      version: \"1.2.3\",\n  1243→      buildDate: \"2024-01-01T00:00:00.000Z\",\n  1244→    });\n  1245→\n  1246→    const json = metadata.serialize();\n  1247→    const parsed = JSON.parse(json);\n  1248→\n  1249→    expect(parsed.version).toBe(\"1.2.3\");\n  1250→    expect(parsed.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n  1251→  });\n  1252→\n  1253→  test(\"deserializes from JSON string\", () => {\n  1254→    const json = JSON.stringify({\n  1255→      version: \"3.0.0\",\n  1256→      buildDate: \"2024-06-01T00:00:00.000Z\",\n  1257→      buildTarget: \"linux-x64\",\n  1258→    });\n  1259→\n  1260→    const metadata = AppMetadata.deserialize(json);\n  1261→\n  1262→    expect(metadata.version).toBe(\"3.0.0\");\n  1263→    expect(metadata.buildDate).toBe(\"2024-06-01T00:00:00.000Z\");\n  1264→    expect(metadata.buildTarget).toBe(\"linux-x64\");\n  1265→  });\n  1266→\n  1267→  test(\"toObject returns metadata object\", () => {\n  1268→    const metadata = AppMetadata.create({\n  1269→      version: \"1.0.0\",\n  1270→      buildDate: \"2024-01-01T00:00:00.000Z\",\n  1271→    });\n  1272→\n  1273→    const obj = metadata.toObject();\n  1274→\n  1275→    expect(obj.version).toBe(\"1.0.0\");\n  1276→    expect(obj.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n  1277→    expect(obj.buildTarget).toBeUndefined();\n  1278→  });\n  1279→\n  1280→  test(\"deserialize handles invalid JSON\", () => {\n  1281→    expect(() => {\n  1282→      AppMetadata.deserialize(\"not valid json\");\n  1283→    }).toThrow();\n  1284→  });\n  1285→\n  1286→  test(\"create validates schema\", () => {\n  1287→    // Valid extra fields should be ignored (schema is not strict)\n  1288→    const metadata = AppMetadata.create({\n  1289→      version: \"1.0.0\",\n  1290→      extraField: \"should be ignored\",\n  1291→    });\n  1292→\n  1293→    expect(metadata.version).toBe(\"1.0.0\");\n  1294→  });\n  1295→});\n  1296→\n  1297→describe(\"getMetadata\", () => {\n  1298→  test(\"returns metadata with version\", () => {\n  1299→    const metadata = getMetadata();\n  1300→\n  1301→    expect(metadata).toBeDefined();\n  1302→    expect(metadata.version).toBeDefined();\n  1303→    expect(typeof metadata.version).toBe(\"string\");\n  1304→    expect(metadata.version.length).toBeGreaterThan(0);\n  1305→  });\n  1306→\n  1307→  test(\"returns consistent metadata on multiple calls\", () => {\n  1308→    const metadata1 = getMetadata();\n  1309→    const metadata2 = getMetadata();\n  1310→\n  1311→    expect(metadata1.version).toBe(metadata2.version);\n  1312→    expect(metadata1.buildDate).toBe(metadata2.buildDate);\n  1313→    expect(metadata1.buildTarget).toBe(metadata2.buildTarget);\n  1314→  });\n  1315→\n  1316→  test(\"version follows semver-like format\", () => {\n  1317→    const metadata = getMetadata();\n  1318→    const version = metadata.version;\n  1319→\n  1320→    // Should be either semver format (x.y.z) or fallback \"1.0.0\"\n  1321→    expect(version).toMatch(/^\\d+\\.\\d+\\.\\d+/);\n  1322→  });\n  1323→});\n  1324→\n  1325→// Helper: create an async iterable from an array with optional delays\n  1326→async function* asyncFromArray<T>(items: T[], delayMs = 0): AsyncGenerator<T> {\n  1327→  for (const item of items) {\n  1328→    if (delayMs > 0) await new Promise((r) => setTimeout(r, delayMs));\n  1329→    yield item;\n  1330→  }\n  1331→}\n  1332→\n  1333→// Helper: create an async iterable that hangs forever after yielding initial items\n  1334→async function* asyncHangAfter<T>(items: T[]): AsyncGenerator<T> {\n  1335→  for (const item of items) {\n  1336→    yield item;\n  1337→  }\n  1338→  // Hang forever\n  1339→  await new Promise<T>(() => {});\n  1340→}\n  1341→\n  1342→describe(\"withIdleTimeout\", () => {\n  1343→  test(\"yields all items from a fast source\", async () => {\n  1344→    const source = asyncFromArray([1, 2, 3]);\n  1345→    const results: number[] = [];\n  1346→\n  1347→    for await (const item of withIdleTimeout(source, 1000)) {\n  1348→      results.push(item);\n  1349→    }\n  1350→\n  1351→    expect(results).toEqual([1, 2, 3]);\n  1352→  });\n  1353→\n  1354→  test(\"yields items when each arrives before timeout\", async () => {\n  1355→    const source = asyncFromArray([\"a\", \"b\", \"c\"], 10);\n  1356→    const results: string[] = [];\n  1357→\n  1358→    for await (const item of withIdleTimeout(source, 200)) {\n  1359→      results.push(item);\n  1360→    }\n  1361→\n  1362→    expect(results).toEqual([\"a\", \"b\", \"c\"]);\n  1363→  });\n  1364→\n  1365→  test(\"throws IdleTimeoutError when source hangs\", async () => {\n  1366→    const source = asyncHangAfter<number>([]);\n  1367→\n  1368→    try {\n  1369→      for await (const _item of withIdleTimeout(source, 50)) {\n  1370→        // Should not yield anything\n  1371→        expect(true).toBe(false);\n  1372→      }\n  1373→      expect(true).toBe(false); // Should not complete normally\n  1374→    } catch (error) {\n  1375→      expect(error).toBeInstanceOf(IdleTimeoutError);\n  1376→      expect((error as IdleTimeoutError).timeoutMs).toBe(50);\n  1377→    }\n  1378→  });\n  1379→\n  1380→  test(\"throws IdleTimeoutError when source hangs after yielding items\", async () => {\n  1381→    const source = asyncHangAfter([1, 2]);\n  1382→    const results: number[] = [];\n  1383→\n  1384→    try {\n  1385→      for await (const item of withIdleTimeout(source, 50)) {\n  1386→        results.push(item);\n  1387→      }\n  1388→      expect(true).toBe(false); // Should not complete normally\n  1389→    } catch (error) {\n  1390→      expect(error).toBeInstanceOf(IdleTimeoutError);\n  1391→    }\n  1392→\n  1393→    // Should have received the items before hanging\n  1394→    expect(results).toEqual([1, 2]);\n  1395→  });\n  1396→\n  1397→  test(\"timer resets on each event\", async () => {\n  1398→    // Each item arrives at 30ms intervals, timeout is 50ms\n  1399→    // Without timer reset this would timeout; with reset it completes fine\n  1400→    const source = asyncFromArray([1, 2, 3, 4, 5], 30);\n  1401→    const results: number[] = [];\n  1402→\n  1403→    for await (const item of withIdleTimeout(source, 50)) {\n  1404→      results.push(item);\n  1405→    }\n  1406→\n  1407→    expect(results).toEqual([1, 2, 3, 4, 5]);\n  1408→  });\n  1409→\n  1410→  test(\"handles empty async iterable\", async () => {\n  1411→    const source = asyncFromArray<number>([]);\n  1412→    const results: number[] = [];\n  1413→\n  1414→    for await (const item of withIdleTimeout(source, 1000)) {\n  1415→      results.push(item);\n  1416→    }\n  1417→\n  1418→    expect(results).toEqual([]);\n  1419→  });\n  1420→\n  1421→  test(\"calls return on iterator when timeout fires\", async () => {\n  1422→    let returnCalled = false;\n  1423→    const source: AsyncIterable<number> = {\n  1424→      [Symbol.asyncIterator]() {\n  1425→        return {\n  1426→          next: () => new Promise<IteratorResult<number>>(() => {}), // hang forever\n  1427→          return: () => {\n  1428→            returnCalled = true;\n  1429→            return Promise.resolve({ done: true as const, value: undefined });\n  1430→          },\n  1431→        };\n  1432→      },\n  1433→    };\n  1434→\n  1435→    try {\n  1436→      for await (const _item of withIdleTimeout(source, 50)) {\n  1437→        // never reached\n  1438→      }\n  1439→    } catch {\n  1440→      // expected\n  1441→    }\n  1442→\n  1443→    // Give the fire-and-forget return() a tick to execute\n  1444→    await new Promise((r) => setTimeout(r, 10));\n  1445→    expect(returnCalled).toBe(true);\n  1446→  });\n  1447→});\n  1448→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bd386bb2-bf82-4238-8328-c4d0499f0ddc","uuid":"45c01e5b-5641-4965-bbcd-8a9d8b0faeb0","tool_use_result":{"type":"text","file":{"filePath":"/Users/philip/projects/hw-budget-tests/plan-gen-execution/agentRoot/source/hankweave/tests/unit/utils.test.ts","content":"import { afterEach, beforeEach, describe, expect, test } from \"bun:test\";\nimport * as fs from \"node:fs\";\nimport { rmSync } from \"node:fs\";\nimport * as path from \"node:path\";\nimport type { FileNode } from \"../../server/types/types\";\nimport {\n  AppMetadata,\n  buildFileTree,\n  copyFiles,\n  escapeShellArg,\n  getMetadata,\n  IdleTimeoutError,\n  Logger,\n  renameWithRetry,\n  serve,\n  WebSocket,\n  withIdleTimeout,\n} from \"../../server/utils\";\nimport { getFreePort } from \"../utils/test-helpers.js\";\n\ndescribe(\"Test Environment\", () => {\n  test(\"NODE_ENV is set to 'test' during Bun test runs\", () => {\n    expect(process.env.NODE_ENV).toBe(\"test\");\n  });\n});\n\ndescribe(\"escapeShellArg\", () => {\n  test(\"escapes single quotes correctly\", () => {\n    expect(escapeShellArg(\"test'value\")).toBe(\"'test'\\\\''value'\");\n  });\n\n  test(\"handles empty strings\", () => {\n    expect(escapeShellArg(\"\")).toBe(\"''\");\n  });\n\n  test(\"handles strings with newlines\", () => {\n    expect(escapeShellArg(\"line1\\nline2\")).toBe(\"'line1\\nline2'\");\n  });\n\n  test(\"handles strings with special shell characters ($, `, \\\\, !)\", () => {\n    expect(escapeShellArg(\"$test\")).toBe(\"'$test'\");\n    expect(escapeShellArg(\"`command`\")).toBe(\"'`command`'\");\n    expect(escapeShellArg(\"\\\\path\")).toBe(\"'\\\\path'\");\n    expect(escapeShellArg(\"!history\")).toBe(\"'!history'\");\n  });\n\n  test(\"handles unicode characters\", () => {\n    expect(escapeShellArg(\"こんにちは\")).toBe(\"'こんにちは'\");\n    expect(escapeShellArg(\"🚀\")).toBe(\"'🚀'\");\n  });\n\n  test(\"handles very long strings\", () => {\n    const longString = \"a\".repeat(10000);\n    const escaped = escapeShellArg(longString);\n    expect(escaped).toBe(`'${longString}'`);\n  });\n\n  test(\"prevents command injection attempts\", () => {\n    expect(escapeShellArg(\"'; rm -rf /\")).toBe(\"''\\\\''; rm -rf /'\");\n    expect(escapeShellArg(\"$(whoami)\")).toBe(\"'$(whoami)'\");\n    expect(escapeShellArg(\"&&malicious\")).toBe(\"'&&malicious'\");\n  });\n});\n\ndescribe(\"buildFileTree\", () => {\n  let tempDir: string;\n\n  beforeEach(async () => {\n    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-filetree-${Date.now()}`);\n    await fs.promises.mkdir(tempDir, { recursive: true });\n  });\n\n  afterEach(() => {\n    rmSync(tempDir, { recursive: true, force: true });\n  });\n\n  test(\"builds tree from flat file list\", async () => {\n    // Create test files\n    await fs.promises.writeFile(path.join(tempDir, \"file1.txt\"), \"content1\");\n    await fs.promises.writeFile(path.join(tempDir, \"file2.txt\"), \"content2\");\n\n    const tree = await buildFileTree(tempDir, \"*.txt\");\n\n    expect(tree).toHaveLength(2);\n    const fileNames = tree.map((node) => node.name).sort();\n    expect(fileNames).toEqual([\"file1.txt\", \"file2.txt\"]);\n\n    tree.forEach((node) => {\n      expect(node.isDirectory).toBe(false);\n      // TypeScript assertion since we know all nodes are files\n      const fileNode = node as FileNode & { isDirectory: false };\n      expect(fileNode.lastModified).toBeDefined();\n    });\n  });\n\n  test(\"handles nested directories correctly\", async () => {\n    // Create nested structure\n    await fs.promises.mkdir(path.join(tempDir, \"src\"), { recursive: true });\n    await fs.promises.mkdir(path.join(tempDir, \"src\", \"utils\"), {\n      recursive: true,\n    });\n    await fs.promises.writeFile(path.join(tempDir, \"src\", \"index.ts\"), \"export {}\");\n    await fs.promises.writeFile(path.join(tempDir, \"src\", \"utils\", \"helper.ts\"), \"export {}\");\n\n    const tree = await buildFileTree(tempDir, \"**/*.ts\");\n\n    // Find the src node\n    const srcNode = tree.find((node) => node.name === \"src\");\n    expect(srcNode).toBeDefined();\n    expect(srcNode?.isDirectory).toBe(true);\n    expect(srcNode?.children).toBeDefined();\n\n    // Check index.ts in src\n    const indexFile = srcNode?.children?.find((child) => child.name === \"index.ts\");\n    expect(indexFile).toBeDefined();\n    expect(indexFile?.isDirectory).toBe(false);\n\n    // Check utils directory\n    const utilsDir = srcNode?.children?.find((child) => child.name === \"utils\");\n    expect(utilsDir).toBeDefined();\n    expect(utilsDir?.isDirectory).toBe(true);\n\n    // Check helper.ts in utils\n    const helperFile = utilsDir?.children?.find((child) => child.name === \"helper.ts\");\n    expect(helperFile).toBeDefined();\n    expect(helperFile?.isDirectory).toBe(false);\n  });\n\n  test(\"sorts files within directories\", async () => {\n    // Create files in non-alphabetical order\n    await fs.promises.writeFile(path.join(tempDir, \"b.txt\"), \"b\");\n    await fs.promises.writeFile(path.join(tempDir, \"a.txt\"), \"a\");\n    await fs.promises.writeFile(path.join(tempDir, \"c.txt\"), \"c\");\n\n    const tree = await buildFileTree(tempDir, \"*.txt\");\n    const names = tree.map((node) => node.name);\n\n    expect(names).toEqual([\"a.txt\", \"b.txt\", \"c.txt\"]);\n  });\n\n  test(\"includes lastModified for files\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"content\");\n\n    const tree = await buildFileTree(tempDir, \"*.txt\");\n    const fileNode = tree.find((node) => node.name === \"test.txt\");\n\n    expect(fileNode).toBeDefined();\n    expect(fileNode?.isDirectory).toBe(false);\n    // Type assertion since we verified it's not a directory\n    const file = fileNode as FileNode & { isDirectory: false };\n    expect(file.lastModified).toBeDefined();\n    if (file.lastModified) {\n      expect(new Date(file.lastModified).getTime()).toBeGreaterThan(0);\n    }\n  });\n\n  test(\"marks directories with isDirectory flag\", async () => {\n    await fs.promises.mkdir(path.join(tempDir, \"dir\"), { recursive: true });\n    await fs.promises.writeFile(path.join(tempDir, \"dir\", \"file.txt\"), \"content\");\n\n    const tree = await buildFileTree(tempDir, \"**/*.txt\");\n\n    const dirNode = tree.find((node) => node.name === \"dir\");\n    expect(dirNode?.isDirectory).toBe(true);\n\n    const fileInDir = dirNode?.children?.find((child) => child.name === \"file.txt\");\n    expect(fileInDir?.isDirectory).toBe(false);\n  });\n\n  test(\"handles empty directories\", async () => {\n    const tree = await buildFileTree(tempDir, \"**/*\");\n    expect(tree).toEqual([]);\n  });\n\n  test(\"handles files at root level\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"root.txt\"), \"root\");\n    await fs.promises.mkdir(path.join(tempDir, \"dir\"), { recursive: true });\n    await fs.promises.writeFile(path.join(tempDir, \"dir\", \"nested.txt\"), \"nested\");\n\n    const tree = await buildFileTree(tempDir, \"**/*.txt\");\n\n    const rootFile = tree.find((node) => node.name === \"root.txt\");\n    expect(rootFile).toBeDefined();\n    expect(rootFile?.path).toBe(\"root.txt\");\n    expect(rootFile?.isDirectory).toBe(false);\n\n    const dirNode = tree.find((node) => node.name === \"dir\");\n    expect(dirNode).toBeDefined();\n    expect(dirNode?.isDirectory).toBe(true);\n\n    const nestedFile = dirNode?.children?.find((child) => child.name === \"nested.txt\");\n    expect(nestedFile).toBeDefined();\n    expect(nestedFile?.isDirectory).toBe(false);\n  });\n});\n\n// Mock logger\nclass MockLogger extends Logger {\n  logs: Array<{ message: string; level: string }> = [];\n\n  log(message: string, level: \"info\" | \"error\" | \"debug\" = \"info\"): void {\n    this.logs.push({ message, level });\n  }\n\n  logSocketTraffic(_socketLogFile: string, _direction: \"in\" | \"out\", _data: unknown): void {\n    // Mock implementation\n  }\n}\n\ndescribe(\"copyFiles\", () => {\n  let tempDir: string;\n  let destDir: string;\n  let mockLogger: MockLogger;\n\n  beforeEach(async () => {\n    const timestamp = Date.now();\n    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-copyfiles-src-${timestamp}`);\n    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-copyfiles-dest-${timestamp}`);\n    await fs.promises.mkdir(tempDir, { recursive: true });\n    mockLogger = new MockLogger(\"\");\n  });\n\n  afterEach(() => {\n    rmSync(tempDir, { recursive: true, force: true });\n    rmSync(destDir, { recursive: true, force: true });\n  });\n\n  test(\"copies single file to destination\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"test content\");\n\n    await copyFiles(tempDir, [\"test.txt\"], destDir, mockLogger);\n\n    expect(await fs.promises.readFile(path.join(destDir, \"test.txt\"), \"utf-8\")).toBe(\n      \"test content\",\n    );\n  });\n\n  test(\"copies multiple files\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"file1.txt\"), \"content1\");\n    await fs.promises.writeFile(path.join(tempDir, \"file2.txt\"), \"content2\");\n\n    await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger);\n\n    expect(await fs.promises.readFile(path.join(destDir, \"file1.txt\"), \"utf-8\")).toBe(\"content1\");\n    expect(await fs.promises.readFile(path.join(destDir, \"file2.txt\"), \"utf-8\")).toBe(\"content2\");\n  });\n\n  test(\"preserves directory structure\", async () => {\n    await fs.promises.mkdir(path.join(tempDir, \"nested\", \"deep\"), {\n      recursive: true,\n    });\n    await fs.promises.writeFile(path.join(tempDir, \"nested\", \"file.txt\"), \"nested content\");\n    await fs.promises.writeFile(\n      path.join(tempDir, \"nested\", \"deep\", \"deep-file.txt\"),\n      \"deep content\",\n    );\n\n    await copyFiles(tempDir, [\"**/*.txt\"], destDir, mockLogger);\n\n    expect(await fs.promises.readFile(path.join(destDir, \"nested\", \"file.txt\"), \"utf-8\")).toBe(\n      \"nested content\",\n    );\n    expect(\n      await fs.promises.readFile(path.join(destDir, \"nested\", \"deep\", \"deep-file.txt\"), \"utf-8\"),\n    ).toBe(\"deep content\");\n  });\n\n  test(\"creates destination directory if it doesn't exist\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"test.txt\"), \"content\");\n\n    rmSync(destDir, { recursive: true, force: true });\n    expect(fs.existsSync(destDir)).toBe(false);\n\n    await copyFiles(tempDir, [\"test.txt\"], destDir, mockLogger);\n\n    expect(fs.existsSync(destDir)).toBe(true);\n    expect(await fs.promises.readFile(path.join(destDir, \"test.txt\"), \"utf-8\")).toBe(\"content\");\n  });\n\n  test(\"handles glob patterns correctly\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"file.js\"), \"js content\");\n    await fs.promises.writeFile(path.join(tempDir, \"file.ts\"), \"ts content\");\n    await fs.promises.writeFile(path.join(tempDir, \"readme.md\"), \"md content\");\n\n    await copyFiles(tempDir, [\"*.js\", \"*.ts\"], destDir, mockLogger);\n\n    expect(fs.existsSync(path.join(destDir, \"file.js\"))).toBe(true);\n    expect(fs.existsSync(path.join(destDir, \"file.ts\"))).toBe(true);\n    expect(fs.existsSync(path.join(destDir, \"readme.md\"))).toBe(false);\n  });\n\n  test(\"handles empty file list gracefully\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"ignored.txt\"), \"content\");\n\n    await copyFiles(tempDir, [\"*.nonexistent\"], destDir, mockLogger);\n\n    expect(fs.existsSync(path.join(destDir, \"ignored.txt\"))).toBe(false);\n  });\n\n  test(\"copies directories recursively\", async () => {\n    await fs.promises.mkdir(path.join(tempDir, \"source-dir\", \"subdir\"), {\n      recursive: true,\n    });\n    await fs.promises.writeFile(path.join(tempDir, \"source-dir\", \"file.txt\"), \"dir content\");\n    await fs.promises.writeFile(\n      path.join(tempDir, \"source-dir\", \"subdir\", \"nested.txt\"),\n      \"nested dir content\",\n    );\n\n    await copyFiles(tempDir, [\"source-dir/**\"], destDir, mockLogger);\n\n    expect(await fs.promises.readFile(path.join(destDir, \"source-dir\", \"file.txt\"), \"utf-8\")).toBe(\n      \"dir content\",\n    );\n    expect(\n      await fs.promises.readFile(path.join(destDir, \"source-dir\", \"subdir\", \"nested.txt\"), \"utf-8\"),\n    ).toBe(\"nested dir content\");\n  });\n\n  test(\"ignores .gitignore rules and copies all matching files\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"include.txt\"), \"included\");\n    await fs.promises.writeFile(path.join(tempDir, \"ignore.txt\"), \"ignored\");\n    await fs.promises.writeFile(path.join(tempDir, \".gitignore\"), \"ignore.txt\\n\");\n\n    await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger);\n\n    expect(fs.existsSync(path.join(destDir, \"include.txt\"))).toBe(true);\n    expect(fs.existsSync(path.join(destDir, \"ignore.txt\"))).toBe(true);\n\n    expect(await fs.promises.readFile(path.join(destDir, \"include.txt\"), \"utf-8\")).toBe(\"included\");\n    expect(await fs.promises.readFile(path.join(destDir, \"ignore.txt\"), \"utf-8\")).toBe(\"ignored\");\n  });\n});\n\n// ENG-125: Symlink tests - skip on Windows where symlinks require elevated privileges\nconst isWindows = process.platform === \"win32\";\nconst describeSymlinks = isWindows ? describe.skip : describe;\n\ndescribeSymlinks(\"copyFiles with symlinks (ENG-125)\", () => {\n  let tempDir: string;\n  let destDir: string;\n  let mockLogger: MockLogger;\n\n  beforeEach(async () => {\n    const timestamp = Date.now();\n    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-symlinks-src-${timestamp}`);\n    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-symlinks-dest-${timestamp}`);\n    await fs.promises.mkdir(tempDir, { recursive: true });\n    mockLogger = new MockLogger(\"\");\n  });\n\n  afterEach(() => {\n    rmSync(tempDir, { recursive: true, force: true });\n    rmSync(destDir, { recursive: true, force: true });\n  });\n\n  test(\"should preserve symlinks when copying directory (verbatimSymlinks)\", async () => {\n    // Create a real file\n    const realFile = path.join(tempDir, \"real.txt\");\n    await fs.promises.writeFile(realFile, \"real content\");\n\n    // Create symlink to real file\n    const symlinkFile = path.join(tempDir, \"link.txt\");\n    await fs.promises.symlink(realFile, symlinkFile);\n\n    // Copy using copyFiles\n    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n\n    // Verify symlink is preserved (not dereferenced)\n    const destSymlink = path.join(destDir, \"link.txt\");\n    const stats = await fs.promises.lstat(destSymlink);\n    expect(stats.isSymbolicLink()).toBe(true);\n  });\n\n  // NOTE: Test for nested directory symlinks removed - the copyFiles function uses glob\n  // patterns which interact with symlinks in ways that can cause \"cannot copy to subdirectory\n  // of self\" errors. The verbatimSymlinks fix specifically addresses EINVAL errors for\n  // node_modules/.bin symlinks, not all symlink scenarios.\n\n  test(\"should handle relative symlinks\", async () => {\n    // Create a real file\n    const realFile = path.join(tempDir, \"real.txt\");\n    await fs.promises.writeFile(realFile, \"real content\");\n\n    // Create relative symlink\n    const symlinkFile = path.join(tempDir, \"relative-link.txt\");\n    await fs.promises.symlink(\"./real.txt\", symlinkFile);\n\n    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n\n    const destSymlink = path.join(destDir, \"relative-link.txt\");\n    const stats = await fs.promises.lstat(destSymlink);\n    expect(stats.isSymbolicLink()).toBe(true);\n\n    // Verify the symlink target is preserved\n    const target = await fs.promises.readlink(destSymlink);\n    expect(target).toBe(\"./real.txt\");\n  });\n\n  test(\"should copy symlink alongside regular files\", async () => {\n    // Create regular file\n    await fs.promises.writeFile(path.join(tempDir, \"regular.txt\"), \"regular content\");\n\n    // Create another file and symlink to it\n    const targetFile = path.join(tempDir, \"target.txt\");\n    await fs.promises.writeFile(targetFile, \"target content\");\n    await fs.promises.symlink(targetFile, path.join(tempDir, \"link.txt\"));\n\n    await copyFiles(tempDir, [\"**/*\"], destDir, mockLogger);\n\n    // Regular file should be copied\n    expect(await fs.promises.readFile(path.join(destDir, \"regular.txt\"), \"utf-8\")).toBe(\n      \"regular content\",\n    );\n\n    // Symlink should be preserved\n    const linkStats = await fs.promises.lstat(path.join(destDir, \"link.txt\"));\n    expect(linkStats.isSymbolicLink()).toBe(true);\n\n    // Target should also be copied\n    expect(await fs.promises.readFile(path.join(destDir, \"target.txt\"), \"utf-8\")).toBe(\n      \"target content\",\n    );\n  });\n});\n\ndescribe(\"copyFiles with overwrite option\", () => {\n  let tempDir: string;\n  let destDir: string;\n  let mockLogger: MockLogger;\n\n  beforeEach(async () => {\n    const timestamp = Date.now();\n    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-overwrite-src-${timestamp}`);\n    destDir = path.resolve(\"tests\", \"test-area\", `temp-test-overwrite-dest-${timestamp}`);\n    await fs.promises.mkdir(tempDir, { recursive: true });\n    await fs.promises.mkdir(destDir, { recursive: true });\n    mockLogger = new MockLogger(\"/dev/null\");\n  });\n\n  afterEach(async () => {\n    rmSync(tempDir, { recursive: true, force: true });\n    rmSync(destDir, { recursive: true, force: true });\n  });\n\n  test(\"default behavior renames on conflict\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n\n    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger);\n\n    expect(conflicts.length).toBe(1);\n    // Original file should be untouched\n    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n      \"old content\",\n    );\n    // New file should be renamed\n    const renamedFile = conflicts[0].resolved;\n    expect(await fs.promises.readFile(renamedFile, \"utf-8\")).toBe(\"new content\");\n  });\n\n  test(\"overwrite: true replaces existing file\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n\n    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger, {\n      overwrite: true,\n    });\n\n    expect(conflicts.length).toBe(0);\n    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n      \"new content\",\n    );\n  });\n\n  test(\"overwrite: true works when destination does not exist\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"new-file.txt\"), \"fresh content\");\n\n    const { conflicts } = await copyFiles(tempDir, [\"new-file.txt\"], destDir, mockLogger, {\n      overwrite: true,\n    });\n\n    expect(conflicts.length).toBe(0);\n    expect(await fs.promises.readFile(path.join(destDir, \"new-file.txt\"), \"utf-8\")).toBe(\n      \"fresh content\",\n    );\n  });\n\n  test(\"overwrite: true replaces multiple files\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"a.txt\"), \"new-a\");\n    await fs.promises.writeFile(path.join(tempDir, \"b.txt\"), \"new-b\");\n    await fs.promises.writeFile(path.join(destDir, \"a.txt\"), \"old-a\");\n    await fs.promises.writeFile(path.join(destDir, \"b.txt\"), \"old-b\");\n\n    const { conflicts } = await copyFiles(tempDir, [\"*.txt\"], destDir, mockLogger, {\n      overwrite: true,\n    });\n\n    expect(conflicts.length).toBe(0);\n    expect(await fs.promises.readFile(path.join(destDir, \"a.txt\"), \"utf-8\")).toBe(\"new-a\");\n    expect(await fs.promises.readFile(path.join(destDir, \"b.txt\"), \"utf-8\")).toBe(\"new-b\");\n  });\n\n  test(\"overwrite: false behaves like default (rename)\", async () => {\n    await fs.promises.writeFile(path.join(tempDir, \"report.txt\"), \"new content\");\n    await fs.promises.writeFile(path.join(destDir, \"report.txt\"), \"old content\");\n\n    const { conflicts } = await copyFiles(tempDir, [\"report.txt\"], destDir, mockLogger, {\n      overwrite: false,\n    });\n\n    expect(conflicts.length).toBe(1);\n    expect(await fs.promises.readFile(path.join(destDir, \"report.txt\"), \"utf-8\")).toBe(\n      \"old content\",\n    );\n  });\n});\n\ndescribe(\"serve\", () => {\n  test(\"creates HTTP server that responds to requests\", async () => {\n    const testPort = await getFreePort();\n\n    const server = serve({\n      port: testPort,\n      fetch: async (request: Request) => {\n        if (request.url.includes(\"/test\")) {\n          return new Response(\"Test OK\", { status: 200 });\n        }\n        return new Response(\"Not Found\", { status: 404 });\n      },\n    });\n\n    // Give server time to start\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      // Make request to server\n      const response = await fetch(`http://localhost:${testPort}/test`);\n      expect(response.status).toBe(200);\n      expect(await response.text()).toBe(\"Test OK\");\n\n      // Test 404 response\n      const notFoundResponse = await fetch(`http://localhost:${testPort}/other`);\n      expect(notFoundResponse.status).toBe(404);\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"creates HTTP server with idle timeout\", async () => {\n    const testPort = await getFreePort();\n\n    const server = serve({\n      port: testPort,\n      idleTimeout: 5,\n      fetch: async () => {\n        return new Response(\"OK\", { status: 200 });\n      },\n    });\n\n    // Give server time to start\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      const response = await fetch(`http://localhost:${testPort}/`);\n      expect(response.status).toBe(200);\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"server.stop() shuts down the server\", async () => {\n    const testPort = await getFreePort();\n\n    const server = serve({\n      port: testPort,\n      fetch: async () => new Response(\"OK\"),\n    });\n\n    // Give server time to start\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    // Verify server is running\n    const response = await fetch(`http://localhost:${testPort}/`);\n    expect(response.status).toBe(200);\n\n    // Stop the server\n    server.stop();\n\n    // Give server time to stop\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    // Verify server is no longer accepting connections\n    try {\n      await fetch(`http://localhost:${testPort}/`);\n      expect(true).toBe(false); // Should not reach here\n    } catch (error) {\n      // Expected error when connecting to stopped server\n      expect(error).toBeDefined();\n    }\n  });\n\n  test(\"creates WebSocket server\", async () => {\n    const testPort = await getFreePort();\n    const connections: Set<unknown> = new Set();\n\n    const server = serve({\n      port: testPort,\n      websocket: {\n        open: (ws) => {\n          connections.add(ws);\n        },\n        message: (ws, message) => {\n          // Echo the message back\n          if (typeof message === \"string\") {\n            ws.send(`echo: ${message}`);\n          }\n        },\n        close: (ws) => {\n          connections.delete(ws);\n        },\n      },\n    });\n\n    // Give server time to start\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      // Create WebSocket client\n      const ws = new WebSocket(`ws://localhost:${testPort}`);\n\n      // Wait for connection\n      await new Promise<void>((resolve, reject) => {\n        ws.onopen = () => resolve();\n        ws.onerror = (error) => reject(error);\n        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n      });\n\n      expect(connections.size).toBe(1);\n\n      // Send message and receive echo\n      const echoPromise = new Promise<string>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(event.data);\n        };\n      });\n\n      ws.send(\"hello\");\n      const echo = await echoPromise;\n      expect(echo).toBe(\"echo: hello\");\n\n      // Close connection\n      ws.close();\n\n      // Wait for close to be processed\n      await new Promise((resolve) => setTimeout(resolve, 100));\n\n      expect(connections.size).toBe(0);\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"handles multiple HTTP requests concurrently\", async () => {\n    const testPort = await getFreePort();\n    let requestCount = 0;\n\n    const server = serve({\n      port: testPort,\n      fetch: async () => {\n        requestCount++;\n        // Simulate some async work\n        await new Promise((resolve) => setTimeout(resolve, 10));\n        return new Response(`Request ${requestCount}`, { status: 200 });\n      },\n    });\n\n    // Give server time to start\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      // Make multiple concurrent requests\n      const requests = Array.from({ length: 5 }, (_, i) =>\n        fetch(`http://localhost:${testPort}/test${i}`),\n      );\n\n      const responses = await Promise.all(requests);\n\n      expect(responses.length).toBe(5);\n      responses.forEach((response) => {\n        expect(response.status).toBe(200);\n      });\n\n      expect(requestCount).toBe(5);\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"WebSocket upgrade hook initializes connection data\", async () => {\n    const testPort = await getFreePort();\n    interface TestData {\n      id: string;\n      authenticated: boolean;\n    }\n    let capturedData: TestData | null = null;\n\n    const server = serve<TestData>({\n      port: testPort,\n      websocket: {\n        upgrade: (_req) => ({\n          id: \"test-123\",\n          authenticated: false,\n        }),\n        open: (ws) => {\n          capturedData = ws.data;\n        },\n      },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      const ws = new WebSocket(`ws://localhost:${testPort}`);\n\n      await new Promise<void>((resolve, reject) => {\n        ws.onopen = () => resolve();\n        ws.onerror = (error) => reject(error);\n        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n      });\n\n      // Give open handler time to execute\n      await new Promise((resolve) => setTimeout(resolve, 100));\n\n      expect(capturedData).not.toBeNull();\n      // biome-ignore lint/style/noNonNullAssertion: checked not null above\n      expect(capturedData!.id).toBe(\"test-123\");\n      // biome-ignore lint/style/noNonNullAssertion: checked not null above\n      expect(capturedData!.authenticated).toBe(false);\n\n      ws.close();\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"WebSocket data can be updated and read back\", async () => {\n    const testPort = await getFreePort();\n    interface TestData {\n      id: string;\n      count: number;\n      active: boolean;\n    }\n\n    const server = serve<TestData>({\n      port: testPort,\n      websocket: {\n        upgrade: (_req) => ({\n          id: \"conn-1\",\n          count: 0,\n          active: false,\n        }),\n        message: (ws, message) => {\n          if (message === \"activate\") {\n            // Update data by replacing entire object\n            ws.data = {\n              ...ws.data,\n              active: true,\n              count: ws.data.count + 1,\n            };\n            ws.send(JSON.stringify(ws.data));\n          } else if (message === \"increment\") {\n            // Update data again\n            ws.data = {\n              ...ws.data,\n              count: ws.data.count + 1,\n            };\n            ws.send(JSON.stringify(ws.data));\n          }\n        },\n      },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      const ws = new WebSocket(`ws://localhost:${testPort}`);\n\n      await new Promise<void>((resolve, reject) => {\n        ws.onopen = () => resolve();\n        ws.onerror = (error) => reject(error);\n        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n      });\n\n      // Test activate\n      const activateResponse = new Promise<TestData>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(JSON.parse(event.data));\n        };\n      });\n      ws.send(\"activate\");\n      const activateData = await activateResponse;\n      expect(activateData.active).toBe(true);\n      expect(activateData.count).toBe(1);\n      expect(activateData.id).toBe(\"conn-1\");\n\n      // Test increment\n      const incrementResponse = new Promise<TestData>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(JSON.parse(event.data));\n        };\n      });\n      ws.send(\"increment\");\n      const incrementData = await incrementResponse;\n      expect(incrementData.active).toBe(true);\n      expect(incrementData.count).toBe(2);\n      expect(incrementData.id).toBe(\"conn-1\");\n\n      ws.close();\n    } finally {\n      server.stop();\n    }\n  });\n\n  test(\"WebSocket data updates persist across handler calls\", async () => {\n    const testPort = await getFreePort();\n    interface ClientData {\n      id: string;\n      handshakeComplete: boolean;\n      messageCount: number;\n    }\n\n    const server = serve<ClientData>({\n      port: testPort,\n      websocket: {\n        upgrade: (_req) => ({\n          id: \"client-xyz\",\n          handshakeComplete: false,\n          messageCount: 0,\n        }),\n        message: (ws, message) => {\n          if (message === \"handshake\") {\n            // Simulate handshake - update data\n            ws.data = {\n              ...ws.data,\n              handshakeComplete: true,\n            };\n            ws.send(\"handshake_ok\");\n          } else if (message === \"ping\") {\n            // Only respond if handshake is complete\n            if (ws.data.handshakeComplete) {\n              ws.data = {\n                ...ws.data,\n                messageCount: ws.data.messageCount + 1,\n              };\n              ws.send(`pong:${ws.data.messageCount}`);\n            } else {\n              ws.send(\"error:not_authenticated\");\n            }\n          }\n        },\n      },\n    });\n\n    await new Promise((resolve) => setTimeout(resolve, 100));\n\n    try {\n      const ws = new WebSocket(`ws://localhost:${testPort}`);\n\n      await new Promise<void>((resolve, reject) => {\n        ws.onopen = () => resolve();\n        ws.onerror = (error) => reject(error);\n        setTimeout(() => reject(new Error(\"Connection timeout\")), 5000);\n      });\n\n      // Test ping before handshake - should fail\n      const pingBeforeHandshake = new Promise<string>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(event.data);\n        };\n      });\n      ws.send(\"ping\");\n      const errorResponse = await pingBeforeHandshake;\n      expect(errorResponse).toBe(\"error:not_authenticated\");\n\n      // Perform handshake\n      const handshakeResponse = new Promise<string>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(event.data);\n        };\n      });\n      ws.send(\"handshake\");\n      const handshakeResult = await handshakeResponse;\n      expect(handshakeResult).toBe(\"handshake_ok\");\n\n      // Test ping after handshake - should succeed\n      const ping1Response = new Promise<string>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(event.data);\n        };\n      });\n      ws.send(\"ping\");\n      const pong1 = await ping1Response;\n      expect(pong1).toBe(\"pong:1\");\n\n      // Test another ping - count should increment\n      const ping2Response = new Promise<string>((resolve) => {\n        ws.onmessage = (event) => {\n          resolve(event.data);\n        };\n      });\n      ws.send(\"ping\");\n      const pong2 = await ping2Response;\n      expect(pong2).toBe(\"pong:2\");\n\n      ws.close();\n    } finally {\n      server.stop();\n    }\n  });\n});\n\ndescribe(\"renameWithRetry\", () => {\n  let tempDir: string;\n\n  beforeEach(async () => {\n    const timestamp = Date.now();\n    tempDir = path.resolve(\"tests\", \"test-area\", `temp-test-rename-${timestamp}`);\n    await fs.promises.mkdir(tempDir, { recursive: true });\n  });\n\n  afterEach(() => {\n    rmSync(tempDir, { recursive: true, force: true });\n  });\n\n  test(\"successfully renames file on first attempt\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    await fs.promises.writeFile(sourcePath, \"test content\");\n\n    await renameWithRetry(sourcePath, targetPath);\n\n    expect(fs.existsSync(targetPath)).toBe(true);\n    expect(fs.existsSync(sourcePath)).toBe(false);\n    expect(await fs.promises.readFile(targetPath, \"utf-8\")).toBe(\"test content\");\n  });\n\n  test(\"overwrites existing target file\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    await fs.promises.writeFile(sourcePath, \"new content\");\n    await fs.promises.writeFile(targetPath, \"old content\");\n\n    await renameWithRetry(sourcePath, targetPath);\n\n    expect(fs.existsSync(targetPath)).toBe(true);\n    expect(fs.existsSync(sourcePath)).toBe(false);\n    expect(await fs.promises.readFile(targetPath, \"utf-8\")).toBe(\"new content\");\n  });\n\n  test(\"retries on EPERM error and eventually succeeds\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n    const mockLogger = new MockLogger(\"\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    // Mock fs.promises.rename to fail twice with EPERM, then succeed\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async (src: string, dest: string) => {\n      attemptCount++;\n      if (attemptCount <= 2) {\n        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n        error.code = \"EPERM\";\n        throw error;\n      }\n      return originalRename.call(fs.promises, src, dest);\n    };\n\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 5,\n        initialDelay: 1, // Use minimal delay for tests\n        logger: mockLogger,\n      });\n\n      expect(fs.existsSync(targetPath)).toBe(true);\n      expect(fs.existsSync(sourcePath)).toBe(false);\n      expect(attemptCount).toBe(3); // Failed twice, succeeded on third attempt\n\n      // Check that retry was logged\n      const retryLogs = mockLogger.logs.filter((log) => log.message.includes(\"File locked\"));\n      expect(retryLogs.length).toBeGreaterThan(0);\n    } finally {\n      // Restore original rename\n      fs.promises.rename = originalRename;\n    }\n  });\n\n  test(\"retries on EBUSY error\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async (src: string, dest: string) => {\n      attemptCount++;\n      if (attemptCount === 1) {\n        const error: NodeJS.ErrnoException = new Error(\"EBUSY: resource busy or locked\");\n        error.code = \"EBUSY\";\n        throw error;\n      }\n      return originalRename.call(fs.promises, src, dest);\n    };\n\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 3,\n        initialDelay: 1,\n      });\n\n      expect(fs.existsSync(targetPath)).toBe(true);\n      expect(attemptCount).toBe(2);\n    } finally {\n      fs.promises.rename = originalRename;\n    }\n  });\n\n  test(\"retries on EACCES error\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async (src: string, dest: string) => {\n      attemptCount++;\n      if (attemptCount === 1) {\n        const error: NodeJS.ErrnoException = new Error(\"EACCES: permission denied\");\n        error.code = \"EACCES\";\n        throw error;\n      }\n      return originalRename.call(fs.promises, src, dest);\n    };\n\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 3,\n        initialDelay: 1,\n      });\n\n      expect(fs.existsSync(targetPath)).toBe(true);\n      expect(attemptCount).toBe(2);\n    } finally {\n      fs.promises.rename = originalRename;\n    }\n  });\n\n  test(\"does not retry on non-retryable errors\", async () => {\n    const sourcePath = path.join(tempDir, \"nonexistent.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    // ENOENT (file not found) should not trigger retry\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 5,\n        initialDelay: 1,\n      });\n      expect(true).toBe(false); // Should not reach here\n    } catch (error) {\n      const err = error as NodeJS.ErrnoException;\n      expect(err.code).toBe(\"ENOENT\");\n    }\n  });\n\n  test(\"throws error after max retries exceeded\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n    const mockLogger = new MockLogger(\"\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async () => {\n      attemptCount++;\n      const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n      error.code = \"EPERM\";\n      throw error;\n    };\n\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 3,\n        initialDelay: 1,\n        logger: mockLogger,\n      });\n      expect(true).toBe(false); // Should not reach here\n    } catch (error) {\n      const err = error as NodeJS.ErrnoException;\n      expect(err.code).toBe(\"EPERM\");\n      expect(attemptCount).toBe(3); // Should try exactly maxRetries times\n\n      // Verify retry attempts were logged\n      const retryLogs = mockLogger.logs.filter((log) => log.message.includes(\"File locked\"));\n      expect(retryLogs.length).toBe(2); // maxRetries - 1 (no log on final attempt)\n    } finally {\n      fs.promises.rename = originalRename;\n    }\n  });\n\n  test(\"uses exponential backoff for retries\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n    const mockLogger = new MockLogger(\"\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    const delays: number[] = [];\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async (src: string, dest: string) => {\n      attemptCount++;\n      if (attemptCount <= 3) {\n        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n        error.code = \"EPERM\";\n        throw error;\n      }\n      return originalRename.call(fs.promises, src, dest);\n    };\n\n    // Capture delays from log messages\n    const originalLog = mockLogger.log.bind(mockLogger);\n    mockLogger.log = (message: string, level = \"info\" as \"info\" | \"error\" | \"debug\") => {\n      originalLog(message, level);\n      const match = message.match(/retrying rename in (\\d+)ms/);\n      if (match) {\n        delays.push(Number.parseInt(match[1]));\n      }\n    };\n\n    try {\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 5,\n        initialDelay: 10,\n        logger: mockLogger,\n      });\n\n      // Verify exponential backoff: 10ms, 20ms, 40ms\n      expect(delays).toEqual([10, 20, 40]);\n    } finally {\n      fs.promises.rename = originalRename;\n    }\n  });\n\n  test(\"works without logger\", async () => {\n    const sourcePath = path.join(tempDir, \"source.txt\");\n    const targetPath = path.join(tempDir, \"target.txt\");\n\n    await fs.promises.writeFile(sourcePath, \"content\");\n\n    let attemptCount = 0;\n    const originalRename = fs.promises.rename;\n    // biome-ignore lint/suspicious/noExplicitAny: mocking for test\n    (fs.promises as any).rename = async (src: string, dest: string) => {\n      attemptCount++;\n      if (attemptCount === 1) {\n        const error: NodeJS.ErrnoException = new Error(\"EPERM: operation not permitted\");\n        error.code = \"EPERM\";\n        throw error;\n      }\n      return originalRename.call(fs.promises, src, dest);\n    };\n\n    try {\n      // Should not throw even without logger\n      await renameWithRetry(sourcePath, targetPath, {\n        maxRetries: 3,\n        initialDelay: 1,\n      });\n\n      expect(fs.existsSync(targetPath)).toBe(true);\n      expect(attemptCount).toBe(2);\n    } finally {\n      fs.promises.rename = originalRename;\n    }\n  });\n});\n\ndescribe(\"AppMetadata\", () => {\n  test(\"creates metadata from valid object\", () => {\n    const metadata = AppMetadata.create({\n      version: \"1.0.0\",\n      buildDate: \"2024-01-01T00:00:00.000Z\",\n      buildTarget: \"darwin-arm64\",\n    });\n\n    expect(metadata.version).toBe(\"1.0.0\");\n    expect(metadata.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n    expect(metadata.buildTarget).toBe(\"darwin-arm64\");\n  });\n\n  test(\"creates metadata with minimal fields\", () => {\n    const metadata = AppMetadata.create({\n      version: \"2.0.0\",\n    });\n\n    expect(metadata.version).toBe(\"2.0.0\");\n    expect(metadata.buildDate).toBeUndefined();\n    expect(metadata.buildTarget).toBeUndefined();\n  });\n\n  test(\"rejects empty version\", () => {\n    expect(() => {\n      AppMetadata.create({\n        version: \"\",\n      });\n    }).toThrow();\n  });\n\n  test(\"rejects missing version\", () => {\n    expect(() => {\n      AppMetadata.create({\n        buildDate: \"2024-01-01T00:00:00.000Z\",\n      });\n    }).toThrow();\n  });\n\n  test(\"serializes to JSON\", () => {\n    const metadata = AppMetadata.create({\n      version: \"1.2.3\",\n      buildDate: \"2024-01-01T00:00:00.000Z\",\n    });\n\n    const json = metadata.serialize();\n    const parsed = JSON.parse(json);\n\n    expect(parsed.version).toBe(\"1.2.3\");\n    expect(parsed.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n  });\n\n  test(\"deserializes from JSON string\", () => {\n    const json = JSON.stringify({\n      version: \"3.0.0\",\n      buildDate: \"2024-06-01T00:00:00.000Z\",\n      buildTarget: \"linux-x64\",\n    });\n\n    const metadata = AppMetadata.deserialize(json);\n\n    expect(metadata.version).toBe(\"3.0.0\");\n    expect(metadata.buildDate).toBe(\"2024-06-01T00:00:00.000Z\");\n    expect(metadata.buildTarget).toBe(\"linux-x64\");\n  });\n\n  test(\"toObject returns metadata object\", () => {\n    const metadata = AppMetadata.create({\n      version: \"1.0.0\",\n      buildDate: \"2024-01-01T00:00:00.000Z\",\n    });\n\n    const obj = metadata.toObject();\n\n    expect(obj.version).toBe(\"1.0.0\");\n    expect(obj.buildDate).toBe(\"2024-01-01T00:00:00.000Z\");\n    expect(obj.buildTarget).toBeUndefined();\n  });\n\n  test(\"deserialize handles invalid JSON\", () => {\n    expect(() => {\n      AppMetadata.deserialize(\"not valid json\");\n    }).toThrow();\n  });\n\n  test(\"create validates schema\", () => {\n    // Valid extra fields should be ignored (schema is not strict)\n    const metadata = AppMetadata.create({\n      version: \"1.0.0\",\n      extraField: \"should be ignored\",\n    });\n\n    expect(metadata.version).toBe(\"1.0.0\");\n  });\n});\n\ndescribe(\"getMetadata\", () => {\n  test(\"returns metadata with version\", () => {\n    const metadata = getMetadata();\n\n    expect(metadata).toBeDefined();\n    expect(metadata.version).toBeDefined();\n    expect(typeof metadata.version).toBe(\"string\");\n    expect(metadata.version.length).toBeGreaterThan(0);\n  });\n\n  test(\"returns consistent metadata on multiple calls\", () => {\n    const metadata1 = getMetadata();\n    const metadata2 = getMetadata();\n\n    expect(metadata1.version).toBe(metadata2.version);\n    expect(metadata1.buildDate).toBe(metadata2.buildDate);\n    expect(metadata1.buildTarget).toBe(metadata2.buildTarget);\n  });\n\n  test(\"version follows semver-like format\", () => {\n    const metadata = getMetadata();\n    const version = metadata.version;\n\n    // Should be either semver format (x.y.z) or fallback \"1.0.0\"\n    expect(version).toMatch(/^\\d+\\.\\d+\\.\\d+/);\n  });\n});\n\n// Helper: create an async iterable from an array with optional delays\nasync function* asyncFromArray<T>(items: T[], delayMs = 0): AsyncGenerator<T> {\n  for (const item of items) {\n    if (delayMs > 0) await new Promise((r) => setTimeout(r, delayMs));\n    yield item;\n  }\n}\n\n// Helper: create an async iterable that hangs forever after yielding initial items\nasync function* asyncHangAfter<T>(items: T[]): AsyncGenerator<T> {\n  for (const item of items) {\n    yield item;\n  }\n  // Hang forever\n  await new Promise<T>(() => {});\n}\n\ndescribe(\"withIdleTimeout\", () => {\n  test(\"yields all items from a fast source\", async () => {\n    const source = asyncFromArray([1, 2, 3]);\n    const results: number[] = [];\n\n    for await (const item of withIdleTimeout(source, 1000)) {\n      results.push(item);\n    }\n\n    expect(results).toEqual([1, 2, 3]);\n  });\n\n  test(\"yields items when each arrives before timeout\", async () => {\n    const source = asyncFromArray([\"a\", \"b\", \"c\"], 10);\n    const results: string[] = [];\n\n    for await (const item of withIdleTimeout(source, 200)) {\n      results.push(item);\n    }\n\n    expect(results).toEqual([\"a\", \"b\", \"c\"]);\n  });\n\n  test(\"throws IdleTimeoutError when source hangs\", async () => {\n    const source = asyncHangAfter<number>([]);\n\n    try {\n      for await (const _item of withIdleTimeout(source, 50)) {\n        // Should not yield anything\n        expect(true).toBe(false);\n      }\n      expect(true).toBe(false); // Should not complete normally\n    } catch (error) {\n      expect(error).toBeInstanceOf(IdleTimeoutError);\n      expect((error as IdleTimeoutError).timeoutMs).toBe(50);\n    }\n  });\n\n  test(\"throws IdleTimeoutError when source hangs after yielding items\", async () => {\n    const source = asyncHangAfter([1, 2]);\n    const results: number[] = [];\n\n    try {\n      for await (const item of withIdleTimeout(source, 50)) {\n        results.push(item);\n      }\n      expect(true).toBe(false); // Should not complete normally\n    } catch (error) {\n      expect(error).toBeInstanceOf(IdleTimeoutError);\n    }\n\n    // Should have received the items before hanging\n    expect(results).toEqual([1, 2]);\n  });\n\n  test(\"timer resets on each event\", async () => {\n    // Each item arrives at 30ms intervals, timeout is 50ms\n    // Without timer reset this would timeout; with reset it completes fine\n    const source = asyncFromArray([1, 2, 3, 4, 5], 30);\n    const results: number[] = [];\n\n    for await (const item of withIdleTimeout(source, 50)) {\n      results.push(item);\n    }\n\n    expect(results).toEqual([1, 2, 3, 4, 5]);\n  });\n\n  test(\"handles empty async iterable\", async () => {\n    const source = asyncFromArray<number>([]);\n    const results: number[] = [];\n\n    for await (const item of withIdleTimeout(source, 1000)) {\n      results.push(item);\n    }\n\n    expect(results).toEqual([]);\n  });\n\n  test(\"calls return on iterator when timeout fires\", async () => {\n    let returnCalled = false;\n    const source: AsyncIterable<number> = {\n      [Symbol.asyncIterator]() {\n        return {\n          next: () => new Promise<IteratorResult<number>>(() => {}), // hang forever\n          return: () => {\n            returnCalled = true;\n            return Promise.resolve({ done: true as const, value: undefined });\n          },\n        };\n      },\n    };\n\n    try {\n      for await (const _item of withIdleTimeout(source, 50)) {\n        // never reached\n      }\n    } catch {\n      // expected\n    }\n\n    // Give the fire-and-forget return() a tick to execute\n    await new Promise((r) => setTimeout(r, 10));\n    expect(returnCalled).toBe(true);\n  });\n});\n","numLines":1448,"startLine":1,"totalLines":1448}},"timestamp":"2026-03-05T12:40:29.767Z"}
