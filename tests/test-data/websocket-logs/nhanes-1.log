{\n      console.log(`  ${cat}: ${files.length} files`);\n    }\n    console.log('');\n  }\n\n  // Find common laboratory tests across all cycles\n  console.log('\\n--- LABORATORY FILE ANALYSIS ---');\n  const allLabFiles = new Set<string>();\n  const labFilesByCycle: { [cycle: string]: string[] } = {};\n\n  for (const cycle of analysisData) {\n    const labFiles = cycle.categories['Laboratory'] || [];\n    labFilesByCycle[cycle.cycle] = labFiles;\n    labFiles.forEach(file => allLabFiles.add(file.replace(/_[A-Z]+\\.csv$/, '')));\n  }\n\n  console.log(`Total unique lab test types found: ${allLabFiles.size}`);\n  \n  // Find tests that appear in all cycles\n  const testCounts: { [test: string]: number } = {};\n  for (const testName of allLabFiles) {\n    testCounts[testName] = 0;\n    for (const cycle of analysisData) {\n      const labFiles = cycle.categories['Laboratory'] || [];\n      if (labFiles.some(file => file.startsWith(testName))) {\n        testCounts[testName]++;\n      }\n    }\n  }\n  \n  const consistentTests = Object.entries(testCounts)\n    .filter(([test, count]) => count === cycles.length)\n    .map(([test]) => test);\n    \n  console.log(`Tests available in ALL cycles (${consistentTests.length}): ${consistentTests.join(', ')}`);\n  \n  const inconsistentTests = Object.entries(testCounts)\n    .filter(([test, count]) => count < cycles.length && count > 1)\n    .sort((a, b) => b[1] - a[1]);\n    \n  console.log('\\nTests with inconsistent availability:');\n  for (const [test, count] of inconsistentTests.slice(0, 10)) {\n    console.log(`  ${test}: ${count}/${cycles.length} cycles`);\n  }\n}\n\ntry {\n  analyzeCycles();\n} catch (error) {\n  console.error('Error:', error);\n}"}}},"metadata":{"size":3657}}
