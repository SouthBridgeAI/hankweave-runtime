{"loggedAt":"2025-08-13T11:27:28.757Z","direction":"out","message":{"id":"1755084448757-ktfpbcqzr","timestamp":"2025-08-13T11:27:28.757Z","type":"file.updated","data":{"path":"typescript_code/src/quick-and-dirty/check_missing_values.ts","filename":"check_missing_values.ts","content":"#!/usr/bin/env bun\n\nimport { readFileSync } from 'fs';\nimport * as Papa from 'papaparse';\n\nconst dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/tadpole/tests/nhanes/executions/execution-8-new-websocket-log/read_only_data_source';\n\n// Sample files to check for missing value patterns\nconst sampleFiles = [\n  '2021-2023_PrePandemic/Demographics/P_DEMO.csv',\n  '2021-2023_PrePandemic/Laboratory/P_CBC.csv', \n  '2021-2023_PrePandemic/Questionnaire/P_BPQ.csv',\n  '2017-2018/Demographics/DEMO_J.csv',\n  '1999-2000/Demographics/DEMO.csv'\n];\n\nfunction analyzeMissingValues() {\n  console.log('=== MISSING VALUE PATTERNS ANALYSIS ===\\n');\n\n  for (const filePath of sampleFiles) {\n    const fullPath = `${dataDir}/${filePath}`;\n    console.log(`Analyzing: ${filePath}`);\n    \n    try {\n      const fileContent = readFileSync(fullPath, 'utf8');\n      const lines = fileContent.split('\\n').slice(0, 1000); // Sample first 1000 lines\n      const sampleContent = lines.join('\\n');\n      \n      const parsed = Papa.parse(sampleContent, {\n        header: true,\n        skipEmptyLines: true\n      });\n\n      if (parsed.errors.length > 0) {\n        console.log(`  Parse errors: ${parsed.errors.length}`);\n      }\n\n      const data = parsed.data as any[];\n      const totalRows = data.length;\n      \n      if (totalRows === 0) {\n        console.log('  No data rows found\\n');\n        continue;\n      }\n\n      // Analyze missing value patterns\n      const missingPatterns = new Set<string>();\n      const columnMissing: { [col: string]: number } = {};\n      \n      // Get all column names\n      const columns = Object.keys(data[0] || {});\n      columns.forEach(col => columnMissing[col] = 0);\n\n      for (const row of data) {\n        for (const [col, value] of Object.entries(row)) {\n          if (value === null || value === undefined || value === '' || \n              String(value).trim() === '' || String(value) === 'NA' ||\n              String(value) === 'NULL' || String(value) === '.' ||\n              String(value) === 'NaN' || String(value) === '#N/A') {\n            missingPatterns.add(String(value));\n            columnMissing[col]++;\n          }\n        }\n      }\n\n      console.log(`  Sample size: ${totalRows} rows, ${columns.length} columns`);\n      console.log(`  Missing value patterns found: [${Array.from(missingPatterns).map(p => `\"${p}\"`).join(', ')}]`);\n      \n      // Find columns with high missing rates\n      const highMissing = Object.entries(columnMissing)\n        .filter(([col, count]) => count > totalRows * 0.1)\n        .sort((a, b) => b[1] - a[1]);\n        \n      if (highMissing.length > 0) {\n        console.log('  Columns with >10% missing:');\n        for (const [col, count] of highMissing.slice(0, 10)) {\n          const percent = ((count / totalRows) * 100).toFixed(1);\n          console.log(`    ${col}: ${percent}% (${count}/${totalRows})`);\n        }\n      }\n\n      // Check for unusual values that might be coded missing\n      const suspiciousValues = new Set<string>();\n      for (const row of data.slice(0, 100)) { // Check first 100 rows\n        for (const value of Object.values(row)) {\n          const str = String(value);\n          if (str.match(/^(999|9999|77|99|7777|9999999|\\.|\\-1)$/)) {\n            suspiciousValues.add(str);\n          }\n        }\n      }\n      \n      if (suspiciousValues.size > 0) {\n        console.log(`  Suspicious coded values: [${Array.from(suspiciousValues).join(', ')}]`);\n      }\n\n    } catch (error) {\n      console.log(`  Error reading file: ${error}`);\n    }\n    \n    console.log('');\n  }\n}\n\ntry {\n  analyzeMissingValues();\n} catch (error) {\n  console.error('Script error:', error);\n}","action":"created"}},"metadata":{"size":4021}}
