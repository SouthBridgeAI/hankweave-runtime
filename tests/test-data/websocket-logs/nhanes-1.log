{"loggedAt":"2025-08-13T11:26:53.710Z","direction":"out","message":{"id":"1755084413710-dotmb2dcu","timestamp":"2025-08-13T11:26:53.710Z","type":"file.updated","data":{"path":"typescript_code/src/quick-and-dirty/analyze_cycle_consistency.ts","filename":"analyze_cycle_consistency.ts","content":"#!/usr/bin/env bun\n\nimport { readdirSync } from 'fs';\nimport { join } from 'path';\n\nconst dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/tadpole/tests/nhanes/executions/execution-8-new-websocket-log/read_only_data_source';\n\ninterface CycleData {\n  cycle: string;\n  categories: {\n    [category: string]: string[];\n  };\n}\n\nfunction analyzeCycles() {\n  const cycles = readdirSync(dataDir).filter(name => name.match(/^\\d{4}-\\d{4}/));\n  const analysisData: CycleData[] = [];\n\n  console.log(`Found ${cycles.length} survey cycles:`);\n  \n  for (const cycle of cycles.sort()) {\n    const cycleDir = join(dataDir, cycle);\n    const categories = readdirSync(cycleDir).filter(name => !name.startsWith('.'));\n    \n    const cycleData: CycleData = {\n      cycle,\n      categories: {}\n    };\n\n    for (const category of categories) {\n      const categoryDir = join(cycleDir, category);\n      try {\n        const files = readdirSync(categoryDir).filter(name => name.endsWith('.csv'));\n        cycleData.categories[category] = files;\n      } catch (e) {\n        cycleData.categories[category] = [];\n      }\n    }\n    \n    analysisData.push(cycleData);\n    \n    // Summary for each cycle\n    const totalFiles = Object.values(cycleData.categories).flat().length;\n    const categoryCount = Object.keys(cycleData.categories).length;\n    console.log(`${cycle}: ${categoryCount} categories, ${totalFiles} files`);\n    \n    for (const [cat, files] of Object.entries(cycleData.categories)) {\n      console.log(`  ${cat}: ${files.length} files`);\n    }\n    console.log('');\n  }\n\n  // Find common laboratory tests across all cycles\n  console.log('\\n--- LABORATORY FILE ANALYSIS ---');\n  const allLabFiles = new Set<string>();\n  const labFilesByCycle: { [cycle: string]: string[] } = {};\n\n  for (const cycle of analysisData) {\n    const labFiles = cycle.categories['Laboratory'] || [];\n    labFilesByCycle[cycle.cycle] = labFiles;\n    labFiles.forEach(file => allLabFiles.add(file.replace(/_[A-Z]+\\.csv$/, '')));\n  }\n\n  console.log(`Total unique lab test types found: ${allLabFiles.size}`);\n  \n  // Find tests that appear in all cycles\n  const testCounts: { [test: string]: number } = {};\n  for (const testName of allLabFiles) {\n    testCounts[testName] = 0;\n    for (const cycle of analysisData) {\n      const labFiles = cycle.categories['Laboratory'] || [];\n      if (labFiles.some(file => file.startsWith(testName))) {\n        testCounts[testName]++;\n      }\n    }\n  }\n  \n  const consistentTests = Object.entries(testCounts)\n    .filter(([test, count]) => count === cycles.length)\n    .map(([test]) => test);\n    \n  console.log(`Tests available in ALL cycles (${consistentTests.length}): ${consistentTests.join(', ')}`);\n  \n  const inconsistentTests = Object.entries(testCounts)\n    .filter(([test, count]) => count < cycles.length && count > 1)\n    .sort((a, b) => b[1] - a[1]);\n    \n  console.log('\\nTests with inconsistent availability:');\n  for (const [test, count] of inconsistentTests.slice(0, 10)) {\n    console.log(`  ${test}: ${count}/${cycles.length} cycles`);\n  }\n}\n\ntry {\n  analyzeCycles();\n} catch (error) {\n  console.error('Error:', error);\n}","action":"created"}},"metadata":{"size":3504}}
