tus: z.enum(['in-progress', 'not-done', 'on-hold', 'completed', 'entered-in-error', 'stopped', 'unknown']).describe('in-progress | not-done | on-hold | completed | entered-in-error | stopped | unknown'),\n  statusReason: z.array(CodeableConcept).optional().describe('Reason administration not performed'),\n  category: CodeableConcept.optional().describe('Type of medication usage'),\n  medicationCodeableConcept: CodeableConcept.optional().describe('What was administered'),\n  medicationReference: Reference.optional().describe('What was administered'),\n  subject: Reference.describe('Who received medication'),\n  context: Reference.optional().describe('Encounter or Episode of Care administered as part of'),\n  supportingInformation: z.array(Reference).optional().describe('Additional information to support administration'),\n  effectiveDateTime: FhirDateTime.optional().describe('Start and end time of administration'),\n  effectivePeriod: Period.optional().describe('Start and end time of administration'),\n  performer: z.array(z.object({\n    function: CodeableConcept.optional().describe('Type of performance'),\n    actor: Reference.describe('Who performed the medication administration')\n  })).optional().describe('Who performed the medication administration and what they did'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Reason administration performed'),\n  reasonReference: z.array(Reference).optional().describe('Condition or observation that supports why the medication was administered'),\n  request: Reference.optional().describe('Request administration performed against'),\n  device: z.array(Reference).optional().describe('Device used to administer'),\n  note: z.array(Annotation).optional().describe('Information about the administration'),\n  dosage: z.object({\n    text: FhirString.optional().describe('Free text dosage instructions'),\n    site: CodeableConcept.optional().describe('Body site administered to'),\n    route: CodeableConcept.optional().describe('Path of substance into body'),\n    method: CodeableConcept.optional().describe('How drug was administered'),\n    dose: Quantity.optional().describe('Amount of medication per dose'),\n    rateRatio: Ratio.optional().describe('Dose quantity per unit of time'),\n    rateQuantity: Quantity.optional().describe('Dose quantity per unit of time')\n  }).optional().describe('Details of how medication was taken'),\n  eventHistory: z.array(Reference).optional().describe('A list of events of interest in the lifecycle')\n}).describe('MedicationAdministration resource - administration of medication to a patient');\n\n/**\n * SupplyDelivery resource - delivery of bulk supplies\n */\nexport const SupplyDelivery = BaseResource.extend({\n  resourceType: z.literal('SupplyDelivery').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External identifier'),\n  basedOn: z.array(Reference).optional().describe('Fulfills plan, proposal or order'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['in-progress', 'completed', 'abandoned', 'entered-in-error']).optional().describe('in-progress | completed | abandoned | entered-in-error'),\n  patient: Reference.optional().describe('Patient for whom the item is supplied'),\n  type: CodeableConcept.optional().describe('Category of dispense event'),\n  suppliedItem: z.object({\n    quantity: Quantity.optional().describe('Amount dispensed'),\n    itemCodeableConcept: CodeableConcept.optional().describe('Medication, Substance, or Device supplied'),\n    itemReference: Reference.optional().describe('Medication, Substance, or Device supplied')\n  }).optional().describe('The item that is delivered or supplied'),\n  occurrenceDateTime: FhirDateTime.optional().describe('When event occurred'),\n  occurrencePeriod: Period.optional().describe('When event occurred'),\n  occurrenceTiming: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n      periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n    }).optional().describe('When the event is to occur')\n  }).optional().describe('When event occurred'),\n  supplier: Reference.optional().describe('Dispenser'),\n  destination: Reference.optional().describe('Where the Supply was sent'),\n  receiver: z.array(Reference).optional().describe('Who collected the Supply')\n}).describe('SupplyDelivery resource - delivery of bulk supplies');\n\n/**\n * Union type for all supported FHIR resources\n */\nexport const Resource = z.union([\n  Patient,\n  Observation,\n  Encounter,\n  Condition,\n  Procedure,\n  MedicationRequest,\n  DiagnosticReport,\n  Immunization,\n  Claim,\n  ExplanationOfBenefit,\n  DocumentReference,\n  Provenance,\n  AllergyIntolerance,\n  CarePlan,\n  CareTeam,\n  Device,\n  ImagingStudy,\n  Medication,\n  MedicationAdministration,\n  SupplyDelivery\n]).describe('Union of all supported FHIR resources');\n\n// Export all individual resource types for use in other modules\nexport type PatientType = z.infer<typeof Patient>;\nexport type ObservationType = z.infer<typeof Observation>;\nexport type EncounterType = z.infer<typeof Encounter>;\nexport type ConditionType = z.infer<typeof Condition>;\nexport type ProcedureType = z.infer<typeof Procedure>;\nexport type MedicationRequestType = z.infer<typeof MedicationRequest>;\nexport type DiagnosticReportType = z.infer<typeof DiagnosticReport>;\nexport type ImmunizationType = z.infer<typeof Immunization>;\nexport type ClaimType = z.infer<typeof Claim>;\nexport type ExplanationOfBenefitType = z.infer<typeof ExplanationOfBenefit>;\nexport type DocumentReferenceType = z.infer<typeof DocumentReference>;\nexport type ProvenanceType = z.infer<typeof Provenance>;\nexport type AllergyIntoleranceType = z.infer<typeof AllergyIntolerance>;\nexport type CarePlanType = z.infer<typeof CarePlan>;\nexport type CareTeamType = z.infer<typeof CareTeam>;\nexport type DeviceType = z.infer<typeof Device>;\nexport type ImagingStudyType = z.infer<typeof ImagingStudy>;\nexport type MedicationType = z.infer<typeof Medication>;\nexport type MedicationAdministrationType = z.infer<typeof MedicationAdministration>;\nexport type SupplyDeliveryType = z.infer<typeof SupplyDelivery>;\nexport type ResourceType = z.infer<typeof Resource>;","action":"modified"}}
