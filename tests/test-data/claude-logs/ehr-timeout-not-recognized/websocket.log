[2025-07-10T09:49:21.148Z] [OUT] {"id":"1752140961148-2imglkb12","timestamp":"2025-07-10T09:49:21.148Z","type":"file.updated","data":{"path":"typescript_code/src/schema/fhir-resources.ts","filename":"fhir-resources.ts","content":"import { z } from 'zod';\nimport {\n  FhirId, FhirUri, FhirDateTime, FhirDate, FhirDecimal, FhirBoolean, FhirCode, FhirString,\n  Coding, CodeableConcept, Quantity, Period, Identifier, HumanName, Address, ContactPoint,\n  Meta, Narrative, Reference, Extension, Attachment, Range, Ratio, Annotation, Dosage\n} from './fhir-datatypes';\n\n/**\n * Base Resource - all FHIR resources inherit from this\n */\nexport const BaseResource = z.object({\n  resourceType: FhirString.describe('The type of resource'),\n  id: FhirId.optional().describe('Logical id of this artifact'),\n  meta: Meta.optional().describe('Metadata about the resource'),\n  implicitRules: FhirUri.optional().describe('A set of rules under which this content was created'),\n  language: FhirCode.optional().describe('Language of the resource content'),\n  text: Narrative.optional().describe('Text summary of the resource, for human interpretation'),\n  contained: z.array(z.any()).optional().describe('Contained, inline Resources'),\n  extension: z.array(Extension).optional().describe('Additional content defined by implementations'),\n  modifierExtension: z.array(Extension).optional().describe('Extensions that cannot be ignored')\n}).describe('Base Resource - all FHIR resources inherit from this');\n\n/**\n * Patient resource - represents a person receiving health care services\n * This is the central resource in most healthcare scenarios\n */\nexport const Patient = BaseResource.extend({\n  resourceType: z.literal('Patient').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('An identifier for this patient'),\n  active: FhirBoolean.optional().describe('Whether this patient record is in active use'),\n  name: z.array(HumanName).optional().describe('A name associated with the patient'),\n  telecom: z.array(ContactPoint).optional().describe('A contact detail for the individual'),\n  gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender - the gender that the patient is considered to have for administration and record keeping purposes'),\n  birthDate: FhirDate.optional().describe('The date of birth for the individual'),\n  deceasedBoolean: FhirBoolean.optional().describe('Indicates if the individual is deceased or not'),\n  deceasedDateTime: FhirDateTime.optional().describe('Indicates if the individual is deceased or not'),\n  address: z.array(Address).optional().describe('An address for the individual'),\n  maritalStatus: CodeableConcept.optional().describe('Marital (civil) status of a patient'),\n  multipleBirthBoolean: FhirBoolean.optional().describe('Whether patient is part of a multiple birth'),\n  multipleBirthInteger: z.number().int().optional().describe('Whether patient is part of a multiple birth'),\n  photo: z.array(Attachment).optional().describe('Image of the patient'),\n  contact: z.array(z.object({\n    relationship: z.array(CodeableConcept).optional().describe('The kind of relationship'),\n    name: HumanName.optional().describe('A name associated with the contact person'),\n    telecom: z.array(ContactPoint).optional().describe('A contact detail for the person'),\n    address: Address.optional().describe('Address for the contact person'),\n    gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender'),\n    organization: Reference.optional().describe('Organization that is associated with the contact'),\n    period: Period.optional().describe('The period during which this contact person or organization is valid to be contacted relating to this patient')\n  })).optional().describe('A contact party (e.g. guardian, partner, friend) for the patient'),\n  communication: z.array(z.object({\n    language: CodeableConcept.describe('The language which can be used to communicate with the patient about his or her health'),\n    preferred: FhirBoolean.optional().describe('Language preference indicator')\n  })).optional().describe('A language which may be used to communicate with the patient about his or her health'),\n  generalPractitioner: z.array(Reference).optional().describe('Patient\\'s nominated primary care provider'),\n  managingOrganization: Reference.optional().describe('Organization that is the custodian of the patient record'),\n  link: z.array(z.object({\n    other: Reference.describe('The other patient or related person resource that the link refers to'),\n    type: z.enum(['replaced-by', 'replaces', 'refer', 'seealso']).describe('The type of link between this patient resource and another patient resource')\n  })).optional().describe('Link to another patient resource that concerns the same actual person')\n}).describe('Patient resource - represents a person receiving health care services');\n\n/**\n * Observation resource - measurements and simple assertions made about a patient\n * This includes vital signs, lab results, and other clinical observations\n */\nexport const Observation = BaseResource.extend({\n  resourceType: z.literal('Observation').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business Identifier for observation'),\n  basedOn: z.array(Reference).optional().describe('Fulfills plan, proposal or order'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['registered', 'preliminary', 'final', 'amended', 'corrected', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the result value'),\n  category: z.array(CodeableConcept).optional().describe('Classification of type of observation'),\n  code: CodeableConcept.describe('Type of observation (code / type)'),\n  subject: Reference.optional().describe('Who and/or what the observation is about'),\n  focus: z.array(Reference).optional().describe('What the observation is about, when it is not about the subject of record'),\n  encounter: Reference.optional().describe('Healthcare event during which this observation is made'),\n  effectiveDateTime: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  effectivePeriod: Period.optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveTiming: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n      periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n    }).optional().describe('When the event is to occur')\n  }).optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveInstant: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  issued: FhirDateTime.optional().describe('Date/Time this version was made available'),\n  performer: z.array(Reference).optional().describe('Who is responsible for the observation'),\n  // Value types - observation can have different value types\n  valueQuantity: Quantity.optional().describe('Actual result - quantity'),\n  valueCodeableConcept: CodeableConcept.optional().describe('Actual result - codeable concept'),\n  valueString: FhirString.optional().describe('Actual result - string'),\n  valueBoolean: FhirBoolean.optional().describe('Actual result - boolean'),\n  valueInteger: z.number().int().optional().describe('Actual result - integer'),\n  valueRange: Range.optional().describe('Actual result - range'),\n  valueRatio: Ratio.optional().describe('Actual result - ratio'),\n  valueSampledData: z.object({\n    origin: Quantity.describe('Zero value and units'),\n    period: FhirDecimal.describe('Number of milliseconds between samples'),\n    factor: FhirDecimal.optional().describe('Multiply data by this before adding to origin'),\n    lowerLimit: FhirDecimal.optional().describe('Lower limit of detection'),\n    upperLimit: FhirDecimal.optional().describe('Upper limit of detection'),\n    dimensions: z.number().int().positive().describe('Number of sample points at each time point'),\n    data: FhirString.optional().describe('Decimal values with spaces, or \"E\" | \"U\" | \"L\"')\n  }).optional().describe('Actual result - sampled data'),\n  valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual result - time'),\n  valueDateTime: FhirDateTime.optional().describe('Actual result - datetime'),\n  valuePeriod: Period.optional().describe('Actual result - period'),\n  dataAbsentReason: CodeableConcept.optional().describe('Why the result is missing'),\n  interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n  note: z.array(Annotation).optional().describe('Comments about the observation'),\n  bodySite: CodeableConcept.optional().describe('Observed body part'),\n  method: CodeableConcept.optional().describe('How it was done'),\n  specimen: Reference.optional().describe('Specimen used for this observation'),\n  device: Reference.optional().describe('(Measurement) Device'),\n  referenceRange: z.array(z.object({\n    low: Quantity.optional().describe('Low Range, if relevant'),\n    high: Quantity.optional().describe('High Range, if relevant'),\n    type: CodeableConcept.optional().describe('Reference range qualifier'),\n    appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n    age: Range.optional().describe('Applicable age range, if relevant'),\n    text: FhirString.optional().describe('Text based reference range in an observation')\n  })).optional().describe('Provides guide for interpretation'),\n  hasMember: z.array(Reference).optional().describe('Related resource that belongs to the Observation group'),\n  derivedFrom: z.array(Reference).optional().describe('Related measurements the observation is made from'),\n  component: z.array(z.object({\n    code: CodeableConcept.describe('Type of component observation (code / type)'),\n    valueQuantity: Quantity.optional().describe('Actual component result - quantity'),\n    valueCodeableConcept: CodeableConcept.optional().describe('Actual component result - codeable concept'),\n    valueString: FhirString.optional().describe('Actual component result - string'),\n    valueBoolean: FhirBoolean.optional().describe('Actual component result - boolean'),\n    valueInteger: z.number().int().optional().describe('Actual component result - integer'),\n    valueRange: Range.optional().describe('Actual component result - range'),\n    valueRatio: Ratio.optional().describe('Actual component result - ratio'),\n    valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual component result - time'),\n    valueDateTime: FhirDateTime.optional().describe('Actual component result - datetime'),\n    valuePeriod: Period.optional().describe('Actual component result - period'),\n    dataAbsentReason: CodeableConcept.optional().describe('Why the component result is missing'),\n    interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n    referenceRange: z.array(z.object({\n      low: Quantity.optional().describe('Low Range, if relevant'),\n      high: Quantity.optional().describe('High Range, if relevant'),\n      type: CodeableConcept.optional().describe('Reference range qualifier'),\n      appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n      age: Range.optional().describe('Applicable age range, if relevant'),\n      text: FhirString.optional().describe('Text based reference range in an observation')\n    })).optional().describe('Provides guide f