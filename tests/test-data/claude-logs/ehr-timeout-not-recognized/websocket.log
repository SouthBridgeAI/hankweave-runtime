ion = z.object({\n  authorReference: Reference.optional().describe('Individual responsible for the annotation'),\n  authorString: FhirString.optional().describe('Individual responsible for the annotation'),\n  time: FhirDateTime.optional().describe('When the annotation was made'),\n  text: FhirString.describe('The annotation - text content')\n}).describe('Text node with attribution');\n\n/**\n * Dosage instructions for medications\n * Used in medication requests, statements, etc.\n */\nexport const Dosage = z.object({\n  sequence: z.number().int().positive().optional().describe('The order of the dosage instructions'),\n  text: FhirString.optional().describe('Free text dosage instructions'),\n  additionalInstruction: z.array(CodeableConcept).optional().describe('Supplemental instruction or warnings'),\n  patientInstruction: FhirString.optional().describe('Patient or consumer oriented instructions'),\n  timing: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      bounds: z.union([\n        z.object({ boundsDuration: Quantity }),\n        z.object({ boundsRange: Range }),\n        z.object({ boundsPeriod: Period })\n      ]).optional().describe('Length/Range of lengths, or (Start and/or end) limits'),\n      count: z.number().int().positive().optional().describe('Number of times to repeat'),\n      countMax: z.number().int().positive().optional().describe('Maximum number of times to repeat'),\n      duration: FhirDecimal.optional().describe('How long when it happens'),\n      durationMax: FhirDecimal.optional().describe('How long when it happens (Max)'),\n      durationUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time'),\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      frequencyMax: z.number().int().positive().optional().describe('Event occurs up to frequencyMax times per period'),\n      period: 