[2025-07-10T10:01:55.685Z] [OUT] {"id":"1752141715685-mw7cvqffz","timestamp":"2025-07-10T10:01:55.685Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/schema-analysis.ts","filename":"schema-analysis.ts","content":"import * as fs from 'fs';\nimport * as path from 'path';\n\n// Deep object analysis to understand the structure\nfunction analyzeObject(obj: any, prefix: string = '', depth: number = 0): Set<string> {\n  const patterns = new Set<string>();\n  \n  if (depth > 10) return patterns; // Prevent infinite recursion\n  \n  if (Array.isArray(obj)) {\n    patterns.add(`${prefix}[]`);\n    if (obj.length > 0) {\n      // Analyze first few elements\n      for (let i = 0; i < Math.min(3, obj.length); i++) {\n        const subPatterns = analyzeObject(obj[i], `${prefix}[${i}]`, depth + 1);\n        subPatterns.forEach(p => patterns.add(p));\n      }\n    }\n  } else if (obj !== null && typeof obj === 'object') {\n    const keys = Object.keys(obj);\n    patterns.add(`${prefix}{${keys.join(', ')}}`);\n    \n    for (const key of keys) {\n      const value = obj[key];\n      const newPrefix = prefix ? `${prefix}.${key}` : key;\n      \n      // Add type information\n      if (value === null) {\n        patterns.add(`${newPrefix}: null`);\n      } else if (Array.isArray(value)) {\n        patterns.add(`${newPrefix}: array[${value.length}]`);\n        if (value.length > 0) {\n          const subPatterns = analyzeObject(value, newPrefix, depth + 1);\n          subPatterns.forEach(p => patterns.add(p));\n        }\n      } else if (typeof value === 'object') {\n        patterns.add(`${newPrefix}: object`);\n        const subPatterns = analyzeObject(value, newPrefix, depth + 1);\n        subPatterns.forEach(p => patterns.add(p));\n      } else {\n        patterns.add(`${newPrefix}: ${typeof value} = ${JSON.stringify(value).slice(0, 50)}`);\n      }\n    }\n  } else {\n    patterns.add(`${prefix}: ${typeof obj} = ${JSON.stringify(obj).slice(0, 50)}`);\n  }\n  \n  return patterns;\n}\n\nasync function analyzeSmallFile() {\n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  // Get a small file for detailed analysis\n  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));\n  const fileSizes = files.map(f => ({\n    name: f,\n    size: fs.statSync(path.join(dataDir, f)).size\n  })).sort((a, b) => a.size - b.size);\n  \n  const smallFile = fileSizes[0];\n  console.log(`Analyzing ${smallFile.name} (${(smallFile.size / 1024).toFixed(1)}KB)`);\n  \n  const content = fs.readFileSync(path.join(dataDir, smallFile.name), 'utf8');\n  const data = JSON.parse(content);\n  \n  console.log('\\n=== BUNDLE STRUCTURE ===');\n  const bundlePatterns = analyzeObject(data, 'bundle', 0);\n  Array.from(bundlePatterns).sort().forEach(pattern => {\n    if (!pattern.includes('.entry[')) {\n      console.log(pattern);\n    }\n  });\n  \n  console.log('\\n=== SAMPLE ENTRY STRUCTURE ===');\n  if (data.entry && data.entry.length > 0) {\n    const sampleEntry = data.entry[0];\n    const entryPatterns = analyzeObject(sampleEntry, 'entry', 0);\n    Array.from(entryPatterns).sort().forEach(pattern => {\n      console.log(pattern);\n    });\n  }\n  \n  console.log('\\n=== RESOURCE TYPES AND THEIR KEYS ===');\n  const resourceTypeKeys = new Map<string, Set<string>>();\n  \n  data.entry.forEach((entry: any, index: number) => {\n    const resource = entry.resource;\n    if (resource && resource.resourceType) {\n      const resourceType = resource.resourceType;\n      if (!resourceTypeKeys.has(resourceType)) {\n        resourceTypeKeys.set(resourceType, new Set());\n      }\n      const keys = resourceTypeKeys.get(resourceType)!;\n      Object.keys(resource).forEach(key => keys.add(key));\n    }\n  });\n  \n  for (const [resourceType, keys] of resourceTypeKeys.entries()) {\n    console.log(`${resourceType}: [${Array.from(keys).sort().join(', ')}]`);\n  }\n  \n  console.log('\\n=== DETAILED RESOURCE ANALYSIS ===');\n  // Analyze each resource type in detail\n  for (const [resourceType, keys] of resourceTypeKeys.entries()) {\n    console.log(`\\n--- ${resourceType} ---`);\n    const sampleResource = data.entry.find((e: any) => e.resource.resourceType === resourceType)?.resource;\n    if (sampleResource) {\n      const resourcePatterns = analyzeObject(sampleResource, resourceType, 0);\n      Array.from(resourcePatterns).sort().slice(0, 20).forEach(pattern => {\n        console.log(pattern);\n      });\n    }\n  }\n}\n\nanalyzeSmallFile().catch(console.error);","action":"created"}}
[2025-07-10T10:01:55.687Z] [OUT] {"id":"1752141715687-c29hheg58","timestamp":"2025-07-10T10:01:55.687Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/simple-structure-analysis.ts","filename":"simple-structure-analysis.ts","content":"import * as fs from 'fs';\nimport * as path from 'path';\n\nasync function analyzeStructure() {\n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  // Get a small file for analysis\n  const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));\n  const fileSizes = files.map(f => ({\n    name: f,\n    size: fs.statSync(path.join(dataDir, f)).size\n  })).sort((a, b) => a.size - b.size);\n  \n  const smallFile = fileSizes[0];\n  console.log(`Analyzing ${smallFile.name}`);\n  \n  const content = fs.readFileSync(path.join(dataDir, smallFile.name), 'utf8');\n  const data = JSON.parse(content);\n  \n  console.log('\\n=== BUNDLE LEVEL ===');\n  console.log('Keys:', Object.keys(data));\n  console.log('Type:', data.type);\n  console.log('ResourceType:', data.resourceType);\n  console.log('Entry count:', data.entry.length);\n  \n  console.log('\\n=== ENTRY STRUCTURE ===');\n  const sampleEntry = data.entry[0];\n  console.log('Entry keys:', Object.keys(sampleEntry));\n  console.log('Request keys:', Object.keys(sampleEntry.request));\n  console.log('Resource keys:', Object.keys(sampleEntry.resource));\n  \n  console.log('\\n=== RESOURCE TYPES ===');\n  const resourceTypes = new Map<string, number>();\n  data.entry.forEach((entry: any) => {\n    const type = entry.resource.resourceType;\n    resourceTypes.set(type, (resourceTypes.get(type) || 0) + 1);\n  });\n  \n  for (const [type, count] of resourceTypes.entries()) {\n    console.log(`${type}: ${count}`);\n  }\n  \n  console.log('\\n=== PATIENT RESOURCE ===');\n  const patientResource = data.entry.find((e: any) => e.resource.resourceType === 'Patient')?.resource;\n  if (patientResource) {\n    console.log('Patient keys:', Object.keys(patientResource));\n    console.log('Name structure:', JSON.stringify(patientResource.name, null, 2));\n    console.log('Address structure:', JSON.stringify(patientResource.address, null, 2));\n  }\n  \n  console.log('\\n=== OBSERVATION RESOURCE ===');\n  const observationResource = data.entry.find((e: any) => e.resource.resourceType === 'Observation')?.resource;\n  if (observationResource) {\n    console.log('Observation keys:', Object.keys(observationResource));\n    console.log('Code structure:', JSON.stringify(observationResource.code, null, 2));\n    console.log('Value structure:', JSON.stringify(observationResource.valueQuantity || observationResource.valueCodeableConcept || observationResource.valueString, null, 2));\n  }\n  \n  console.log('\\n=== ENCOUNTER RESOURCE ===');\n  const encounterResource = data.entry.find((e: any) => e.resource.resourceType === 'Encounter')?.resource;\n  if (encounterResource) {\n    console.log('Encounter keys:', Object.keys(encounterResource));\n    console.log('Class structure:', JSON.stringify(encounterResource.class, null, 2));\n    console.log('Period structure:', JSON.stringify(encounterResource.period, null, 2));\n  }\n}\n\nanalyzeStructure().catch(console.error);","action":"created"}}
[2025-07-10T10:01:55.687Z] [OUT] {"id":"1752141715687-jhdd2qca0","timestamp":"2025-07-10T10:01:55.687Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/analyze-fhir-files.ts","filename":"analyze-fhir-files.ts","content":"import * as fs from 'fs';\nimport * as path from 'path';\n\ninterface FileAnalysis {\n  filename: string;\n  fileSize: number;\n  entryCount: number;\n  patientName: string;\n  patientBirthDate: string;\n  patientGender: string;\n  patientCity: string;\n  resourceCounts: Record<string, number>;\n  dateRange: {\n    earliest: string;\n    latest: string;\n  };\n}\n\nasync function analyzeFile(filePath: string): Promise<FileAnalysis> {\n  try {\n    const content = fs.readFileSync(filePath, 'utf8');\n    const data = JSON.parse(content);\n    \n    const filename = path.basename(filePath);\n    const fileSize = fs.statSync(filePath).size;\n    const entryCount = data.entry.length;\n    \n    // Get patient info (first entry should be Patient)\n    const patient = data.entry[0].resource;\n    const patientName = `${patient.name[0].given.join(' ')} ${patient.name[0].family}`;\n    const patientBirthDate = patient.birthDate;\n    const patientGender = patient.gender;\n    const patientCity = patient.address[0].city;\n    \n    // Count resource types\n    const resourceCounts: Record<string, number> = {};\n    data.entry.forEach((entry: any) => {\n      const resourceType = entry.resource.resourceType;\n      resourceCounts[resourceType] = (resourceCounts[resourceType] || 0) + 1;\n    });\n    \n    // Find date range\n    const dates: string[] = [];\n    data.entry.forEach((entry: any) => {\n      const resource = entry.resource;\n      if (resource.effectiveDateTime) {\n        dates.push(resource.effectiveDateTime);\n      }\n      if (resource.period?.start) {\n        dates.push(resource.period.start);\n      }\n    });\n    \n    dates.sort();\n    const dateRange = {\n      earliest: dates[0] || 'N/A',\n      latest: dates[dates.length - 1] || 'N/A'\n    };\n    \n    return {\n      filename,\n      fileSize,\n      entryCount,\n      patientName,\n      patientBirthDate,\n      patientGender,\n      patientCity,\n      resourceCounts,\n      dateRange\n    };\n  } catch (error) {\n    console.error(`Error analyzing ${filePath}:`, error);\n    throw error;\n  }\n}\n\nasync function main() {\n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  // Get all JSON files\n  const files = fs.readdirSync(dataDir)\n    .filter(f => f.endsWith('.json'))\n    .map(f => path.join(dataDir, f));\n  \n  console.log(`Found ${files.length} JSON files`);\n  \n  // Analyze a sample of files (first 10 and last 10 by size)\n  const fileSizes = files.map(f => ({\n    path: f,\n    size: fs.statSync(f).size\n  })).sort((a, b) => b.size - a.size);\n  \n  const samplesToAnalyze = [\n    ...fileSizes.slice(0, 5), // 5 largest\n    ...fileSizes.slice(-5)    // 5 smallest\n  ];\n  \n  console.log('Analyzing sample files...');\n  const analyses: FileAnalysis[] = [];\n  \n  for (const file of samplesToAnalyze) {\n    try {\n      console.log(`Analyzing ${path.basename(file.path)} (${(file.size / 1024 / 1024).toFixed(1)}MB)`);\n      const analysis = await analyzeFile(file.path);\n      analyses.push(analysis);\n    } catch (error) {\n      console.error(`Failed to analyze ${file.path}`);\n    }\n  }\n  \n  // Print summary\n  console.log('\\n=== ANALYSIS SUMMARY ===');\n  console.log('File Size Distribution:');\n  analyses.forEach(a => {\n    console.log(`${a.filename}: ${(a.fileSize / 1024 / 1024).toFixed(1)}MB, ${a.entryCount} entries`);\n  });\n  \n  console.log('\\nResource Type Patterns:');\n  const allResourceTypes = new Set<string>();\n  analyses.forEach(a => Object.keys(a.resourceCounts).forEach(type => allResourceTypes.add(type)));\n  \n  Array.from(allResourceTypes).sort().forEach(resourceType => {\n    const counts = analyses.map(a => a.resourceCounts[resourceType] || 0);\n    const min = Math.min(...counts);\n    const max = Math.max(...counts);\n    const avg = counts.reduce((a, b) => a + b, 0) / counts.length;\n    console.log(`${resourceType}: min=${min}, max=${max}, avg=${avg.toFixed(1)}`);\n  });\n  \n  console.log('\\nPatient Demographics:');\n  analyses.forEach(a => {\n    console.log(`${a.patientName} (${a.patientGender}, born ${a.patientBirthDate}) - ${a.patientCity}`);\n  });\n}\n\nmain().catch(console.error);","action":"created"}}
[2025-07-10T10:01:55.687Z] [OUT] {"id":"1752141715687-px1n0uujm","timestamp":"2025-07-10T10:01:55.687Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/financial-outliers.ts","filename":"financial-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { ClaimType, ExplanationOfBenefitType } from '../schema';\n\ninterface FinancialAnalysis {\n  totalClaims: number;\n  totalEOBs: number;\n  claimStatusDistribution: Record<string, number>;\n  eobStatusDistribution: Record<string, number>;\n  claimTypeDistribution: Record<string, number>;\n  useDistribution: Record<string, number>;\n  amounts: {\n    claimAmounts: number[];\n    eobAmounts: number[];\n    paymentAmounts: number[];\n    adjustmentAmounts: number[];\n    outliers: Array<{type: string, amount: number, description: string, file: string}>;\n    extremelyHigh: Array<{type: string, amount: number, description: string, file: string}>;\n    negativeAmounts: Array<{type: string, amount: number, description: string, file: string}>;\n    zeroAmounts: number;\n  };\n  currencyPatterns: Record<string, number>;\n  procedureCodes: Record<string, number>;\n  diagnosisCodes: Record<string, number>;\n  providerPatterns: Record<string, number>;\n  paymentPatterns: {\n    fullPayments: number;\n    partialPayments: number;\n    deniedClaims: number;\n    adjustedClaims: number;\n  };\n  timePatterns: {\n    sameDay: number; // Claim and payment same day\n    quickTurnaround: number; // Payment within 7 days\n    normalTurnaround: number; // Payment within 30 days\n    slowTurnaround: number; // Payment > 30 days\n  };\n}\n\nfunction extractAmount(obj: any): number | null {\n  if (obj?.value !== undefined) {\n    return parseFloat(obj.value);\n  }\n  return null;\n}\n\nfunction extractCurrency(obj: any): string {\n  if (obj?.code) {\n    return obj.code;\n  }\n  if (obj?.system?.includes('currency')) {\n    return obj.system.split('/').pop() || 'unknown';\n  }\n  return 'USD'; // Default assumption\n}\n\nasync function analyzeFinancials() {\n  console.log('=== Financial Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 5), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing financial data in ${sampleFiles.length} files...`);\n  \n  const analysis: FinancialAnalysis = {\n    totalClaims: 0,\n    totalEOBs: 0,\n    claimStatusDistribution: {},\n    eobStatusDistribution: {},\n    claimTypeDistribution: {},\n    useDistribution: {},\n    amounts: {\n      claimAmounts: [],\n      eobAmounts: [],\n      paymentAmounts: [],\n      adjustmentAmounts: [],\n      outliers: [],\n      extremelyHigh: [],\n      negativeAmounts: [],\n      zeroAmounts: 0\n    },\n    currencyPatterns: {},\n    procedureCodes: {},\n    diagnosisCodes: {},\n    providerPatterns: {},\n    paymentPatterns: {\n      fullPayments: 0,\n      partialPayments: 0,\n      deniedClaims: 0,\n      adjustedClaims: 0\n    },\n    timePatterns: {\n      sameDay: 0,\n      quickTurnaround: 0,\n      normalTurnaround: 0,\n      slowTurnaround: 0\n    }\n  };\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const claims = extractResourcesByType(result.bundle, 'Claim') as ClaimType[];\n      const eobs = extractResourcesByType(result.bundle, 'ExplanationOfBenefit') as ExplanationOfBenefitType[];\n      \n      // Analyze Claims\n      for (const claim of claims) {\n        analysis.totalClaims++;\n        \n        // Status distribution\n        if (claim.status) {\n          analysis.claimStatusDistribution[claim.status] = \n            (analysis.claimStatusDistribution[claim.status] || 0) + 1;\n        }\n        \n        // Type distribution\n        if (claim.type?.text) {\n          analysis.claimTypeDistribution[claim.type.text] = \n            (analysis.claimTypeDistribution[claim.type.text] || 0) + 1;\n        }\n        \n        // Use distribution\n        if (claim.use) {\n          analysis.useDistribution[claim.use] = \n            (analysis.useDistribution[claim.use] || 0) + 1;\n        }\n        \n        // Provider patterns\n        if (claim.provider?.display) {\n          analysis.providerPatterns[claim.provider.display] = \n            (analysis.providerPatterns[claim.provider.display] || 0) + 1;\n        }\n        \n        // Analyze claim items for amounts\n        if (claim.item) {\n          for (const item of claim.item) {\n            // Net amount\n            const netAmount = extractAmount(item.net);\n            if (netAmount !== null) {\n              analysis.amounts.claimAmounts.push(netAmount);\n              const currency = extractCurrency(item.net);\n              analysis.currencyPatterns[currency] = \n                (analysis.currencyPatterns[currency] || 0) + 1;\n              \n              // Check for outliers\n              if (netAmount === 0) {\n                analysis.amounts.zeroAmounts++;\n              } else if (netAmount < 0) {\n                analysis.amounts.negativeAmounts.push({\n                  type: 'Claim Item',\n                  amount: netAmount,\n                  description: item.productOrService?.text || 'Unknown service',\n                  file: fileName\n                });\n              } else if (netAmount > 50000) {\n                analysis.amounts.extremelyHigh.push({\n                  type: 'Claim Item',\n                  amount: netAmount,\n                  description: item.productOrService?.text || 'Unknown service',\n                  file: fileName\n                });\n              }\n            }\n            \n            // Unit price\n            const unitPrice = extractAmount(item.unitPrice);\n            if (unitPrice !== null && unitPrice > 10000) {\n              analysis.amounts.outliers.push({\n                type: 'Unit Price',\n                amount: unitPrice,\n                description: item.productOrService?.text || 'Unknown service',\n                file: fileName\n              });\n            }\n            \n            // Track procedure codes\n            if (item.productOrService?.coding?.[0]?.code) {\n              const code = item.productOrService.coding[0].code;\n              analysis.procedureCodes[code] = \n                (analysis.procedureCodes[code] || 0) + 1;\n            }\n          }\n        }\n        \n        // Track diagnosis codes\n        if (claim.diagnosis) {\n          for (const diag of claim.diagnosis) {\n            if (diag.diagnosisCodeableConcept?.coding?.[0]?.code) {\n              const code = diag.diagnosisCodeableConcept.coding[0].code;\n              analysis.diagnosisCodes[code] = \n                (analysis.diagnosisCodes[code] || 0) + 1;\n            }\n          }\n        }\n      }\n      \n      // Analyze Explanation of Benefits\n      for (const eob of eobs) {\n        analysis.totalEOBs++;\n        \n        // Status distribution\n        if (eob.status) {\n          analysis.eobStatusDistribution[eob.status] = \n            (analysis.eobStatusDistribution[eob.status] || 0) + 1;\n        }\n        \n        // Analyze totals\n        if (eob.total) {\n          for (const total of eob.total) {\n            const amount = extractAmount(total.amount);\n            if (amount !== null) {\n              analysis.amounts.eobAmounts.push(amount);\n              \n              if (amount > 100000) {\n                analysis.amounts.extremelyHigh.push({\n                  type: 'EOB Total',\n                  amount,\n                  description: total.category?.text || 'Unknown category',\n                  file: fileName\n                });\n              }\n            }\n          }\n        }\n        \n        // Analyze payments\n        if (eob.payment) {\n          const paymentAmount = extractAmount(eob.payment.amount);\n          if (paymentAmount !== null) {\n            analysis.amounts.paymentAmounts.push(paymentAmount);\n            \n            // Analyze payment patterns (simplified)\n            if (paymentAmount === 0) {\n              analysis.paymentPatterns.deniedClaims++;\n            } else if (paymentAmount > 0) {\n              analysis.paymentPatterns.fullPayments++;\n            }\n          }\n          \n          const adjustmentAmount = extractAmount(eob.payment.adjustment);\n          if (adjustmentAmount !== null) {\n            analysis.amounts.adjustmentAmounts.push(adjustmentAmount);\n            if (adjustmentAmount !== 0) {\n              analysis.paymentPatterns.adjustedClaims++;\n            }\n          }\n        }\n        \n        // Analyze item adjudications\n        if (eob.item) {\n          for (const item of eob.item) {\n            if (item.adjudication) {\n              for (const adj of item.adjudication) {\n                const adjAmount = extractAmount(adj.amount);\n                if (adjAmount !== null && adjAmount > 25000) {\n                  analysis.amounts.outliers.push({\n                    type: 'Adjudication',\n                    amount: adjAmount,\n                    description: adj.category?.text || 'Unknown adjudication',\n                    file: fileName\n                  });\n                }\n              }\n            }\n          }\n        }\n      }\n      \n    } catch (error) {\n      console.error(`Error analyzing financial data in ${fileName}:`, error);\n    }\n  }\n  \n  // Calculate statistics\n  const calculateStats = (values: number[]) => {\n    if (values.length === 0) return { min: 0, max: 0, mean: 0, median: 0 };\n    const sorted = [...values].sort((a, b) => a - b);\n    return {\n      min: sorted[0],\n      max: sorted[sorted.length - 1],\n      mean: values.reduce((a, b) => a + b, 0) / values.length,\n      median: sorted[Math.floor(sorted.length / 2)]\n    };\n  };\n  \n  const claimStats = calculateStats(analysis.amounts.claimAmounts);\n  const eobStats = calculateStats(analysis.amounts.eobAmounts);\n  const paymentStats = calculateStats(analysis.amounts.paymentAmounts);\n  \n  // Print results\n  console.log(`\\n=== FINANCIAL ANALYSIS RESULTS ===`);\n  console.log(`Total claims: ${analysis.totalClaims}`);\n  console.log(`Total EOBs: ${analysis.totalEOBs}\\n`);\n  \n  console.log('CLAIM STATUS DISTRIBUTION:');\n  Object.entries(analysis.claimStatusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalClaims*100).toFixed(1)}%)`));\n  \n  console.log('\\nEOB STATUS DISTRIBUTION:');\n  Object.entries(analysis.eobStatusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalEOBs*100).toFixed(1)}%)`));\n  \n  console.log('\\nCLAIM TYPE DISTRIBUTION:');\n  Object.entries(analysis.claimTypeDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([type, count]) => console.log(`- ${type}: ${count}`));\n  \n  console.log('\\nUSE DISTRIBUTION:');\n  Object.entries(analysis.useDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([use, count]) => console.log(`- ${use}: ${count}`));\n  \n  console.log('\\nAMOUNT ANALYSIS:');\n  console.log(`Claim amounts (${analysis.amounts.claimAmounts.length} values):`);\n  console.log(`  Range: $${claimStats.min.toFixed(2)} - $${claimStats.max.toFixed(2)}`);\n  console.log(`  Mean: $${claimStats.mean.toFixed(2)}`);\n  console.log(`  Median: $${claimStats.median.toFixed(2)}`);\n  \n  if (analysis.amounts.eobAmounts.length > 0) {\n    console.log(`EOB amounts (${analysis.amounts.eobAmounts.length} values):`);\n    console.log(`  Range: $${eobStats.min.toFixed(2)} - $${eobStats.max.toFixed(2)}`);\n    console.log(`  Mean: $${eobStats.mean.toFixed(2)}`);\n  }\n  \n  if (analysis.amounts.paymentAmounts.length > 0) {\n    console.log(`Payment amounts (${analysis.amounts.paymentAmounts.length} values):`);\n    console.log(`  Range: $${paymentStats.min.toFixed(2)} - $${paymentStats.max.toFixed(2)}`);\n    console.log(`  Mean: $${paymentStats.mean.toFixed(2)}`);\n  }\n  \n  console.log('\\nCURRENCY PATTERNS:');\n  Object.entries(analysis.currencyPatterns)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([currency, count]) => console.log(`- ${currency}: ${count}`));\n  \n  console.log('\\nTOP PROCEDURE CODES:');\n  Object.entries(analysis.procedureCodes)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([code, count]) => console.log(`- ${code}: ${count}`));\n  \n  console.log('\\nTOP DIAGNOSIS CODES:');\n  Object.entries(analysis.diagnosisCodes)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([code, count]) => console.log(`- ${code}: ${count}`));\n  \n  console.log('\\nPAYMENT PATTERNS:');\n  console.log(`- Full/partial payments: ${analysis.paymentPatterns.fullPayments}`);\n  console.log(`- Denied claims: ${analysis.paymentPatterns.deniedClaims}`);\n  console.log(`- Adjusted claims: ${analysis.paymentPatterns.adjustedClaims}`);\n  \n  console.log('\\nANOMALIES:');\n  console.log(`- Zero amounts: ${analysis.amounts.zeroAmounts}`);\n  console.log(`- Negative amounts: ${analysis.amounts.negativeAmounts.length}`);\n  if (analysis.amounts.negativeAmounts.length > 0) {\n    analysis.amounts.negativeAmounts.slice(0, 3).forEach(amt => \n      console.log(`  ${amt.description}: $${amt.amount} (${amt.file})`));\n  }\n  \n  console.log(`- Extremely high amounts (>$50,000): ${analysis.amounts.extremelyHigh.length}`);\n  if (analysis.amounts.extremelyHigh.length > 0) {\n    analysis.amounts.extremelyHigh.slice(0, 3).forEach(amt => \n      console.log(`  ${amt.description}: $${amt.amount.toFixed(2)} (${amt.file})`));\n  }\n  \n  console.log(`- Other outliers: ${analysis.amounts.outliers.length}`);\n  if (analysis.amounts.outliers.length > 0) {\n    analysis.amounts.outliers.slice(0, 3).forEach(amt => \n      console.log(`  ${amt.type} - ${amt.description}: $${amt.amount.toFixed(2)} (${amt.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeFinancials().catch(console.error);\n}\n\nexport { analyzeFinancials };","action":"created"}}
[2025-07-10T10:01:55.687Z] [OUT] {"id":"1752141715687-2tc9q44ef","timestamp":"2025-07-10T10:01:55.687Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/outlier-summary.ts","filename":"outlier-summary.ts","content":"import { analyzePatientData } from './patient-data-outliers';\nimport { analyzeObservations } from './observation-outliers';\nimport { analyzeMedications } from './medication-outliers';\nimport { analyzeFinancials } from './financial-outliers';\n\nasync function generateOutlierSummary() {\n  console.log('=== COMPREHENSIVE OUTLIER ANALYSIS SUMMARY ===\\n');\n  console.log('Running all analysis scripts to generate comprehensive dataset insights...\\n');\n  \n  try {\n    // Run all analyses\n    console.log('1. Patient Data Analysis...');\n    const patientAnalysis = await analyzePatientData();\n    \n    console.log('\\n2. Observation Analysis...');\n    const observationAnalysis = await analyzeObservations();\n    \n    console.log('\\n3. Medication Analysis...');\n    const medicationAnalysis = await analyzeMedications();\n    \n    console.log('\\n4. Financial Analysis...');\n    const financialAnalysis = await analyzeFinancials();\n    \n    // Generate summary insights\n    console.log('\\n' + '='.repeat(80));\n    console.log('DATASET QUALITY & OUTLIER SUMMARY');\n    console.log('='.repeat(80));\n    \n    console.log('\\n📊 SAMPLE SIZE:');\n    console.log(`- Patients analyzed: ${patientAnalysis.totalPatients}`);\n    console.log(`- Observations analyzed: ${observationAnalysis.totalObservations}`);\n    console.log(`- Medication requests: ${medicationAnalysis.totalMedicationRequests}`);\n    console.log(`- Claims/EOBs: ${financialAnalysis.totalClaims}/${financialAnalysis.totalEOBs}`);\n    \n    console.log('\\n🚨 KEY OUTLIERS DETECTED:');\n    \n    // Patient outliers\n    console.log('\\nPatient Data:');\n    if (patientAnalysis.birthdatePatterns.futureDates > 0) {\n      console.log(`- ⚠️  Future birth dates: ${patientAnalysis.birthdatePatterns.futureDates} patients`);\n    }\n    console.log(`- ℹ️  100% synthetic names with numeric suffixes (expected)`);\n    console.log(`- ℹ️  ${patientAnalysis.namePatterns.unicodeNames} patients (${(patientAnalysis.namePatterns.unicodeNames/patientAnalysis.totalPatients*100).toFixed(1)}%) have unicode names`);\n    console.log(`- ℹ️  All patients from Boston, MA, US (synthetic data constraint)`);\n    \n    // Observation outliers\n    console.log('\\nObservation Data:');\n    if (observationAnalysis.vitalSigns.height.outliers.length > 0) {\n      const minHeight = Math.min(...observationAnalysis.vitalSigns.height.values);\n      const maxHeight = Math.max(...observationAnalysis.vitalSigns.height.values);\n      console.log(`- ⚠️  Height outliers: ${observationAnalysis.vitalSigns.height.outliers.length} measurements`);\n      console.log(`  Range: ${minHeight} - ${maxHeight} cm (some very short heights detected)`);\n    }\n    if (observationAnalysis.vitalSigns.weight.outliers.length > 0) {\n      const minWeight = Math.min(...observationAnalysis.vitalSigns.weight.values);\n      const maxWeight = Math.max(...observationAnalysis.vitalSigns.weight.values);\n      console.log(`- ℹ️  Weight range: ${minWeight} - ${maxWeight} kg (includes pediatric patients)`);\n    }\n    if (observationAnalysis.extremeValues.length > 0) {\n      console.log(`- ⚠️  Extreme values: ${observationAnalysis.extremeValues.length} measurements with values >10000 or <0`);\n      console.log(`  Note: Negative bone density T-scores are clinically normal`);\n    }\n    \n    // Medication outliers\n    console.log('\\nMedication Data:');\n    const stoppedPercentage = medicationAnalysis.statusDistribution['stopped'] / medicationAnalysis.totalMedicationRequests * 100;\n    console.log(`- ℹ️  ${stoppedPercentage.toFixed(1)}% of medications have \"stopped\" status`);\n    console.log(`- ℹ️  Most common frequency: 1x per day (${medicationAnalysis.dosagePatterns.frequencies['1x per d'] || 0} medications)`);\n    if (medicationAnalysis.doseRanges.extremeLow.length > 0) {\n      console.log(`- ⚠️  Extremely low doses: ${medicationAnalysis.doseRanges.extremeLow.length} medications`);\n    }\n    if (medicationAnalysis.doseRanges.extremeHigh.length > 0) {\n      console.log(`- ⚠️  Extremely high doses: ${medicationAnalysis.doseRanges.extremeHigh.length} medications`);\n    }\n    \n    // Financial outliers\n    console.log('\\nFinancial Data:');\n    const claimAmounts = financialAnalysis.amounts.claimAmounts;\n    const maxClaimAmount = Math.max(...claimAmounts);\n    const deniedPercentage = financialAnalysis.paymentPatterns.deniedClaims / financialAnalysis.totalClaims * 100;\n    console.log(`- ℹ️  Claim amounts range: $0 - $${maxClaimAmount.toFixed(2)}`);\n    console.log(`- ℹ️  ${deniedPercentage.toFixed(1)}% of claims denied (payment amount = $0)`);\n    console.log(`- ℹ️  ${financialAnalysis.amounts.zeroAmounts} zero-amount transactions`);\n    if (financialAnalysis.amounts.extremelyHigh.length > 0) {\n      console.log(`- ⚠️  Extremely high amounts: ${financialAnalysis.amounts.extremelyHigh.length} transactions >$50,000`);\n    }\n    if (financialAnalysis.amounts.negativeAmounts.length > 0) {\n      console.log(`- ⚠️  Negative amounts: ${financialAnalysis.amounts.negativeAmounts.length} transactions`);\n    }\n    \n    console.log('\\n📋 SCHEMA RECOMMENDATIONS:');\n    console.log('\\nBased on outlier analysis, consider these schema constraints:');\n    \n    console.log('\\n1. Patient Resource:');\n    console.log('   - birthDate: constrain to 1900-2030 range');\n    console.log('   - gender: enum [male, female] (only observed values)');\n    console.log('   - name: expect numeric suffix pattern for synthetic data');\n    console.log('   - address.country: likely always \"US\" in this dataset');\n    \n    console.log('\\n2. Observation Resource:');\n    console.log('   - status: likely always \"final\" in this dataset');\n    console.log('   - valueQuantity.value: add reasonable ranges per observation type');\n    console.log('   - height: 50-250 cm range (pediatric to adult)');\n    console.log('   - weight: 2-200 kg range (pediatric to adult)');\n    console.log('   - heart rate: 40-200 bpm range');\n    console.log('   - allow negative values for bone density T-scores');\n    \n    console.log('\\n3. MedicationRequest Resource:');\n    console.log('   - status: enum [active, stopped] (primary observed values)');\n    console.log('   - intent: likely always \"order\" in this dataset');\n    console.log('   - dosage frequency: 1-4x per day most common');\n    \n    console.log('\\n4. Claim/EOB Resources:');\n    console.log('   - status: likely always \"active\" in this dataset');\n    console.log('   - amounts: $0-$100,000 reasonable range');\n    console.log('   - currency: likely always \"USD\" in this dataset');\n    console.log('   - allow zero amounts for denied claims');\n    \n    console.log('\\n5. General Patterns:');\n    console.log('   - All UUIDs follow standard format');\n    console.log('   - Geographic data constrained to Boston area');\n    console.log('   - Date ranges span 1920-2025 (synthetic data)');\n    console.log('   - Multiple language support (English/Spanish names)');\n    \n    return {\n      patientAnalysis,\n      observationAnalysis,\n      medicationAnalysis,\n      financialAnalysis\n    };\n    \n  } catch (error) {\n    console.error('Error running comprehensive analysis:', error);\n    throw error;\n  }\n}\n\nif (require.main === module) {\n  generateOutlierSummary().catch(console.error);\n}\n\nexport { generateOutlierSummary };","action":"created"}}
[2025-07-10T10:01:55.688Z] [OUT] {"id":"1752141715688-15whjh6bw","timestamp":"2025-07-10T10:01:55.688Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/observation-outliers.ts","filename":"observation-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { ObservationType } from '../schema';\n\ninterface ObservationAnalysis {\n  totalObservations: number;\n  statusDistribution: Record<string, number>;\n  categoryDistribution: Record<string, number>;\n  valueTypes: {\n    quantity: number;\n    string: number;\n    boolean: number;\n    codeableConcept: number;\n    missing: number;\n  };\n  vitalSigns: {\n    height: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    weight: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    bloodPressure: { \n      systolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n      diastolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n    };\n    heartRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    temperature: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    respiratoryRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n  };\n  labValues: {\n    cholesterol: { values: number[]; outliers: Array<{value: number, file: string}> };\n    glucose: { values: number[]; outliers: Array<{value: number, file: string}> };\n    hemoglobin: { values: number[]; outliers: Array<{value: number, file: string}> };\n  };\n  codePatterns: Record<string, number>;\n  unitPatterns: Record<string, number>;\n  extremeValues: Array<{type: string, value: number, unit: string, file: string}>;\n}\n\nfunction detectOutliers(values: number[]): { outliers: number[]; q1: number; q3: number; iqr: number } {\n  if (values.length === 0) return { outliers: [], q1: 0, q3: 0, iqr: 0 };\n  \n  const sorted = [...values].sort((a, b) => a - b);\n  const q1Index = Math.floor(sorted.length * 0.25);\n  const q3Index = Math.floor(sorted.length * 0.75);\n  const q1 = sorted[q1Index];\n  const q3 = sorted[q3Index];\n  const iqr = q3 - q1;\n  const lowerBound = q1 - 1.5 * iqr;\n  const upperBound = q3 + 1.5 * iqr;\n  \n  const outliers = values.filter(v => v < lowerBound || v > upperBound);\n  return { outliers, q1, q3, iqr };\n}\n\nasync function analyzeObservations() {\n  console.log('=== Observation Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 10), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing observations in ${sampleFiles.length} files...`);\n  \n  const analysis: ObservationAnalysis = {\n    totalObservations: 0,\n    statusDistribution: {},\n    categoryDistribution: {},\n    valueTypes: {\n      quantity: 0,\n      string: 0,\n      boolean: 0,\n      codeableConcept: 0,\n      missing: 0\n    },\n    vitalSigns: {\n      height: { values: [], unit: '', outliers: [] },\n      weight: { values: [], unit: '', outliers: [] },\n      bloodPressure: { \n        systolic: { values: [], outliers: [] },\n        diastolic: { values: [], outliers: [] }\n      },\n      heartRate: { values: [], unit: '', outliers: [] },\n      temperature: { values: [], unit: '', outliers: [] },\n      respiratoryRate: { values: [], unit: '', outliers: [] }\n    },\n    labValues: {\n      cholesterol: { values: [], outliers: [] },\n      glucose: { values: [], outliers: [] },\n      hemoglobin: { values: [], outliers: [] }\n    },\n    codePatterns: {},\n    unitPatterns: {},\n    extremeValues: []\n  };\n  \n  const heightCodes = ['8302-2', '3137-7'];\n  const weightCodes = ['29463-7', '3141-9'];\n  const bpCodes = ['85354-9', '8480-6', '8462-4']; // BP panel, systolic, diastolic\n  const heartRateCodes = ['8867-4'];\n  const temperatureCodes = ['8310-5'];\n  const respiratoryCodes = ['9279-1'];\n  const cholesterolCodes = ['2093-3', '14647-2'];\n  const glucoseCodes = ['2339-0', '33747-0'];\n  const hemoglobinCodes = ['718-7'];\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const observations = extractResourcesByType(result.bundle, 'Observation') as ObservationType[];\n      \n      for (const obs of observations) {\n        analysis.totalObservations++;\n        \n        // Analyze status\n        if (obs.status) {\n          analysis.statusDistribution[obs.status] = \n            (analysis.statusDistribution[obs.status] || 0) + 1;\n        }\n        \n        // Analyze category\n        if (obs.category?.[0]?.coding?.[0]?.display) {\n          const category = obs.category[0].coding[0].display;\n          analysis.categoryDistribution[category] = \n            (analysis.categoryDistribution[category] || 0) + 1;\n        }\n        \n        // Analyze value types\n        if (obs.valueQuantity) {\n          analysis.valueTypes.quantity++;\n          \n          const value = obs.valueQuantity.value;\n          const unit = obs.valueQuantity.unit || obs.valueQuantity.code || '';\n          const code = obs.code.coding?.[0]?.code;\n          \n          if (value !== undefined && code) {\n            // Track units\n            if (unit) {\n              analysis.unitPatterns[unit] = (analysis.unitPatterns[unit] || 0) + 1;\n            }\n            \n            // Categorize vital signs\n            if (heightCodes.includes(code)) {\n              analysis.vitalSigns.height.values.push(value);\n              analysis.vitalSigns.height.unit = unit;\n            } else if (weightCodes.includes(code)) {\n              analysis.vitalSigns.weight.values.push(value);\n              analysis.vitalSigns.weight.unit = unit;\n            } else if (code === '8480-6') { // Systolic BP\n              analysis.vitalSigns.bloodPressure.systolic.values.push(value);\n            } else if (code === '8462-4') { // Diastolic BP\n              analysis.vitalSigns.bloodPressure.diastolic.values.push(value);\n            } else if (heartRateCodes.includes(code)) {\n              analysis.vitalSigns.heartRate.values.push(value);\n              analysis.vitalSigns.heartRate.unit = unit;\n            } else if (temperatureCodes.includes(code)) {\n              analysis.vitalSigns.temperature.values.push(value);\n              analysis.vitalSigns.temperature.unit = unit;\n            } else if (respiratoryCodes.includes(code)) {\n              analysis.vitalSigns.respiratoryRate.values.push(value);\n              analysis.vitalSigns.respiratoryRate.unit = unit;\n            } else if (cholesterolCodes.includes(code)) {\n              analysis.labValues.cholesterol.values.push(value);\n            } else if (glucoseCodes.includes(code)) {\n              analysis.labValues.glucose.values.push(value);\n            } else if (hemoglobinCodes.includes(code)) {\n              analysis.labValues.hemoglobin.values.push(value);\n            }\n            \n            // Track extreme values\n            if (value > 10000 || value < 0) {\n              analysis.extremeValues.push({\n                type: obs.code.text || obs.code.coding?.[0]?.display || 'Unknown',\n                value,\n                unit,\n                file: fileName\n              });\n            }\n          }\n        } else if (obs.valueString) {\n          analysis.valueTypes.string++;\n        } else if (obs.valueBoolean !== undefined) {\n          analysis.valueTypes.boolean++;\n        } else if (obs.valueCodeableConcept) {\n          analysis.valueTypes.codeableConcept++;\n        } else {\n          analysis.valueTypes.missing++;\n        }\n        \n        // Analyze codes\n        if (obs.code.coding?.[0]?.code) {\n          const code = obs.code.coding[0].code;\n          analysis.codePatterns[code] = (analysis.codePatterns[code] || 0) + 1;\n        }\n      }\n      \n    } catch (error) {\n      console.error(`Error analyzing observations in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers for vital signs\n  const detectVitalOutliers = (values: number[], type: string, fileName: string) => {\n    const { outliers } = detectOutliers(values);\n    return outliers.map(value => ({ value, file: fileName }));\n  };\n  \n  // Find outliers for each vital sign type\n  analysis.vitalSigns.height.outliers = detectVitalOutliers(analysis.vitalSigns.height.values, 'height', 'multiple');\n  analysis.vitalSigns.weight.outliers = detectVitalOutliers(analysis.vitalSigns.weight.values, 'weight', 'multiple');\n  analysis.vitalSigns.bloodPressure.systolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.systolic.values, 'systolic', 'multiple');\n  analysis.vitalSigns.bloodPressure.diastolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.diastolic.values, 'diastolic', 'multiple');\n  analysis.vitalSigns.heartRate.outliers = detectVitalOutliers(analysis.vitalSigns.heartRate.values, 'heartRate', 'multiple');\n  analysis.vitalSigns.temperature.outliers = detectVitalOutliers(analysis.vitalSigns.temperature.values, 'temperature', 'multiple');\n  analysis.vitalSigns.respiratoryRate.outliers = detectVitalOutliers(analysis.vitalSigns.respiratoryRate.values, 'respiratoryRate', 'multiple');\n  \n  // Print results\n  console.log(`\\n=== OBSERVATION ANALYSIS RESULTS ===`);\n  console.log(`Total observations analyzed: ${analysis.totalObservations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nCATEGORY DISTRIBUTION:');\n  Object.entries(analysis.categoryDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([category, count]) => \n      console.log(`- ${category}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVALUE TYPES:');\n  Object.entries(analysis.valueTypes)\n    .forEach(([type, count]) => \n      console.log(`- ${type}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVITAL SIGNS ANALYSIS:');\n  \n  // Height analysis\n  if (analysis.vitalSigns.height.values.length > 0) {\n    const heights = analysis.vitalSigns.height.values;\n    console.log(`- Height (${analysis.vitalSigns.height.unit}): ${heights.length} measurements`);\n    console.log(`  Range: ${Math.min(...heights).toFixed(1)} - ${Math.max(...heights).toFixed(1)}`);\n    console.log(`  Mean: ${(heights.reduce((a, b) => a + b, 0) / heights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.height.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.height.outliers.length}`);\n      analysis.vitalSigns.height.outliers.slice(0, 3).forEach(o => \n        console.log(`    ${o.value} ${analysis.vitalSigns.height.unit}`));\n    }\n  }\n  \n  // Weight analysis\n  if (analysis.vitalSigns.weight.values.length > 0) {\n    const weights = analysis.vitalSigns.weight.values;\n    console.log(`- Weight (${analysis.vitalSigns.weight.unit}): ${weights.length} measurements`);\n    console.log(`  Range: ${Math.min(...weights).toFixed(1)} - ${Math.max(...weights).toFixed(1)}`);\n    console.log(`  Mean: ${(weights.reduce((a, b) => a + b, 0) / weights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.weight.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.weight.outliers.length}`);\n    }\n  }\n  \n  // Blood pressure analysis\n  if (analysis.vitalSigns.bloodPressure.systolic.values.length > 0) {\n    const systolic = analysis.vitalSigns.bloodPressure.systolic.values;\n    const diastolic = analysis.vitalSigns.bloodPressure.diastolic.values;\n    console.log(`- Blood Pressure (mmHg): ${systolic.length} systolic, ${diastolic.length} diastolic`);\n    console.log(`  Systolic range: ${Math.min(...systolic)} - ${Math.max(...systolic)}`);\n    if (diastolic.length > 0) {\n      console.log(`  Diastolic range: ${Math.min(...diastolic)} - ${Math.max(...diastolic)}`);\n    }\n    if (analysis.vitalSigns.bloodPressure.systolic.outliers.length > 0) {\n      console.log(`  Systolic outliers: ${analysis.vitalSigns.bloodPressure.systolic.outliers.length}`);\n    }\n  }\n  \n  // Heart rate analysis\n  if (analysis.vitalSigns.heartRate.values.length > 0) {\n    const hr = analysis.vitalSigns.heartRate.values;\n    console.log(`- Heart Rate (${analysis.vitalSigns.heartRate.unit}): ${hr.length} measurements`);\n    console.log(`  Range: ${Math.min(...hr)} - ${Math.max(...hr)}`);\n    console.log(`  Mean: ${(hr.reduce((a, b) => a + b, 0) / hr.length).toFixed(1)}`);\n  }\n  \n  console.log('\\nMOST COMMON OBSERVATION CODES:');\n  Object.entries(analysis.codePatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([code, count]) => console.log(`- ${code}: ${count}`));\n  \n  console.log('\\nMOST COMMON UNITS:');\n  Object.entries(analysis.unitPatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  if (analysis.extremeValues.length > 0) {\n    console.log('\\nEXTREME VALUES (>10000 or <0):');\n    analysis.extremeValues.slice(0, 10).forEach(extreme => \n      console.log(`- ${extreme.type}: ${extreme.value} ${extreme.unit} (${extreme.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeObservations().catch(console.error);\n}\n\nexport { analyzeObservations };","action":"created"}}
[2025-07-10T10:01:55.688Z] [OUT] {"id":"1752141715688-zst3knoyp","timestamp":"2025-07-10T10:01:55.688Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/medication-outliers.ts","filename":"medication-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { MedicationRequestType, MedicationAdministrationType } from '../schema';\n\ninterface MedicationAnalysis {\n  totalMedicationRequests: number;\n  totalMedicationAdministrations: number;\n  statusDistribution: Record<string, number>;\n  intentDistribution: Record<string, number>;\n  priorityDistribution: Record<string, number>;\n  dosagePatterns: {\n    texts: Record<string, number>;\n    routes: Record<string, number>;\n    frequencies: Record<string, number>;\n    methods: Record<string, number>;\n  };\n  doseRanges: {\n    values: number[];\n    units: Record<string, number>;\n    outliers: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeLow: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeHigh: Array<{value: number, unit: string, medication: string, file: string}>;\n  };\n  medicationCodes: Record<string, number>;\n  medicationNames: Record<string, number>;\n  durationPatterns: {\n    short: number; // < 1 day\n    normal: number; // 1-30 days\n    long: number; // 30-365 days\n    extreme: number; // > 365 days\n    examples: Array<{duration: string, medication: string, file: string}>;\n  };\n  refillPatterns: {\n    noRefills: number;\n    lowRefills: number; // 1-3\n    normalRefills: number; // 4-11\n    highRefills: number; // 12+\n    unlimited: number;\n  };\n}\n\nfunction extractNumericDose(doseText: string): { value: number; unit: string } | null {\n  // Common patterns for doses\n  const patterns = [\n    /(\\d+(?:\\.\\d+)?)\\s*(mg|g|mcg|μg|units?|ml|tablets?|capsules?)/i,\n    /(\\d+(?:\\.\\d+)?)\\s*(milligrams?|grams?|micrograms?|milliliters?)/i\n  ];\n  \n  for (const pattern of patterns) {\n    const match = doseText.match(pattern);\n    if (match) {\n      return {\n        value: parseFloat(match[1]),\n        unit: match[2].toLowerCase()\n      };\n    }\n  }\n  return null;\n}\n\nfunction parseDuration(text: string): number | null {\n  // Extract duration in days\n  const patterns = [\n    /(\\d+)\\s*days?/i,\n    /(\\d+)\\s*weeks?/i,\n    /(\\d+)\\s*months?/i,\n    /(\\d+)\\s*years?/i\n  ];\n  \n  const dayMatch = text.match(patterns[0]);\n  if (dayMatch) return parseInt(dayMatch[1]);\n  \n  const weekMatch = text.match(patterns[1]);\n  if (weekMatch) return parseInt(weekMatch[1]) * 7;\n  \n  const monthMatch = text.match(patterns[2]);\n  if (monthMatch) return parseInt(monthMatch[1]) * 30;\n  \n  const yearMatch = text.match(patterns[3]);\n  if (yearMatch) return parseInt(yearMatch[1]) * 365;\n  \n  return null;\n}\n\nasync function analyzeMedications() {\n  console.log('=== Medication Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 5), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing medications in ${sampleFiles.length} files...`);\n  \n  const analysis: MedicationAnalysis = {\n    totalMedicationRequests: 0,\n    totalMedicationAdministrations: 0,\n    statusDistribution: {},\n    intentDistribution: {},\n    priorityDistribution: {},\n    dosagePatterns: {\n      texts: {},\n      routes: {},\n      frequencies: {},\n      methods: {}\n    },\n    doseRanges: {\n      values: [],\n      units: {},\n      outliers: [],\n      extremeLow: [],\n      extremeHigh: []\n    },\n    medicationCodes: {},\n    medicationNames: {},\n    durationPatterns: {\n      short: 0,\n      normal: 0,\n      long: 0,\n      extreme: 0,\n      examples: []\n    },\n    refillPatterns: {\n      noRefills: 0,\n      lowRefills: 0,\n      normalRefills: 0,\n      highRefills: 0,\n      unlimited: 0\n    }\n  };\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const medicationRequests = extractResourcesByType(result.bundle, 'MedicationRequest') as MedicationRequestType[];\n      const medicationAdmins = extractResourcesByType(result.bundle, 'MedicationAdministration') as MedicationAdministrationType[];\n      \n      // Analyze MedicationRequests\n      for (const medReq of medicationRequests) {\n        analysis.totalMedicationRequests++;\n        \n        // Status distribution\n        if (medReq.status) {\n          analysis.statusDistribution[medReq.status] = \n            (analysis.statusDistribution[medReq.status] || 0) + 1;\n        }\n        \n        // Intent distribution\n        if (medReq.intent) {\n          analysis.intentDistribution[medReq.intent] = \n            (analysis.intentDistribution[medReq.intent] || 0) + 1;\n        }\n        \n        // Priority distribution\n        if (medReq.priority) {\n          analysis.priorityDistribution[medReq.priority] = \n            (analysis.priorityDistribution[medReq.priority] || 0) + 1;\n        }\n        \n        // Medication names/codes\n        let medicationName = 'Unknown';\n        if (medReq.medicationCodeableConcept?.text) {\n          medicationName = medReq.medicationCodeableConcept.text;\n          analysis.medicationNames[medicationName] = \n            (analysis.medicationNames[medicationName] || 0) + 1;\n        }\n        \n        if (medReq.medicationCodeableConcept?.coding?.[0]?.code) {\n          const code = medReq.medicationCodeableConcept.coding[0].code;\n          analysis.medicationCodes[code] = \n            (analysis.medicationCodes[code] || 0) + 1;\n        }\n        \n        // Dosage patterns\n        if (medReq.dosageInstruction) {\n          for (const dosage of medReq.dosageInstruction) {\n            // Dosage text patterns\n            if (dosage.text) {\n              analysis.dosagePatterns.texts[dosage.text] = \n                (analysis.dosagePatterns.texts[dosage.text] || 0) + 1;\n              \n              // Extract numeric dose\n              const dose = extractNumericDose(dosage.text);\n              if (dose) {\n                analysis.doseRanges.values.push(dose.value);\n                analysis.doseRanges.units[dose.unit] = \n                  (analysis.doseRanges.units[dose.unit] || 0) + 1;\n                \n                // Check for extreme doses\n                if (dose.value < 0.01) {\n                  analysis.doseRanges.extremeLow.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                } else if (dose.value > 10000) {\n                  analysis.doseRanges.extremeHigh.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n              \n              // Extract duration\n              const duration = parseDuration(dosage.text);\n              if (duration) {\n                if (duration < 1) {\n                  analysis.durationPatterns.short++;\n                } else if (duration <= 30) {\n                  analysis.durationPatterns.normal++;\n                } else if (duration <= 365) {\n                  analysis.durationPatterns.long++;\n                } else {\n                  analysis.durationPatterns.extreme++;\n                  analysis.durationPatterns.examples.push({\n                    duration: `${duration} days`,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n            }\n            \n            // Route patterns\n            if (dosage.route?.text) {\n              analysis.dosagePatterns.routes[dosage.route.text] = \n                (analysis.dosagePatterns.routes[dosage.route.text] || 0) + 1;\n            }\n            \n            // Method patterns\n            if (dosage.method?.text) {\n              analysis.dosagePatterns.methods[dosage.method.text] = \n                (analysis.dosagePatterns.methods[dosage.method.text] || 0) + 1;\n            }\n            \n            // Timing/frequency patterns\n            if (dosage.timing?.repeat?.frequency) {\n              const freq = `${dosage.timing.repeat.frequency}x per ${dosage.timing.repeat.periodUnit || 'period'}`;\n              analysis.dosagePatterns.frequencies[freq] = \n                (analysis.dosagePatterns.frequencies[freq] || 0) + 1;\n            }\n          }\n        }\n        \n        // Refill patterns\n        if (medReq.dispenseRequest?.numberOfRepeatsAllowed !== undefined) {\n          const refills = medReq.dispenseRequest.numberOfRepeatsAllowed;\n          if (refills === 0) {\n            analysis.refillPatterns.noRefills++;\n          } else if (refills <= 3) {\n            analysis.refillPatterns.lowRefills++;\n          } else if (refills <= 11) {\n            analysis.refillPatterns.normalRefills++;\n          } else if (refills < 100) {\n            analysis.refillPatterns.highRefills++;\n          } else {\n            analysis.refillPatterns.unlimited++;\n          }\n        }\n      }\n      \n      // Analyze MedicationAdministrations\n      analysis.totalMedicationAdministrations += medicationAdmins.length;\n      \n    } catch (error) {\n      console.error(`Error analyzing medications in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers in doses\n  if (analysis.doseRanges.values.length > 0) {\n    const sorted = [...analysis.doseRanges.values].sort((a, b) => a - b);\n    const q1 = sorted[Math.floor(sorted.length * 0.25)];\n    const q3 = sorted[Math.floor(sorted.length * 0.75)];\n    const iqr = q3 - q1;\n    const lowerBound = q1 - 1.5 * iqr;\n    const upperBound = q3 + 1.5 * iqr;\n    \n    // Find outliers (simplified - just mark extreme values)\n    analysis.doseRanges.values.forEach(value => {\n      if (value < lowerBound || value > upperBound) {\n        // Would need to trace back to specific medication, simplified for now\n      }\n    });\n  }\n  \n  // Print results\n  console.log(`\\n=== MEDICATION ANALYSIS RESULTS ===`);\n  console.log(`Total medication requests: ${analysis.totalMedicationRequests}`);\n  console.log(`Total medication administrations: ${analysis.totalMedicationAdministrations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  console.log('\\nINTENT DISTRIBUTION:');\n  Object.entries(analysis.intentDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([intent, count]) => \n      console.log(`- ${intent}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  if (Object.keys(analysis.priorityDistribution).length > 0) {\n    console.log('\\nPRIORITY DISTRIBUTION:');\n    Object.entries(analysis.priorityDistribution)\n      .sort(([,a], [,b]) => b - a)\n      .forEach(([priority, count]) => \n        console.log(`- ${priority}: ${count}`));\n  }\n  \n  console.log('\\nTOP MEDICATIONS:');\n  Object.entries(analysis.medicationNames)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([name, count]) => console.log(`- ${name}: ${count}`));\n  \n  console.log('\\nDOSE ANALYSIS:');\n  if (analysis.doseRanges.values.length > 0) {\n    console.log(`- Total doses analyzed: ${analysis.doseRanges.values.length}`);\n    console.log(`- Dose range: ${Math.min(...analysis.doseRanges.values)} - ${Math.max(...analysis.doseRanges.values)}`);\n    console.log(`- Mean dose: ${(analysis.doseRanges.values.reduce((a, b) => a + b, 0) / analysis.doseRanges.values.length).toFixed(2)}`);\n  }\n  \n  console.log('\\nTOP DOSE UNITS:');\n  Object.entries(analysis.doseRanges.units)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  console.log('\\nROUTE PATTERNS:');\n  Object.entries(analysis.dosagePatterns.routes)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([route, count]) => console.log(`- ${route}: ${count}`));\n  \n  console.log('\\nFREQUENCY PATTERNS:');\n  Object.entries(analysis.dosagePatterns.frequencies)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([freq, count]) => console.log(`- ${freq}: ${count}`));\n  \n  console.log('\\nDURATION PATTERNS:');\n  console.log(`- Short duration (<1 day): ${analysis.durationPatterns.short}`);\n  console.log(`- Normal duration (1-30 days): ${analysis.durationPatterns.normal}`);\n  console.log(`- Long duration (30-365 days): ${analysis.durationPatterns.long}`);\n  console.log(`- Extreme duration (>365 days): ${analysis.durationPatterns.extreme}`);\n  if (analysis.durationPatterns.examples.length > 0) {\n    console.log('  Examples of extreme durations:');\n    analysis.durationPatterns.examples.slice(0, 3).forEach(ex => \n      console.log(`    ${ex.medication}: ${ex.duration} (${ex.file})`));\n  }\n  \n  console.log('\\nREFILL PATTERNS:');\n  console.log(`- No refills: ${analysis.refillPatterns.noRefills}`);\n  console.log(`- Low refills (1-3): ${analysis.refillPatterns.lowRefills}`);\n  console.log(`- Normal refills (4-11): ${analysis.refillPatterns.normalRefills}`);\n  console.log(`- High refills (12+): ${analysis.refillPatterns.highRefills}`);\n  console.log(`- Unlimited refills: ${analysis.refillPatterns.unlimited}`);\n  \n  if (analysis.doseRanges.extremeLow.length > 0) {\n    console.log('\\nEXTREMELY LOW DOSES (<0.01):');\n    analysis.doseRanges.extremeLow.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  if (analysis.doseRanges.extremeHigh.length > 0) {\n    console.log('\\nEXTREMELY HIGH DOSES (>10000):');\n    analysis.doseRanges.extremeHigh.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeMedications().catch(console.error);\n}\n\nexport { analyzeMedications };","action":"created"}}
[2025-07-10T10:01:55.688Z] [OUT] {"id":"1752141715688-iaufju9ii","timestamp":"2025-07-10T10:01:55.688Z","type":"file.updated","data":{"path":"./typescript_code/src/quick-and-dirty/patient-data-outliers.ts","filename":"patient-data-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractPatientFromBundle } from '../schema';\n\ninterface PatientAnalysis {\n  totalPatients: number;\n  birthdatePatterns: {\n    futureDates: number;\n    veryOldDates: number; // Before 1900\n    dateRange: { earliest: string; latest: string };\n    yearDistribution: Record<number, number>;\n  };\n  namePatterns: {\n    avgFirstNameLength: number;\n    avgLastNameLength: number;\n    maxFirstNameLength: number;\n    maxLastNameLength: number;\n    numericSuffixPattern: number;\n    unicodeNames: number;\n    longNames: string[];\n    shortNames: string[];\n  };\n  genderDistribution: Record<string, number>;\n  addressPatterns: {\n    cities: Record<string, number>;\n    states: Record<string, number>;\n    countries: Record<string, number>;\n    postalCodePatterns: Record<string, number>;\n  };\n  maritalStatusDistribution: Record<string, number>;\n  identifierPatterns: {\n    uuidFormat: number;\n    nonUuidFormat: number;\n    systemPatterns: Record<string, number>;\n  };\n}\n\nasync function analyzePatientData() {\n  console.log('=== Patient Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleSize = Math.min(50, allFiles.length); // Sample 50 files for performance\n  const sampleFiles = [\n    ...allFiles.slice(0, 10), // First 10 (smallest)\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Middle 10\n    ...allFiles.slice(-10), // Last 10 (largest)\n    // Random additional files to reach sample size\n    ...allFiles.filter((_, i) => i % Math.floor(allFiles.length / Math.max(1, sampleSize - 30)) === 0).slice(0, sampleSize - 30)\n  ].slice(0, sampleSize);\n  \n  console.log(`Analyzing ${sampleFiles.length} files...`);\n  \n  const analysis: PatientAnalysis = {\n    totalPatients: 0,\n    birthdatePatterns: {\n      futureDates: 0,\n      veryOldDates: 0,\n      dateRange: { earliest: '9999-12-31', latest: '1900-01-01' },\n      yearDistribution: {}\n    },\n    namePatterns: {\n      avgFirstNameLength: 0,\n      avgLastNameLength: 0,\n      maxFirstNameLength: 0,\n      maxLastNameLength: 0,\n      numericSuffixPattern: 0,\n      unicodeNames: 0,\n      longNames: [],\n      shortNames: []\n    },\n    genderDistribution: {},\n    addressPatterns: {\n      cities: {},\n      states: {},\n      countries: {},\n      postalCodePatterns: {}\n    },\n    maritalStatusDistribution: {},\n    identifierPatterns: {\n      uuidFormat: 0,\n      nonUuidFormat: 0,\n      systemPatterns: {}\n    }\n  };\n  \n  let totalFirstNameLength = 0;\n  let totalLastNameLength = 0;\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const patient = extractPatientFromBundle(result.bundle);\n      if (!patient) continue;\n      \n      analysis.totalPatients++;\n      \n      // Analyze birth date\n      if (patient.birthDate) {\n        const birthYear = new Date(patient.birthDate).getFullYear();\n        const currentYear = new Date().getFullYear();\n        \n        if (birthYear > currentYear) {\n          analysis.birthdatePatterns.futureDates++;\n        }\n        if (birthYear < 1900) {\n          analysis.birthdatePatterns.veryOldDates++;\n        }\n        \n        if (patient.birthDate < analysis.birthdatePatterns.dateRange.earliest) {\n          analysis.birthdatePatterns.dateRange.earliest = patient.birthDate;\n        }\n        if (patient.birthDate > analysis.birthdatePatterns.dateRange.latest) {\n          analysis.birthdatePatterns.dateRange.latest = patient.birthDate;\n        }\n        \n        analysis.birthdatePatterns.yearDistribution[birthYear] = \n          (analysis.birthdatePatterns.yearDistribution[birthYear] || 0) + 1;\n      }\n      \n      // Analyze names\n      if (patient.name?.[0]) {\n        const name = patient.name[0];\n        const firstName = name.given?.[0] || '';\n        const lastName = name.family || '';\n        \n        totalFirstNameLength += firstName.length;\n        totalLastNameLength += lastName.length;\n        \n        analysis.namePatterns.maxFirstNameLength = Math.max(\n          analysis.namePatterns.maxFirstNameLength, \n          firstName.length\n        );\n        analysis.namePatterns.maxLastNameLength = Math.max(\n          analysis.namePatterns.maxLastNameLength, \n          lastName.length\n        );\n        \n        // Check for numeric suffix pattern\n        if (/\\d+$/.test(firstName) || /\\d+$/.test(lastName)) {\n          analysis.namePatterns.numericSuffixPattern++;\n        }\n        \n        // Check for unicode characters\n        if (/[^\\x00-\\x7F]/.test(firstName + lastName)) {\n          analysis.namePatterns.unicodeNames++;\n        }\n        \n        // Track very long or very short names\n        const fullName = `${firstName} ${lastName}`;\n        if (fullName.length > 30) {\n          analysis.namePatterns.longNames.push(`${fullName} (${fileName})`);\n        }\n        if (fullName.length < 10) {\n          analysis.namePatterns.shortNames.push(`${fullName} (${fileName})`);\n        }\n      }\n      \n      // Analyze gender\n      if (patient.gender) {\n        analysis.genderDistribution[patient.gender] = \n          (analysis.genderDistribution[patient.gender] || 0) + 1;\n      }\n      \n      // Analyze address\n      if (patient.address?.[0]) {\n        const address = patient.address[0];\n        \n        if (address.city) {\n          analysis.addressPatterns.cities[address.city] = \n            (analysis.addressPatterns.cities[address.city] || 0) + 1;\n        }\n        \n        if (address.state) {\n          analysis.addressPatterns.states[address.state] = \n            (analysis.addressPatterns.states[address.state] || 0) + 1;\n        }\n        \n        if (address.country) {\n          analysis.addressPatterns.countries[address.country] = \n            (analysis.addressPatterns.countries[address.country] || 0) + 1;\n        }\n        \n        if (address.postalCode) {\n          const pattern = address.postalCode.replace(/\\d/g, 'N');\n          analysis.addressPatterns.postalCodePatterns[pattern] = \n            (analysis.addressPatterns.postalCodePatterns[pattern] || 0) + 1;\n        }\n      }\n      \n      // Analyze marital status\n      if (patient.maritalStatus?.text) {\n        analysis.maritalStatusDistribution[patient.maritalStatus.text] = \n          (analysis.maritalStatusDistribution[patient.maritalStatus.text] || 0) + 1;\n      }\n      \n      // Analyze identifiers\n      if (patient.identifier) {\n        for (const identifier of patient.identifier) {\n          if (identifier.value) {\n            const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n            if (uuidPattern.test(identifier.value)) {\n              analysis.identifierPatterns.uuidFormat++;\n            } else {\n              analysis.identifierPatterns.nonUuidFormat++;\n            }\n          }\n          \n          if (identifier.system) {\n            analysis.identifierPatterns.systemPatterns[identifier.system] = \n              (analysis.identifierPatterns.systemPatterns[identifier.system] || 0) + 1;\n          }\n        }\n      }\n      \n    } catch (error) {\n      console.error(`Error analyzing ${fileName}:`, error);\n    }\n  }\n  \n  // Calculate averages\n  if (analysis.totalPatients > 0) {\n    analysis.namePatterns.avgFirstNameLength = totalFirstNameLength / analysis.totalPatients;\n    analysis.namePatterns.avgLastNameLength = totalLastNameLength / analysis.totalPatients;\n  }\n  \n  // Print results\n  console.log(`\\n=== PATIENT DATA ANALYSIS RESULTS ===`);\n  console.log(`Total patients analyzed: ${analysis.totalPatients}\\n`);\n  \n  console.log('BIRTH DATE PATTERNS:');\n  console.log(`- Future dates: ${analysis.birthdatePatterns.futureDates} (${(analysis.birthdatePatterns.futureDates/analysis.totalPatients*100).toFixed(1)}%)`);\n  console.log(`- Very old dates (pre-1900): ${analysis.birthdatePatterns.veryOldDates}`);\n  console.log(`- Date range: ${analysis.birthdatePatterns.dateRange.earliest} to ${analysis.birthdatePatterns.dateRange.latest}`);\n  console.log(`- Year distribution (top 10):`);\n  Object.entries(analysis.birthdatePatterns.yearDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([year, count]) => console.log(`  ${year}: ${count} patients`));\n  \n  console.log('\\nNAME PATTERNS:');\n  console.log(`- Avg first name length: ${analysis.namePatterns.avgFirstNameLength.toFixed(1)} chars`);\n  console.log(`- Avg last name length: ${analysis.namePatterns.avgLastNameLength.toFixed(1)} chars`);\n  console.log(`- Max first name length: ${analysis.namePatterns.maxFirstNameLength} chars`);\n  console.log(`- Max last name length: ${analysis.namePatterns.maxLastNameLength} chars`);\n  console.log(`- Names with numeric suffixes: ${analysis.namePatterns.numericSuffixPattern} (${(analysis.namePatterns.numericSuffixPattern/analysis.totalPatients*100).toFixed(1)}%)`);\n  console.log(`- Names with unicode chars: ${analysis.namePatterns.unicodeNames} (${(analysis.namePatterns.unicodeNames/analysis.totalPatients*100).toFixed(1)}%)`);\n  if (analysis.namePatterns.longNames.length > 0) {\n    console.log(`- Very long names (>30 chars): ${analysis.namePatterns.longNames.length}`);\n    analysis.namePatterns.longNames.slice(0, 3).forEach(name => console.log(`  ${name}`));\n  }\n  if (analysis.namePatterns.shortNames.length > 0) {\n    console.log(`- Very short names (<10 chars): ${analysis.namePatterns.shortNames.length}`);\n    analysis.namePatterns.shortNames.slice(0, 3).forEach(name => console.log(`  ${name}`));\n  }\n  \n  console.log('\\nGENDER DISTRIBUTION:');\n  Object.entries(analysis.genderDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([gender, count]) => \n      console.log(`- ${gender}: ${count} (${(count/analysis.totalPatients*100).toFixed(1)}%)`));\n  \n  console.log('\\nADDRESS PATTERNS:');\n  console.log(`- Cities (top 10):`);\n  Object.entries(analysis.addressPatterns.cities)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([city, count]) => console.log(`  ${city}: ${count}`));\n  \n  console.log(`- States:`);\n  Object.entries(analysis.addressPatterns.states)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([state, count]) => console.log(`  ${state}: ${count}`));\n  \n  console.log(`- Countries:`);\n  Object.entries(analysis.addressPatterns.countries)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([country, count]) => console.log(`  ${country}: ${count}`));\n  \n  console.log(`- Postal code patterns:`);\n  Object.entries(analysis.addressPatterns.postalCodePatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 5)\n    .forEach(([pattern, count]) => console.log(`  ${pattern}: ${count}`));\n  \n  if (Object.keys(analysis.maritalStatusDistribution).length > 0) {\n    console.log('\\nMARITAL STATUS:');\n    Object.entries(analysis.maritalStatusDistribution)\n      .sort(([,a], [,b]) => b - a)\n      .forEach(([status, count]) => console.log(`- ${status}: ${count}`));\n  }\n  \n  console.log('\\nIDENTIFIER PATTERNS:');\n  console.log(`- UUID format: ${analysis.identifierPatterns.uuidFormat}`);\n  console.log(`- Non-UUID format: ${analysis.identifierPatterns.nonUuidFormat}`);\n  console.log(`- Systems:`);\n  Object.entries(analysis.identifierPatterns.systemPatterns)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([system, count]) => console.log(`  ${system}: ${count}`));\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzePatientData().catch(console.error);\n}\n\nexport { analyzePatientData };","action":"created"}}
[2025-07-10T10:01:55.689Z] [OUT] {"id":"1752141715689-kdeqmo52a","timestamp":"2025-07-10T10:01:55.689Z","type":"file.updated","data":{"path":"./typescript_code/src/schema/fhir-bundle.ts","filename":"fhir-bundle.ts","content":"import { z } from 'zod';\nimport { FhirId, FhirUri, FhirString, Meta, Narrative, Extension, Identifier } from './fhir-datatypes';\nimport { Resource } from './fhir-resources';\n\n/**\n * Bundle Entry - each entry in a FHIR Bundle\n * Contains the resource and metadata about how it should be processed\n */\nexport const BundleEntry = z.object({\n  // Links\n  fullUrl: FhirUri.optional().describe('URI for resource (Absolute or relative)'),\n  \n  // Resource contained in the entry\n  resource: Resource.optional().describe('A resource in the bundle'),\n  \n  // Search related information\n  search: z.object({\n    mode: z.enum(['match', 'include', 'outcome']).optional().describe('Why this entry is in the result set'),\n    score: z.number().optional().describe('Search ranking (between 0 and 1)')\n  }).optional().describe('Search related information'),\n  \n  // Request information for transaction/batch bundles\n  request: z.object({\n    method: z.enum(['GET', 'HEAD', 'POST', 'PUT', 'DELETE', 'PATCH']).describe('HTTP method for the request'),\n    url: FhirString.describe('URL for HTTP equivalent of this entry (can be relative path like \"Patient\")'),\n    ifNoneMatch: FhirString.optional().describe('For managing cache currency'),\n    ifModifiedSince: z.string().optional().describe('For managing cache currency'),\n    ifMatch: FhirString.optional().describe('For managing update contention'),\n    ifNoneExist: FhirString.optional().describe('For conditional creates')\n  }).optional().describe('Additional execution information for transaction/batch'),\n  \n  // Response information for transaction/batch bundles\n  response: z.object({\n    status: FhirString.describe('Status response code (text optional)'),\n    location: FhirUri.optional().describe('The location (if the operation returns a location)'),\n    etag: FhirString.optional().describe('The Etag for the resource (if relevant)'),\n    lastModified: z.string().optional().describe('Server\\'s date time modified'),\n    outcome: Resource.optional().describe('OperationOutcome with hints and warnings')\n  }).optional().describe('Results of execution for transaction/batch')\n}).describe('Bundle Entry - each entry in a FHIR Bundle');\n\n/**\n * Bundle Link - links between bundles for navigation\n * Used for pagination and related bundles\n */\nexport const BundleLink = z.object({\n  relation: FhirString.describe('See http://www.iana.org/assignments/link-relations/link-relations.xhtml#link-relations-1'),\n  url: FhirUri.describe('Reference details for the link')\n}).describe('Bundle Link - links between bundles for navigation');\n\n/**\n * FHIR Bundle - a container for a collection of resources\n * \n * This is the top-level container for all FHIR transactions in our dataset.\n * Each patient file is a Bundle containing all their medical records.\n * \n * Bundle Types in our dataset:\n * - \"transaction\": All bundles in our dataset are transaction bundles\n * - This means they represent a set of actions to be performed as a single atomic operation\n * \n * Key characteristics observed in our data:\n * - Each bundle represents one patient's complete medical history\n * - Contains 31 to 22,049 entries per patient\n * - Entries include Patient, Observations, Encounters, Conditions, etc.\n * - All entries have fullUrl and request fields for transaction processing\n * - Generated by Synthea synthetic health data generator\n * \n * File size correlation:\n * - Newborn patients: ~30-50 entries, ~65KB files\n * - Adult patients: 1,500-22,000 entries, 5-57MB files\n * - Size correlates with patient age and medical complexity\n */\nexport const Bundle = z.object({\n  // Base Resource fields\n  resourceType: z.literal('Bundle').describe('Resource type - always \"Bundle\"'),\n  id: FhirId.optional().describe('Logical id of this artifact'),\n  meta: Meta.optional().describe('Metadata about the resource'),\n  implicitRules: FhirUri.optional().describe('A set of rules under which this content was created'),\n  language: z.string().optional().describe('Language of the resource content'),\n  \n  // Bundle-specific fields\n  identifier: Identifier.optional().describe('Persistent identifier for the bundle'),\n  \n  /**\n   * Bundle type - indicates how the bundle is intended to be processed\n   * In our dataset, all bundles are \"transaction\" type\n   * \n   * FHIR Bundle types:\n   * - document: Document bundle\n   * - message: Message bundle\n   * - transaction: Transaction bundle (our data)\n   * - transaction-response: Transaction response bundle\n   * - batch: Batch bundle\n   * - batch-response: Batch response bundle\n   * - history: History bundle\n   * - searchset: Search result bundle\n   * - collection: Collection bundle\n   */\n  type: z.enum([\n    'document',\n    'message', \n    'transaction',\n    'transaction-response',\n    'batch',\n    'batch-response',\n    'history',\n    'searchset',\n    'collection'\n  ]).describe('Bundle type - how the bundle is intended to be processed'),\n  \n  /**\n   * When the bundle was assembled\n   * Not present in our synthetic data, but included for completeness\n   */\n  timestamp: z.string().optional().describe('When the bundle was assembled'),\n  \n  /**\n   * Total number of matches for search bundles\n   * Not applicable to our transaction bundles\n   */\n  total: z.number().int().nonnegative().optional().describe('If search, the total number of matches'),\n  \n  /**\n   * Links for navigation between bundles\n   * Used for pagination in search results\n   * Not present in our transaction bundles\n   */\n  link: z.array(BundleLink).optional().describe('Links related to this Bundle'),\n  \n  /**\n   * The entries in the bundle\n   * This is the core of our data - contains all the patient's medical records\n   * \n   * In our dataset:\n   * - Always present (required for transaction bundles)\n   * - Contains 31 to 22,049 entries per patient\n   * - First entry is always Patient resource\n   * - Last entry is always Provenance resource\n   * - Middle entries are medical records (Observations, Encounters, etc.)\n   * \n   * Entry structure:\n   * - fullUrl: UUID for the resource\n   * - resource: The actual FHIR resource\n   * - request: HTTP method and URL for transaction processing\n   */\n  entry: z.array(BundleEntry).describe('Entry in the bundle - will have a resource or information'),\n  \n  /**\n   * Digital signature for the bundle\n   * Not present in our synthetic data\n   */\n  signature: z.object({\n    type: z.array(z.object({\n      system: FhirUri.optional(),\n      code: z.string().optional(),\n      display: FhirString.optional()\n    })).describe('Indication of the reason the entity signed the object(s)'),\n    when: z.string().describe('When the signature was created'),\n    who: z.object({\n      reference: FhirString.optional(),\n      display: FhirString.optional()\n    }).describe('Who signed'),\n    onBehalfOf: z.object({\n      reference: FhirString.optional(),\n      display: FhirString.optional()\n    }).optional().describe('The party represented'),\n    targetFormat: z.string().optional().describe('The technical format of the signed resources'),\n    sigFormat: z.string().optional().describe('The technical format of the signature'),\n    data: z.string().optional().describe('The actual signature content')\n  }).optional().describe('Digital Signature')\n}).describe('FHIR Bundle - a container for a collection of resources');\n\n/**\n * Specific schema for Transaction Bundles in our dataset\n * This is more restrictive than the general Bundle schema\n */\nexport const TransactionBundle = Bundle.extend({\n  type: z.literal('transaction').describe('Bundle type - always \"transaction\" in our dataset'),\n  entry: z.array(BundleEntry).min(1).describe('Entry in the bundle - always has at least one entry in our data'),\n  // Note: timestamp and total are not used in transaction bundles\n  timestamp: z.undefined().optional(),\n  total: z.undefined().optional(),\n  link: z.undefined().optional()\n}).describe('Transaction Bundle - specific to our synthetic patient data');\n\n/**\n * Type exports for TypeScript usage\n */\nexport type BundleType = z.infer<typeof Bundle>;\nexport type TransactionBundleType = z.infer<typeof TransactionBundle>;\nexport type BundleEntryType = z.infer<typeof BundleEntry>;\nexport type BundleLinkType = z.infer<typeof BundleLink>;\n\n/**\n * Validation helper for transaction bundles\n * Includes additional business logic validation specific to our dataset\n */\nexport const validateTransactionBundle = (data: unknown) => {\n  const result = TransactionBundle.safeParse(data);\n  \n  if (!result.success) {\n    return result;\n  }\n  \n  const bundle = result.data;\n  \n  // Additional validation for our specific dataset\n  const errors: string[] = [];\n  \n  // Check that first entry is Patient\n  if (bundle.entry.length > 0 && bundle.entry[0].resource?.resourceType !== 'Patient') {\n    errors.push('First entry must be a Patient resource');\n  }\n  \n  // Check that all entries have fullUrl for transaction bundles\n  for (let i = 0; i < bundle.entry.length; i++) {\n    const entry = bundle.entry[i];\n    if (!entry.fullUrl) {\n      errors.push(`Entry ${i} missing fullUrl (required for transaction bundles)`);\n    }\n    if (!entry.request) {\n      errors.push(`Entry ${i} missing request (required for transaction bundles)`);\n    }\n  }\n  \n  // Check for duplicate resource IDs\n  const resourceIds = new Set<string>();\n  for (let i = 0; i < bundle.entry.length; i++) {\n    const entry = bundle.entry[i];\n    if (entry.resource?.id) {\n      if (resourceIds.has(entry.resource.id)) {\n        errors.push(`Duplicate resource ID: ${entry.resource.id}`);\n      }\n      resourceIds.add(entry.resource.id);\n    }\n  }\n  \n  if (errors.length > 0) {\n    return {\n      success: false,\n      error: {\n        issues: errors.map(error => ({ message: error }))\n      }\n    };\n  }\n  \n  return result;\n};\n\n/**\n * Helper function to extract patient from bundle\n */\nexport const extractPatientFromBundle = (bundle: BundleType) => {\n  const patientEntry = bundle.entry.find(entry => entry.resource?.resourceType === 'Patient');\n  return patientEntry?.resource;\n};\n\n/**\n * Helper function to get resource counts by type\n */\nexport const getResourceCounts = (bundle: BundleType) => {\n  const counts: Record<string, number> = {};\n  \n  for (const entry of bundle.entry) {\n    if (entry.resource?.resourceType) {\n      const resourceType = entry.resource.resourceType;\n      counts[resourceType] = (counts[resourceType] || 0) + 1;\n    }\n  }\n  \n  return counts;\n};\n\n/**\n * Helper function to extract all resources of a specific type\n */\nexport const extractResourcesByType = <T extends string>(bundle: BundleType, resourceType: T) => {\n  return bundle.entry\n    .filter(entry => entry.resource?.resourceType === resourceType)\n    .map(entry => entry.resource)\n    .filter(resource => resource !== undefined);\n};","action":"created"}}
[2025-07-10T10:01:55.689Z] [OUT] {"id":"1752141715689-2k3ymllj0","timestamp":"2025-07-10T10:01:55.689Z","type":"file.updated","data":{"path":"./typescript_code/src/schema/fhir-resources.ts","filename":"fhir-resources.ts","content":"import { z } from 'zod';\nimport {\n  FhirId, FhirUri, FhirDateTime, FhirDate, FhirDecimal, FhirBoolean, FhirCode, FhirString,\n  Coding, CodeableConcept, Quantity, Period, Identifier, HumanName, Address, ContactPoint,\n  Meta, Narrative, Reference, Extension, Attachment, Range, Ratio, Annotation, Dosage\n} from './fhir-datatypes';\n\n/**\n * Base Resource - all FHIR resources inherit from this\n */\nexport const BaseResource = z.object({\n  resourceType: FhirString.describe('The type of resource'),\n  id: FhirId.optional().describe('Logical id of this artifact'),\n  meta: Meta.optional().describe('Metadata about the resource'),\n  implicitRules: FhirUri.optional().describe('A set of rules under which this content was created'),\n  language: FhirCode.optional().describe('Language of the resource content'),\n  text: Narrative.optional().describe('Text summary of the resource, for human interpretation'),\n  contained: z.array(z.any()).optional().describe('Contained, inline Resources'),\n  extension: z.array(Extension).optional().describe('Additional content defined by implementations'),\n  modifierExtension: z.array(Extension).optional().describe('Extensions that cannot be ignored')\n}).describe('Base Resource - all FHIR resources inherit from this');\n\n/**\n * Patient resource - represents a person receiving health care services\n * This is the central resource in most healthcare scenarios\n * \n * SYNTHETIC DATA PATTERNS OBSERVED:\n * - All names follow FirstName[Number] LastName[Number] pattern (100% synthetic)\n * - 22.5% have unicode characters (Spanish names like José, María)\n * - All patients located in Boston, MA, US with NNNNN postal code pattern\n * - Birth dates span 1920-2022 (103 year range, includes future dates up to 2025)\n * - Average name lengths: ~9.5 chars first, ~9.7 chars last\n * - Max name lengths: 14 chars observed\n * - Gender distribution: 52.5% male, 47.5% female\n * - Marital status: \"Never Married\" most common, followed by \"Married\", \"Divorced\"\n * - Multiple identifier systems: Synthea, hospital MRN, SSN, state ID, passport\n */\nexport const Patient = BaseResource.extend({\n  resourceType: z.literal('Patient').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('An identifier for this patient'),\n  active: FhirBoolean.optional().describe('Whether this patient record is in active use'),\n  name: z.array(HumanName).optional().describe('A name associated with the patient'),\n  telecom: z.array(ContactPoint).optional().describe('A contact detail for the individual'),\n  gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender - In this synthetic dataset, only \"male\" and \"female\" values observed (52.5% male, 47.5% female)'),\n  birthDate: FhirDate.optional().describe('The date of birth for the individual'),\n  deceasedBoolean: FhirBoolean.optional().describe('Indicates if the individual is deceased or not'),\n  deceasedDateTime: FhirDateTime.optional().describe('Indicates if the individual is deceased or not'),\n  address: z.array(Address).optional().describe('An address for the individual'),\n  maritalStatus: CodeableConcept.optional().describe('Marital (civil) status of a patient'),\n  multipleBirthBoolean: FhirBoolean.optional().describe('Whether patient is part of a multiple birth'),\n  multipleBirthInteger: z.number().int().optional().describe('Whether patient is part of a multiple birth'),\n  photo: z.array(Attachment).optional().describe('Image of the patient'),\n  contact: z.array(z.object({\n    relationship: z.array(CodeableConcept).optional().describe('The kind of relationship'),\n    name: HumanName.optional().describe('A name associated with the contact person'),\n    telecom: z.array(ContactPoint).optional().describe('A contact detail for the person'),\n    address: Address.optional().describe('Address for the contact person'),\n    gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender'),\n    organization: Reference.optional().describe('Organization that is associated with the contact'),\n    period: Period.optional().describe('The period during which this contact person or organization is valid to be contacted relating to this patient')\n  })).optional().describe('A contact party (e.g. guardian, partner, friend) for the patient'),\n  communication: z.array(z.object({\n    language: CodeableConcept.describe('The language which can be used to communicate with the patient about his or her health'),\n    preferred: FhirBoolean.optional().describe('Language preference indicator')\n  })).optional().describe('A language which may be used to communicate with the patient about his or her health'),\n  generalPractitioner: z.array(Reference).optional().describe('Patient\\'s nominated primary care provider'),\n  managingOrganization: Reference.optional().describe('Organization that is the custodian of the patient record'),\n  link: z.array(z.object({\n    other: Reference.describe('The other patient or related person resource that the link refers to'),\n    type: z.enum(['replaced-by', 'replaces', 'refer', 'seealso']).describe('The type of link between this patient resource and another patient resource')\n  })).optional().describe('Link to another patient resource that concerns the same actual person')\n}).describe('Patient resource - represents a person receiving health care services');\n\n/**\n * Observation resource - measurements and simple assertions made about a patient\n * This includes vital signs, lab results, and other clinical observations\n * \n * OUTLIER ANALYSIS FINDINGS:\n * - Status: 100% \"final\" in dataset (no other statuses observed)\n * - Categories: Laboratory (61.9%), Vital signs (27.0%), Survey (8.5%), Social history (2.5%)\n * - Value types: quantity (72.3%), codeableConcept (23.0%), missing (4.8%)\n * - Height outliers: Range 70.7-188.5 cm (some very short heights for adults)\n * - Weight range: 9.2-106.8 kg (includes pediatric patients)\n * - Heart rate: 60-100 bpm (normal clinical range)\n * - Some negative values are normal (e.g., bone density T-scores)\n * - Most common units: mg/dL, mmol/L, kg, /min, cm\n */\nexport const Observation = BaseResource.extend({\n  resourceType: z.literal('Observation').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business Identifier for observation'),\n  basedOn: z.array(Reference).optional().describe('Fulfills plan, proposal or order'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['registered', 'preliminary', 'final', 'amended', 'corrected', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the result value - In this synthetic dataset, 100% are \"final\"'),\n  category: z.array(CodeableConcept).optional().describe('Classification of type of observation'),\n  code: CodeableConcept.describe('Type of observation (code / type)'),\n  subject: Reference.optional().describe('Who and/or what the observation is about'),\n  focus: z.array(Reference).optional().describe('What the observation is about, when it is not about the subject of record'),\n  encounter: Reference.optional().describe('Healthcare event during which this observation is made'),\n  effectiveDateTime: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  effectivePeriod: Period.optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveTiming: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n      periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n    }).optional().describe('When the event is to occur')\n  }).optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveInstant: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  issued: FhirDateTime.optional().describe('Date/Time this version was made available'),\n  performer: z.array(Reference).optional().describe('Who is responsible for the observation'),\n  // Value types - observation can have different value types\n  valueQuantity: Quantity.optional().describe('Actual result - quantity'),\n  valueCodeableConcept: CodeableConcept.optional().describe('Actual result - codeable concept'),\n  valueString: FhirString.optional().describe('Actual result - string'),\n  valueBoolean: FhirBoolean.optional().describe('Actual result - boolean'),\n  valueInteger: z.number().int().optional().describe('Actual result - integer'),\n  valueRange: Range.optional().describe('Actual result - range'),\n  valueRatio: Ratio.optional().describe('Actual result - ratio'),\n  valueSampledData: z.object({\n    origin: Quantity.describe('Zero value and units'),\n    period: FhirDecimal.describe('Number of milliseconds between samples'),\n    factor: FhirDecimal.optional().describe('Multiply data by this before adding to origin'),\n    lowerLimit: FhirDecimal.optional().describe('Lower limit of detection'),\n    upperLimit: FhirDecimal.optional().describe('Upper limit of detection'),\n    dimensions: z.number().int().positive().describe('Number of sample points at each time point'),\n    data: FhirString.optional().describe('Decimal values with spaces, or \"E\" | \"U\" | \"L\"')\n  }).optional().describe('Actual result - sampled data'),\n  valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual result - time'),\n  valueDateTime: FhirDateTime.optional().describe('Actual result - datetime'),\n  valuePeriod: Period.optional().describe('Actual result - period'),\n  dataAbsentReason: CodeableConcept.optional().describe('Why the result is missing'),\n  interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n  note: z.array(Annotation).optional().describe('Comments about the observation'),\n  bodySite: CodeableConcept.optional().describe('Observed body part'),\n  method: CodeableConcept.optional().describe('How it was done'),\n  specimen: Reference.optional().describe('Specimen used for this observation'),\n  device: Reference.optional().describe('(Measurement) Device'),\n  referenceRange: z.array(z.object({\n    low: Quantity.optional().describe('Low Range, if relevant'),\n    high: Quantity.optional().describe('High Range, if relevant'),\n    type: CodeableConcept.optional().describe('Reference range qualifier'),\n    appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n    age: Range.optional().describe('Applicable age range, if relevant'),\n    text: FhirString.optional().describe('Text based reference range in an observation')\n  })).optional().describe('Provides guide for interpretation'),\n  hasMember: z.array(Reference).optional().describe('Related resource that belongs to the Observation group'),\n  derivedFrom: z.array(Reference).optional().describe('Related measurements the observation is made from'),\n  component: z.array(z.object({\n    code: CodeableConcept.describe('Type of component observation (code / type)'),\n    valueQuantity: Quantity.optional().describe('Actual component result - quantity'),\n    valueCodeableConcept: CodeableConcept.optional().describe('Actual component result - codeable concept'),\n    valueString: FhirString.optional().describe('Actual component result - string'),\n    valueBoolean: FhirBoolean.optional().describe('Actual component result - boolean'),\n    valueInteger: z.number().int().optional().describe('Actual component result - integer'),\n    valueRange: Range.optional().describe('Actual component result - range'),\n    valueRatio: Ratio.optional().describe('Actual component result - ratio'),\n    valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual component result - time'),\n    valueDateTime: FhirDateTime.optional().describe('Actual component result - datetime'),\n    valuePeriod: Period.optional().describe('Actual component result - period'),\n    dataAbsentReason: CodeableConcept.optional().describe('Why the component result is missing'),\n    interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n    referenceRange: z.array(z.object({\n      low: Quantity.optional().describe('Low Range, if relevant'),\n      high: Quantity.optional().describe('High Range, if relevant'),\n      type: CodeableConcept.optional().describe('Reference range qualifier'),\n      appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n      age: Range.optional().describe('Applicable age range, if relevant'),\n      text: FhirString.optional().describe('Text based reference range in an observation')\n    })).optional().describe('Provides guide for interpretation')\n  })).optional().describe('Component results - for panels and batteries')\n}).describe('Observation resource - measurements and simple assertions made about a patient');\n\n/**\n * Encounter resource - an interaction between a patient and healthcare provider\n * This includes hospital visits, clinic appointments, home visits, etc.\n */\nexport const Encounter = BaseResource.extend({\n  resourceType: z.literal('Encounter').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Identifier(s) by which this encounter is known'),\n  status: z.enum(['planned', 'arrived', 'triaged', 'in-progress', 'onleave', 'finished', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the encounter'),\n  statusHistory: z.array(z.object({\n    status: z.enum(['planned', 'arrived', 'triaged', 'in-progress', 'onleave', 'finished', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the encounter'),\n    period: Period.describe('The time that the episode was in the specified status')\n  })).optional().describe('List of past encounter statuses'),\n  class: Coding.describe('inpatient | outpatient | ambulatory | emergency +'),\n  classHistory: z.array(z.object({\n    class: Coding.describe('inpatient | outpatient | ambulatory | emergency +'),\n    period: Period.describe('The time that the episode was in the specified class')\n  })).optional().describe('List of past encounter classes'),\n  type: z.array(CodeableConcept).optional().describe('Specific type of encounter'),\n  serviceType: CodeableConcept.optional().describe('Specific type of service'),\n  priority: CodeableConcept.optional().describe('Indicates the urgency of the encounter'),\n  subject: Reference.optional().describe('The patient or group present at the encounter'),\n  episodeOfCare: z.array(Reference).optional().describe('Episode(s) of care that this encounter should be recorded against'),\n  basedOn: z.array(Reference).optional().describe('The ServiceRequest that initiated this encounter'),\n  participant: z.array(z.object({\n    type: z.array(CodeableConcept).optional().describe('Role of participant in encounter'),\n    period: Period.optional().describe('Period of time during the encounter that the participant participated'),\n    individual: Reference.optional().describe('Persons involved in the encounter other than the patient')\n  })).optional().describe('List of participants involved in the encounter'),\n  appointment: z.array(Reference).optional().describe('The appointment that scheduled this encounter'),\n  period: Period.optional().describe('The start and end time of the encounter'),\n  length: Quantity.optional().describe('Quantity of time the encounter lasted (less time absent)'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Coded reason the encounter takes place'),\n  reasonReference: z.array(Reference).optional().describe('Reason the encounter takes place (reference)'),\n  diagnosis: z.array(z.object({\n    condition: Reference.describe('The diagnosis or procedure relevant to the encounter'),\n    use: CodeableConcept.optional().describe('Role that this diagnosis has within the encounter'),\n    rank: z.number().int().positive().optional().describe('Ranking of the diagnosis (for each role type)')\n  })).optional().describe('The list of diagnosis relevant to this encounter'),\n  account: z.array(Reference).optional().describe('The set of accounts that may be used for billing for this Encounter'),\n  hospitalization: z.object({\n    preAdmissionIdentifier: Identifier.optional().describe('Pre-admission identifier'),\n    origin: Reference.optional().describe('The location/organization from which the patient came before admission'),\n    admitSource: CodeableConcept.optional().describe('From where patient was admitted (physician referral, transfer)'),\n    reAdmission: CodeableConcept.optional().describe('The type of hospital re-admission that has occurred'),\n    dietPreference: z.array(CodeableConcept).optional().describe('Diet preferences reported by the patient'),\n    specialCourtesy: z.array(CodeableConcept).optional().describe('Special courtesies (VIP, board member)'),\n    specialArrangement: z.array(CodeableConcept).optional().describe('Wheelchair, translator, stretcher, etc.'),\n    destination: Reference.optional().describe('Location/organization to which the patient is discharged'),\n    dischargeDisposition: CodeableConcept.optional().describe('Category or kind of location after discharge')\n  }).optional().describe('Details about the admission to a healthcare service'),\n  location: z.array(z.object({\n    location: Reference.describe('Location the encounter takes place'),\n    status: z.enum(['planned', 'active', 'reserved', 'completed']).optional().describe('The status of the participants\\' presence at the specified location'),\n    physicalType: CodeableConcept.optional().describe('The physical type of the location'),\n    period: Period.optional().describe('Time period during which the patient was present at the location')\n  })).optional().describe('List of locations where the patient has been'),\n  serviceProvider: Reference.optional().describe('The organization (facility) responsible for this encounter'),\n  partOf: Reference.optional().describe('Another Encounter this encounter is part of')\n}).describe('Encounter resource - an interaction between a patient and healthcare provider');\n\n/**\n * Condition resource - a clinical condition, problem, diagnosis, or other event\n * This includes diseases, injuries, disorders, and other health-related conditions\n */\nexport const Condition = BaseResource.extend({\n  resourceType: z.literal('Condition').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External Ids for this condition'),\n  clinicalStatus: CodeableConcept.optional().describe('active | recurrence | relapse | inactive | remission | resolved'),\n  verificationStatus: CodeableConcept.optional().describe('unconfirmed | provisional | differential | confirmed | refuted | entered-in-error'),\n  category: z.array(CodeableConcept).optional().describe('problem-list-item | encounter-diagnosis | health-concern'),\n  severity: CodeableConcept.optional().describe('Subjective severity of condition'),\n  code: CodeableConcept.optional().describe('Identification of the condition, problem or diagnosis'),\n  bodySite: z.array(CodeableConcept).optional().describe('Anatomical location, if relevant'),\n  subject: Reference.describe('Who has the condition?'),\n  encounter: Reference.optional().describe('Encounter created as part of'),\n  onsetDateTime: FhirDateTime.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetAge: Quantity.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetPeriod: Period.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetRange: Range.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetString: FhirString.optional().describe('Estimated or actual date, date-time, or age'),\n  abatementDateTime: FhirDateTime.optional().describe('When in resolution/remission'),\n  abatementAge: Quantity.optional().describe('When in resolution/remission'),\n  abatementPeriod: Period.optional().describe('When in resolution/remission'),\n  abatementRange: Range.optional().describe('When in resolution/remission'),\n  abatementString: FhirString.optional().describe('When in resolution/remission'),\n  recordedDate: FhirDateTime.optional().describe('Date record was first recorded'),\n  recorder: Reference.optional().describe('Who recorded the condition'),\n  asserter: Reference.optional().describe('Person who asserts this condition'),\n  stage: z.array(z.object({\n    summary: CodeableConcept.optional().describe('Simple summary (disease specific)'),\n    assessment: z.array(Reference).optional().describe('Formal record of assessment'),\n    type: CodeableConcept.optional().describe('Kind of staging')\n  })).optional().describe('Stage/grade, usually assessed formally'),\n  evidence: z.array(z.object({\n    code: z.array(CodeableConcept).optional().describe('Manifestation/symptom'),\n    detail: z.array(Reference).optional().describe('Supporting information found elsewhere')\n  })).optional().describe('Supporting evidence'),\n  note: z.array(Annotation).optional().describe('Additional information about the Condition')\n}).describe('Condition resource - a clinical condition, problem, diagnosis, or other event');\n\n/**\n * Procedure resource - an activity that is performed on, with, or for a patient\n * This in