[2025-07-10T09:59:37.315Z] [OUT] {"id":"1752141577315-dn2ii5ir1","timestamp":"2025-07-10T09:59:37.315Z","type":"file.updated","data":{"path":"typescript_code/src/schema/fhir-resources.ts","filename":"fhir-resources.ts","content":"import { z } from 'zod';\nimport {\n  FhirId, FhirUri, FhirDateTime, FhirDate, FhirDecimal, FhirBoolean, FhirCode, FhirString,\n  Coding, CodeableConcept, Quantity, Period, Identifier, HumanName, Address, ContactPoint,\n  Meta, Narrative, Reference, Extension, Attachment, Range, Ratio, Annotation, Dosage\n} from './fhir-datatypes';\n\n/**\n * Base Resource - all FHIR resources inherit from this\n */\nexport const BaseResource = z.object({\n  resourceType: FhirString.describe('The type of resource'),\n  id: FhirId.optional().describe('Logical id of this artifact'),\n  meta: Meta.optional().describe('Metadata about the resource'),\n  implicitRules: FhirUri.optional().describe('A set of rules under which this content was created'),\n  language: FhirCode.optional().describe('Language of the resource content'),\n  text: Narrative.optional().describe('Text summary of the resource, for human interpretation'),\n  contained: z.array(z.any()).optional().describe('Contained, inline Resources'),\n  extension: z.array(Extension).optional().describe('Additional content defined by implementations'),\n  modifierExtension: z.array(Extension).optional().describe('Extensions that cannot be ignored')\n}).describe('Base Resource - all FHIR resources inherit from this');\n\n/**\n * Patient resource - represents a person receiving health care services\n * This is the central resource in most healthcare scenarios\n * \n * SYNTHETIC DATA PATTERNS OBSERVED:\n * - All names follow FirstName[Number] LastName[Number] pattern (100% synthetic)\n * - 22.5% have unicode characters (Spanish names like José, María)\n * - All patients located in Boston, MA, US with NNNNN postal code pattern\n * - Birth dates span 1920-2022 (103 year range, includes future dates up to 2025)\n * - Average name lengths: ~9.5 chars first, ~9.7 chars last\n * - Max name lengths: 14 chars observed\n * - Gender distribution: 52.5% male, 47.5% female\n * - Marital status: \"Never Married\" most common, followed by \"Married\", \"Divorced\"\n * - Multiple identifier systems: Synthea, hospital MRN, SSN, state ID, passport\n */\nexport const Patient = BaseResource.extend({\n  resourceType: z.literal('Patient').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('An identifier for this patient'),\n  active: FhirBoolean.optional().describe('Whether this patient record is in active use'),\n  name: z.array(HumanName).optional().describe('A name associated with the patient'),\n  telecom: z.array(ContactPoint).optional().describe('A contact detail for the individual'),\n  gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender - In this synthetic dataset, only \"male\" and \"female\" values observed (52.5% male, 47.5% female)'),\n  birthDate: FhirDate.optional().describe('The date of birth for the individual'),\n  deceasedBoolean: FhirBoolean.optional().describe('Indicates if the individual is deceased or not'),\n  deceasedDateTime: FhirDateTime.optional().describe('Indicates if the individual is deceased or not'),\n  address: z.array(Address).optional().describe('An address for the individual'),\n  maritalStatus: CodeableConcept.optional().describe('Marital (civil) status of a patient'),\n  multipleBirthBoolean: FhirBoolean.optional().describe('Whether patient is part of a multiple birth'),\n  multipleBirthInteger: z.number().int().optional().describe('Whether patient is part of a multiple birth'),\n  photo: z.array(Attachment).optional().describe('Image of the patient'),\n  contact: z.array(z.object({\n    relationship: z.array(CodeableConcept).optional().describe('The kind of relationship'),\n    name: HumanName.optional().describe('A name associated with the contact person'),\n    telecom: z.array(ContactPoint).optional().describe('A contact detail for the person'),\n    address: Address.optional().describe('Address for the contact person'),\n    gender: z.enum(['male', 'female', 'other', 'unknown']).optional().describe('Administrative gender'),\n    organization: Reference.optional().describe('Organization that is associated with the contact'),\n    period: Period.optional().describe('The period during which this contact person or organization is valid to be contacted relating to this patient')\n  })).optional().describe('A contact party (e.g. guardian, partner, friend) for the patient'),\n  communication: z.array(z.object({\n    language: CodeableConcept.describe('The language which can be used to communicate with the patient about his or her health'),\n    preferred: FhirBoolean.optional().describe('Language preference indicator')\n  })).optional().describe('A language which may be used to communicate with the patient about his or her health'),\n  generalPractitioner: z.array(Reference).optional().describe('Patient\\'s nominated primary care provider'),\n  managingOrganization: Reference.optional().describe('Organization that is the custodian of the patient record'),\n  link: z.array(z.object({\n    other: Reference.describe('The other patient or related person resource that the link refers to'),\n    type: z.enum(['replaced-by', 'replaces', 'refer', 'seealso']).describe('The type of link between this patient resource and another patient resource')\n  })).optional().describe('Link to another patient resource that concerns the same actual person')\n}).describe('Patient resource - represents a person receiving health care services');\n\n/**\n * Observation resource - measurements and simple assertions made about a patient\n * This includes vital signs, lab results, and other clinical observations\n */\nexport const Observation = BaseResource.extend({\n  resourceType: z.literal('Observation').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business Identifier for observation'),\n  basedOn: z.array(Reference).optional().describe('Fulfills plan, proposal or order'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['registered', 'preliminary', 'final', 'amended', 'corrected', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the result value'),\n  category: z.array(CodeableConcept).optional().describe('Classification of type of observation'),\n  code: CodeableConcept.describe('Type of observation (code / type)'),\n  subject: Reference.optional().describe('Who and/or what the observation is about'),\n  focus: z.array(Reference).optional().describe('What the observation is about, when it is not about the subject of record'),\n  encounter: Reference.optional().describe('Healthcare event during which this observation is made'),\n  effectiveDateTime: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  effectivePeriod: Period.optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveTiming: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n      periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n    }).optional().describe('When the event is to occur')\n  }).optional().describe('Clinically relevant time/time-period for observation'),\n  effectiveInstant: FhirDateTime.optional().describe('Clinically relevant time/time-period for observation'),\n  issued: FhirDateTime.optional().describe('Date/Time this version was made available'),\n  performer: z.array(Reference).optional().describe('Who is responsible for the observation'),\n  // Value types - observation can have different value types\n  valueQuantity: Quantity.optional().describe('Actual result - quantity'),\n  valueCodeableConcept: CodeableConcept.optional().describe('Actual result - codeable concept'),\n  valueString: FhirString.optional().describe('Actual result - string'),\n  valueBoolean: FhirBoolean.optional().describe('Actual result - boolean'),\n  valueInteger: z.number().int().optional().describe('Actual result - integer'),\n  valueRange: Range.optional().describe('Actual result - range'),\n  valueRatio: Ratio.optional().describe('Actual result - ratio'),\n  valueSampledData: z.object({\n    origin: Quantity.describe('Zero value and units'),\n    period: FhirDecimal.describe('Number of milliseconds between samples'),\n    factor: FhirDecimal.optional().describe('Multiply data by this before adding to origin'),\n    lowerLimit: FhirDecimal.optional().describe('Lower limit of detection'),\n    upperLimit: FhirDecimal.optional().describe('Upper limit of detection'),\n    dimensions: z.number().int().positive().describe('Number of sample points at each time point'),\n    data: FhirString.optional().describe('Decimal values with spaces, or \"E\" | \"U\" | \"L\"')\n  }).optional().describe('Actual result - sampled data'),\n  valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual result - time'),\n  valueDateTime: FhirDateTime.optional().describe('Actual result - datetime'),\n  valuePeriod: Period.optional().describe('Actual result - period'),\n  dataAbsentReason: CodeableConcept.optional().describe('Why the result is missing'),\n  interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n  note: z.array(Annotation).optional().describe('Comments about the observation'),\n  bodySite: CodeableConcept.optional().describe('Observed body part'),\n  method: CodeableConcept.optional().describe('How it was done'),\n  specimen: Reference.optional().describe('Specimen used for this observation'),\n  device: Reference.optional().describe('(Measurement) Device'),\n  referenceRange: z.array(z.object({\n    low: Quantity.optional().describe('Low Range, if relevant'),\n    high: Quantity.optional().describe('High Range, if relevant'),\n    type: CodeableConcept.optional().describe('Reference range qualifier'),\n    appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n    age: Range.optional().describe('Applicable age range, if relevant'),\n    text: FhirString.optional().describe('Text based reference range in an observation')\n  })).optional().describe('Provides guide for interpretation'),\n  hasMember: z.array(Reference).optional().describe('Related resource that belongs to the Observation group'),\n  derivedFrom: z.array(Reference).optional().describe('Related measurements the observation is made from'),\n  component: z.array(z.object({\n    code: CodeableConcept.describe('Type of component observation (code / type)'),\n    valueQuantity: Quantity.optional().describe('Actual component result - quantity'),\n    valueCodeableConcept: CodeableConcept.optional().describe('Actual component result - codeable concept'),\n    valueString: FhirString.optional().describe('Actual component result - string'),\n    valueBoolean: FhirBoolean.optional().describe('Actual component result - boolean'),\n    valueInteger: z.number().int().optional().describe('Actual component result - integer'),\n    valueRange: Range.optional().describe('Actual component result - range'),\n    valueRatio: Ratio.optional().describe('Actual component result - ratio'),\n    valueTime: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$/).optional().describe('Actual component result - time'),\n    valueDateTime: FhirDateTime.optional().describe('Actual component result - datetime'),\n    valuePeriod: Period.optional().describe('Actual component result - period'),\n    dataAbsentReason: CodeableConcept.optional().describe('Why the component result is missing'),\n    interpretation: z.array(CodeableConcept).optional().describe('High, low, normal, etc.'),\n    referenceRange: z.array(z.object({\n      low: Quantity.optional().describe('Low Range, if relevant'),\n      high: Quantity.optional().describe('High Range, if relevant'),\n      type: CodeableConcept.optional().describe('Reference range qualifier'),\n      appliesTo: z.array(CodeableConcept).optional().describe('Reference range population'),\n      age: Range.optional().describe('Applicable age range, if relevant'),\n      text: FhirString.optional().describe('Text based reference range in an observation')\n    })).optional().describe('Provides guide for interpretation')\n  })).optional().describe('Component results - for panels and batteries')\n}).describe('Observation resource - measurements and simple assertions made about a patient');\n\n/**\n * Encounter resource - an interaction between a patient and healthcare provider\n * This includes hospital visits, clinic appointments, home visits, etc.\n */\nexport const Encounter = BaseResource.extend({\n  resourceType: z.literal('Encounter').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Identifier(s) by which this encounter is known'),\n  status: z.enum(['planned', 'arrived', 'triaged', 'in-progress', 'onleave', 'finished', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the encounter'),\n  statusHistory: z.array(z.object({\n    status: z.enum(['planned', 'arrived', 'triaged', 'in-progress', 'onleave', 'finished', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the encounter'),\n    period: Period.describe('The time that the episode was in the specified status')\n  })).optional().describe('List of past encounter statuses'),\n  class: Coding.describe('inpatient | outpatient | ambulatory | emergency +'),\n  classHistory: z.array(z.object({\n    class: Coding.describe('inpatient | outpatient | ambulatory | emergency +'),\n    period: Period.describe('The time that the episode was in the specified class')\n  })).optional().describe('List of past encounter classes'),\n  type: z.array(CodeableConcept).optional().describe('Specific type of encounter'),\n  serviceType: CodeableConcept.optional().describe('Specific type of service'),\n  priority: CodeableConcept.optional().describe('Indicates the urgency of the encounter'),\n  subject: Reference.optional().describe('The patient or group present at the encounter'),\n  episodeOfCare: z.array(Reference).optional().describe('Episode(s) of care that this encounter should be recorded against'),\n  basedOn: z.array(Reference).optional().describe('The ServiceRequest that initiated this encounter'),\n  participant: z.array(z.object({\n    type: z.array(CodeableConcept).optional().describe('Role of participant in encounter'),\n    period: Period.optional().describe('Period of time during the encounter that the participant participated'),\n    individual: Reference.optional().describe('Persons involved in the encounter other than the patient')\n  })).optional().describe('List of participants involved in the encounter'),\n  appointment: z.array(Reference).optional().describe('The appointment that scheduled this encounter'),\n  period: Period.optional().describe('The start and end time of the encounter'),\n  length: Quantity.optional().describe('Quantity of time the encounter lasted (less time absent)'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Coded reason the encounter takes place'),\n  reasonReference: z.array(Reference).optional().describe('Reason the encounter takes place (reference)'),\n  diagnosis: z.array(z.object({\n    condition: Reference.describe('The diagnosis or procedure relevant to the encounter'),\n    use: CodeableConcept.optional().describe('Role that this diagnosis has within the encounter'),\n    rank: z.number().int().positive().optional().describe('Ranking of the diagnosis (for each role type)')\n  })).optional().describe('The list of diagnosis relevant to this encounter'),\n  account: z.array(Reference).optional().describe('The set of accounts that may be used for billing for this Encounter'),\n  hospitalization: z.object({\n    preAdmissionIdentifier: Identifier.optional().describe('Pre-admission identifier'),\n    origin: Reference.optional().describe('The location/organization from which the patient came before admission'),\n    admitSource: CodeableConcept.optional().describe('From where patient was admitted (physician referral, transfer)'),\n    reAdmission: CodeableConcept.optional().describe('The type of hospital re-admission that has occurred'),\n    dietPreference: z.array(CodeableConcept).optional().describe('Diet preferences reported by the patient'),\n    specialCourtesy: z.array(CodeableConcept).optional().describe('Special courtesies (VIP, board member)'),\n    specialArrangement: z.array(CodeableConcept).optional().describe('Wheelchair, translator, stretcher, etc.'),\n    destination: Reference.optional().describe('Location/organization to which the patient is discharged'),\n    dischargeDisposition: CodeableConcept.optional().describe('Category or kind of location after discharge')\n  }).optional().describe('Details about the admission to a healthcare service'),\n  location: z.array(z.object({\n    location: Reference.describe('Location the encounter takes place'),\n    status: z.enum(['planned', 'active', 'reserved', 'completed']).optional().describe('The status of the participants\\' presence at the specified location'),\n    physicalType: CodeableConcept.optional().describe('The physical type of the location'),\n    period: Period.optional().describe('Time period during which the patient was present at the location')\n  })).optional().describe('List of locations where the patient has been'),\n  serviceProvider: Reference.optional().describe('The organization (facility) responsible for this encounter'),\n  partOf: Reference.optional().describe('Another Encounter this encounter is part of')\n}).describe('Encounter resource - an interaction between a patient and healthcare provider');\n\n/**\n * Condition resource - a clinical condition, problem, diagnosis, or other event\n * This includes diseases, injuries, disorders, and other health-related conditions\n */\nexport const Condition = BaseResource.extend({\n  resourceType: z.literal('Condition').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External Ids for this condition'),\n  clinicalStatus: CodeableConcept.optional().describe('active | recurrence | relapse | inactive | remission | resolved'),\n  verificationStatus: CodeableConcept.optional().describe('unconfirmed | provisional | differential | confirmed | refuted | entered-in-error'),\n  category: z.array(CodeableConcept).optional().describe('problem-list-item | encounter-diagnosis | health-concern'),\n  severity: CodeableConcept.optional().describe('Subjective severity of condition'),\n  code: CodeableConcept.optional().describe('Identification of the condition, problem or diagnosis'),\n  bodySite: z.array(CodeableConcept).optional().describe('Anatomical location, if relevant'),\n  subject: Reference.describe('Who has the condition?'),\n  encounter: Reference.optional().describe('Encounter created as part of'),\n  onsetDateTime: FhirDateTime.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetAge: Quantity.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetPeriod: Period.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetRange: Range.optional().describe('Estimated or actual date, date-time, or age'),\n  onsetString: FhirString.optional().describe('Estimated or actual date, date-time, or age'),\n  abatementDateTime: FhirDateTime.optional().describe('When in resolution/remission'),\n  abatementAge: Quantity.optional().describe('When in resolution/remission'),\n  abatementPeriod: Period.optional().describe('When in resolution/remission'),\n  abatementRange: Range.optional().describe('When in resolution/remission'),\n  abatementString: FhirString.optional().describe('When in resolution/remission'),\n  recordedDate: FhirDateTime.optional().describe('Date record was first recorded'),\n  recorder: Reference.optional().describe('Who recorded the condition'),\n  asserter: Reference.optional().describe('Person who asserts this condition'),\n  stage: z.array(z.object({\n    summary: CodeableConcept.optional().describe('Simple summary (disease specific)'),\n    assessment: z.array(Reference).optional().describe('Formal record of assessment'),\n    type: CodeableConcept.optional().describe('Kind of staging')\n  })).optional().describe('Stage/grade, usually assessed formally'),\n  evidence: z.array(z.object({\n    code: z.array(CodeableConcept).optional().describe('Manifestation/symptom'),\n    detail: z.array(Reference).optional().describe('Supporting information found elsewhere')\n  })).optional().describe('Supporting evidence'),\n  note: z.array(Annotation).optional().describe('Additional information about the Condition')\n}).describe('Condition resource - a clinical condition, problem, diagnosis, or other event');\n\n/**\n * Procedure resource - an activity that is performed on, with, or for a patient\n * This includes surgeries, therapies, diagnostic procedures, etc.\n */\nexport const Procedure = BaseResource.extend({\n  resourceType: z.literal('Procedure').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External Identifiers for this procedure'),\n  instantiatesCanonical: z.array(FhirUri).optional().describe('Instantiates FHIR protocol or definition'),\n  instantiatesUri: z.array(FhirUri).optional().describe('Instantiates external protocol or definition'),\n  basedOn: z.array(Reference).optional().describe('A request for this procedure'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['preparation', 'in-progress', 'not-done', 'on-hold', 'stopped', 'completed', 'entered-in-error', 'unknown']).describe('The status of the procedure'),\n  statusReason: CodeableConcept.optional().describe('Reason for current status'),\n  category: CodeableConcept.optional().describe('Classification of the procedure'),\n  code: CodeableConcept.optional().describe('Identification of the procedure'),\n  subject: Reference.describe('Who the procedure was performed on'),\n  encounter: Reference.optional().describe('Encounter created as part of'),\n  performedDateTime: FhirDateTime.optional().describe('When the procedure was performed'),\n  performedPeriod: Period.optional().describe('When the procedure was performed'),\n  performedString: FhirString.optional().describe('When the procedure was performed'),\n  performedAge: Quantity.optional().describe('When the procedure was performed'),\n  performedRange: Range.optional().describe('When the procedure was performed'),\n  recorder: Reference.optional().describe('Who recorded the procedure'),\n  asserter: Reference.optional().describe('Person who asserts this procedure'),\n  performer: z.array(z.object({\n    function: CodeableConcept.optional().describe('Type of performance'),\n    actor: Reference.describe('The reference to the practitioner'),\n    onBehalfOf: Reference.optional().describe('Organization the device or practitioner was acting for')\n  })).optional().describe('The people who performed the procedure'),\n  location: Reference.optional().describe('Where the procedure happened'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Coded reason procedure performed'),\n  reasonReference: z.array(Reference).optional().describe('The justification that the procedure was performed'),\n  bodySite: z.array(CodeableConcept).optional().describe('Target body sites'),\n  outcome: CodeableConcept.optional().describe('The result of procedure'),\n  report: z.array(Reference).optional().describe('Any report resulting from the procedure'),\n  complication: z.array(CodeableConcept).optional().describe('Complication following the procedure'),\n  complicationDetail: z.array(Reference).optional().describe('A condition that is a result of the procedure'),\n  followUp: z.array(CodeableConcept).optional().describe('Instructions for follow up'),\n  note: z.array(Annotation).optional().describe('Additional information about the procedure'),\n  focalDevice: z.array(z.object({\n    action: CodeableConcept.optional().describe('Kind of change to device'),\n    manipulated: Reference.describe('Device that was changed')\n  })).optional().describe('Manipulated, implanted, or removed device'),\n  usedReference: z.array(Reference).optional().describe('Items used during procedure'),\n  usedCode: z.array(CodeableConcept).optional().describe('Coded items used during procedure')\n}).describe('Procedure resource - an activity that is performed on, with, or for a patient');\n\n/**\n * MedicationRequest resource - an order or request for both supply and administration of a medication\n * This includes prescriptions, medication orders, etc.\n */\nexport const MedicationRequest = BaseResource.extend({\n  resourceType: z.literal('MedicationRequest').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External ids for this request'),\n  status: z.enum(['active', 'on-hold', 'cancelled', 'completed', 'entered-in-error', 'stopped', 'draft', 'unknown']).describe('The status of the medication request'),\n  statusReason: CodeableConcept.optional().describe('Reason for current status'),\n  intent: z.enum(['proposal', 'plan', 'order', 'original-order', 'reflex-order', 'filler-order', 'instance-order', 'option']).describe('The intent of the medication request'),\n  category: z.array(CodeableConcept).optional().describe('Type of medication usage'),\n  priority: z.enum(['routine', 'urgent', 'asap', 'stat']).optional().describe('Indicates how quickly the Medication Request should be addressed'),\n  doNotPerform: FhirBoolean.optional().describe('True if request is prohibiting action'),\n  reportedBoolean: FhirBoolean.optional().describe('Reported rather than primary record'),\n  reportedReference: Reference.optional().describe('Reported rather than primary record'),\n  medicationCodeableConcept: CodeableConcept.optional().describe('Medication to be taken'),\n  medicationReference: Reference.optional().describe('Medication to be taken'),\n  subject: Reference.describe('Who or group medication request is for'),\n  encounter: Reference.optional().describe('Encounter created as part of encounter'),\n  supportingInformation: z.array(Reference).optional().describe('Information to support ordering of the medication'),\n  authoredOn: FhirDateTime.optional().describe('When request was initially authored'),\n  requester: Reference.optional().describe('Who/What requested the Request'),\n  performer: Reference.optional().describe('Intended performer of administration'),\n  performerType: CodeableConcept.optional().describe('Desired kind of performer of the medication administration'),\n  recorder: Reference.optional().describe('Person who entered the request'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Reason or indication for ordering or not ordering the medication'),\n  reasonReference: z.array(Reference).optional().describe('Condition or observation that supports why the prescription is being written'),\n  instantiatesCanonical: z.array(FhirUri).optional().describe('Instantiates FHIR protocol or definition'),\n  instantiatesUri: z.array(FhirUri).optional().describe('Instantiates external protocol or definition'),\n  basedOn: z.array(Reference).optional().describe('What request fulfills'),\n  groupIdentifier: Identifier.optional().describe('Composite request this is part of'),\n  courseOfTherapyType: CodeableConcept.optional().describe('Overall pattern of medication administration'),\n  insurance: