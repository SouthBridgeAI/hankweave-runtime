[2025-07-10T09:45:24.934Z] [OUT] {"id":"1752140724934-b8lxzz70g","timestamp":"2025-07-10T09:45:24.934Z","type":"file.updated","data":{"path":"typescript_code/src/schema/fhir-bundle.ts","filename":"fhir-bundle.ts","content":"import { z } from 'zod';\nimport { FhirId, FhirUri, FhirString, Meta, Narrative, Extension, Identifier } from './fhir-datatypes';\nimport { Resource } from './fhir-resources';\n\n/**\n * Bundle Entry - each entry in a FHIR Bundle\n * Contains the resource and metadata about how it should be processed\n */\nexport const BundleEntry = z.object({\n  // Links\n  fullUrl: FhirUri.optional().describe('URI for resource (Absolute or relative)'),\n  \n  // Resource contained in the entry\n  resource: Resource.optional().describe('A resource in the bundle'),\n  \n  // Search related information\n  search: z.object({\n    mode: z.enum(['match', 'include', 'outcome']).optional().describe('Why this entry is in the result set'),\n    score: z.number().optional().describe('Search ranking (between 0 and 1)')\n  }).optional().describe('Search related information'),\n  \n  // Request information for transaction/batch bundles\n  request: z.object({\n    method: z.enum(['GET', 'HEAD', 'POST', 'PUT', 'DELETE', 'PATCH']).describe('HTTP method for the request'),\n    url: FhirUri.describe('URL for HTTP equivalent of this entry'),\n    ifNoneMatch: FhirString.optional().describe('For managing cache currency'),\n    ifModifiedSince: z.string().optional().describe('For managing cache currency'),\n    ifMatch: FhirString.optional().describe('For managing update contention'),\n    ifNoneExist: FhirString.optional().describe('For conditional creates')\n  }).optional().describe('Additional execution information for transaction/batch'),\n  \n  // Response information for transaction/batch bundles\n  response: z.object({\n    status: FhirString.describe('Status response code (text optional)'),\n    location: FhirUri.optional().describe('The location (if the operation returns a location)'),\n    etag: FhirString.optional().describe('The Etag for the resource (if relevant)'),\n    lastModified: z.string().optional().describe('Server\\'s date time modified'),\n    outcome: Resource.optional().describe('OperationOutcome with hints and warnings')\n  }).optional().describe('Results of execution for transaction/batch')\n}).describe('Bundle Entry - each entry in a FHIR Bundle');\n\n/**\n * Bundle Link - links between bundles for navigation\n * Used for pagination and related bundles\n */\nexport const BundleLink = z.object({\n  relation: FhirString.describe('See http://www.iana.org/assignments/link-relations/link-relations.xhtml#link-relations-1'),\n  url: FhirUri.describe('Reference details for the link')\n}).describe('Bundle Link - links between bundles for navigation');\n\n/**\n * FHIR Bundle - a container for a collection of resources\n * \n * This is the top-level container for all FHIR transactions in our dataset.\n * Each patient file is a Bundle containing all their medical records.\n * \n * Bundle Types in our dataset:\n * - \"transaction\": All bundles in our dataset are transaction bundles\n * - This means they represent a set of actions to be performed as a single atomic operation\n * \n * Key characteristics observed in our data:\n * - Each bundle represents one patient's complete medical history\n * - Contains 31 to 22,049 entries per patient\n * - Entries include Patient, Observations, Encounters, Conditions, etc.\n * - All entries have fullUrl and request fields for transaction processing\n * - Generated by Synthea synthetic health data generator\n * \n * File size correlation:\n * - Newborn patients: ~30-50 entries, ~65KB files\n * - Adult patients: 1,500-22,000 entries, 5-57MB files\n * - Size correlates with patient age and medical complexity\n */\nexport const Bundle = z.object({\n  // Base Resource fields\n  resourceType: z.literal('Bundle').describe('Resource type - always \"Bundle\"'),\n  id: FhirId.optional().describe('Logical id of this artifact'),\n  meta: Meta.optional().describe('Metadata about the resource'),\n  implicitRules: FhirUri.optional().describe('A set of rules under which this content was created'),\n  language: z.string().optional().describe('Language of the resource content'),\n  \n  // Bundle-specific fields\n  identifier: Identifier.optional().describe('Persistent identifier for the bundle'),\n  \n  /**\n   * Bundle type - indicates how the bundle is intended to be processed\n   * In our dataset, all bundles are \"transaction\" type\n   * \n   * FHIR Bundle types:\n   * - document: Document bundle\n   * - message: Message bundle\n   * - transaction: Transaction bundle (our data)\n   * - transaction-response: Transaction response bundle\n   * - batch: Batch bundle\n   * - batch-response: Batch response bundle\n   * - history: History bundle\n   * - searchset: Search result bundle\n   * - collection: Collection bundle\n   */\n  type: z.enum([\n    'document',\n    'message', \n    'transaction',\n    'transaction-response',\n    'batch',\n    'batch-response',\n    'history',\n    'searchset',\n    'collection'\n  ]).describe('Bundle type - how the bundle is intended to be processed'),\n  \n  /**\n   * When the bundle was assembled\n   * Not present in our synthetic data, but included for completeness\n   */\n  timestamp: z.string().optional().describe('When the bundle was assembled'),\n  \n  /**\n   * Total number of matches for search bundles\n   * Not applicable to our transaction bundles\n   */\n  total: z.number().int().nonnegative().optional().describe('If search, the total number of matches'),\n  \n  /**\n   * Links for navigation between bundles\n   * Used for pagination in search results\n   * Not present in our transaction bundles\n   */\n  link: z.array(BundleLink).optional().describe('Links related to this Bundle'),\n  \n  /**\n   * The entries in the bundle\n   * This is the core of our data - contains all the patient's medical records\n   * \n   * In our dataset:\n   * - Always present (required for transaction bundles)\n   * - Contains 31 to 22,049 entries per patient\n   * - First entry is always Patient resource\n   * - Last entry is always Provenance resource\n   * - Middle entries are medical records (Observations, Encounters, etc.)\n   * \n   * Entry structure:\n   * - fullUrl: UUID for the resource\n   * - resource: The actual FHIR resource\n   * - request: HTTP method and URL for transaction processing\n   */\n  entry: z.array(BundleEntry).describe('Entry in the bundle - will have a resource or information'),\n  \n  /**\n   * Digital signature for the bundle\n   * Not present in our synthetic data\n   */\n  signature: z.object({\n    type: z.array(z.object({\n      system: FhirUri.optional(),\n      code: z.string().optional(),\n      display: FhirString.optional()\n    })).describe('Indication of the reason the entity signed the object(s)'),\n    when: z.string().describe('When the signature was created'),\n    who: z.object({\n      reference: FhirString.optional(),\n      display: FhirString.optional()\n    }).describe('Who signed'),\n    onBehalfOf: z.object({\n      reference: FhirString.optional(),\n      display: FhirString.optional()\n    }).optional().describe('The party represented'),\n    targetFormat: z.string().optional().describe('The technical format of the signed resources'),\n    sigFormat: z.string().optional().describe('The technical format of the signature'),\n    data: z.string().optional().describe('The actual signature content')\n  }).optional().describe('Digital Signature')\n}).describe('FHIR Bundle - a container for a collection of resources');\n\n/**\n * Specific schema for Transaction Bundles in our dataset\n * This is more restrictive than the general Bundle schema\n */\nexport const TransactionBundle = Bundle.extend({\n  type: z.literal('transaction').describe('Bundle type - always \"transaction\" in our dataset'),\n  entry: z.array(BundleEntry).min(1).describe('Entry in the bundle - always has at least one entry in our data'),\n  // Note: timestamp and total are not used in transaction bundles\n  timestamp: z.undefined().optional(),\n  total: z.undefined().optional(),\n  link: z.undefined().optional()\n}).describe('Transaction Bundle - specific to our synthetic patient data');\n\n/**\n * Type exports for TypeScript usage\n */\nexport type BundleType = z.infer<typeof Bundle>;\nexport type TransactionBundleType = z.infer<typeof TransactionBundle>;\nexport type BundleEntryType = z.infer<typeof BundleEntry>;\nexport type BundleLinkType = z.infer<typeof BundleLink>;\n\n/**\n * Validation helper for transaction bundles\n * Includes additional business logic validation specific to our dataset\n */\nexport const validateTransactionBundle = (data: unknown) => {\n  const result = TransactionBundle.safeParse(data);\n  \n  if (!result.success) {\n    return result;\n  }\n  \n  const bundle = result.data;\n  \n  // Additional validation for our specific dataset\n  const errors: string[] = [];\n  \n  // Check that first entry is Patient\n  if (bundle.entry.length > 0 && bundle.entry[0].resource?.resourceType !== 'Patient') {\n    errors.push('First entry must be a Patient resource');\n  }\n  \n  // Check that all entries have fullUrl for transaction bundles\n  for (let i = 0; i < bundle.entry.length; i++) {\n    const entry = bundle.entry[i];\n    if (!entry.fullUrl) {\n      errors.push(`Entry ${i} missing fullUrl (required for transaction bundles)`);\n    }\n    if (!entry.request) {\n      errors.push(`Entry ${i} missing request (required for transaction bundles)`);\n    }\n  }\n  \n  // Check for duplicate resource IDs\n  const resourceIds = new Set<string>();\n  for (let i = 0; i < bundle.entry.length; i++) {\n    const entry = bundle.entry[i];\n    if (entry.resource?.id) {\n      if (resourceIds.has(entry.resource.id)) {\n        errors.push(`Duplicate resource ID: ${entry.resource.id}`);\n      }\n      resourceIds.add(entry.resource.id);\n    }\n  }\n  \n  if (errors.length > 0) {\n    return {\n      success: false,\n      error: {\n        issues: errors.map(error => ({ message: error }))\n      }\n    };\n  }\n  \n  return result;\n};\n\n/**\n * Helper function to extract patient from bundle\n */\nexport const extractPatientFromBundle = (bundle: BundleType) => {\n  const patientEntry = bundle.entry.find(entry => entry.resource?.resourceType === 'Patient');\n  return patientEntry?.resource;\n};\n\n/**\n * Helper function to get resource counts by type\n */\nexport const getResourceCounts = (bundle: BundleType) => {\n  const counts: Record<string, number> = {};\n  \n  for (const entry of bundle.entry) {\n    if (entry.resource?.resourceType) {\n      const resourceType = entry.resource.resourceType;\n      counts[resourceType] = (counts[resourceType] || 0) + 1;\n    }\n  }\n  \n  return counts;\n};\n\n/**\n * Helper function to extract all resources of a specific type\n */\nexport const extractResourcesByType = <T extends string>(bundle: BundleType, resourceType: T) => {\n  return bundle.entry\n    .filter(entry => entry.resource?.resourceType === resourceType)\n    .map(entry => entry.resource)\n    .filter(resource => resource !== undefined);\n};","action":"modified"}}
