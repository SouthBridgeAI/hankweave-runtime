ctivity is occurring'),\n  activity: CodeableConcept.optional().describe('Activity that occurred'),\n  agent: z.array(z.object({\n    type: CodeableConcept.optional().describe('How the agent participated'),\n    role: z.array(CodeableConcept).optional().describe('What the agents role was'),\n    who: Reference.describe('Who participated'),\n    onBehalfOf: Reference.optional().describe('Who the agent is representing')\n  })).describe('Actor involved'),\n  entity: z.array(z.object({\n    role: z.enum(['derivation', 'revision', 'quotation', 'source', 'removal']).describe('How the entity was used during the activity'),\n    what: Reference.describe('Identity of entity'),\n    agent: z.array(z.object({\n      type: CodeableConcept.optional().describe('How the agent participated'),\n      role: z.array(CodeableConcept).optional().describe('What the agents role was'),\n      who: Reference.describe('Who participated'),\n      onBehalfOf: Reference.optional().describe('Who the agent is representing')\n    })).optional().describe('Entity is attributed to this agent')\n  })).optional().describe('An entity used in this activity'),\n  signature: z.array(z.object({\n    type: z.array(Coding).describe('Indication of the reason the entity signed the object(s)'),\n    when: FhirDateTime.describe('When the signature was created'),\n    who: Reference.describe('Who signed'),\n    onBehalfOf: Reference.optional().describe('The party represented'),\n    targetFormat: FhirCode.optional().describe('The technical format of the signed resources'),\n    sigFormat: FhirCode.optional().describe('The technical format of the signature'),\n    data: z.string().optional().describe('The actual signature content (XML DigSig. JWS, picture, etc.)')\n  })).optional().describe('Signature on target')\n}).describe('Provenance resource - who, what, when, where, why');\n\n/**\n * Union type for all supported FHIR resources\n */\nexport const Resource = z.union([\n  Patient,\n  Observation,\n  Encounter,\n  Condition,\n  Procedure,\n  MedicationRequest,\n  DiagnosticReport,\n  Immunization,\n  Claim,\n  ExplanationOfBenefit,\n  DocumentReference,\n  Provenance\n]).describe('Union of all supported FHIR resources');\n\n// Export all individual resource types for use in other modules\nexport type PatientType = z.infer<typeof Patient>;\nexport type ObservationType = z.infer<typeof Observation>;\nexport type EncounterType = z.infer<typeof Encounter>;\nexport type ConditionType = z.infer<typeof Condition>;\nexport type ProcedureType = z.infer<typeof Procedure>;\nexport type MedicationRequestType = z.infer<typeof MedicationRequest>;\nexport type DiagnosticReportType = z.infer<typeof DiagnosticReport>;\nexport type ImmunizationType = z.infer<typeof Immunization>;\nexport type ClaimType = z.infer<typeof Claim>;\nexport type ExplanationOfBenefitType = z.infer<typeof ExplanationOfBenefit>;\nexport type DocumentReferenceType = z.infer<typeof DocumentReference>;\nexport type ProvenanceType = z.infer<typeof Provenance>;\nexport type ResourceType = z.infer<typeof Resource>;"}}}
