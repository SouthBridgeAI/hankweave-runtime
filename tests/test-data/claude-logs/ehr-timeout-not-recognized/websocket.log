[2025-07-10T09:55:15.050Z] [OUT] {"id":"1752141315050-u8kdbqx56","timestamp":"2025-07-10T09:55:15.050Z","type":"file.updated","data":{"path":"typescript_code/src/quick-and-dirty/observation-outliers.ts","filename":"observation-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { ObservationType } from '../schema';\n\ninterface ObservationAnalysis {\n  totalObservations: number;\n  statusDistribution: Record<string, number>;\n  categoryDistribution: Record<string, number>;\n  valueTypes: {\n    quantity: number;\n    string: number;\n    boolean: number;\n    codeableConcept: number;\n    missing: number;\n  };\n  vitalSigns: {\n    height: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    weight: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    bloodPressure: { \n      systolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n      diastolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n    };\n    heartRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    temperature: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    respiratoryRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n  };\n  labValues: {\n    cholesterol: { values: number[]; outliers: Array<{value: number, file: string}> };\n    glucose: { values: number[]; outliers: Array<{value: number, file: string}> };\n    hemoglobin: { values: number[]; outliers: Array<{value: number, file: string}> };\n  };\n  codePatterns: Record<string, number>;\n  unitPatterns: Record<string, number>;\n  extremeValues: Array<{type: string, value: number, unit: string, file: string}>;\n}\n\nfunction detectOutliers(values: number[]): { outliers: number[]; q1: number; q3: number; iqr: number } {\n  if (values.length === 0) return { outliers: [], q1: 0, q3: 0, iqr: 0 };\n  \n  const sorted = [...values].sort((a, b) => a - b);\n  const q1Index = Math.floor(sorted.length * 0.25);\n  const q3Index = Math.floor(sorted.length * 0.75);\n  const q1 = sorted[q1Index];\n  const q3 = sorted[q3Index];\n  const iqr = q3 - q1;\n  const lowerBound = q1 - 1.5 * iqr;\n  const upperBound = q3 + 1.5 * iqr;\n  \n  const outliers = values.filter(v => v < lowerBound || v > upperBound);\n  return { outliers, q1, q3, iqr };\n}\n\nasync function analyzeObservations() {\n  console.log('=== Observation Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 10), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing observations in ${sampleFiles.length} files...`);\n  \n  const analysis: ObservationAnalysis = {\n    totalObservations: 0,\n    statusDistribution: {},\n    categoryDistribution: {},\n    valueTypes: {\n      quantity: 0,\n      string: 0,\n      boolean: 0,\n      codeableConcept: 0,\n      missing: 0\n    },\n    vitalSigns: {\n      height: { values: [], unit: '', outliers: [] },\n      weight: { values: [], unit: '', outliers: [] },\n      bloodPressure: { \n        systolic: { values: [], outliers: [] },\n        diastolic: { values: [], outliers: [] }\n      },\n      heartRate: { values: [], unit: '', outliers: [] },\n      temperature: { values: [], unit: '', outliers: [] },\n      respiratoryRate: { values: [], unit: '', outliers: [] }\n    },\n    labValues: {\n      cholesterol: { values: [], outliers: [] },\n      glucose: { values: [], outliers: [] },\n      hemoglobin: { values: [], outliers: [] }\n    },\n    codePatterns: {},\n    unitPatterns: {},\n    extremeValues: []\n  };\n  \n  const heightCodes = ['8302-2', '3137-7'];\n  const weightCodes = ['29463-7', '3141-9'];\n  const bpCodes = ['85354-9', '8480-6', '8462-4']; // BP panel, systolic, diastolic\n  const heartRateCodes = ['8867-4'];\n  const temperatureCodes = ['8310-5'];\n  const respiratoryCodes = ['9279-1'];\n  const cholesterolCodes = ['2093-3', '14647-2'];\n  const glucoseCodes = ['2339-0', '33747-0'];\n  const hemoglobinCodes = ['718-7'];\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const observations = extractResourcesByType(result.bundle, 'Observation') as ObservationType[];\n      \n      for (const obs of observations) {\n        analysis.totalObservations++;\n        \n        // Analyze status\n        if (obs.status) {\n          analysis.statusDistribution[obs.status] = \n            (analysis.statusDistribution[obs.status] || 0) + 1;\n        }\n        \n        // Analyze category\n        if (obs.category?.[0]?.coding?.[0]?.display) {\n          const category = obs.category[0].coding[0].display;\n          analysis.categoryDistribution[category] = \n            (analysis.categoryDistribution[category] || 0) + 1;\n        }\n        \n        // Analyze value types\n        if (obs.valueQuantity) {\n          analysis.valueTypes.quantity++;\n          \n          const value = obs.valueQuantity.value;\n          const unit = obs.valueQuantity.unit || obs.valueQuantity.code || '';\n          const code = obs.code.coding?.[0]?.code;\n          \n          if (value !== undefined && code) {\n            // Track units\n            if (unit) {\n              analysis.unitPatterns[unit] = (analysis.unitPatterns[unit] || 0) + 1;\n            }\n            \n            // Categorize vital signs\n            if (heightCodes.includes(code)) {\n              analysis.vitalSigns.height.values.push(value);\n              analysis.vitalSigns.height.unit = unit;\n            } else if (weightCodes.includes(code)) {\n              analysis.vitalSigns.weight.values.push(value);\n              analysis.vitalSigns.weight.unit = unit;\n            } else if (code === '8480-6') { // Systolic BP\n              analysis.vitalSigns.bloodPressure.systolic.values.push(value);\n            } else if (code === '8462-4') { // Diastolic BP\n              analysis.vitalSigns.bloodPressure.diastolic.values.push(value);\n            } else if (heartRateCodes.includes(code)) {\n              analysis.vitalSigns.heartRate.values.push(value);\n              analysis.vitalSigns.heartRate.unit = unit;\n            } else if (temperatureCodes.includes(code)) {\n              analysis.vitalSigns.temperature.values.push(value);\n              analysis.vitalSigns.temperature.unit = unit;\n            } else if (respiratoryCodes.includes(code)) {\n              analysis.vitalSigns.respiratoryRate.values.push(value);\n              analysis.vitalSigns.respiratoryRate.unit = unit;\n            } else if (cholesterolCodes.includes(code)) {\n              analysis.labValues.cholesterol.values.push(value);\n            } else if (glucoseCodes.includes(code)) {\n              analysis.labValues.glucose.values.push(value);\n            } else if (hemoglobinCodes.includes(code)) {\n              analysis.labValues.hemoglobin.values.push(value);\n            }\n            \n            // Track extreme values\n            if (value > 10000 || value < 0) {\n              analysis.extremeValues.push({\n                type: obs.code.text || obs.code.coding?.[0]?.display || 'Unknown',\n                value,\n                unit,\n                file: fileName\n              });\n            }\n          }\n        } else if (obs.valueString) {\n          analysis.valueTypes.string++;\n        } else if (obs.valueBoolean !== undefined) {\n          analysis.valueTypes.boolean++;\n        } else if (obs.valueCodeableConcept) {\n          analysis.valueTypes.codeableConcept++;\n        } else {\n          analysis.valueTypes.missing++;\n        }\n        \n        // Analyze codes\n        if (obs.code.coding?.[0]?.code) {\n          const code = obs.code.coding[0].code;\n          analysis.codePatterns[code] = (analysis.codePatterns[code] || 0) + 1;\n        }\n      }\n      \n    } catch (error) {\n      console.error(`Error analyzing observations in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers for vital signs\n  const detectVitalOutliers = (values: number[], type: string, fileName: string) => {\n    const { outliers } = detectOutliers(values);\n    return outliers.map(value => ({ value, file: fileName }));\n  };\n  \n  // Find outliers for each vital sign type\n  analysis.vitalSigns.height.outliers = detectVitalOutliers(analysis.vitalSigns.height.values, 'height', 'multiple');\n  analysis.vitalSigns.weight.outliers = detectVitalOutliers(analysis.vitalSigns.weight.values, 'weight', 'multiple');\n  analysis.vitalSigns.bloodPressure.systolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.systolic.values, 'systolic', 'multiple');\n  analysis.vitalSigns.bloodPressure.diastolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.diastolic.values, 'diastolic', 'multiple');\n  analysis.vitalSigns.heartRate.outliers = detectVitalOutliers(analysis.vitalSigns.heartRate.values, 'heartRate', 'multiple');\n  analysis.vitalSigns.temperature.outliers = detectVitalOutliers(analysis.vitalSigns.temperature.values, 'temperature', 'multiple');\n  analysis.vitalSigns.respiratoryRate.outliers = detectVitalOutliers(analysis.vitalSigns.respiratoryRate.values, 'respiratoryRate', 'multiple');\n  \n  // Print results\n  console.log(`\\n=== OBSERVATION ANALYSIS RESULTS ===`);\n  console.log(`Total observations analyzed: ${analysis.totalObservations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nCATEGORY DISTRIBUTION:');\n  Object.entries(analysis.categoryDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([category, count]) => \n      console.log(`- ${category}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVALUE TYPES:');\n  Object.entries(analysis.valueTypes)\n    .forEach(([type, count]) => \n      console.log(`- ${type}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVITAL SIGNS ANALYSIS:');\n  \n  // Height analysis\n  if (analysis.vitalSigns.height.values.length > 0) {\n    const heights = analysis.vitalSigns.height.values;\n    console.log(`- Height (${analysis.vitalSigns.height.unit}): ${heights.length} measurements`);\n    console.log(`  Range: ${Math.min(...heights).toFixed(1)} - ${Math.max(...heights).toFixed(1)}`);\n    console.log(`  Mean: ${(heights.reduce((a, b) => a + b, 0) / heights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.height.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.height.outliers.length}`);\n      analysis.vitalSigns.height.outliers.slice(0, 3).forEach(o => \n        console.log(`    ${o.value} ${analysis.vitalSigns.height.unit}`));\n    }\n  }\n  \n  // Weight analysis\n  if (analysis.vitalSigns.weight.values.length > 0) {\n    const weights = analysis.vitalSigns.weight.values;\n    console.log(`- Weight (${analysis.vitalSigns.weight.unit}): ${weights.length} measurements`);\n    console.log(`  Range: ${Math.min(...weights).toFixed(1)} - ${Math.max(...weights).toFixed(1)}`);\n    console.log(`  Mean: ${(weights.reduce((a, b) => a + b, 0) / weights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.weight.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.weight.outliers.length}`);\n    }\n  }\n  \n  // Blood pressure analysis\n  if (analysis.vitalSigns.bloodPressure.systolic.values.length > 0) {\n    const systolic = analysis.vitalSigns.bloodPressure.systolic.values;\n    const diastolic = analysis.vitalSigns.bloodPressure.diastolic.values;\n    console.log(`- Blood Pressure (mmHg): ${systolic.length} systolic, ${diastolic.length} diastolic`);\n    console.log(`  Systolic range: ${Math.min(...systolic)} - ${Math.max(...systolic)}`);\n    if (diastolic.length > 0) {\n      console.log(`  Diastolic range: ${Math.min(...diastolic)} - ${Math.max(...diastolic)}`);\n    }\n    if (analysis.vitalSigns.bloodPressure.systolic.outliers.length > 0) {\n      console.log(`  Systolic outliers: ${analysis.vitalSigns.bloodPressure.systolic.outliers.length}`);\n    }\n  }\n  \n  // Heart rate analysis\n  if (analysis.vitalSigns.heartRate.values.length > 0) {\n    const hr = analysis.vitalSigns.heartRate.values;\n    console.log(`- Heart Rate (${analysis.vitalSigns.heartRate.unit}): ${hr.length} measurements`);\n    console.log(`  Range: ${Math.min(...hr)} - ${Math.max(...hr)}`);\n    console.log(`  Mean: ${(hr.reduce((a, b) => a + b, 0) / hr.length).toFixed(1)}`);\n  }\n  \n  console.log('\\nMOST COMMON OBSERVATION CODES:');\n  Object.entries(analysis.codePatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([code, count]) => console.log(`- ${code}: ${count}`));\n  \n  console.log('\\nMOST COMMON UNITS:');\n  Object.entries(analysis.unitPatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  if (analysis.extremeValues.length > 0) {\n    console.log('\\nEXTREME VALUES (>10000 or <0):');\n    analysis.extremeValues.slice(0, 10).forEach(extreme => \n      console.log(`- ${extreme.type}: ${extreme.value} ${extreme.unit} (${extreme.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeObservations().catch(console.error);\n}\n\nexport { analyzeObservations };","action":"created"}}
[2025-07-10T09:55:15.052Z] [OUT] {"id":"1752141315052-gts7a2uc2","timestamp":"2025-07-10T09:55:15.052Z","type":"assistant.action","data":{"phaseId":"phase-2a","action":"tool_use","content":"","toolName":"Write","toolInput":{"file_path":"/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/typescript_code/src/quick-and-dirty/observation-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { ObservationType } from '../schema';\n\ninterface ObservationAnalysis {\n  totalObservations: number;\n  statusDistribution: Record<string, number>;\n  categoryDistribution: Record<string, number>;\n  valueTypes: {\n    quantity: number;\n    string: number;\n    boolean: number;\n    codeableConcept: number;\n    missing: number;\n  };\n  vitalSigns: {\n    height: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    weight: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    bloodPressure: { \n      systolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n      diastolic: { values: number[]; outliers: Array<{value: number, file: string}> };\n    };\n    heartRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    temperature: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n    respiratoryRate: { values: number[]; unit: string; outliers: Array<{value: number, file: string}> };\n  };\n  labValues: {\n    cholesterol: { values: number[]; outliers: Array<{value: number, file: string}> };\n    glucose: { values: number[]; outliers: Array<{value: number, file: string}> };\n    hemoglobin: { values: number[]; outliers: Array<{value: number, file: string}> };\n  };\n  codePatterns: Record<string, number>;\n  unitPatterns: Record<string, number>;\n  extremeValues: Array<{type: string, value: number, unit: string, file: string}>;\n}\n\nfunction detectOutliers(values: number[]): { outliers: number[]; q1: number; q3: number; iqr: number } {\n  if (values.length === 0) return { outliers: [], q1: 0, q3: 0, iqr: 0 };\n  \n  const sorted = [...values].sort((a, b) => a - b);\n  const q1Index = Math.floor(sorted.length * 0.25);\n  const q3Index = Math.floor(sorted.length * 0.75);\n  const q1 = sorted[q1Index];\n  const q3 = sorted[q3Index];\n  const iqr = q3 - q1;\n  const lowerBound = q1 - 1.5 * iqr;\n  const upperBound = q3 + 1.5 * iqr;\n  \n  const outliers = values.filter(v => v < lowerBound || v > upperBound);\n  return { outliers, q1, q3, iqr };\n}\n\nasync function analyzeObservations() {\n  console.log('=== Observation Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 10), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing observations in ${sampleFiles.length} files...`);\n  \n  const analysis: ObservationAnalysis = {\n    totalObservations: 0,\n    statusDistribution: {},\n    categoryDistribution: {},\n    valueTypes: {\n      quantity: 0,\n      string: 0,\n      boolean: 0,\n      codeableConcept: 0,\n      missing: 0\n    },\n    vitalSigns: {\n      height: { values: [], unit: '', outliers: [] },\n      weight: { values: [], unit: '', outliers: [] },\n      bloodPressure: { \n        systolic: { values: [], outliers: [] },\n        diastolic: { values: [], outliers: [] }\n      },\n      heartRate: { values: [], unit: '', outliers: [] },\n      temperature: { values: [], unit: '', outliers: [] },\n      respiratoryRate: { values: [], unit: '', outliers: [] }\n    },\n    labValues: {\n      cholesterol: { values: [], outliers: [] },\n      glucose: { values: [], outliers: [] },\n      hemoglobin: { values: [], outliers: [] }\n    },\n    codePatterns: {},\n    unitPatterns: {},\n    extremeValues: []\n  };\n  \n  const heightCodes = ['8302-2', '3137-7'];\n  const weightCodes = ['29463-7', '3141-9'];\n  const bpCodes = ['85354-9', '8480-6', '8462-4']; // BP panel, systolic, diastolic\n  const heartRateCodes = ['8867-4'];\n  const temperatureCodes = ['8310-5'];\n  const respiratoryCodes = ['9279-1'];\n  const cholesterolCodes = ['2093-3', '14647-2'];\n  const glucoseCodes = ['2339-0', '33747-0'];\n  const hemoglobinCodes = ['718-7'];\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const observations = extractResourcesByType(result.bundle, 'Observation') as ObservationType[];\n      \n      for (const obs of observations) {\n        analysis.totalObservations++;\n        \n        // Analyze status\n        if (obs.status) {\n          analysis.statusDistribution[obs.status] = \n            (analysis.statusDistribution[obs.status] || 0) + 1;\n        }\n        \n        // Analyze category\n        if (obs.category?.[0]?.coding?.[0]?.display) {\n          const category = obs.category[0].coding[0].display;\n          analysis.categoryDistribution[category] = \n            (analysis.categoryDistribution[category] || 0) + 1;\n        }\n        \n        // Analyze value types\n        if (obs.valueQuantity) {\n          analysis.valueTypes.quantity++;\n          \n          const value = obs.valueQuantity.value;\n          const unit = obs.valueQuantity.unit || obs.valueQuantity.code || '';\n          const code = obs.code.coding?.[0]?.code;\n          \n          if (value !== undefined && code) {\n            // Track units\n            if (unit) {\n              analysis.unitPatterns[unit] = (analysis.unitPatterns[unit] || 0) + 1;\n            }\n            \n            // Categorize vital signs\n            if (heightCodes.includes(code)) {\n              analysis.vitalSigns.height.values.push(value);\n              analysis.vitalSigns.height.unit = unit;\n            } else if (weightCodes.includes(code)) {\n              analysis.vitalSigns.weight.values.push(value);\n              analysis.vitalSigns.weight.unit = unit;\n            } else if (code === '8480-6') { // Systolic BP\n              analysis.vitalSigns.bloodPressure.systolic.values.push(value);\n            } else if (code === '8462-4') { // Diastolic BP\n              analysis.vitalSigns.bloodPressure.diastolic.values.push(value);\n            } else if (heartRateCodes.includes(code)) {\n              analysis.vitalSigns.heartRate.values.push(value);\n              analysis.vitalSigns.heartRate.unit = unit;\n            } else if (temperatureCodes.includes(code)) {\n              analysis.vitalSigns.temperature.values.push(value);\n              analysis.vitalSigns.temperature.unit = unit;\n            } else if (respiratoryCodes.includes(code)) {\n              analysis.vitalSigns.respiratoryRate.values.push(value);\n              analysis.vitalSigns.respiratoryRate.unit = unit;\n            } else if (cholesterolCodes.includes(code)) {\n              analysis.labValues.cholesterol.values.push(value);\n            } else if (glucoseCodes.includes(code)) {\n              analysis.labValues.glucose.values.push(value);\n            } else if (hemoglobinCodes.includes(code)) {\n              analysis.labValues.hemoglobin.values.push(value);\n            }\n            \n            // Track extreme values\n            if (value > 10000 || value < 0) {\n              analysis.extremeValues.push({\n                type: obs.code.text || obs.code.coding?.[0]?.display || 'Unknown',\n                value,\n                unit,\n                file: fileName\n              });\n            }\n          }\n        } else if (obs.valueString) {\n          analysis.valueTypes.string++;\n        } else if (obs.valueBoolean !== undefined) {\n          analysis.valueTypes.boolean++;\n        } else if (obs.valueCodeableConcept) {\n          analysis.valueTypes.codeableConcept++;\n        } else {\n          analysis.valueTypes.missing++;\n        }\n        \n        // Analyze codes\n        if (obs.code.coding?.[0]?.code) {\n          const code = obs.code.coding[0].code;\n          analysis.codePatterns[code] = (analysis.codePatterns[code] || 0) + 1;\n        }\n      }\n      \n    } catch (error) {\n      console.error(`Error analyzing observations in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers for vital signs\n  const detectVitalOutliers = (values: number[], type: string, fileName: string) => {\n    const { outliers } = detectOutliers(values);\n    return outliers.map(value => ({ value, file: fileName }));\n  };\n  \n  // Find outliers for each vital sign type\n  analysis.vitalSigns.height.outliers = detectVitalOutliers(analysis.vitalSigns.height.values, 'height', 'multiple');\n  analysis.vitalSigns.weight.outliers = detectVitalOutliers(analysis.vitalSigns.weight.values, 'weight', 'multiple');\n  analysis.vitalSigns.bloodPressure.systolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.systolic.values, 'systolic', 'multiple');\n  analysis.vitalSigns.bloodPressure.diastolic.outliers = detectVitalOutliers(analysis.vitalSigns.bloodPressure.diastolic.values, 'diastolic', 'multiple');\n  analysis.vitalSigns.heartRate.outliers = detectVitalOutliers(analysis.vitalSigns.heartRate.values, 'heartRate', 'multiple');\n  analysis.vitalSigns.temperature.outliers = detectVitalOutliers(analysis.vitalSigns.temperature.values, 'temperature', 'multiple');\n  analysis.vitalSigns.respiratoryRate.outliers = detectVitalOutliers(analysis.vitalSigns.respiratoryRate.values, 'respiratoryRate', 'multiple');\n  \n  // Print results\n  console.log(`\\n=== OBSERVATION ANALYSIS RESULTS ===`);\n  console.log(`Total observations analyzed: ${analysis.totalObservations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nCATEGORY DISTRIBUTION:');\n  Object.entries(analysis.categoryDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([category, count]) => \n      console.log(`- ${category}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVALUE TYPES:');\n  Object.entries(analysis.valueTypes)\n    .forEach(([type, count]) => \n      console.log(`- ${type}: ${count} (${(count/analysis.totalObservations*100).toFixed(1)}%)`));\n  \n  console.log('\\nVITAL SIGNS ANALYSIS:');\n  \n  // Height analysis\n  if (analysis.vitalSigns.height.values.length > 0) {\n    const heights = analysis.vitalSigns.height.values;\n    console.log(`- Height (${analysis.vitalSigns.height.unit}): ${heights.length} measurements`);\n    console.log(`  Range: ${Math.min(...heights).toFixed(1)} - ${Math.max(...heights).toFixed(1)}`);\n    console.log(`  Mean: ${(heights.reduce((a, b) => a + b, 0) / heights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.height.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.height.outliers.length}`);\n      analysis.vitalSigns.height.outliers.slice(0, 3).forEach(o => \n        console.log(`    ${o.value} ${analysis.vitalSigns.height.unit}`));\n    }\n  }\n  \n  // Weight analysis\n  if (analysis.vitalSigns.weight.values.length > 0) {\n    const weights = analysis.vitalSigns.weight.values;\n    console.log(`- Weight (${analysis.vitalSigns.weight.unit}): ${weights.length} measurements`);\n    console.log(`  Range: ${Math.min(...weights).toFixed(1)} - ${Math.max(...weights).toFixed(1)}`);\n    console.log(`  Mean: ${(weights.reduce((a, b) => a + b, 0) / weights.length).toFixed(1)}`);\n    if (analysis.vitalSigns.weight.outliers.length > 0) {\n      console.log(`  Outliers: ${analysis.vitalSigns.weight.outliers.length}`);\n    }\n  }\n  \n  // Blood pressure analysis\n  if (analysis.vitalSigns.bloodPressure.systolic.values.length > 0) {\n    const systolic = analysis.vitalSigns.bloodPressure.systolic.values;\n    const diastolic = analysis.vitalSigns.bloodPressure.diastolic.values;\n    console.log(`- Blood Pressure (mmHg): ${systolic.length} systolic, ${diastolic.length} diastolic`);\n    console.log(`  Systolic range: ${Math.min(...systolic)} - ${Math.max(...systolic)}`);\n    if (diastolic.length > 0) {\n      console.log(`  Diastolic range: ${Math.min(...diastolic)} - ${Math.max(...diastolic)}`);\n    }\n    if (analysis.vitalSigns.bloodPressure.systolic.outliers.length > 0) {\n      console.log(`  Systolic outliers: ${analysis.vitalSigns.bloodPressure.systolic.outliers.length}`);\n    }\n  }\n  \n  // Heart rate analysis\n  if (analysis.vitalSigns.heartRate.values.length > 0) {\n    const hr = analysis.vitalSigns.heartRate.values;\n    console.log(`- Heart Rate (${analysis.vitalSigns.heartRate.unit}): ${hr.length} measurements`);\n    console.log(`  Range: ${Math.min(...hr)} - ${Math.max(...hr)}`);\n    console.log(`  Mean: ${(hr.reduce((a, b) => a + b, 0) / hr.length).toFixed(1)}`);\n  }\n  \n  console.log('\\nMOST COMMON OBSERVATION CODES:');\n  Object.entries(analysis.codePatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([code, count]) => console.log(`- ${code}: ${count}`));\n  \n  console.log('\\nMOST COMMON UNITS:');\n  Object.entries(analysis.unitPatterns)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  if (analysis.extremeValues.length > 0) {\n    console.log('\\nEXTREME VALUES (>10000 or <0):');\n    analysis.extremeValues.slice(0, 10).forEach(extreme => \n      console.log(`- ${extreme.type}: ${extreme.value} ${extreme.unit} (${extreme.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeObservations().catch(console.error);\n}\n\nexport { analyzeObservations };"}}}
