uick-and-dirty/simple-structure-analysis.ts","isDirectory":false,"lastModified":"2025-07-10T09:35:16.355Z","children":[]}]},{"name":"schema","path":"typescript_code/src/schema","isDirectory":true,"children":[{"name":"fhir-bundle.ts","path":"typescript_code/src/schema/fhir-bundle.ts","isDirectory":false,"lastModified":"2025-07-10T09:46:28.508Z","children":[]},{"name":"fhir-datatypes.ts","path":"typescript_code/src/schema/fhir-datatypes.ts","isDirectory":false,"lastModified":"2025-07-10T10:03:37.727Z","children":[]},{"name":"fhir-resources.ts","path":"typescript_code/src/schema/fhir-resources.ts","isDirectory":false,"lastModified":"2025-07-10T10:00:01.465Z","children":[]},{"name":"index.ts","path":"typescript_code/src/schema/index.ts","isDirectory":false,"lastModified":"2025-07-10T09:51:42.373Z","children":[]}]},{"name":"validations","path":"typescript_code/src/validations","isDirectory":true,"children":[{"name":"detailed-test.ts","path":"typescript_code/src/validations/detailed-test.ts","isDirectory":false,"lastModified":"2025-07-10T09:50:08.179Z","children":[]},{"name":"schema-validation.ts","path":"typescript_code/src/validations/schema-validation.ts","isDirectory":false,"lastModified":"2025-07-10T09:45:05.247Z","children":[]},{"name":"simple-test.ts","path":"typescript_code/src/validations/simple-test.ts","isDirectory":false,"lastModified":"2025-07-10T09:45:49.880Z","children":[]}]}]}]}]}]}}
