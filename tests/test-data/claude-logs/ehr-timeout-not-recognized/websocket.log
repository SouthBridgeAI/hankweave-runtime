why activity was prohibited'),\n      reasonReference: z.array(Reference).optional().describe('Why activity is needed'),\n      goal: z.array(Reference).optional().describe('Goals this activity relates to'),\n      status: z.enum(['not-started', 'scheduled', 'in-progress', 'on-hold', 'completed', 'cancelled', 'stopped', 'unknown', 'entered-in-error']).describe('not-started | scheduled | in-progress | on-hold | completed | cancelled | stopped | unknown | entered-in-error'),\n      statusReason: CodeableConcept.optional().describe('Reason for current status'),\n      doNotPerform: FhirBoolean.optional().describe('If true, activity is prohibiting action'),\n      scheduledTiming: z.object({\n        event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n        repeat: z.object({\n          frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n          period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n          periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n        }).optional().describe('When the event is to occur')\n      }).optional().describe('When activity is to occur'),\n      scheduledPeriod: Period.optional().describe('When activity is to occur'),\n      scheduledString: FhirString.optional().describe('When activity is to occur'),\n      location: Reference.optional().describe('Where it should happen'),\n      performer: z.array(Reference).optional().describe('Who will be responsible?'),\n      productCodeableConcept: CodeableConcept.optional().describe('What is to be administered/supplied'),\n      productReference: Reference.optional().describe('What is to be administered/supplied'),\n      dailyAmount: Quantity.optional().describe('How to consume/day?'),\n      quantity: Quantity.optional().describe('How much to administer/supply/consume'),\n      description: FhirString.optional().describe('Extra info describing activity to perform')\n    }).optional().describe('In-line definition of activity')\n  })).optional().describe('Action to occur as part of plan'),\n  note: z.array(Annotation).optional().describe('Comments about the plan')\n}).describe('CarePlan resource - healthcare plan for patient or group');\n\n/**\n * CareTeam resource - planned participants in patient care\n */\nexport const CareTeam = BaseResource.extend({\n  resourceType: z.literal('CareTeam').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External Ids for this team'),\n  status: z.enum(['proposed', 'active', 'suspended', 'inactive', 'entered-in-error']).optional().describe('proposed | active | suspended | inactive | entered-in-error'),\n  category: z.array(CodeableConcept).optional().describe('Type of team'),\n  name: FhirString.optional().describe('Name of the team, such as crisis assessment team'),\n  subject: Reference.optional().describe('Who care team is for'),\n  encounter: Reference.optional().describe('Encounter created as part of'),\n  period: Period.optional().describe('Time period team covers'),\n  participant: z.array(z.object({\n    role: z.array(CodeableConcept).optional().describe('Type of involvement'),\n    member: Reference.optional().describe('Who is involved'),\n    onBehalfOf: Reference.optional().describe('Organization of the practitioner'),\n    period: Period.optional().describe('Time period of participant')\n  })).optional().describe('Members of the team'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Why the care team exists'),\n  reasonReference: z.array(Reference).optional().describe('Why the care team exists'),\n  managingOrganization: z.array(Reference).optional().describe('Organization responsible for the care team'),\n  telecom: z.array(ContactPoint).optional().describe('A contact detail for the care team'),\n  note: z.array(Annotation).optional().describe('Comments made about the CareTeam')\n}).describe('CareTeam resource - planned participants in patient care');\n\n/**\n * Device resource - item used in healthcare\n */\nexport const Device = BaseResource.extend({\n  resourceType: z.literal('Device').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Instance identifier'),\n  definition: Reference.optional().describe('The reference to the definition for the device'),\n  udiCarrier: z.array(z.object({\n    deviceIdentifier: FhirString.optional().describe('Mandatory fixed portion of UDI'),\n    issuer: FhirUri.optional().describe('UDI Issuing Organization'),\n    jurisdiction: FhirUri.optional().describe('Regional UDI authority'),\n    carrierAIDC: z.string().optional().describe('UDI Machine Readable Barcode String'),\n    carrierHRF: FhirString.optional().describe('UDI Human Readable Barcode String'),\n    entryType: z.enum(['barcode', 'rfid', 'manual', 'card', 'self-reported', 'unknown']).optional().describe('barcode | rfid | manual +')\n  })).optional().describe('Unique Device Identifier (UDI) Barcode string'),\n  status: z.enum(['active', 'inactive', 'entered-in-error', 'unknown']).optional().describe('active | inactive | entered-in-error | unknown'),\n  statusReason: z.array(CodeableConcept).optional().describe('online | paused | standby | offline | not-ready | transduc-discon | hw-discon | off'),\n  distinctIdentifier: FhirString.optional().describe('The distinct identification string'),\n  manufacturer: FhirString.optional().describe('Name of device manufacturer'),\n  manufactureDate: FhirDateTime.optional().describe('Date when the device was made'),\n  expirationDate: FhirDateTime.optional().describe('Date and time of expiry of this device'),\n  lotNumber: FhirString.optional().describe('Lot number of manufacture'),\n  serialNumber: FhirString.optional().describe('Serial number assigned by the manufacturer'),\n  deviceName: z.array(z.object({\n    name: FhirString.describe('The name of the device'),\n    type: z.enum(['udi-label-name', 'user-friendly-name', 'patient-reported-name', 'manufacturer-name', 'model-name', 'other']).describe('udi-label-name | user-friendly-name | patient-reported-name | manufacturer-name | model-name | other')\n  })).optional().describe('The name of the device as given by the manufacturer'),\n  modelNumber: FhirString.optional().describe('The model number for the device'),\n  partNumber: FhirString.optional().describe('The part number of the device'),\n  type: CodeableConcept.optional().describe('The kind or type of device'),\n  specialization: z.array(z.object({\n    systemType: CodeableConcept.describe('The standard that is used to operate and communicate'),\n    version: FhirString.optional().describe('The version of the standard that is used to operate and communicate')\n  })).optional().describe('The capabilities supported on a  device, the standards to which the device conforms'),\n  version: z.array(z.object({\n    type: CodeableConcept.optional().describe('The type of the device version'),\n    component: Identifier.optional().describe('A single component of the device version'),\n    value: FhirString.describe('The version text')\n  })).optional().describe('The actual design of the device or software version running on the device'),\n  property: z.array(z.object({\n    type: CodeableConcept.describe('Code that specifies the property DeviceDefinitionPropetyCode (Extensible)'),\n    valueQuantity: z.array(Quantity).optional().describe('Property value as a quantity'),\n    valueCode: z.array(CodeableConcept).optional().describe('Property value as a code, e.g., NTP4 (synced to NTP)')\n  })).optional().describe('The actual configuration settings of a device as it actually operates'),\n  patient: Reference.optional().describe('Patient to whom Device is affixed'),\n  owner: Reference.optional().describe('Organization responsible for device'),\n  contact: z.array(ContactPoint).optional().describe('Details for human/organization for support'),\n  location: Reference.optional().describe('Where the device is found'),\n  url: FhirUri.optional().describe('Network address to contact device'),\n  note: z.array(Annotation).optional().describe('Device notes and comments'),\n  safety: z.array(CodeableConcept).optional().describe('Safety Characteristics of Device'),\n  parent: Reference.optional().describe('The parent device')\n}).describe('Device resource - item used in healthcare');\n\n/**\n * ImagingStudy resource - a set of images produced in single study\n */\nexport const ImagingStudy = BaseResource.extend({\n  resourceType: z.literal('ImagingStudy').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Identifiers for the whole study'),\n  status: z.enum(['registered', 'available', 'cancelled', 'entered-in-error', 'unknown']).describe('registered | available | cancelled | entered-in-error | unknown'),\n  modality: z.array(Coding).optional().describe('All series modality if actual acquisition modalities'),\n  subject: Reference.describe('Who or what is the subject of the study'),\n  encounter: Reference.optional().describe('Encounter with which this imaging study is associated'),\n  started: FhirDateTime.optional().describe('When the study was started'),\n  basedOn: z.array(Reference).optional().describe('Request fulfilled'),\n  referrer: Reference.optional().describe('Referring physician'),\n  interpreter: z.array(Reference).optional().describe('Who interpreted images'),\n  endpoint: z.array(Reference).optional().describe('Study access endpoint'),\n  numberOfSeries: z.number().int().nonnegative().optional().describe('Number of Study Related Series'),\n  numberOfInstances: z.number().int().nonnegative().optional().describe('Number of Study Related Instances'),\n  procedureReference: Reference.optional().describe('The performed Procedure reference'),\n  procedureCode: z.array(CodeableConcept).optional().describe('The performed procedure code'),\n  location: Reference.optional().describe('Where ImagingStudy occurred'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Why the study was requested'),\n  reasonReference: z.array(Reference).optional().describe('Why was study performed'),\n  note: z.array(Annotation).optional().describe('User-defined comments'),\n  description: FhirString.optional().describe('Institution-generated description'),\n  series: z.array(z.object({\n    uid: FhirId.describe('DICOM Series Instance UID for the series'),\n    number: z.number().int().nonnegative().optional().describe('Numeric identifier of this series'),\n    modality: Coding.describe('The modality of the instances in the series'),\n    description: FhirString.optional().describe('A short human readable summary of the series'),\n    numberOfInstances: z.number().int().nonnegative().optional().describe('Number of Series Related Instances'),\n    endpoint: z.array(Reference).optional().describe('Series access endpoint'),\n    bodySite: Coding.optional().describe('Body part examined'),\n    laterality: Coding.optional().describe('Body part laterality'),\n    specimen: z.array(Reference).optional().describe('Specimen imaged'),\n    started: FhirDateTime.optional().describe('When the series started'),\n    performer: z.array(z.object({\n      function: CodeableConcept.optional().describe('Type of performance'),\n      actor: Reference.describe('Who performed the series')\n    })).optional().describe('Who performed the series'),\n    instance: z.array(z.object({\n      uid: FhirId.describe('DICOM SOP Instance UID'),\n      sopClass: Coding.describe('DICOM class type'),\n      number: z.number().int().nonnegative().optional().describe('The number of this instance in the series'),\n      title: FhirString.optional().describe('Description of instance')\n    })).optional().describe('A single SOP instance from the series')\n  })).optional().describe('Each study has one or more series of instances')\n}).describe('ImagingStudy resource - a set of images produced in single study');\n\n/**\n * Medication resource - definition of a medication\n */\nexport const Medication = BaseResource.extend({\n  resourceType: z.literal('Medication').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business identifier for this medication'),\n  code: CodeableConcept.optional().describe('Codes that identify this medication'),\n  status: z.enum(['active', 'inactive', 'entered-in-error']).optional().describe('active | inactive | entered-in-error'),\n  manufacturer: Reference.optional().describe('Manufacturer of the item'),\n  form: CodeableConcept.optional().describe('powder | tablets | capsule +'),\n  amount: Ratio.optional().describe('Amount of drug in package'),\n  ingredient: z.array(z.object({\n    itemCodeableConcept: CodeableConcept.optional().describe('The actual ingredient or content'),\n    itemReference: Reference.optional().describe('The actual ingredient or content'),\n    isActive: FhirBoolean.optional().describe('Active ingredient indicator'),\n    strength: Ratio.optional().describe('Quantity of ingredient present')\n  })).optional().describe('Active or inactive ingredient'),\n  batch: z.object({\n    lotNumber: FhirString.optional().describe('Identifier assigned to batch'),\n    expirationDate: FhirDateTime.optional().describe('When batch will expire')\n  }).optional().describe('Details about packaged medications')\n}).describe('Medication resource - definition of a medication');\n\n/**\n * MedicationAdministration resource - administration of medication to a patient\n */\nexport const MedicationAdministration = BaseResource.extend({\n  resourceType: z.literal('MedicationAdministration').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External identifier'),\n  instantiates: z.array(FhirUri).optional().describe('Instantiates protocol or definition'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['in-progress', 'not-done', 'on-hold', 'completed', 'entered-in-error', 'stopped', 'unknown']).describe('in-progress | not-done | on-hold | completed | entered-in-error | stopped | unknown'),\n  statusReason: z.array(CodeableConcept).optional().describe('Reason administration not performed'),\n  category: CodeableConcept.optional().describe('Type of medication usage'),\n  medicationCodeableConcept: CodeableConcept.optional().describe('What was administered'),\n  medicationReference: Reference.optional().describe('What was administered'),\n  subject: Reference.describe('Who received medication'),\n  context: Reference.optional().describe('Encounter or Episode of Care administered as part of'),\n  supportingInformation: z.array(Reference).optional().describe('Additional information to support administration'),\n  effectiveDateTime: FhirDateTime.optional().describe('Start and end time of administration'),\n  effectivePeriod: Period.optional().describe('Start and end time of administration'),\n  performer: z.array(z.object({\n    function: CodeableConcept.optional().describe('Type of performance'),\n    actor: Reference.describe('Who performed the medication administration')\n  })).optional().describe('Who performed the medication administration and what they did'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Reason administration performed'),\n  reasonReference: z.array(Reference).optional().describe('Condition or observation that supports why the medication was administered'),\n  request: Reference.optional().describe('Request administration performed against'),\n  device: z.array(Reference).optional().describe('Device used to administer'),\n  note: z.array(Annotation).optional().describe('Information about the administration'),\n  dosage: z.object({\n    text: FhirString.optional().describe('Free text dosage instructions'),\n    site: CodeableConcept.optional().describe('Body site administered to'),\n    route: CodeableConcept.optional().describe('Path of substance into body'),\n    method: CodeableConcept.optional().describe('How drug was administered'),\n    dose: Quantity.optional().describe('Amount of medication per dose'),\n    rateRatio: Ratio.optional().describe('Dose quantity per unit of time'),\n    rateQuantity: Quantity.optional().describe('Dose quantity per unit of time')\n  }).optional().describe('Details of how medication was taken'),\n  eventHistory: z.array(Reference).optional().describe('A list of events of interest in the lifecycle')\n}).describe('MedicationAdministration resource - administration of medication to a patient');\n\n/**\n * SupplyDelivery resource - delivery of bulk supplies\n */\nexport const SupplyDelivery = BaseResource.extend({\n  resourceType: z.literal('SupplyDelivery').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('External identifier'),\n  basedOn: z.array(Reference).optional().describe('Fulfills plan, proposal or order'),\n  partOf: z.array(Reference).optional().describe('Part of referenced event'),\n  status: z.enum(['in-progress', 'completed', 'abandoned', 'entered-in-error']).optional().describe('in-progress | completed | abandoned | entered-in-error'),\n  patient: Reference.optional().describe('Patient for whom the item is supplied'),\n  type: CodeableConcept.optional().describe('Category of dispense event'),\n  suppliedItem: z.object({\n    quantity: Quantity.optional().describe('Amount dispensed'),\n    itemCodeableConcept: CodeableConcept.optional().describe('Medication, Substance, or Device supplied'),\n    itemReference: Reference.optional().describe('Medication, Substance, or Device supplied')\n  }).optional().describe('The item that is delivered or supplied'),\n  occurrenceDateTime: FhirDateTime.optional().describe('When event occurred'),\n  occurrencePeriod: Period.optional().describe('When event occurred'),\n  occurrenceTiming: z.object({\n    event: z.array(FhirDateTime).optional().describe('When the event occurs'),\n    repeat: z.object({\n      frequency: z.number().int().positive().optional().describe('Event occurs frequency times per period'),\n      period: FhirDecimal.optional().describe('Event occurs frequency times per period'),\n      periodUnit: z.enum(['s', 'min', 'h', 'd', 'wk', 'mo', 'a']).optional().describe('Unit of time')\n    }).optional().describe('When the event is to occur')\n  }).optional().describe('When event occurred'),\n  supplier: Reference.optional().describe('Dispenser'),\n  destination: Reference.optional().describe('Where the Supply was sent'),\n  receiver: z.array(Reference).optional().describe('Who collected the Supply')\n}).describe('SupplyDelivery resource - delivery of bulk supplies');\n\n/**\n * Union type for all supported FHIR resources\n */\nexport const Resource = z.union([\n  Patient,\n  Observation,\n  Encounter,\n  Condition,\n  Procedure,\n  MedicationRequest,\n  DiagnosticReport,\n  Immunization,\n  Claim,\n  ExplanationOfBenefit,\n  DocumentReference,\n  Provenance,\n  AllergyIntolerance,\n  CarePlan,\n  CareTeam,\n  Device,\n  ImagingStudy,\n  Medication,\n  MedicationAdministration,\n  SupplyDelivery\n]).describe('Union of all supported FHIR resources');\n\n// Export all individual resource types for use in other modules\nexport type PatientType = z.infer<typeof Patient>;\nexport type ObservationType = z.infer<typeof Observation>;\nexport type EncounterType = z.infer<typeof Encounter>;\nexport type ConditionType = z.infer<typeof Condition>;\nexport type ProcedureType = z.infer<typeof Procedure>;\nexport type MedicationRequestType = z.infer<typeof MedicationRequest>;\nexport type DiagnosticReportType = z.infer<typeof DiagnosticReport>;\nexport type ImmunizationType = z.infer<typeof Immunization>;\nexport type ClaimType = z.infer<typeof Claim>;\nexport type ExplanationOfBenefitType = z.infer<typeof ExplanationOfBenefit>;\nexport type DocumentReferenceType = z.infer<typeof DocumentReference>;\nexport type ProvenanceType = z.infer<typeof Provenance>;\nexport type AllergyIntoleranceType = z.infer<typeof AllergyIntolerance>;\nexport type CarePlanType = z.infer<typeof CarePlan>;\nexport type CareTeamType = z.infer<typeof CareTeam>;\nexport type DeviceType = z.infer<typeof Device>;\nexport type ImagingStudyType = z.infer<typeof ImagingStudy>;\nexport type MedicationType = z.infer<typeof Medication>;\nexport type MedicationAdministrationType = z.infer<typeof MedicationAdministration>;\nexport type SupplyDeliveryType = z.infer<typeof SupplyDelivery>;\nexport type ResourceType = z.infer<typeof Resource>;","action":"modified"}}
