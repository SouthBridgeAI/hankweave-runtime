isDirectory":true,"children":[{"name":"detailed-test.ts","path":"typescript_code/src/validations/detailed-test.ts","isDirectory":false,"lastModified":"2025-07-10T09:50:08.179Z","children":[]},{"name":"schema-validation.ts","path":"typescript_code/src/validations/schema-validation.ts","isDirectory":false,"lastModified":"2025-07-10T09:45:05.247Z","children":[]},{"name":"simple-test.ts","path":"typescript_code/src/validations/simple-test.ts","isDirectory":false,"lastModified":"2025-07-10T09:45:49.880Z","children":[]}]}]}]}]}]}}
