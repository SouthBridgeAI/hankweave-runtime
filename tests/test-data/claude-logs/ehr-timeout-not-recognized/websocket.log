[2025-07-10T09:56:27.172Z] [OUT] {"id":"1752141387172-wk1xq4d8q","timestamp":"2025-07-10T09:56:27.172Z","type":"file.updated","data":{"path":"typescript_code/src/quick-and-dirty/medication-outliers.ts","filename":"medication-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { MedicationRequestType, MedicationAdministrationType } from '../schema';\n\ninterface MedicationAnalysis {\n  totalMedicationRequests: number;\n  totalMedicationAdministrations: number;\n  statusDistribution: Record<string, number>;\n  intentDistribution: Record<string, number>;\n  priorityDistribution: Record<string, number>;\n  dosagePatterns: {\n    texts: Record<string, number>;\n    routes: Record<string, number>;\n    frequencies: Record<string, number>;\n    methods: Record<string, number>;\n  };\n  doseRanges: {\n    values: number[];\n    units: Record<string, number>;\n    outliers: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeLow: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeHigh: Array<{value: number, unit: string, medication: string, file: string}>;\n  };\n  medicationCodes: Record<string, number>;\n  medicationNames: Record<string, number>;\n  durationPatterns: {\n    short: number; // < 1 day\n    normal: number; // 1-30 days\n    long: number; // 30-365 days\n    extreme: number; // > 365 days\n    examples: Array<{duration: string, medication: string, file: string}>;\n  };\n  refillPatterns: {\n    noRefills: number;\n    lowRefills: number; // 1-3\n    normalRefills: number; // 4-11\n    highRefills: number; // 12+\n    unlimited: number;\n  };\n}\n\nfunction extractNumericDose(doseText: string): { value: number; unit: string } | null {\n  // Common patterns for doses\n  const patterns = [\n    /(\\d+(?:\\.\\d+)?)\\s*(mg|g|mcg|μg|units?|ml|tablets?|capsules?)/i,\n    /(\\d+(?:\\.\\d+)?)\\s*(milligrams?|grams?|micrograms?|milliliters?)/i\n  ];\n  \n  for (const pattern of patterns) {\n    const match = doseText.match(pattern);\n    if (match) {\n      return {\n        value: parseFloat(match[1]),\n        unit: match[2].toLowerCase()\n      };\n    }\n  }\n  return null;\n}\n\nfunction parseDuration(text: string): number | null {\n  // Extract duration in days\n  const patterns = [\n    /(\\d+)\\s*days?/i,\n    /(\\d+)\\s*weeks?/i,\n    /(\\d+)\\s*months?/i,\n    /(\\d+)\\s*years?/i\n  ];\n  \n  const dayMatch = text.match(patterns[0]);\n  if (dayMatch) return parseInt(dayMatch[1]);\n  \n  const weekMatch = text.match(patterns[1]);\n  if (weekMatch) return parseInt(weekMatch[1]) * 7;\n  \n  const monthMatch = text.match(patterns[2]);\n  if (monthMatch) return parseInt(monthMatch[1]) * 30;\n  \n  const yearMatch = text.match(patterns[3]);\n  if (yearMatch) return parseInt(yearMatch[1]) * 365;\n  \n  return null;\n}\n\nasync function analyzeMedications() {\n  console.log('=== Medication Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 5), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing medications in ${sampleFiles.length} files...`);\n  \n  const analysis: MedicationAnalysis = {\n    totalMedicationRequests: 0,\n    totalMedicationAdministrations: 0,\n    statusDistribution: {},\n    intentDistribution: {},\n    priorityDistribution: {},\n    dosagePatterns: {\n      texts: {},\n      routes: {},\n      frequencies: {},\n      methods: {}\n    },\n    doseRanges: {\n      values: [],\n      units: {},\n      outliers: [],\n      extremeLow: [],\n      extremeHigh: []\n    },\n    medicationCodes: {},\n    medicationNames: {},\n    durationPatterns: {\n      short: 0,\n      normal: 0,\n      long: 0,\n      extreme: 0,\n      examples: []\n    },\n    refillPatterns: {\n      noRefills: 0,\n      lowRefills: 0,\n      normalRefills: 0,\n      highRefills: 0,\n      unlimited: 0\n    }\n  };\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const medicationRequests = extractResourcesByType(result.bundle, 'MedicationRequest') as MedicationRequestType[];\n      const medicationAdmins = extractResourcesByType(result.bundle, 'MedicationAdministration') as MedicationAdministrationType[];\n      \n      // Analyze MedicationRequests\n      for (const medReq of medicationRequests) {\n        analysis.totalMedicationRequests++;\n        \n        // Status distribution\n        if (medReq.status) {\n          analysis.statusDistribution[medReq.status] = \n            (analysis.statusDistribution[medReq.status] || 0) + 1;\n        }\n        \n        // Intent distribution\n        if (medReq.intent) {\n          analysis.intentDistribution[medReq.intent] = \n            (analysis.intentDistribution[medReq.intent] || 0) + 1;\n        }\n        \n        // Priority distribution\n        if (medReq.priority) {\n          analysis.priorityDistribution[medReq.priority] = \n            (analysis.priorityDistribution[medReq.priority] || 0) + 1;\n        }\n        \n        // Medication names/codes\n        let medicationName = 'Unknown';\n        if (medReq.medicationCodeableConcept?.text) {\n          medicationName = medReq.medicationCodeableConcept.text;\n          analysis.medicationNames[medicationName] = \n            (analysis.medicationNames[medicationName] || 0) + 1;\n        }\n        \n        if (medReq.medicationCodeableConcept?.coding?.[0]?.code) {\n          const code = medReq.medicationCodeableConcept.coding[0].code;\n          analysis.medicationCodes[code] = \n            (analysis.medicationCodes[code] || 0) + 1;\n        }\n        \n        // Dosage patterns\n        if (medReq.dosageInstruction) {\n          for (const dosage of medReq.dosageInstruction) {\n            // Dosage text patterns\n            if (dosage.text) {\n              analysis.dosagePatterns.texts[dosage.text] = \n                (analysis.dosagePatterns.texts[dosage.text] || 0) + 1;\n              \n              // Extract numeric dose\n              const dose = extractNumericDose(dosage.text);\n              if (dose) {\n                analysis.doseRanges.values.push(dose.value);\n                analysis.doseRanges.units[dose.unit] = \n                  (analysis.doseRanges.units[dose.unit] || 0) + 1;\n                \n                // Check for extreme doses\n                if (dose.value < 0.01) {\n                  analysis.doseRanges.extremeLow.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                } else if (dose.value > 10000) {\n                  analysis.doseRanges.extremeHigh.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n              \n              // Extract duration\n              const duration = parseDuration(dosage.text);\n              if (duration) {\n                if (duration < 1) {\n                  analysis.durationPatterns.short++;\n                } else if (duration <= 30) {\n                  analysis.durationPatterns.normal++;\n                } else if (duration <= 365) {\n                  analysis.durationPatterns.long++;\n                } else {\n                  analysis.durationPatterns.extreme++;\n                  analysis.durationPatterns.examples.push({\n                    duration: `${duration} days`,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n            }\n            \n            // Route patterns\n            if (dosage.route?.text) {\n              analysis.dosagePatterns.routes[dosage.route.text] = \n                (analysis.dosagePatterns.routes[dosage.route.text] || 0) + 1;\n            }\n            \n            // Method patterns\n            if (dosage.method?.text) {\n              analysis.dosagePatterns.methods[dosage.method.text] = \n                (analysis.dosagePatterns.methods[dosage.method.text] || 0) + 1;\n            }\n            \n            // Timing/frequency patterns\n            if (dosage.timing?.repeat?.frequency) {\n              const freq = `${dosage.timing.repeat.frequency}x per ${dosage.timing.repeat.periodUnit || 'period'}`;\n              analysis.dosagePatterns.frequencies[freq] = \n                (analysis.dosagePatterns.frequencies[freq] || 0) + 1;\n            }\n          }\n        }\n        \n        // Refill patterns\n        if (medReq.dispenseRequest?.numberOfRepeatsAllowed !== undefined) {\n          const refills = medReq.dispenseRequest.numberOfRepeatsAllowed;\n          if (refills === 0) {\n            analysis.refillPatterns.noRefills++;\n          } else if (refills <= 3) {\n            analysis.refillPatterns.lowRefills++;\n          } else if (refills <= 11) {\n            analysis.refillPatterns.normalRefills++;\n          } else if (refills < 100) {\n            analysis.refillPatterns.highRefills++;\n          } else {\n            analysis.refillPatterns.unlimited++;\n          }\n        }\n      }\n      \n      // Analyze MedicationAdministrations\n      analysis.totalMedicationAdministrations += medicationAdmins.length;\n      \n    } catch (error) {\n      console.error(`Error analyzing medications in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers in doses\n  if (analysis.doseRanges.values.length > 0) {\n    const sorted = [...analysis.doseRanges.values].sort((a, b) => a - b);\n    const q1 = sorted[Math.floor(sorted.length * 0.25)];\n    const q3 = sorted[Math.floor(sorted.length * 0.75)];\n    const iqr = q3 - q1;\n    const lowerBound = q1 - 1.5 * iqr;\n    const upperBound = q3 + 1.5 * iqr;\n    \n    // Find outliers (simplified - just mark extreme values)\n    analysis.doseRanges.values.forEach(value => {\n      if (value < lowerBound || value > upperBound) {\n        // Would need to trace back to specific medication, simplified for now\n      }\n    });\n  }\n  \n  // Print results\n  console.log(`\\n=== MEDICATION ANALYSIS RESULTS ===`);\n  console.log(`Total medication requests: ${analysis.totalMedicationRequests}`);\n  console.log(`Total medication administrations: ${analysis.totalMedicationAdministrations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  console.log('\\nINTENT DISTRIBUTION:');\n  Object.entries(analysis.intentDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([intent, count]) => \n      console.log(`- ${intent}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  if (Object.keys(analysis.priorityDistribution).length > 0) {\n    console.log('\\nPRIORITY DISTRIBUTION:');\n    Object.entries(analysis.priorityDistribution)\n      .sort(([,a], [,b]) => b - a)\n      .forEach(([priority, count]) => \n        console.log(`- ${priority}: ${count}`));\n  }\n  \n  console.log('\\nTOP MEDICATIONS:');\n  Object.entries(analysis.medicationNames)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([name, count]) => console.log(`- ${name}: ${count}`));\n  \n  console.log('\\nDOSE ANALYSIS:');\n  if (analysis.doseRanges.values.length > 0) {\n    console.log(`- Total doses analyzed: ${analysis.doseRanges.values.length}`);\n    console.log(`- Dose range: ${Math.min(...analysis.doseRanges.values)} - ${Math.max(...analysis.doseRanges.values)}`);\n    console.log(`- Mean dose: ${(analysis.doseRanges.values.reduce((a, b) => a + b, 0) / analysis.doseRanges.values.length).toFixed(2)}`);\n  }\n  \n  console.log('\\nTOP DOSE UNITS:');\n  Object.entries(analysis.doseRanges.units)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  console.log('\\nROUTE PATTERNS:');\n  Object.entries(analysis.dosagePatterns.routes)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([route, count]) => console.log(`- ${route}: ${count}`));\n  \n  console.log('\\nFREQUENCY PATTERNS:');\n  Object.entries(analysis.dosagePatterns.frequencies)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([freq, count]) => console.log(`- ${freq}: ${count}`));\n  \n  console.log('\\nDURATION PATTERNS:');\n  console.log(`- Short duration (<1 day): ${analysis.durationPatterns.short}`);\n  console.log(`- Normal duration (1-30 days): ${analysis.durationPatterns.normal}`);\n  console.log(`- Long duration (30-365 days): ${analysis.durationPatterns.long}`);\n  console.log(`- Extreme duration (>365 days): ${analysis.durationPatterns.extreme}`);\n  if (analysis.durationPatterns.examples.length > 0) {\n    console.log('  Examples of extreme durations:');\n    analysis.durationPatterns.examples.slice(0, 3).forEach(ex => \n      console.log(`    ${ex.medication}: ${ex.duration} (${ex.file})`));\n  }\n  \n  console.log('\\nREFILL PATTERNS:');\n  console.log(`- No refills: ${analysis.refillPatterns.noRefills}`);\n  console.log(`- Low refills (1-3): ${analysis.refillPatterns.lowRefills}`);\n  console.log(`- Normal refills (4-11): ${analysis.refillPatterns.normalRefills}`);\n  console.log(`- High refills (12+): ${analysis.refillPatterns.highRefills}`);\n  console.log(`- Unlimited refills: ${analysis.refillPatterns.unlimited}`);\n  \n  if (analysis.doseRanges.extremeLow.length > 0) {\n    console.log('\\nEXTREMELY LOW DOSES (<0.01):');\n    analysis.doseRanges.extremeLow.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  if (analysis.doseRanges.extremeHigh.length > 0) {\n    console.log('\\nEXTREMELY HIGH DOSES (>10000):');\n    analysis.doseRanges.extremeHigh.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeMedications().catch(console.error);\n}\n\nexport { analyzeMedications };","action":"created"}}
[2025-07-10T09:56:27.175Z] [OUT] {"id":"1752141387175-ng93m311e","timestamp":"2025-07-10T09:56:27.175Z","type":"assistant.action","data":{"phaseId":"phase-2a","action":"tool_use","content":"","toolName":"Write","toolInput":{"file_path":"/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/typescript_code/src/quick-and-dirty/medication-outliers.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { extractResourcesByType } from '../schema';\nimport type { MedicationRequestType, MedicationAdministrationType } from '../schema';\n\ninterface MedicationAnalysis {\n  totalMedicationRequests: number;\n  totalMedicationAdministrations: number;\n  statusDistribution: Record<string, number>;\n  intentDistribution: Record<string, number>;\n  priorityDistribution: Record<string, number>;\n  dosagePatterns: {\n    texts: Record<string, number>;\n    routes: Record<string, number>;\n    frequencies: Record<string, number>;\n    methods: Record<string, number>;\n  };\n  doseRanges: {\n    values: number[];\n    units: Record<string, number>;\n    outliers: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeLow: Array<{value: number, unit: string, medication: string, file: string}>;\n    extremeHigh: Array<{value: number, unit: string, medication: string, file: string}>;\n  };\n  medicationCodes: Record<string, number>;\n  medicationNames: Record<string, number>;\n  durationPatterns: {\n    short: number; // < 1 day\n    normal: number; // 1-30 days\n    long: number; // 30-365 days\n    extreme: number; // > 365 days\n    examples: Array<{duration: string, medication: string, file: string}>;\n  };\n  refillPatterns: {\n    noRefills: number;\n    lowRefills: number; // 1-3\n    normalRefills: number; // 4-11\n    highRefills: number; // 12+\n    unlimited: number;\n  };\n}\n\nfunction extractNumericDose(doseText: string): { value: number; unit: string } | null {\n  // Common patterns for doses\n  const patterns = [\n    /(\\d+(?:\\.\\d+)?)\\s*(mg|g|mcg|μg|units?|ml|tablets?|capsules?)/i,\n    /(\\d+(?:\\.\\d+)?)\\s*(milligrams?|grams?|micrograms?|milliliters?)/i\n  ];\n  \n  for (const pattern of patterns) {\n    const match = doseText.match(pattern);\n    if (match) {\n      return {\n        value: parseFloat(match[1]),\n        unit: match[2].toLowerCase()\n      };\n    }\n  }\n  return null;\n}\n\nfunction parseDuration(text: string): number | null {\n  // Extract duration in days\n  const patterns = [\n    /(\\d+)\\s*days?/i,\n    /(\\d+)\\s*weeks?/i,\n    /(\\d+)\\s*months?/i,\n    /(\\d+)\\s*years?/i\n  ];\n  \n  const dayMatch = text.match(patterns[0]);\n  if (dayMatch) return parseInt(dayMatch[1]);\n  \n  const weekMatch = text.match(patterns[1]);\n  if (weekMatch) return parseInt(weekMatch[1]) * 7;\n  \n  const monthMatch = text.match(patterns[2]);\n  if (monthMatch) return parseInt(monthMatch[1]) * 30;\n  \n  const yearMatch = text.match(patterns[3]);\n  if (yearMatch) return parseInt(yearMatch[1]) * 365;\n  \n  return null;\n}\n\nasync function analyzeMedications() {\n  console.log('=== Medication Data Outlier Analysis ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  const loader = new FhirLoader(dataDir);\n  \n  // Load a sample of files for analysis\n  const allFiles = loader.getAvailableFiles();\n  const sampleFiles = [\n    ...allFiles.slice(0, 5), // Small files\n    ...allFiles.slice(Math.floor(allFiles.length / 2) - 5, Math.floor(allFiles.length / 2) + 5), // Medium files\n    ...allFiles.slice(-5) // Large files\n  ];\n  \n  console.log(`Analyzing medications in ${sampleFiles.length} files...`);\n  \n  const analysis: MedicationAnalysis = {\n    totalMedicationRequests: 0,\n    totalMedicationAdministrations: 0,\n    statusDistribution: {},\n    intentDistribution: {},\n    priorityDistribution: {},\n    dosagePatterns: {\n      texts: {},\n      routes: {},\n      frequencies: {},\n      methods: {}\n    },\n    doseRanges: {\n      values: [],\n      units: {},\n      outliers: [],\n      extremeLow: [],\n      extremeHigh: []\n    },\n    medicationCodes: {},\n    medicationNames: {},\n    durationPatterns: {\n      short: 0,\n      normal: 0,\n      long: 0,\n      extreme: 0,\n      examples: []\n    },\n    refillPatterns: {\n      noRefills: 0,\n      lowRefills: 0,\n      normalRefills: 0,\n      highRefills: 0,\n      unlimited: 0\n    }\n  };\n  \n  for (const fileName of sampleFiles) {\n    try {\n      const result = await loader.loadBundle(fileName);\n      if (!result.success || !result.bundle) continue;\n      \n      const medicationRequests = extractResourcesByType(result.bundle, 'MedicationRequest') as MedicationRequestType[];\n      const medicationAdmins = extractResourcesByType(result.bundle, 'MedicationAdministration') as MedicationAdministrationType[];\n      \n      // Analyze MedicationRequests\n      for (const medReq of medicationRequests) {\n        analysis.totalMedicationRequests++;\n        \n        // Status distribution\n        if (medReq.status) {\n          analysis.statusDistribution[medReq.status] = \n            (analysis.statusDistribution[medReq.status] || 0) + 1;\n        }\n        \n        // Intent distribution\n        if (medReq.intent) {\n          analysis.intentDistribution[medReq.intent] = \n            (analysis.intentDistribution[medReq.intent] || 0) + 1;\n        }\n        \n        // Priority distribution\n        if (medReq.priority) {\n          analysis.priorityDistribution[medReq.priority] = \n            (analysis.priorityDistribution[medReq.priority] || 0) + 1;\n        }\n        \n        // Medication names/codes\n        let medicationName = 'Unknown';\n        if (medReq.medicationCodeableConcept?.text) {\n          medicationName = medReq.medicationCodeableConcept.text;\n          analysis.medicationNames[medicationName] = \n            (analysis.medicationNames[medicationName] || 0) + 1;\n        }\n        \n        if (medReq.medicationCodeableConcept?.coding?.[0]?.code) {\n          const code = medReq.medicationCodeableConcept.coding[0].code;\n          analysis.medicationCodes[code] = \n            (analysis.medicationCodes[code] || 0) + 1;\n        }\n        \n        // Dosage patterns\n        if (medReq.dosageInstruction) {\n          for (const dosage of medReq.dosageInstruction) {\n            // Dosage text patterns\n            if (dosage.text) {\n              analysis.dosagePatterns.texts[dosage.text] = \n                (analysis.dosagePatterns.texts[dosage.text] || 0) + 1;\n              \n              // Extract numeric dose\n              const dose = extractNumericDose(dosage.text);\n              if (dose) {\n                analysis.doseRanges.values.push(dose.value);\n                analysis.doseRanges.units[dose.unit] = \n                  (analysis.doseRanges.units[dose.unit] || 0) + 1;\n                \n                // Check for extreme doses\n                if (dose.value < 0.01) {\n                  analysis.doseRanges.extremeLow.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                } else if (dose.value > 10000) {\n                  analysis.doseRanges.extremeHigh.push({\n                    value: dose.value,\n                    unit: dose.unit,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n              \n              // Extract duration\n              const duration = parseDuration(dosage.text);\n              if (duration) {\n                if (duration < 1) {\n                  analysis.durationPatterns.short++;\n                } else if (duration <= 30) {\n                  analysis.durationPatterns.normal++;\n                } else if (duration <= 365) {\n                  analysis.durationPatterns.long++;\n                } else {\n                  analysis.durationPatterns.extreme++;\n                  analysis.durationPatterns.examples.push({\n                    duration: `${duration} days`,\n                    medication: medicationName,\n                    file: fileName\n                  });\n                }\n              }\n            }\n            \n            // Route patterns\n            if (dosage.route?.text) {\n              analysis.dosagePatterns.routes[dosage.route.text] = \n                (analysis.dosagePatterns.routes[dosage.route.text] || 0) + 1;\n            }\n            \n            // Method patterns\n            if (dosage.method?.text) {\n              analysis.dosagePatterns.methods[dosage.method.text] = \n                (analysis.dosagePatterns.methods[dosage.method.text] || 0) + 1;\n            }\n            \n            // Timing/frequency patterns\n            if (dosage.timing?.repeat?.frequency) {\n              const freq = `${dosage.timing.repeat.frequency}x per ${dosage.timing.repeat.periodUnit || 'period'}`;\n              analysis.dosagePatterns.frequencies[freq] = \n                (analysis.dosagePatterns.frequencies[freq] || 0) + 1;\n            }\n          }\n        }\n        \n        // Refill patterns\n        if (medReq.dispenseRequest?.numberOfRepeatsAllowed !== undefined) {\n          const refills = medReq.dispenseRequest.numberOfRepeatsAllowed;\n          if (refills === 0) {\n            analysis.refillPatterns.noRefills++;\n          } else if (refills <= 3) {\n            analysis.refillPatterns.lowRefills++;\n          } else if (refills <= 11) {\n            analysis.refillPatterns.normalRefills++;\n          } else if (refills < 100) {\n            analysis.refillPatterns.highRefills++;\n          } else {\n            analysis.refillPatterns.unlimited++;\n          }\n        }\n      }\n      \n      // Analyze MedicationAdministrations\n      analysis.totalMedicationAdministrations += medicationAdmins.length;\n      \n    } catch (error) {\n      console.error(`Error analyzing medications in ${fileName}:`, error);\n    }\n  }\n  \n  // Detect outliers in doses\n  if (analysis.doseRanges.values.length > 0) {\n    const sorted = [...analysis.doseRanges.values].sort((a, b) => a - b);\n    const q1 = sorted[Math.floor(sorted.length * 0.25)];\n    const q3 = sorted[Math.floor(sorted.length * 0.75)];\n    const iqr = q3 - q1;\n    const lowerBound = q1 - 1.5 * iqr;\n    const upperBound = q3 + 1.5 * iqr;\n    \n    // Find outliers (simplified - just mark extreme values)\n    analysis.doseRanges.values.forEach(value => {\n      if (value < lowerBound || value > upperBound) {\n        // Would need to trace back to specific medication, simplified for now\n      }\n    });\n  }\n  \n  // Print results\n  console.log(`\\n=== MEDICATION ANALYSIS RESULTS ===`);\n  console.log(`Total medication requests: ${analysis.totalMedicationRequests}`);\n  console.log(`Total medication administrations: ${analysis.totalMedicationAdministrations}\\n`);\n  \n  console.log('STATUS DISTRIBUTION:');\n  Object.entries(analysis.statusDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([status, count]) => \n      console.log(`- ${status}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  console.log('\\nINTENT DISTRIBUTION:');\n  Object.entries(analysis.intentDistribution)\n    .sort(([,a], [,b]) => b - a)\n    .forEach(([intent, count]) => \n      console.log(`- ${intent}: ${count} (${(count/analysis.totalMedicationRequests*100).toFixed(1)}%)`));\n  \n  if (Object.keys(analysis.priorityDistribution).length > 0) {\n    console.log('\\nPRIORITY DISTRIBUTION:');\n    Object.entries(analysis.priorityDistribution)\n      .sort(([,a], [,b]) => b - a)\n      .forEach(([priority, count]) => \n        console.log(`- ${priority}: ${count}`));\n  }\n  \n  console.log('\\nTOP MEDICATIONS:');\n  Object.entries(analysis.medicationNames)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([name, count]) => console.log(`- ${name}: ${count}`));\n  \n  console.log('\\nDOSE ANALYSIS:');\n  if (analysis.doseRanges.values.length > 0) {\n    console.log(`- Total doses analyzed: ${analysis.doseRanges.values.length}`);\n    console.log(`- Dose range: ${Math.min(...analysis.doseRanges.values)} - ${Math.max(...analysis.doseRanges.values)}`);\n    console.log(`- Mean dose: ${(analysis.doseRanges.values.reduce((a, b) => a + b, 0) / analysis.doseRanges.values.length).toFixed(2)}`);\n  }\n  \n  console.log('\\nTOP DOSE UNITS:');\n  Object.entries(analysis.doseRanges.units)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([unit, count]) => console.log(`- ${unit}: ${count}`));\n  \n  console.log('\\nROUTE PATTERNS:');\n  Object.entries(analysis.dosagePatterns.routes)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([route, count]) => console.log(`- ${route}: ${count}`));\n  \n  console.log('\\nFREQUENCY PATTERNS:');\n  Object.entries(analysis.dosagePatterns.frequencies)\n    .sort(([,a], [,b]) => b - a)\n    .slice(0, 10)\n    .forEach(([freq, count]) => console.log(`- ${freq}: ${count}`));\n  \n  console.log('\\nDURATION PATTERNS:');\n  console.log(`- Short duration (<1 day): ${analysis.durationPatterns.short}`);\n  console.log(`- Normal duration (1-30 days): ${analysis.durationPatterns.normal}`);\n  console.log(`- Long duration (30-365 days): ${analysis.durationPatterns.long}`);\n  console.log(`- Extreme duration (>365 days): ${analysis.durationPatterns.extreme}`);\n  if (analysis.durationPatterns.examples.length > 0) {\n    console.log('  Examples of extreme durations:');\n    analysis.durationPatterns.examples.slice(0, 3).forEach(ex => \n      console.log(`    ${ex.medication}: ${ex.duration} (${ex.file})`));\n  }\n  \n  console.log('\\nREFILL PATTERNS:');\n  console.log(`- No refills: ${analysis.refillPatterns.noRefills}`);\n  console.log(`- Low refills (1-3): ${analysis.refillPatterns.lowRefills}`);\n  console.log(`- Normal refills (4-11): ${analysis.refillPatterns.normalRefills}`);\n  console.log(`- High refills (12+): ${analysis.refillPatterns.highRefills}`);\n  console.log(`- Unlimited refills: ${analysis.refillPatterns.unlimited}`);\n  \n  if (analysis.doseRanges.extremeLow.length > 0) {\n    console.log('\\nEXTREMELY LOW DOSES (<0.01):');\n    analysis.doseRanges.extremeLow.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  if (analysis.doseRanges.extremeHigh.length > 0) {\n    console.log('\\nEXTREMELY HIGH DOSES (>10000):');\n    analysis.doseRanges.extremeHigh.slice(0, 5).forEach(dose => \n      console.log(`- ${dose.medication}: ${dose.value} ${dose.unit} (${dose.file})`));\n  }\n  \n  return analysis;\n}\n\nif (require.main === module) {\n  analyzeMedications().catch(console.error);\n}\n\nexport { analyzeMedications };"}}}
