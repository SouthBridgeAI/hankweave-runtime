tion of diagnostic tests\n * This includes lab results, pathology reports, imaging reports, etc.\n */\nexport const DiagnosticReport = BaseResource.extend({\n  resourceType: z.literal('DiagnosticReport').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business identifier for report'),\n  basedOn: z.array(Reference).optional().describe('What was requested'),\n  status: z.enum(['registered', 'partial', 'preliminary', 'final', 'amended', 'corrected', 'appended', 'cancelled', 'entered-in-error', 'unknown']).describe('The status of the diagnostic report'),\n  category: z.array(CodeableConcept).optional().describe('Service category'),\n  code: CodeableConcept.describe('Name/Code for this diagnostic report'),\n  subject: Reference.optional().describe('The subject of the report - usually, but not always, the patient'),\n  encounter: Reference.optional().describe('Health care event when test ordered'),\n  effectiveDateTime: FhirDateTime.optional().describe('Clinically relevant time/time-period for report'),\n  effectivePeriod: Period.optional().describe('Clinically relevant time/time-period for report'),\n  issued: FhirDateTime.optional().describe('DateTime this version was made available'),\n  performer: z.array(Reference).optional().describe('Responsible Diagnostic Service'),\n  resultsInterpreter: z.array(Reference).optional().describe('Primary result interpreter'),\n  specimen: z.array(Reference).optional().describe('Specimens this report is based on'),\n  result: z.array(Reference).optional().describe('Observations'),\n  imagingStudy: z.array(Reference).optional().describe('Reference to full details of imaging associated with the diagnostic report'),\n  media: z.array(z.object({\n    comment: FhirString.optional().describe('Comment about the image'),\n    link: Reference.describe('Reference to the image source')\n  })).optional().describe('Key images associated with this report'),\n  conclusion: FhirString.optional().describ