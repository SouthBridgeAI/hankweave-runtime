[2025-07-10T09:32:17.887Z] [OUT] {"id":"1752139937886-5prms78hn","timestamp":"2025-07-10T09:32:17.886Z","type":"assistant.action","data":{"phaseId":"phase-1","action":"tool_use","content":"","toolName":"Write","toolInput":{"file_path":"/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/typescript_code/src/quick-and-dirty/analyze-fhir-files.ts","content":"import * as fs from 'fs';\nimport * as path from 'path';\n\ninterface FileAnalysis {\n  filename: string;\n  fileSize: number;\n  entryCount: number;\n  patientName: string;\n  patientBirthDate: string;\n  patientGender: string;\n  patientCity: string;\n  resourceCounts: Record<string, number>;\n  dateRange: {\n    earliest: string;\n    latest: string;\n  };\n}\n\nasync function analyzeFile(filePath: string): Promise<FileAnalysis> {\n  try {\n    const content = fs.readFileSync(filePath, 'utf8');\n    const data = JSON.parse(content);\n    \n    const filename = path.basename(filePath);\n    const fileSize = fs.statSync(filePath).size;\n    const entryCount = data.entry.length;\n    \n    // Get patient info (first entry should be Patient)\n    const patient = data.entry[0].resource;\n    const patientName = `${patient.name[0].given.join(' ')} ${patient.name[0].family}`;\n    const patientBirthDate = patient.birthDate;\n    const patientGender = patient.gender;\n    const patientCity = patient.address[0].city;\n    \n    // Count resource types\n    const resourceCounts: Record<string, number> = {};\n    data.entry.forEach((entry: any) => {\n      const resourceType = entry.resource.resourceType;\n      resourceCounts[resourceType] = (resourceCounts[resourceType] || 0) + 1;\n    });\n    \n    // Find date range\n    const dates: string[] = [];\n    data.entry.forEach((entry: any) => {\n      const resource = entry.resource;\n      if (resource.effectiveDateTime) {\n        dates.push(resource.effectiveDateTime);\n      }\n      if (resource.period?.start) {\n        dates.push(resource.period.start);\n      }\n    });\n    \n    dates.sort();\n    const dateRange = {\n      earliest: dates[0] || 'N/A',\n      latest: dates[dates.length - 1] || 'N/A'\n    };\n    \n    return {\n      filename,\n      fileSize,\n      entryCount,\n      patientName,\n      patientBirthDate,\n      patientGender,\n      patientCity,\n      resourceCounts,\n      dateRange\n    };\n  } catch (error) {\n    console.error(`Error analyzing ${filePath}:`, error);\n    throw error;\n  }\n}\n\nasync function main() {\n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  // Get all JSON files\n  const files = fs.readdirSync(dataDir)\n    .filter(f => f.endsWith('.json'))\n    .map(f => path.join(dataDir, f));\n  \n  console.log(`Found ${files.length} JSON files`);\n  \n  // Analyze a sample of files (first 10 and last 10 by size)\n  const fileSizes = files.map(f => ({\n    path: f,\n    size: fs.statSync(f).size\n  })).sort((a, b) => b.size - a.size);\n  \n  const samplesToAnalyze = [\n    ...fileSizes.slice(0, 5), // 5 largest\n    ...fileSizes.slice(-5)    // 5 smallest\n  ];\n  \n  console.log('Analyzing sample files...');\n  const analyses: FileAnalysis[] = [];\n  \n  for (const file of samplesToAnalyze) {\n    try {\n      console.log(`Analyzing ${path.basename(file.path)} (${(file.size / 1024 / 1024).toFixed(1)}MB)`);\n      const analysis = await analyzeFile(file.path);\n      analyses.push(analysis);\n    } catch (error) {\n      console.error(`Failed to analyze ${file.path}`);\n    }\n  }\n  \n  // Print summary\n  console.log('\\n=== ANALYSIS SUMMARY ===');\n  console.log('File Size Distribution:');\n  analyses.forEach(a => {\n    console.log(`${a.filename}: ${(a.fileSize / 1024 / 1024).toFixed(1)}MB, ${a.entryCount} entries`);\n  });\n  \n  console.log('\\nResource Type Patterns:');\n  const allResourceTypes = new Set<string>();\n  analyses.forEach(a => Object.keys(a.resourceCounts).forEach(type => allResourceTypes.add(type)));\n  \n  Array.from(allResourceTypes).sort().forEach(resourceType => {\n    const counts = analyses.map(a => a.resourceCounts[resourceType] || 0);\n    const min = Math.min(...counts);\n    const max = Math.max(...counts);\n    const avg = counts.reduce((a, b) => a + b, 0) / counts.length;\n    console.log(`${resourceType}: min=${min}, max=${max}, avg=${avg.toFixed(1)}`);\n  });\n  \n  console.log('\\nPatient Demographics:');\n  analyses.forEach(a => {\n    console.log(`${a.patientName} (${a.patientGender}, born ${a.patientBirthDate}) - ${a.patientCity}`);\n  });\n}\n\nmain().catch(console.error);"}}}
