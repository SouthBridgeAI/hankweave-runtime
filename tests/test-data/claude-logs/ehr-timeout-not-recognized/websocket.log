[2025-07-10T09:45:05.919Z] [OUT] {"id":"1752140705919-pyenl7msw","timestamp":"2025-07-10T09:45:05.919Z","type":"file.updated","data":{"path":"typescript_code/src/validations/schema-validation.ts","filename":"schema-validation.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { DATASET_INFO } from '../schema';\n\n/**\n * Schema Validation Script\n * \n * This script validates the FHIR schemas against the actual dataset files.\n * It tests both successful parsing and validation of the data.\n */\n\nasync function validateSchemas() {\n  console.log('=== FHIR Schema Validation ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  try {\n    const loader = new FhirLoader(dataDir);\n    const availableFiles = loader.getAvailableFiles();\n    \n    console.log(`Found ${availableFiles.length} FHIR files`);\n    console.log(`Dataset Info: ${DATASET_INFO.name}`);\n    console.log(`Expected patients: ${DATASET_INFO.totalPatients}`);\n    console.log(`File size range: ${DATASET_INFO.fileSize.min} - ${DATASET_INFO.fileSize.max}`);\n    console.log(`Entry count range: ${DATASET_INFO.entryCount.min} - ${DATASET_INFO.entryCount.max}\\n`);\n    \n    // Test with a few representative files\n    const filesToTest = [\n      // Smallest file (newborn)\n      availableFiles.find(f => f.includes('Travis723')) || availableFiles[0],\n      // Medium file\n      availableFiles[Math.floor(availableFiles.length / 2)],\n      // Largest file (would be too slow, so we'll use second largest)\n      availableFiles.find(f => f.includes('Mercedes82')) || availableFiles[availableFiles.length - 1]\n    ].filter(f => f !== undefined);\n    \n    console.log(`Testing ${filesToTest.length} representative files:\\n`);\n    \n    let successCount = 0;\n    let errorCount = 0;\n    const allErrors: string[] = [];\n    const allWarnings: string[] = [];\n    \n    for (const fileName of filesToTest) {\n      console.log(`--- Testing ${fileName} ---`);\n      \n      const result = await loader.loadBundle(fileName);\n      \n      if (result.success) {\n        successCount++;\n        console.log(`✅ Successfully loaded and validated`);\n        \n        if (result.metadata) {\n          console.log(`   File size: ${(result.metadata.fileSize / 1024 / 1024).toFixed(2)}MB`);\n          console.log(`   Entry count: ${result.metadata.entryCount}`);\n          console.log(`   Patient category: ${result.metadata.patientCategory}`);\n          console.log(`   Load time: ${result.metadata.loadTime}ms`);\n        }\n        \n        if (result.patient) {\n          const name = result.patient.name?.[0] ? \n            `${result.patient.name[0].given?.join(' ')} ${result.patient.name[0].family}` : \n            'Unknown';\n          console.log(`   Patient: ${name} (${result.patient.gender}, born ${result.patient.birthDate})`);\n        }\n        \n        if (result.resourceCounts) {\n          const topResources = Object.entries(result.resourceCounts)\n            .sort((a, b) => b[1] - a[1])\n            .slice(0, 5)\n            .map(([type, count]) => `${type}:${count}`)\n            .join(', ');\n          console.log(`   Top resources: ${topResources}`);\n        }\n        \n        if (result.warnings && result.warnings.length > 0) {\n          console.log(`   ⚠️  Warnings: ${result.warnings.length}`);\n          result.warnings.forEach(warning => {\n            console.log(`      - ${warning}`);\n            allWarnings.push(`${fileName}: ${warning}`);\n          });\n        }\n        \n      } else {\n        errorCount++;\n        console.log(`❌ Failed to load/validate`);\n        \n        if (result.errors) {\n          result.errors.forEach(error => {\n            console.log(`   Error: ${error}`);\n            allErrors.push(`${fileName}: ${error}`);\n          });\n        }\n      }\n      \n      console.log('');\n    }\n    \n    // Summary\n    console.log('=== VALIDATION SUMMARY ===');\n    console.log(`✅ Successful: ${successCount}/${filesToTest.length}`);\n    console.log(`❌ Failed: ${errorCount}/${filesToTest.length}`);\n    console.log(`⚠️  Total warnings: ${allWarnings.length}`);\n    console.log(`❌ Total errors: ${allErrors.length}`);\n    \n    if (allErrors.length > 0) {\n      console.log('\\n=== ALL ERRORS ===');\n      allErrors.forEach(error => console.log(`❌ ${error}`));\n    }\n    \n    if (allWarnings.length > 0) {\n      console.log('\\n=== ALL WARNINGS ===');\n      allWarnings.forEach(warning => console.log(`⚠️  ${warning}`));\n    }\n    \n    // Get cache stats\n    const cacheStats = loader.getCacheStats();\n    console.log(`\\nCache stats: ${cacheStats.cachedFiles} files cached, ${cacheStats.successfulLoads} successful, ${cacheStats.failedLoads} failed`);\n    \n    // Test specific schema features\n    console.log('\\n=== SCHEMA FEATURE TESTS ===');\n    \n    // Test a successful bundle\n    const successfulResult = await loader.loadBundle(filesToTest[0]);\n    if (successfulResult.success && successfulResult.bundle) {\n      const bundle = successfulResult.bundle;\n      \n      console.log('✅ Bundle validation passed');\n      \n      // Test patient extraction\n      const patient = loader.extractPatient(bundle);\n      console.log(`✅ Patient extraction: ${patient ? 'success' : 'failed'}`);\n      \n      // Test observation extraction\n      const observations = loader.extractObservations(bundle);\n      console.log(`✅ Observation extraction: ${observations.length} observations found`);\n      \n      // Test bundle stats\n      const stats = loader.getBundleStats(bundle);\n      console.log(`✅ Bundle stats: ${stats.totalEntries} entries, ${stats.resourceTypes} resource types`);\n      \n      // Test validation\n      const validation = loader.validateBundle(bundle);\n      console.log(`✅ Bundle validation: ${validation.isValid ? 'valid' : 'has issues'}`);\n    }\n    \n    console.log('\\n=== VALIDATION COMPLETE ===');\n    return { successCount, errorCount, allErrors, allWarnings };\n    \n  } catch (error) {\n    console.error('Fatal error during validation:', error);\n    return { successCount: 0, errorCount: 1, allErrors: [error instanceof Error ? error.message : 'Unknown error'], allWarnings: [] };\n  }\n}\n\n// Run validation if this script is executed directly\nif (require.main === module) {\n  validateSchemas().then(result => {\n    if (result.errorCount > 0) {\n      process.exit(1);\n    }\n  }).catch(error => {\n    console.error('Script failed:', error);\n    process.exit(1);\n  });\n}\n\nexport { validateSchemas };","action":"created"}}
[2025-07-10T09:45:05.920Z] [OUT] {"id":"1752140705920-q9fs11nhs","timestamp":"2025-07-10T09:45:05.920Z","type":"assistant.action","data":{"phaseId":"phase-2","action":"tool_use","content":"","toolName":"Write","toolInput":{"file_path":"/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/typescript_code/src/validations/schema-validation.ts","content":"import { FhirLoader } from '../loaders/fhir-loader';\nimport { DATASET_INFO } from '../schema';\n\n/**\n * Schema Validation Script\n * \n * This script validates the FHIR schemas against the actual dataset files.\n * It tests both successful parsing and validation of the data.\n */\n\nasync function validateSchemas() {\n  console.log('=== FHIR Schema Validation ===\\n');\n  \n  const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n  \n  try {\n    const loader = new FhirLoader(dataDir);\n    const availableFiles = loader.getAvailableFiles();\n    \n    console.log(`Found ${availableFiles.length} FHIR files`);\n    console.log(`Dataset Info: ${DATASET_INFO.name}`);\n    console.log(`Expected patients: ${DATASET_INFO.totalPatients}`);\n    console.log(`File size range: ${DATASET_INFO.fileSize.min} - ${DATASET_INFO.fileSize.max}`);\n    console.log(`Entry count range: ${DATASET_INFO.entryCount.min} - ${DATASET_INFO.entryCount.max}\\n`);\n    \n    // Test with a few representative files\n    const filesToTest = [\n      // Smallest file (newborn)\n      availableFiles.find(f => f.includes('Travis723')) || availableFiles[0],\n      // Medium file\n      availableFiles[Math.floor(availableFiles.length / 2)],\n      // Largest file (would be too slow, so we'll use second largest)\n      availableFiles.find(f => f.includes('Mercedes82')) || availableFiles[availableFiles.length - 1]\n    ].filter(f => f !== undefined);\n    \n    console.log(`Testing ${filesToTest.length} representative files:\\n`);\n    \n    let successCount = 0;\n    let errorCount = 0;\n    const allErrors: string[] = [];\n    const allWarnings: string[] = [];\n    \n    for (const fileName of filesToTest) {\n      console.log(`--- Testing ${fileName} ---`);\n      \n      const result = await loader.loadBundle(fileName);\n      \n      if (result.success) {\n        successCount++;\n        console.log(`✅ Successfully loaded and validated`);\n        \n        if (result.metadata) {\n          console.log(`   File size: ${(result.metadata.fileSize / 1024 / 1024).toFixed(2)}MB`);\n          console.log(`   Entry count: ${result.metadata.entryCount}`);\n          console.log(`   Patient category: ${result.metadata.patientCategory}`);\n          console.log(`   Load time: ${result.metadata.loadTime}ms`);\n        }\n        \n        if (result.patient) {\n          const name = result.patient.name?.[0] ? \n            `${result.patient.name[0].given?.join(' ')} ${result.patient.name[0].family}` : \n            'Unknown';\n          console.log(`   Patient: ${name} (${result.patient.gender}, born ${result.patient.birthDate})`);\n        }\n        \n        if (result.resourceCounts) {\n          const topResources = Object.entries(result.resourceCounts)\n            .sort((a, b) => b[1] - a[1])\n            .slice(0, 5)\n            .map(([type, count]) => `${type}:${count}`)\n            .join(', ');\n          console.log(`   Top resources: ${topResources}`);\n        }\n        \n        if (result.warnings && result.warnings.length > 0) {\n          console.log(`   ⚠️  Warnings: ${result.warnings.length}`);\n          result.warnings.forEach(warning => {\n            console.log(`      - ${warning}`);\n            allWarnings.push(`${fileName}: ${warning}`);\n          });\n        }\n        \n      } else {\n        errorCount++;\n        console.log(`❌ Failed to load/validate`);\n        \n        if (result.errors) {\n          result.errors.forEach(error => {\n            console.log(`   Error: ${error}`);\n            allErrors.push(`${fileName}: ${error}`);\n          });\n        }\n      }\n      \n      console.log('');\n    }\n    \n    // Summary\n    console.log('=== VALIDATION SUMMARY ===');\n    console.log(`✅ Successful: ${successCount}/${filesToTest.length}`);\n    console.log(`❌ Failed: ${errorCount}/${filesToTest.length}`);\n    console.log(`⚠️  Total warnings: ${allWarnings.length}`);\n    console.log(`❌ Total errors: ${allErrors.length}`);\n    \n    if (allErrors.length > 0) {\n      console.log('\\n=== ALL ERRORS ===');\n      allErrors.forEach(error => console.log(`❌ ${error}`));\n    }\n    \n    if (allWarnings.length > 0) {\n      console.log('\\n=== ALL WARNINGS ===');\n      allWarnings.forEach(warning => console.log(`⚠️  ${warning}`));\n    }\n    \n    // Get cache stats\n    const cacheStats = loader.getCacheStats();\n    console.log(`\\nCache stats: ${cacheStats.cachedFiles} files cached, ${cacheStats.successfulLoads} successful, ${cacheStats.failedLoads} failed`);\n    \n    // Test specific schema features\n    console.log('\\n=== SCHEMA FEATURE TESTS ===');\n    \n    // Test a successful bundle\n    const successfulResult = await loader.loadBundle(filesToTest[0]);\n    if (successfulResult.success && successfulResult.bundle) {\n      const bundle = successfulResult.bundle;\n      \n      console.log('✅ Bundle validation passed');\n      \n      // Test patient extraction\n      const patient = loader.extractPatient(bundle);\n      console.log(`✅ Patient extraction: ${patient ? 'success' : 'failed'}`);\n      \n      // Test observation extraction\n      const observations = loader.extractObservations(bundle);\n      console.log(`✅ Observation extraction: ${observations.length} observations found`);\n      \n      // Test bundle stats\n      const stats = loader.getBundleStats(bundle);\n      console.log(`✅ Bundle stats: ${stats.totalEntries} entries, ${stats.resourceTypes} resource types`);\n      \n      // Test validation\n      const validation = loader.validateBundle(bundle);\n      console.log(`✅ Bundle validation: ${validation.isValid ? 'valid' : 'has issues'}`);\n    }\n    \n    console.log('\\n=== VALIDATION COMPLETE ===');\n    return { successCount, errorCount, allErrors, allWarnings };\n    \n  } catch (error) {\n    console.error('Fatal error during validation:', error);\n    return { successCount: 0, errorCount: 1, allErrors: [error instanceof Error ? error.message : 'Unknown error'], allWarnings: [] };\n  }\n}\n\n// Run validation if this script is executed directly\nif (require.main === module) {\n  validateSchemas().then(result => {\n    if (result.errorCount > 0) {\n      process.exit(1);\n    }\n  }).catch(error => {\n    console.error('Script failed:', error);\n    process.exit(1);\n  });\n}\n\nexport { validateSchemas };"}}}
