[2025-07-10T09:51:17.276Z] [OUT] {"id":"1752141077276-g7z1kjhng","timestamp":"2025-07-10T09:51:17.276Z","type":"file.updated","data":{"path":"typescript_code/src/loaders/fhir-loader.ts","filename":"fhir-loader.ts","content":"import * as fs from 'fs';\nimport * as path from 'path';\nimport { \n  validateTransactionBundle, \n  extractPatientFromBundle, \n  getResourceCounts,\n  extractResourcesByType,\n  DATASET_UTILS,\n  validatePatientBundle,\n  type BundleType,\n  type PatientType,\n  type ObservationType \n} from '../schema';\nimport { TransactionBundle } from '../schema/fhir-bundle';\n\n/**\n * FHIR Loader for Healthcare EHR Dataset\n * \n * This loader provides functionality to:\n * - Load and validate FHIR bundle files\n * - Extract patient information\n * - Analyze resource distributions\n * - Validate against schema and dataset assumptions\n * \n * Usage:\n * ```typescript\n * const loader = new FhirLoader('/path/to/fhir/data');\n * const bundle = await loader.loadBundle('patient-file.json');\n * const patient = loader.extractPatient(bundle);\n * ```\n */\n\nexport interface LoadResult {\n  success: boolean;\n  bundle?: BundleType;\n  patient?: PatientType;\n  resourceCounts?: Record<string, number>;\n  errors?: string[];\n  warnings?: string[];\n  metadata?: {\n    fileName: string;\n    fileSize: number;\n    entryCount: number;\n    patientCategory: string;\n    loadTime: number;\n  };\n}\n\nexport interface ValidationResult {\n  isValid: boolean;\n  schemaErrors?: string[];\n  datasetWarnings?: string[];\n  resourceTypeIssues?: string[];\n  patientDataIssues?: string[];\n}\n\nexport class FhirLoader {\n  private dataDir: string;\n  private loadedFiles: Map<string, LoadResult> = new Map();\n  \n  constructor(dataDirectory: string) {\n    this.dataDir = dataDirectory;\n    if (!fs.existsSync(dataDirectory)) {\n      throw new Error(`Data directory does not exist: ${dataDirectory}`);\n    }\n  }\n  \n  /**\n   * Load and validate a single FHIR bundle file\n   */\n  async loadBundle(fileName: string): Promise<LoadResult> {\n    const startTime = Date.now();\n    const filePath = path.join(this.dataDir, fileName);\n    \n    try {\n      // Check if already loaded\n      if (this.loadedFiles.has(fileName)) {\n        return this.loadedFiles.get(fileName)!;\n      }\n      \n      // Read file\n      if (!fs.existsSync(filePath)) {\n        return {\n          success: false,\n          errors: [`File not found: ${fileName}`],\n          metadata: {\n            fileName,\n            fileSize: 0,\n            entryCount: 0,\n            patientCategory: 'unknown',\n            loadTime: Date.now() - startTime\n          }\n        };\n      }\n      \n      const fileContent = fs.readFileSync(filePath, 'utf8');\n      const fileSize = fs.statSync(filePath).size;\n      \n      // Parse JSON\n      let jsonData: any;\n      try {\n        jsonData = JSON.parse(fileContent);\n      } catch (parseError) {\n        return {\n          success: false,\n          errors: [`JSON parse error: ${parseError instanceof Error ? parseError.message : 'Unknown error'}`],\n          metadata: {\n            fileName,\n            fileSize,\n            entryCount: 0,\n            patientCategory: 'unknown',\n            loadTime: Date.now() - startTime\n          }\n        };\n      }\n      \n      // Validate against schema\n      const validationResult = validatePatientBundle(jsonData);\n      if (!validationResult.success) {\n        const errors = validationResult.error?.issues?.map(issue => \n          typeof issue === 'string' ? issue : issue.message || 'Unknown validation error'\n        ) || ['Unknown validation error'];\n        \n        return {\n          success: false,\n          errors,\n          metadata: {\n            fileName,\n            fileSize,\n            entryCount: jsonData.entry?.length || 0,\n            patientCategory: DATASET_UTILS.estimatePatientCategory(jsonData.entry?.length || 0),\n            loadTime: Date.now() - startTime\n          }\n        };\n      }\n      \n      const bundle = validationResult.data;\n      const patient = extractPatientFromBundle(bundle);\n      const resourceCounts = getResourceCounts(bundle);\n      \n      // Additional validation and warnings\n      const warnings: string[] = [];\n      const validation = this.validateBundle(bundle);\n      \n      if (validation.datasetWarnings) {\n        warnings.push(...validation.datasetWarnings);\n      }\n      \n      if (validation.resourceTypeIssues) {\n        warnings.push(...validation.resourceTypeIssues);\n      }\n      \n      if (validation.patientDataIssues) {\n        warnings.push(...validation.patientDataIssues);\n      }\n      \n      const result: LoadResult = {\n        success: true,\n        bundle,\n        patient,\n        resourceCounts,\n        warnings: warnings.length > 0 ? warnings : undefined,\n        metadata: {\n          fileName,\n          fileSize,\n          entryCount: bundle.entry.length,\n          patientCategory: DATASET_UTILS.estimatePatientCategory(bundle.entry.length),\n          loadTime: Date.now() - startTime\n        }\n      };\n      \n      // Cache result\n      this.loadedFiles.set(fileName, result);\n      \n      return result;\n      \n    } catch (error) {\n      return {\n        success: false,\n        errors: [`Unexpected error: ${error instanceof Error ? error.message : 'Unknown error'}`],\n        metadata: {\n          fileName,\n          fileSize: 0,\n          entryCount: 0,\n          patientCategory: 'unknown',\n          loadTime: Date.now() - startTime\n        }\n      };\n    }\n  }\n  \n  /**\n   * Load multiple bundle files\n   */\n  async loadBundles(fileNames: string[]): Promise<LoadResult[]> {\n    const results: LoadResult[] = [];\n    \n    for (const fileName of fileNames) {\n      const result = await this.loadBundle(fileName);\n      results.push(result);\n    }\n    \n    return results;\n  }\n  \n  /**\n   * Load all JSON files in the data directory\n   */\n  async loadAllBundles(): Promise<LoadResult[]> {\n    const files = fs.readdirSync(this.dataDir)\n      .filter(file => file.endsWith('.json'))\n      .sort();\n    \n    return this.loadBundles(files);\n  }\n  \n  /**\n   * Get list of available files\n   */\n  getAvailableFiles(): string[] {\n    return fs.readdirSync(this.dataDir)\n      .filter(file => file.endsWith('.json'))\n      .sort();\n  }\n  \n  /**\n   * Validate a bundle against schema and dataset assumptions\n   */\n  validateBundle(bundle: BundleType): ValidationResult {\n    const result: ValidationResult = {\n      isValid: true,\n      datasetWarnings: [],\n      resourceTypeIssues: [],\n      patientDataIssues: []\n    };\n    \n    // Check dataset assumptions\n    const datasetIssues = DATASET_UTILS.validateDatasetAssumptions(bundle);\n    if (datasetIssues.length > 0) {\n      result.datasetWarnings = datasetIssues;\n    }\n    \n    // Check resource types\n    const resourceCounts = getResourceCounts(bundle);\n    const expectedTypes = DATASET_UTILS.getExpectedResourceTypes();\n    \n    // Check for missing common resource types\n    const missingTypes = expectedTypes.filter(type => !resourceCounts[type]);\n    if (missingTypes.length > 0) {\n      result.resourceTypeIssues?.push(`Missing expected resource types: ${missingTypes.join(', ')}`);\n    }\n    \n    // Check for unexpected resource types\n    const unexpectedTypes = Object.keys(resourceCounts).filter(type => !expectedTypes.includes(type as any));\n    if (unexpectedTypes.length > 0) {\n      result.resourceTypeIssues?.push(`Unexpected resource types: ${unexpectedTypes.join(', ')}`);\n    }\n    \n    // Validate patient data\n    const patient = extractPatientFromBundle(bundle);\n    if (patient) {\n      // Check patient name pattern\n      const firstName = patient.name?.[0]?.given?.[0];\n      const lastName = patient.name?.[0]?.family;\n      \n      if (firstName && !DATASET_UTILS.isValidPatientName(firstName)) {\n        result.patientDataIssues?.push(`Patient first name \"${firstName}\" doesn't match synthetic pattern`);\n      }\n      \n      if (lastName && !DATASET_UTILS.isValidPatientName(lastName)) {\n        result.patientDataIssues?.push(`Patient last name \"${lastName}\" doesn't match synthetic pattern`);\n      }\n      \n      // Check patient ID is UUID\n      if (patient.id && !DATASET_UTILS.isValidUUID(patient.id)) {\n        result.patientDataIssues?.push(`Patient ID \"${patient.id}\" is not a valid UUID`);\n      }\n      \n      // Check birth date format\n      if (patient.birthDate) {\n        const birthDate = new Date(patient.birthDate);\n        if (birthDate.getFullYear() < 1900 || birthDate.getFullYear() > 2030) {\n          result.patientDataIssues?.push(`Patient birth date \"${patient.birthDate}\" seems unrealistic`);\n        }\n      }\n    } else {\n      result.patientDataIssues?.push('No patient resource found in bundle');\n    }\n    \n    // Overall validation result\n    result.isValid = (\n      (result.datasetWarnings?.length || 0) === 0 &&\n      (result.resourceTypeIssues?.length || 0) === 0 &&\n      (result.patientDataIssues?.length || 0) === 0\n    );\n    \n    return result;\n  }\n  \n  /**\n   * Extract patient information from a bundle\n   */\n  extractPatient(bundle: BundleType): PatientType | undefined {\n    return extractPatientFromBundle(bundle);\n  }\n  \n  /**\n   * Extract all observations from a bundle\n   */\n  extractObservations(bundle: BundleType): ObservationType[] {\n    return extractResourcesByType(bundle, 'Observation') as ObservationType[];\n  }\n  \n  /**\n   * Get summary statistics for a bundle\n   */\n  getBundleStats(bundle: BundleType) {\n    const resourceCounts = getResourceCounts(bundle);\n    const patient = extractPatientFromBundle(bundle);\n    \n    return {\n      totalEntries: bundle.entry.length,\n      resourceTypes: Object.keys(resourceCounts).length,\n      resourceCounts,\n      patient: patient ? {\n        id: patient.id,\n        name: patient.name?.[0] ? \n          `${patient.name[0].given?.join(' ')} ${patient.name[0].family}` : \n          'Unknown',\n        gender: patient.gender,\n        birthDate: patient.birthDate,\n        address: patient.address?.[0]?.city\n      } : undefined,\n      patientCategory: DATASET_UTILS.estimatePatientCategory(bundle.entry.length)\n    };\n  }\n  \n  /**\n   * Get summary statistics for all loaded bundles\n   */\n  getAllBundleStats() {\n    const stats = Array.from(this.loadedFiles.values())\n      .filter(result => result.success && result.bundle)\n      .map(result => this.getBundleStats(result.bundle!));\n    \n    return {\n      totalBundles: stats.length,\n      totalEntries: stats.reduce((sum, stat) => sum + stat.totalEntries, 0),\n      resourceTypeCounts: stats.reduce((acc, stat) => {\n        Object.entries(stat.resourceCounts).forEach(([type, count]) => {\n          acc[type] = (acc[type] || 0) + count;\n        });\n        return acc;\n      }, {} as Record<string, number>),\n      patientCategories: stats.reduce((acc, stat) => {\n        acc[stat.patientCategory] = (acc[stat.patientCategory] || 0) + 1;\n        return acc;\n      }, {} as Record<string, number>)\n    };\n  }\n  \n  /**\n   * Clear loaded file cache\n   */\n  clearCache() {\n    this.loadedFiles.clear();\n  }\n  \n  /**\n   * Get cache statistics\n   */\n  getCacheStats() {\n    return {\n      cachedFiles: this.loadedFiles.size,\n      successfulLoads: Array.from(this.loadedFiles.values()).filter(result => result.success).length,\n      failedLoads: Array.from(this.loadedFiles.values()).filter(result => !result.success).length\n    };\n  }\n}","action":"modified"}}
