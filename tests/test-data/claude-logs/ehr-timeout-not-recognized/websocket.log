y result interpreter'),\n  specimen: z.array(Reference).optional().describe('Specimens this report is based on'),\n  result: z.array(Reference).optional().describe('Observations'),\n  imagingStudy: z.array(Reference).optional().describe('Reference to full details of imaging associated with the diagnostic report'),\n  media: z.array(z.object({\n    comment: FhirString.optional().describe('Comment about the image'),\n    link: Reference.describe('Reference to the image source')\n  })).optional().describe('Key images associated with this report'),\n  conclusion: FhirString.optional().describe('Clinical conclusion (interpretation) of test results'),\n  conclusionCode: z.array(CodeableConcept).optional().describe('Codes for the clinical conclusion of test results'),\n  presentedForm: z.array(Attachment).optional().describe('Entire report as issued')\n}).describe('DiagnosticReport resource - the findings and interpretation of diagnostic tests');\n\n/**\n * Immunization resource - describes the event of a patient being administered a vaccine\n * This includes vaccinations, immunizations, and inoculations\n */\nexport const Immunization = BaseResource.extend({\n  resourceType: z.literal('Immunization').describe('Resource type identifier'),\n  identifier: z.array(Identifier).optional().describe('Business identifier'),\n  status: z.enum(['completed', 'entered-in-error', 'not-done']).describe('Indicates the current status of the immunization event'),\n  statusReason: CodeableConcept.optional().describe('Reason not done'),\n  vaccineCode: CodeableConcept.describe('Vaccine product administered'),\n  patient: Reference.describe('Who was immunized'),\n  encounter: Reference.optional().describe('Encounter immunization was part of'),\n  occurrenceDateTime: FhirDateTime.optional().describe('Vaccine administration date'),\n  occurrenceString: FhirString.optional().describe('Vaccine administration date'),\n  recorded: FhirDateTime.optional().describe('When the immunization was first captured in the subject\\'s record'),\n  primarySource: FhirBoolean.optional().describe('Indicates context the data was recorded in'),\n  reportOrigin: CodeableConcept.optional().describe('Indicates the source of a secondarily reported record'),\n  location: Reference.optional().describe('Where immunization occurred'),\n  manufacturer: Reference.optional().describe('Vaccine manufacturer'),\n  lotNumber: FhirString.optional().describe('Vaccine lot number'),\n  expirationDate: FhirDate.optional().describe('Vaccine expiration date'),\n  site: CodeableConcept.optional().describe('Body site vaccine was administered'),\n  route: CodeableConcept.optional().describe('How vaccine entered body'),\n  doseQuantity: Quantity.optional().describe('Amount of vaccine administered'),\n  performer: z.array(z.object({\n    function: CodeableConcept.optional().describe('What type of performance was done'),\n    actor: Reference.describe('Individual or organization who was performing')\n  })).optional().describe('Who performed event'),\n  note: z.array(Annotation).optional().describe('Additional immunization notes'),\n  reasonCode: z.array(CodeableConcept).optional().describe('Why immunization occurred'),\n  reasonReference: z.array(Reference).optional().describe('Why immunization occurred'),\n  isSubpotent: FhirBoolean.optional().describe('Dose potency'),\n  subpotentReason: z.array(CodeableConcept).optional().describe('Reason for being subpotent'),\n  education: z.array(z.object({\n    documentType: FhirString.optional().describe('Educational material document identifier'),\n    reference: FhirUri.optional().describe('Educational material reference pointer'),\n    publicationDate: FhirDateTime.optional().describe('Educational material publication date'),\n    presentationDate: FhirDateTime.optional().describe('Educational material presentation date')\n  })).optional().describe('Educational material presented to patient'),\n  programEligibility: z.array(CodeableConcept).optional().describ