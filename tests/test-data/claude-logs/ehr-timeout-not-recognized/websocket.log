[2025-07-10T09:50:08.189Z] [OUT] {"id":"1752141008189-u5na4vz4x","timestamp":"2025-07-10T09:50:08.189Z","type":"file.updated","data":{"path":"typescript_code/src/validations/detailed-test.ts","filename":"detailed-test.ts","content":"import { z } from 'zod';\nimport { Patient } from '../schema/fhir-resources';\nimport * as fs from 'fs';\n\nasync function detailedTest() {\n  console.log('=== Detailed Schema Test ===\\n');\n  \n  try {\n    // Load the small file\n    const dataDir = '/Users/hrishioa/Dropbox/Projects/Southbridge/experiments/sealed-agents/tests/healthcare-ehr-langton/data/fhir';\n    const files = fs.readdirSync(dataDir).filter(f => f.endsWith('.json'));\n    const smallestFile = files.find(f => f.includes('Travis723')) || files[0];\n    \n    console.log(`Loading: ${smallestFile}`);\n    \n    const content = fs.readFileSync(`${dataDir}/${smallestFile}`, 'utf8');\n    const data = JSON.parse(content);\n    \n    // Test the first resource (Patient)\n    const patientResource = data.entry[0].resource;\n    console.log(`Testing Patient resource with resourceType: ${patientResource.resourceType}`);\n    console.log(`Patient has these keys: ${Object.keys(patientResource).join(', ')}`);\n    \n    const patientResult = Patient.safeParse(patientResource);\n    \n    if (patientResult.success) {\n      console.log('✅ Patient validation successful!');\n    } else {\n      console.log('❌ Patient validation failed');\n      console.log('Detailed errors:');\n      patientResult.error.issues.forEach((issue, index) => {\n        console.log(`  ${index + 1}. Path: ${issue.path.join('.')} - ${issue.message}`);\n        if (issue.path.length > 0) {\n          const value = issue.path.reduce((obj, key) => obj?.[key], patientResource);\n          console.log(`     Value: ${JSON.stringify(value)}`);\n        }\n      });\n    }\n    \n    // Test another resource type that's failing\n    const observationResource = data.entry.find(e => e.resource.resourceType === 'Observation')?.resource;\n    if (observationResource) {\n      const { Observation } = await import('../schema/fhir-resources');\n      console.log(`\\nTesting Observation resource...`);\n      \n      const obsResult = Observation.safeParse(observationResource);\n      if (obsResult.success) {\n        console.log('✅ Observation validation successful!');\n      } else {\n        console.log('❌ Observation validation failed');\n        console.log('First 5 errors:');\n        obsResult.error.issues.slice(0, 5).forEach((issue, index) => {\n          console.log(`  ${index + 1}. Path: ${issue.path.join('.')} - ${issue.message}`);\n        });\n      }\n    }\n    \n  } catch (error) {\n    console.error('❌ Test failed:', error);\n  }\n}\n\ndetailedTest();","action":"created"}}
