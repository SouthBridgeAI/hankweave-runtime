# Source files (we ship the built dist/ instead)
server/
scripts/

# Tests
tests/
*.test.ts
*.test.js

# Shim build artifacts (only index.js is needed at runtime)
shims/*/node_modules/
shims/*/tests/
shims/*/src/
shims/*/bun.lock
shims/*/tsconfig.json
shims/*/rebuild.sh
shims/*/docs/

# Same exclusions for dist/ copies (build step copies shims into dist/)
dist/shims/*/node_modules/
dist/shims/*/tests/
dist/shims/*/src/
dist/shims/*/bun.lock
dist/shims/*/tsconfig.json
dist/shims/*/rebuild.sh
dist/shims/*/docs/

# Development files
.vscode/
.idea/
*.log
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation and development
documentation/
external-docs/
intermediates/
CLAUDE.md
spec.md
README.md

# Test artifacts
test-install*/
*.tgz

# Config files
tsconfig.json
biome.json
bun.lockb

# Keep these
!dist/
!LICENSE
!package.json
