# Docker environment for running full E2E test suites
# Uses Debian (glibc-based) for compatibility with Bun
#
# This image contains the full source code and runs tests from source,
# providing a clean Linux environment for validation.
#
# Usage:
#   docker build -f Dockerfile.e2e -t strandweave-e2e ../..
#   docker run -e ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY strandweave-e2e
#
FROM debian:bookworm-slim

# Install basic utilities and git (required for checkpoint tests)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (required by cli.js)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create a test user (don't run as root)
RUN useradd -m testuser

# Switch to test user for Bun installation
USER testuser
WORKDIR /home/testuser

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash

# Add Bun to PATH
ENV BUN_INSTALL="/home/testuser/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

# Configure git (required for checkpoint system)
RUN git config --global user.email "test@strandweave.dev" \
    && git config --global user.name "Strandweave Test"

# Create project directory
WORKDIR /home/testuser/strandweave

# Copy package files first for better layer caching
COPY --chown=testuser:testuser package.json bun.lockb ./

# Install dependencies
RUN bun install

# Copy source code
COPY --chown=testuser:testuser server/ ./server/
COPY --chown=testuser:testuser tests/ ./tests/
COPY --chown=testuser:testuser tsconfig.json biome.json ./

# Create necessary directories
RUN mkdir -p tests/test-area tests/test-results

# Default: run both E2E test suites
CMD ["sh", "-c", "bun test tests/e2e/happy-path-e2e.test.ts tests/e2e/rollback-comprehensive-e2e.test.ts"]


