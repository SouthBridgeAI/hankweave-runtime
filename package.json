{
  "name": "@southbridgeai/strandweave",
  "version": "0.1.31",
  "description": "Orchestration runtime for antibrittle agentic workflows",
  "author": "Southbridge",
  "license": "MIT",
  "keywords": [
    "strandweave"
  ],
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "bin": {
    "strandweave": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "shims",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:exe": "bun scripts/build-executable.ts",
    "build:exe:linux": "bun scripts/build-executable.ts linux-x64 strandweave-linux-x64",
    "build:exe:linux-arm": "bun scripts/build-executable.ts linux-arm64 strandweave-linux-arm64",
    "build:exe:mac": "bun scripts/build-executable.ts darwin-arm64 strandweave-darwin-arm64",
    "build:exe:mac-intel": "bun scripts/build-executable.ts darwin-x64 strandweave-darwin-x64",
    "build:exe:windows": "bun scripts/build-executable.ts windows-x64 strandweave-windows-x64",
    "build:exe:all": "bun build:exe:linux && bun build:exe:linux-arm && bun build:exe:mac && bun build:exe:mac-intel && bun build:exe:windows",
    "test:package": "bun scripts/test-local-package.ts",
    "test:package:verdaccio": "bun scripts/test-with-verdaccio.ts",
    "test:e2e:init": "bun scripts/e2e/init.ts normal",
    "test:e2e:init:npx": "bun scripts/e2e/init.ts npx",
    "test:e2e:init:bunx": "bun scripts/e2e/init.ts bunx",
    "test:e2e:init:binary": "bun scripts/e2e/init.ts binary",
    "test:docker": "./scripts/test-docker/test-executable.sh",
    "test:docker:arm64": "./scripts/test-docker/test-executable.sh --arm64",
    "test:docker:x64": "./scripts/test-docker/test-executable.sh --x64",
    "test:docker:e2e": "./scripts/test-docker/test-e2e.sh",
    "test:docker:full-e2e": "./scripts/test-docker/run-full-e2e.sh",
    "test:docker:full-e2e:happy": "./scripts/test-docker/run-full-e2e.sh --happy-path",
    "test:docker:full-e2e:rollback": "./scripts/test-docker/run-full-e2e.sh --rollback",
    "test:docker:full-e2e:shell": "./scripts/test-docker/run-full-e2e.sh --shell",
    "prepublishOnly": "bun run build",
    "typecheck": "bun run tsc --noEmit && echo 'Type check passed ✅'",
    "tc": "bun typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major",
    "fetch-models": "bun scripts/fetch-models-dev.ts",
    "server": "bun server/index.ts",
    "server:basic": "bun server/index.ts --basic",
    "test": "bun tests/utils/check-test-ready.ts && bun test tests/unit tests/integration tests/e2e/happy-path-e2e.test.ts tests/e2e/rollback-improved-1-e2e.test.ts && bun tests/unit/cleanup-after-tests.ts",
    "test:long": "LONG_TESTS=true bun test tests/long-running",
    "test:unit": "bun tests/unit/cleanup-after-tests.ts && bun test tests/unit && bun tests/unit/cleanup-after-tests.ts",
    "test:integration": "bun tests/integration",
    "test:e2e:check": "bun tests/utils/check-test-ready.ts",
    "test:e2e:sanity": "bun tests/utils/sanity-check.ts",
    "test:e2e:cleanup": "./tests/utils/cleanup-test.sh",
    "pre-test": "bun run test:e2e:check && bun run pre-test:cleanup",
    "pre-test:cleanup": "rm -rf tests/test-area && mkdir -p tests/test-area && rm -rf tests/test-results && mkdir -p tests/test-results && echo '✅ Test area and results cleaned'",
    "cleanup": "echo 'Error: --cleanup requires --config' && exit 1",
    "cleanup:example": "bun server/index.ts --cleanup --config=strand.json",
    "cleanup:force": "bun server/index.ts --cleanup --config=strand.json -y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/bun": "latest",
    "@types/lodash.merge": "^4.6.9",
    "verdaccio": "^6.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.5",
    "@ai-sdk/google": "^2.0.7",
    "@ai-sdk/groq": "^2.0.11",
    "@ai-sdk/openai": "^2.0.18",
    "@anthropic-ai/claude-agent-sdk": "^0.1.70",
    "ai": "^5.0.15",
    "crossws": "^0.4.1",
    "eta": "^3.5.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "lodash.merge": "^4.6.2",
    "minimatch": "^10.0.1",
    "simple-git": "^3.28.0",
    "srvx": "^0.10.0",
    "zod": "^3.25.74"
  }
}
