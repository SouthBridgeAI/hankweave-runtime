{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/hankweave@latest/schemas/sentinel.schema.json",
  "title": "Hankweave Sentinel Configuration",
  "description": "Schema for sentinel configuration files - parallel observation agents. Note: Some runtime validations cannot be expressed in JSON Schema. See https://hankweave.dev/reference/sentinel-config for documentation.",
  "$ref": "#/definitions/HankweaveSentinelConfiguration",
  "definitions": {
    "HankweaveSentinelConfiguration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "event"
                },
                "on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "operator": {
                            "type": "string",
                            "enum": [
                              "equals",
                              "notEquals"
                            ]
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "operator",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "operator": {
                            "type": "string",
                            "enum": [
                              "in",
                              "notIn"
                            ]
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "array",
                            "items": {
                              "type": [
                                "string",
                                "number"
                              ]
                            },
                            "minItems": 1
                          }
                        },
                        "required": [
                          "operator",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "operator": {
                            "type": "string",
                            "const": "contains"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "operator",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "operator": {
                            "type": "string",
                            "const": "matches"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "operator",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "operator": {
                            "type": "string",
                            "enum": [
                              "greaterThan",
                              "lessThan"
                            ]
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "operator",
                          "path",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "type",
                "on"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "sequence"
                },
                "interestFilter": {
                  "type": "object",
                  "properties": {
                    "on": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "on"
                  ],
                  "additionalProperties": false
                },
                "pattern": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "equals",
                                    "notEquals"
                                  ]
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": [
                                    "string",
                                    "number",
                                    "boolean",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "operator",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "in",
                                    "notIn"
                                  ]
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "array",
                                  "items": {
                                    "type": [
                                      "string",
                                      "number"
                                    ]
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "operator",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operator": {
                                  "type": "string",
                                  "const": "contains"
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operator",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operator": {
                                  "type": "string",
                                  "const": "matches"
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "operator",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "operator": {
                                  "type": "string",
                                  "enum": [
                                    "greaterThan",
                                    "lessThan"
                                  ]
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "operator",
                                "path",
                                "value"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "consecutive": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "interestFilter",
                "pattern"
              ],
              "additionalProperties": false
            }
          ]
        },
        "execution": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "immediate"
                }
              },
              "required": [
                "strategy"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "debounce"
                },
                "milliseconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 300000
                }
              },
              "required": [
                "strategy",
                "milliseconds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "count"
                },
                "threshold": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "strategy",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "timeWindow"
                },
                "milliseconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 3600000
                }
              },
              "required": [
                "strategy",
                "milliseconds"
              ],
              "additionalProperties": false
            }
          ]
        },
        "systemPromptFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "systemPromptText": {
          "type": "string"
        },
        "userPromptFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "userPromptText": {
          "type": "string"
        },
        "conversational": {
          "type": "object",
          "properties": {
            "trimmingStrategy": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "maxTurns"
                    },
                    "maxTurns": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "type",
                    "maxTurns"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "maxTokens"
                    },
                    "maxTokens": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "type",
                    "maxTokens"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "continueOnError": {
              "type": "boolean"
            }
          },
          "required": [
            "trimmingStrategy"
          ],
          "additionalProperties": false
        },
        "errorHandling": {
          "type": "object",
          "properties": {
            "maxConsecutiveFailures": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum consecutive failures before unloading sentinel. Default: 3"
            },
            "unloadOnFatalError": {
              "type": "boolean",
              "description": "Whether to unload on fatal errors. Default: true"
            }
          },
          "additionalProperties": false
        },
        "llmParams": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Temperature for response generation (0=deterministic, 2=creative)"
            },
            "maxOutputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "description": "Maximum tokens in the response"
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "description": "Number of retry attempts for failed LLM calls"
            }
          },
          "additionalProperties": false
        },
        "model": {
          "type": "string",
          "description": "The full model ID to use (e.g., \"anthropic/claude-3-5-sonnet-20241022\", \"openai/gpt-4-turbo\")."
        },
        "structuredOutput": {
          "type": "object",
          "properties": {
            "output": {
              "type": "string",
              "enum": [
                "object",
                "array",
                "enum"
              ]
            },
            "schemaStr": {
              "type": "string"
            },
            "schemaFile": {
              "type": "string"
            },
            "enumValues": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "schemaName": {
              "type": "string"
            },
            "schemaDescription": {
              "type": "string"
            }
          },
          "required": [
            "output"
          ],
          "additionalProperties": false
        },
        "joinString": {
          "type": "string",
          "description": "String to join entries in text-based log file. Only valid for text output. Supports escape sequences: \\n (newline), \\t (tab), \\r (carriage return), \\\\ (backslash). Defaults to '\\n---\\n' for visual separation."
        },
        "reportToWebsocket": {
          "type": "object",
          "properties": {
            "lifecycle": {
              "type": "boolean"
            },
            "errors": {
              "type": "boolean"
            },
            "outputs": {
              "type": "boolean"
            },
            "triggers": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "text",
                "jsonl"
              ]
            },
            "file": {
              "type": "string"
            },
            "lastValueFile": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "$schema": {
          "type": "string",
          "description": "JSON Schema URL for editor support"
        }
      },
      "required": [
        "id",
        "name",
        "trigger",
        "execution",
        "model"
      ],
      "additionalProperties": false
    }
  }
}